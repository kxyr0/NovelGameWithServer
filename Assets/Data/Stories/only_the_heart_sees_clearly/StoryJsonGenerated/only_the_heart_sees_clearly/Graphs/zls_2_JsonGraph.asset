  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u043A\u0430 \u043A\u0430\u0436\u0435\u0442\u0441\u044F
      \u0435\u0439 \u043D\u0435\u0436\u0438\u0432\u043E\u0439, \u0430 \u043E\u0442
      \u0442\u043E\u0433\u043E - \u043F\u0443\u0433\u0430\u044E\u0449\u0435\u0439."
    style: {fileID: 0}
    authorComment: 
  - speakerId: oksana
    speakerNameHint: "\u041D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u043A\u0430"
    speaker: {fileID: 11400000, guid: e3e5431c37c54cd0acca84a5951f3db7, type: 2}
    emotion: 2
    richText: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0442\u044B \u0434\u0440\u043E\u0436\u0438\u0448\u044C?
      \u042F \u0432\u0435\u0434\u044C \u0432\u0438\u0436\u0443 \u0442\u0432\u043E\u0438
      \u0441\u043B\u0451\u0437\u044B. \u041E\u043D\u0438 \u043F\u0430\u0445\u043D\u0443\u0442
      \u0441\u043E\u043B\u044C\u044E \u0438 \u0433\u043E\u0440\u0435\u0447\u044C\u044E.
      \u041F\u043E\u0437\u0432\u043E\u043B\u044C \u043C\u043D\u0435 \u0438\u0445
      \u0441\u043C\u044B\u0442\u044C..."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442,
      \u043A\u0430\u043A \u0435\u0451 \u0432\u043E\u043B\u044F \u0441\u043B\u0430\u0431\u0435\u0435\u0442,
      \u043D\u043E \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u043C\u043E\u0436\u0435\u0442
      \u0441 \u044D\u0442\u0438\u043C \u043F\u043E\u0434\u0435\u043B\u0430\u0442\u044C."
    style: {fileID: 0}
    authorComment: 
