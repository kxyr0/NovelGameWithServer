  lines:
  - speakerId: bab_nyura
    speakerNameHint: "\u0411\u0430\u0431 \u041D\u044E\u0440\u0430"
    speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 2
    richText: "\u041E\u0445, \u0432\u043D\u0443\u0447\u0435\u043D\u044C\u043A\u0430,
      \u043E\u043F\u044F\u0442\u044C \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430
      \u0442\u044B \u043C\u0435\u043D\u044F. \u041F\u043E\u0439\u0434\u0443-\u043A\u0430
      \u044F\u0439\u0446\u0430 \u0441\u043E\u0431\u0435\u0440\u0443\u2026"
    style: {fileID: 0}
    authorComment: 
  - speakerId: bab_nyura
    speakerNameHint: "\u0411\u0430\u0431 \u041D\u044E\u0440\u0430"
    speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 2
    richText: "\u0410 \u0442\u044B \u043A\u0430\u043A \u043F\u043E\u0435\u0448\u044C
      - \u0441\u0431\u0435\u0433\u0430\u0439 \u043D\u0430 \u0440\u044B\u043D\u043E\u043A,
      \u0431\u0443\u0434\u044C \u0434\u043E\u0431\u0440\u0430. \u0422\u0432\u043E\u0440\u043E\u0436\u043A\u0443
      \u0442\u0430\u043C \u0441\u0432\u0435\u0436\u0435\u0433\u043E \u0432\u043E\u0437\u044C\u043C\u0438
      \u0443 \u0442\u0451\u0442\u0438 \u0413\u0430\u043B\u0438, \u043E\u043D\u0430
      \u0443 \u043D\u0430\u0441 \u0441 \u0444\u0435\u0440\u043C\u044B. \u0421\u043A\u0430\u0436\u0438
      - \u043E\u0442 \u041D\u044E\u0440\u044B, \u043E\u043D\u0430 \u043F\u043E\u0439\u043C\u0451\u0442."
    style: {fileID: 0}
    authorComment: 
  - speakerId: bab_nyura
    speakerNameHint: "\u0411\u0430\u0431 \u041D\u044E\u0440\u0430"
    speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 2
    richText: "\u0418 \u0441\u043C\u0435\u0442\u0430\u043D\u043A\u0438 \u043F\u0440\u0438\u0445\u0432\u0430\u0442\u0438
      - \u043A \u0432\u0435\u0447\u0435\u0440\u0443 \u0431\u043B\u0438\u043D\u0446\u043E\u0432
      \u043D\u0430\u0436\u0430\u0440\u044E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u043D\u0435\u0441\u043F\u0435\u0448\u043D\u043E \u0434\u043E\u0435\u0434\u0430\u0435\u0442
      \u043E\u043B\u0430\u0434\u044C\u0438. \u0421\u043E\u043B\u043D\u0446\u0435
      \u0437\u0430 \u043E\u043A\u043D\u043E\u043C \u0437\u0430\u043B\u0438\u0432\u0430\u0435\u0442
      \u0441\u0430\u0434 \u0442\u0430\u043A\u0438\u043C \u044F\u0440\u043A\u0438\u043C
      \u0441\u0432\u0435\u0442\u043E\u043C, \u0447\u0442\u043E \u0437\u0435\u043B\u0435\u043D\u044C
      \u043A\u0430\u0436\u0435\u0442\u0441\u044F \u0444\u043B\u0443\u043E\u0440\u0435\u0441\u0446\u0435\u043D\u0442\u043D\u043E\u0439.
      \u041E\u043D\u0430 \u0432\u0441\u0442\u0430\u0435\u0442, \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044F
      \u043D\u0435\u043F\u0440\u0438\u0432\u044B\u0447\u043D\u0443\u044E \u0441\u044B\u0442\u043E\u0441\u0442\u044C
      \u0438 \u043B\u0435\u0433\u043A\u043E\u0441\u0442\u044C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: '{playerName}'
    speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 9
    richText: "\u0421\u0442\u0440\u0430\u043D\u043D\u043E. \u0412 \u043E\u0444\u0438\u0441\u0435
      \u043F\u043E\u0441\u043B\u0435 \u0442\u0430\u043A\u043E\u0433\u043E \u0437\u0430\u0432\u0442\u0440\u0430\u043A\u0430
      \u044F \u0431\u044B \u0443\u0436\u0435 \u043C\u0435\u0447\u0442\u0430\u043B\u0430
      \u043E \u0432\u0442\u043E\u0440\u043E\u0439 \u0447\u0430\u0448\u043A\u0435
      \u043A\u043E\u0444\u0435, \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0441\u0442\u043E
      \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0433\u043B\u0430\u0437\u0430.
      \u0410 \u0437\u0434\u0435\u0441\u044C... \u0437\u0434\u0435\u0441\u044C \u044D\u043D\u0435\u0440\u0433\u0438\u044F
      \u0431\u0443\u0434\u0442\u043E \u0432 \u0441\u0430\u043C\u043E\u043C \u0432\u043E\u0437\u0434\u0443\u0445\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u043D\u0430\u0434\u0435\u0432\u0430\u0435\u0442 \u0441\u0430\u043D\u0434\u0430\u043B\u0438\u0438
      \u0438 \u0431\u0435\u0440\u0435\u0442 \u043F\u043B\u0435\u0442\u0435\u043D\u0443\u044E
      \u043A\u043E\u0440\u0437\u0438\u043D\u043A\u0443."
    style: {fileID: 0}
    authorComment: 
