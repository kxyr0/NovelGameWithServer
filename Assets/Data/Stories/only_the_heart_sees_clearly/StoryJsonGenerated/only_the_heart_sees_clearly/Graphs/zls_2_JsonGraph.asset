  guid: zls2_dialogue_022_phone_ignore
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u0435 \u0433\u043B\u044F\u0434\u044F, \u043E\u0442\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u0442\u0435\u043B\u0435\u0444\u043E\u043D \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443.
      {playerName} \u043F\u0435\u0440\u0435\u0441\u0438\u043B\u0438\u0432\u0430\u0435\u0442
      \u0441\u0435\u0431\u044F \u0438 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435
      \u0431\u043E\u043B\u0435\u0437\u043D\u0435\u043D\u043D\u043E\u0435 \u043B\u044E\u0431\u043E\u043F\u044B\u0442\u0441\u0442\u0432\u043E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0422\u0435\u043B\u0435\u0444\u043E\u043D \u043B\u0435\u0442\u0438\u0442
      \u043D\u0430 \u043F\u043E\u0434\u0443\u0448\u043A\u0443 \u044D\u043A\u0440\u0430\u043D\u043E\u043C
      \u0432\u043D\u0438\u0437, \u043D\u043E \u0432\u043E\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435
      \u0432\u0441\u0435 \u0440\u0430\u0432\u043D\u043E \u043F\u043E\u0434\u0441\u043E\u0432\u044B\u0432\u0430\u0435\u0442
      \u0435\u0439 \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u044B\u0435 \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u0435\u0433\u043E \u0441\u043C\u0435\u0445, \u0437\u0430\u043F\u0430\u0445
      \u0435\u0433\u043E \u043F\u0430\u0440\u0444\u044E\u043C\u0430, \u0442\u043E,
      \u043A\u0430\u043A \u043E\u043D \u0448\u0435\u043F\u0447\u0435\u0442 \u043A\u043E\u043C\u0443-\u0442\u043E
      \u0434\u0440\u0443\u0433\u043E\u043C\u0443 \u0442\u0435 \u0436\u0435 \u0441\u043B\u043E\u0432\u0430,
      \u0447\u0442\u043E \u043A\u043E\u0433\u0434\u0430-\u0442\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u043B
      \u0435\u0439."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: '{playerName}'
    speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 28
    richText: "\u041E\u043D \u0434\u0430\u0436\u0435 \u043D\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u043B
      \u043C\u043E\u0435\u0433\u043E \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u044F\u2026"
    style: {fileID: 0}
    authorComment: 
