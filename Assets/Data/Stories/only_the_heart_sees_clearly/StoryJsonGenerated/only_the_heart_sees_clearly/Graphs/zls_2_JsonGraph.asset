  - speakerId: bab_nyura
    speakerNameHint: "\u0411\u0430\u0431 \u041D\u044E\u0440\u0430"
    speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 14
    richText: "\u0411\u0435\u0433\u0430\u0442\u044C-\u0442\u043E \u043C\u043E\u0436\u043D\u043E,
      \u0434\u0430 \u0442\u043E\u043B\u044C\u043A\u043E \u043A\u0440\u0443\u0433\u043B\u0430\u044F
      \u043E\u043D\u0430, \u0417\u0435\u043C\u043B\u044F-\u0442\u043E. \u0420\u0430\u043D\u043E
      \u0438\u043B\u0438 \u043F\u043E\u0437\u0434\u043D\u043E \u0432\u0441\u0435
      \u0440\u0430\u0432\u043D\u043E \u043A \u043D\u0430\u0447\u0430\u043B\u0443
      \u043F\u0440\u0438\u0434\u0435\u0448\u044C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0420\u0435\u0448\u0438\u0432 \u0432\u043E\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F
