  guid: zls2_choice_questions_after_ivan_ask_grandfather
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  - character: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: bab_nyura
  lines:
  - speakerId: hero
    speakerNameHint: '{playerName}'
    speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 17
    richText: "\u0410 \u0434\u0435\u0434\u0443\u0448\u043A\u0430? \u041E\u043D \u0442\u043E\u0436\u0435
      \u043D\u0435 \u043B\u044E\u0431\u0438\u043B \u0433\u043E\u0440\u043E\u0434,
      \u043A\u0430\u043A \u0438 \u0442\u044B?"
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0411\u0430\u0431 \u041D\u044E\u0440\u0430 \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F,
      \u0433\u043B\u044F\u0434\u044F \u043A\u0443\u0434\u0430-\u0442\u043E \u0441\u043A\u0432\u043E\u0437\u044C
      {playerName:acc}, \u043F\u0440\u0435\u0434\u0430\u0432\u0430\u044F\u0441\u044C
      \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u044F\u043C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: bab_nyura
    speakerNameHint: "\u0411\u0430\u0431 \u041D\u044E\u0440\u0430"
    speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 17
    richText: "\u0422\u0432\u043E\u0439 \u0434\u0435\u0434, \u0421\u0442\u0435\u043F\u0430\u043D,
      \u0433\u043E\u0440\u044B \u043C\u043E\u0433 \u0441\u0432\u0435\u0440\u043D\u0443\u0442\u044C,
      \u0430 \u0432 \u0433\u043E\u0440\u043E\u0434 \u043A\u0430\u043A \u043A \u0434\u043E\u0447\u043A\u0435
      \u043F\u0440\u0438\u0435\u0437\u0436\u0430\u043B, \u0447\u0430\u0445. \u0413\u043E\u0432\u043E\u0440\u0438\u043B,
      \u043C\u043E\u043B, \u0434\u0443\u0448\u0430 \u0442\u0430\u043C \u043D\u0435
      \u0434\u044B\u0448\u0438\u0442. \u0418 \u043B\u0435\u0441 \u043E\u043D \u043D\u0430\u0448
      \u043A\u0430\u043A \u0441\u0432\u043E\u0438 \u043F\u044F\u0442\u044C \u043F\u0430\u043B\u044C\u0446\u0435\u0432
      \u0437\u043D\u0430\u043B - \u043B\u0435\u0448\u0435\u0433\u043E \u043D\u0435
      \u0441\u0442\u0440\u0430\u0448\u0438\u043B\u0441\u044F, \u0432 \u043B\u0430\u0434\u0430\u0445
      \u0441 \u043D\u0438\u043C \u0431\u044B\u043B. \u0412\u0435\u0440\u0438\u043B,
      \u0447\u0442\u043E \u041F\u043E\u0434\u043B\u0435\u0441\u044C\u0435 - \u0441\u0435\u0440\u0434\u0446\u0435
      \u043C\u0438\u0440\u0430. \u0427\u0442\u043E \u0435\u0441\u043B\u0438 \u043E\u043D\u043E
      \u0431\u0438\u0442\u044C\u0441\u044F \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043D\u0435\u0442,
      \u0442\u043E \u0438 \u0432\u0435\u0437\u0434\u0435 \u0436\u0438\u0437\u043D\u044C
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: '{playerName}'
    speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 9
    richText: "\u0418 \u0442\u044B\u2026 \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C
      \u0437\u0434\u0435\u0441\u044C \u0441\u043E\u0432\u0441\u0435\u043C \u043E\u0434\u043D\u0430
      \u043F\u043E\u0441\u043B\u0435 \u0435\u0433\u043E \u0443\u0445\u043E\u0434\u0430?
      \u041D\u0435\u0443\u0436\u0435\u043B\u0438 \u043D\u0435 \u0445\u043E\u0442\u0435\u043B\u043E\u0441\u044C
      \u0432 \u0446\u0438\u0432\u0438\u043B\u0438\u0437\u0430\u0446\u0438\u044E,
      \u043A \u043B\u044E\u0434\u044F\u043C?"
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0411\u0430\u0431 \u041D\u044E\u0440\u0430 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E
      \u0440\u0430\u0437\u0433\u043B\u0430\u0436\u0438\u0432\u0430\u0435\u0442 \u0441\u043A\u0430\u0442\u0435\u0440\u0442\u044C
      \u043C\u043E\u0440\u0449\u0438\u043D\u0438\u0441\u0442\u044B\u043C\u0438 \u043B\u0430\u0434\u043E\u043D\u044F\u043C\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: bab_nyura
    speakerNameHint: "\u0411\u0430\u0431 \u041D\u044E\u0440\u0430"
    speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 2
    richText: "\u0410 \u044F \u0438 \u043D\u0435 \u043E\u0434\u043D\u0430. \u0417\u0434\u0435\u0441\u044C
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430
      \u0437\u043D\u0430\u0435\u0442, \u0437\u0434\u043E\u0440\u043E\u0432\u0430\u0435\u0442\u0441\u044F.
      \u0415\u0441\u0442\u044C \u0441 \u043A\u0435\u043C \u0441\u043B\u043E\u0432\u043E\u043C
      \u043E\u0431\u043C\u043E\u043B\u0432\u0438\u0442\u044C\u0441\u044F. \u0414\u0430
      \u0438 \u043E\u0434\u0438\u043D\u043E\u0447\u0435\u0441\u0442\u0432\u043E,
      {playerName}, \u044D\u0442\u043E \u043D\u0430\u0443\u043A\u0430 \u0442\u043E\u043D\u043A\u0430\u044F.
      \u041A \u043D\u0435\u043C\u0443 \u043F\u0440\u0438\u0432\u044B\u043A\u043D\u0443\u0442\u044C
      \u043D\u0443\u0436\u043D\u043E - \u0442\u0430\u043A \u0438 \u0441\u043B\u044B\u0448\u0430\u0442\u044C
      \u043D\u0430\u0443\u0447\u0438\u0448\u044C\u0441\u044F: \u0441\u0435\u0431\u044F,
      \u0434\u0440\u0443\u0433\u0438\u0445, \u043F\u0440\u0438\u0440\u043E\u0434\u0443
      \u043D\u0430\u0448\u0443 \u0437\u0434\u0435\u0448\u043D\u044E\u044E\u2026"
    style: {fileID: 0}
    authorComment: 
