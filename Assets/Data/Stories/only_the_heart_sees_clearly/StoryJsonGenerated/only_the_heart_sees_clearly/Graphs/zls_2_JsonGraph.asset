  guid: zls2_dialogue_020_phone_intro
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0417\u0430\u043A\u043E\u043D\u0447\u0438\u0432 \u0441 \u0443\u0431\u043E\u0440\u043A\u043E\u0439,
      {playerName} \u0443\u0445\u043E\u0434\u0438\u0442 \u043A \u0441\u0435\u0431\u0435,
      \u0447\u0442\u043E\u0431\u044B \u043F\u0435\u0440\u0435\u0432\u0435\u0441\u0442\u0438
      \u0434\u0443\u0445."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u043E\u043B\u043D\u0435\u0447\u043D\u044B\u0435 \u043B\u0443\u0447\u0438
      \u043B\u044C\u044E\u0442\u0441\u044F \u0441\u043A\u0432\u043E\u0437\u044C \u043F\u044B\u043B\u044C\u043D\u044B\u0435
      \u0441\u0442\u0435\u043A\u043B\u0430, \u043E\u043A\u0440\u0430\u0448\u0438\u0432\u0430\u044F
      \u0441\u0442\u0435\u043D\u044B \u0432 \u0446\u0432\u0435\u0442 \u0441\u043F\u0435\u043B\u043E\u0439
      \u043E\u0431\u043B\u0435\u043F\u0438\u0445\u0438. \u041F\u0430\u0445\u043D\u0435\u0442
      \u043D\u0430\u0433\u0440\u0435\u0442\u044B\u043C \u0434\u0435\u0440\u0435\u0432\u043E\u043C
      \u0438 \u0441\u0443\u0445\u043E\u0439 \u043F\u043E\u043B\u044B\u043D\u044C\u044E,
      \u0441\u0432\u0438\u0441\u0430\u044E\u0449\u0435\u0439 \u0441 \u0431\u0430\u043B\u043E\u043A."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u0443\u0434\u043E\u0432\u043B\u0435\u0442\u0432\u043E\u0440\u0435\u043D\u043D\u043E
      \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F \u044D\u0442\u043E\u0439
      \u043D\u0435\u0437\u0430\u043C\u044B\u0441\u043B\u043E\u0432\u0430\u0442\u043E\u0439
      \u043A\u0430\u0440\u0442\u0438\u043D\u0435. \u0415\u0439 \u0445\u043E\u0447\u0435\u0442\u0441\u044F
      \u043F\u0440\u043E\u0441\u0442\u043E \u0437\u0430\u043A\u0440\u044B\u0442\u044C
      \u0433\u043B\u0430\u0437\u0430 \u0438 \u043D\u0430 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u044C\u0435
      \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F \u0432
      \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0435\u0439 \u0442\u0438\u0448\u0438\u043D\u0435,
      \u043D\u043E \u0442\u0435\u043B\u0435\u0444\u043E\u043D \u0432 \u043A\u0430\u0440\u043C\u0430\u043D\u0435
      \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E \u0433\u043B\u0443\u0445\u043E
      \u0432\u0438\u0431\u0440\u0438\u0440\u0443\u0435\u0442, \u0441\u043E\u043E\u0431\u0449\u0430\u044F
      \u043E \u043D\u043E\u0432\u043E\u043C \u0443\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u0438\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042D\u0442\u043E\u0442 \u0437\u0432\u0443\u043A \u043A\u0430\u0436\u0435\u0442\u0441\u044F
      \u0437\u0434\u0435\u0441\u044C \u0438\u043D\u043E\u0440\u043E\u0434\u043D\u044B\u043C,
      \u043A\u0430\u043A \u0441\u043A\u0440\u0435\u0436\u0435\u0442 \u0433\u0432\u043E\u0437\u0434\u044F
      \u043F\u043E \u0441\u0442\u0435\u043A\u043B\u0443. \u041E\u043D\u0430 \u0432\u0437\u0434\u0440\u0430\u0433\u0438\u0432\u0430\u0435\u0442
      \u043E\u0442 \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E\u0441\u0442\u0438,
      \u043D\u043E \u0434\u043E\u0441\u0442\u0430\u0451\u0442 \u0441\u043C\u0430\u0440\u0442\u0444\u043E\u043D."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: '{playerName}'
    speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 6
    richText: "\u041D\u0435\u0443\u0436\u0435\u043B\u0438 \u043F\u043E\u044F\u0432\u0438\u043B\u0430\u0441\u044C
      \u0441\u0435\u0442\u044C?"
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042D\u043A\u0440\u0430\u043D \u0432\u0441\u043F\u044B\u0445\u0438\u0432\u0430\u0435\u0442.
      \u041E\u043D\u0430 \u0431\u044B\u0441\u0442\u0440\u043E \u043F\u0440\u043E\u0431\u0435\u0433\u0430\u0435\u0442\u0441\u044F
      \u043F\u043E \u043D\u0435\u043C\u0443 \u0433\u043B\u0430\u0437\u0430\u043C\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\xAB\u0410\u0440\u0442\u0451\u043C \u0434\u043E\u0431\u0430\u0432\u0438\u043B
      \u043D\u043E\u0432\u043E\u0435 \u0444\u043E\u0442\u043E\xBB"
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: '{playerName}'
    speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 28
    richText: "\u2026"
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: '{playerName}'
    speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 28
    richText: "\u041D\u0435 \u0441\u043C\u043E\u0442\u0440\u0438. \u041F\u0440\u043E\u0441\u0442\u043E
      \u0441\u043C\u0430\u0445\u043D\u0438 \u0438 \u0436\u0438\u0432\u0438 \u0434\u0430\u043B\u044C\u0448\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: '{playerName}'
    speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 28
    richText: "\u042D\u0442\u043E \u0442\u0435\u0431\u0435 \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u0434\u0430\u0441\u0442."
    style: {fileID: 0}
    authorComment: 
