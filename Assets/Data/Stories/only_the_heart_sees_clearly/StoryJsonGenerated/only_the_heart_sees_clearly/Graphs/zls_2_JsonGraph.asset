  lines:
  - speakerId: bab_nyura
    speakerNameHint: "\u0411\u0430\u0431 \u041D\u044E\u0440\u0430"
    speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 6
    richText: "\u0411\u0430\u0442\u044E\u0448\u043A\u0438, \u0430 \u0447\u0435\u0433\u043E
      \u043A\u043E\u043B\u0435\u043D\u0438 \u043A\u0440\u043E\u0432\u044F\u0442!?"
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0432\u0441\u043F\u043B\u0435\u0441\u043A\u0438\u0432\u0430\u0435\u0442
      \u0440\u0443\u043A\u0430\u043C\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u043E\u0442\u043C\u0430\u0445\u0438\u0432\u0430\u0435\u0442\u0441\u044F:
      \u041D\u0438\u0447\u0435\u0433\u043E \u0441\u0442\u0440\u0430\u0448\u043D\u043E\u0433\u043E,
