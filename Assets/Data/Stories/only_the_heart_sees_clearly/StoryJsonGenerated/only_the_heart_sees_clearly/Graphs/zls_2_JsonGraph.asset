  guid: zls2_dialogue_017_market_leave
  nodeTitle: 
  activeCharacters: []
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u043E\u043B\u043D\u0446\u0435 \u0443\u0436\u0435 \u043A\u043B\u043E\u043D\u0438\u0442\u0441\u044F
      \u043A \u0437\u0430\u043F\u0430\u0434\u0443, \u0436\u0430\u0440\u0430 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u0442\u044F\u0433\u0443\u0447\u0435\u0439, \u043B\u0435\u043D\u0438\u0432\u043E\u0439."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041B\u044E\u0434\u0438 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u0440\u0430\u0441\u0445\u043E\u0434\u044F\u0442\u0441\u044F: \u043A\u0442\u043E
      \u0441 \u043A\u043E\u0440\u0437\u0438\u043D\u043A\u0430\u043C\u0438, \u043A\u0442\u043E
      \u0441 \u0434\u0435\u0442\u044C\u043C\u0438 \u0437\u0430 \u0440\u0443\u043A\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
