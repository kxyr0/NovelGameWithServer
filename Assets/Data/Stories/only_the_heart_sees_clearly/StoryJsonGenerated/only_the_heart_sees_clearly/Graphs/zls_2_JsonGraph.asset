    speakerNameHint: hero
  - character: {fileID: 11400000, guid: 986b87b8b26944e9b0390c6979bdb391, type: 2}
    emotion: 0
    position: 1
    speakerNameHint: girl_1
  - character: {fileID: 11400000, guid: b27ea0cd50da4d35ae5a312ad98d8ff5, type: 2}
    emotion: 0
