  guid: pp_dialogue_vlad_coffee_block_001
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  - character: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: pp_vlad
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0417\u0430\u0442\u0435\u043C \u0441\u0442\u0430\u0432\u0438\u0442
      \u043D\u0430 \u0441\u0442\u043E\u043B \u043A\u0430\u0440\u0442\u043E\u043D\u043D\u044B\u0439
      \u0441\u0442\u0430\u043A\u0430\u043D\u0447\u0438\u043A \u0438 \u043F\u043E\u0434\u0432\u0438\u0433\u0430\u0435\u0442
      \u043A \u043D\u0435\u043C\u0443"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 2
    richText: "\u042D\u0442\u043E \u0432 \u0437\u043D\u0430\u043A \u043F\u0435\u0440\u0435\u043C\u0438\u0440\u0438\u044F.
      \u0414\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438\u0441\u044C?"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 26
    richText: "\u041B\u0430\u0442\u0442\u0435?"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u041C\u042F \u0431\u0443\u0434\u043D\u0438\u0447\u043D\u043E
      \u043F\u043E\u0436\u0438\u043C\u0430\u0435\u0442 \u043F\u043B\u0435\u0447\u0430\u043C\u0438:"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 2
    richText: "\u041D\u0430 \u043A\u043E\u043A\u043E\u0441\u043E\u0432\u043E\u043C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 30
    richText: "\xAB\u041A\u0430\u043A \u0431\u0443\u0434\u0442\u043E \u0431\u044B
      \u044D\u0442\u043E \u0432\u0430\u0436\u043D\u043E. \u041A\u043E\u043A\u043E\u0441\u043E\u0432\u043E\u0435,
      \u043C\u0438\u043D\u0434\u0430\u043B\u044C\u043D\u043E\u0435 - \u0432\u0441\u0451
      \u043E\u0434\u043D\u043E: \u043D\u0435 \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F,
      \u0435\u0441\u043B\u0438 \u0431\u0443\u0434\u0435\u0442 \u043E\u0442 \u043C\u0435\u043D\u044F.\xBB"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 17
    richText: "\u0413\u043E\u0441\u043F\u043E\u0434\u0438\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u0432\u0437\u0434\u044B\u0445\u0430\u0435\u0442, \u043D\u043E
      \u0432\u0441\u0451-\u0442\u0430\u043A\u0438 \u043F\u0440\u0438\u0434\u0432\u0438\u0433\u0430\u0435\u0442
      \u0441\u0442\u0430\u043A\u0430\u043D\u0447\u0438\u043A \u043A \u0441\u0435\u0431\u0435."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 17
    richText: "\u041E\u0431\u044B\u0447\u043D\u043E \u043F\u044C\u044E \u0447\u0435\u0440\u043D\u044B\u0439."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 13
    richText: "\u0417\u043D\u0430\u0447\u0438\u0442, \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u043D\u0435 \u043A\u0430\u043A \u043E\u0431\u044B\u0447\u043D\u043E."
    style: {fileID: 0}
    authorComment: 
