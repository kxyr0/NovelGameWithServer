  guid: pp_dialogue_gabriel_cutscene_001
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0427\u0442\u043E-\u0442\u043E - \u0418\u041C\u042F \u043D\u0435
      \u0437\u043D\u0430\u0435\u0442, \u0447\u0442\u043E \u0438\u043C\u0435\u043D\u043D\u043E
      - \u0437\u0430\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0435\u0451
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F \u0438
      \u0440\u0430\u0441\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0435\u0433\u043E
      \u043F\u043E\u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u0435\u0435,
      \u0430 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0440\u0430\u0432\u043D\u043E\u0434\u0443\u0448\u043D\u043E
      \u0441\u043C\u0430\u0445\u043D\u0443\u0442\u044C \u0438 \u0437\u0430\u043A\u0440\u044B\u0442\u044C
      \u0441\u043D\u0438\u043C\u043E\u043A."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0442 \u0435\u0433\u043E \u0446\u0435\u043F\u043A\u043E\u0433\u043E,
      \u0445\u0438\u0449\u043D\u043E\u0433\u043E \u0432\u0437\u0433\u043B\u044F\u0434\u0430
      \u0435\u0439 \u043D\u0430 \u0441\u0435\u043A\u0443\u043D\u0434\u0443 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u0434\u0430\u0436\u0435 \u043A\u0430\u043A-\u0442\u043E \u043D\u0435\u043B\u043E\u0432\u043A\u043E
      - \u043A\u0430\u043A \u0435\u0441\u043B\u0438 \u0431\u044B \u043E\u043D \u0437\u043D\u0430\u043B,
      \u0447\u0442\u043E \u043E\u043D\u0430 \u0441\u0435\u0439\u0447\u0430\u0441
      \u0432 \u043E\u0442\u043A\u0440\u044B\u0442\u0443\u044E \u043F\u044F\u043B\u0438\u0442\u0441\u044F
      \u043D\u0430 \u0435\u0433\u043E \u0444\u043E\u0442\u043E."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 12
    richText: "\xAB\u041A\u0440\u0430\u0441\u0438\u0432\u044B\u0439 \u043C\u0443\u0436\u0447\u0438\u043D\u0430\u2026\xBB"
    style: {fileID: 0}
    authorComment: 
