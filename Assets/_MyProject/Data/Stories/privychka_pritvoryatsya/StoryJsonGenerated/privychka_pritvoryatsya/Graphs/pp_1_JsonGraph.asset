  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u0432\u0441\u043F\u044B\u0445\u043D\u0443\u0432\u0448\u0435\u0435
      \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0435\u043D\u0438\u0435, \u043E\u043D\u0430
      \u043F\u0440\u043E\u0433\u043B\u0430\u0442\u044B\u0432\u0430\u0435\u0442 \u043D\u0435\u0432\u044B\u0441\u043A\u0430\u0437\u0430\u043D\u043D\u044B\u0435
      \u0441\u043B\u043E\u0432\u0430, \u0440\u0435\u0448\u0438\u0432 \u043B\u0438\u0448\u043D\u0438\u0439
      \u0440\u0430\u0437 \u043D\u0435 \u0432\u044B\u0441\u043E\u0432\u044B\u0432\u0430\u0442\u044C\u0441\u044F.
      \u0417\u043B\u0438\u0442\u0441\u044F \u043B\u0438 \u043E\u043D\u0430 \u043D\u0430
      \u0441\u0435\u0431\u044F \u0438\u0437-\u0437\u0430 \u044D\u0442\u043E\u0433\u043E?
      \u0414\u0430, \u043A\u043E\u043D\u0435\u0447\u043D\u043E, \u0434\u0430. \u041D\u043E
      \u0438\u043C\u0435\u0435\u0442 \u043B\u0438 \u044D\u0442\u0430 \u0437\u043B\u043E\u0441\u0442\u044C
      \u0441\u043C\u044B\u0441\u043B, \u0435\u0441\u043B\u0438 \u043E\u0442\u043C\u043E\u0442\u0430\u0442\u044C
      \u043D\u0430\u0437\u0430\u0434 \u0432\u0440\u0435\u043C\u044F \u0438 \u043F\u043E\u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F
      \u0441\u0435\u0431\u044F \u043E\u0442\u0441\u0442\u043E\u044F\u0442\u044C \u043E\u043D\u0430
      \u0443\u0436\u0435 \u043D\u0435 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u0430?"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 20
    richText: "\xAB\u041D\u0430\u043F\u044B\u0449\u0435\u043D\u043D\u044B\u0439 \u043F\u0440\u0438\u0434\u0443\u0440\u043E\u043A\u2026\xBB"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E, \u043E\u043D\u0430 \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E
      \u043F\u043E\u043C\u043D\u0438\u0442 \u0435\u0433\u043E \u043B\u0435\u0434\u044F\u043D\u043E\u0439
      \u0432\u0437\u0433\u043B\u044F\u0434, \u0435\u0433\u043E \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0439
      \u0442\u043E\u043D \u0438\u2026 \u0440\u0430\u0441\u0441\u0435\u0447\u0435\u043D\u043D\u0443\u044E
      \u0448\u0440\u0430\u043C\u043E\u043C \u0433\u0443\u0431\u0443."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 9
    richText: "\xAB\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u043E\u0442\u043A\u0443\u0434\u0430
      \u0443 \u043D\u0435\u0433\u043E \u044D\u0442\u043E\u0442 \u0448\u0440\u0430\u043C?
      \u041D\u0443\u0436\u043D\u043E \u0431\u0443\u0434\u0435\u0442 \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C\u2026\xBB"
    style: {fileID: 0}
    authorComment: 
