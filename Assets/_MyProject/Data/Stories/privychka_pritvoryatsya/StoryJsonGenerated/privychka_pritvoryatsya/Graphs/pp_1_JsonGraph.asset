  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: pp_intro_walk_001
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041A\u0430\u0431\u043B\u0443\u043A\u0438 \u0433\u043B\u0443\u0445\u043E
      \u0443\u0434\u0430\u0440\u044F\u044E\u0442\u0441\u044F \u043E\u0431 \u0430\u0441\u0444\u0430\u043B\u044C\u0442."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u0435\u0442\u0435\u0440 \u043B\u0438\u0436\u0435\u0442 \u0445\u043E\u043B\u043E\u0434\u043E\u043C
      \u0449\u0435\u043A\u0438, \u0437\u0430\u0441\u0442\u0430\u0432\u043B\u044F\u044F
      \u043F\u043E\u0436\u0430\u043B\u0435\u0442\u044C \u043E \u0442\u043E\u043C,
      \u0447\u0442\u043E \u043E\u043D\u0430 \u0432 \u043E\u0447\u0435\u0440\u0435\u0434\u043D\u043E\u0439
      \u0440\u0430\u0437 \u043F\u0440\u0435\u0434\u043F\u043E\u0447\u043B\u0430 \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u0439
      \u043E\u0431\u0440\u0430\u0437 \u0448\u0430\u043F\u043A\u0435."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 2
    richText: "\xAB\u0417\u0430\u0442\u043E \u0443\u043A\u043B\u0430\u0434\u043A\u0430
      \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435\u2026\xBB"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u043B\u043E\u0432\u0438\u0442 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
      \u0432\u0437\u0433\u043B\u044F\u0434 \u0432 \u043E\u0442\u0440\u0430\u0436\u0435\u043D\u0438\u0438
      \u043E\u0434\u043D\u043E\u0439 \u0438\u0437 \u0432\u0438\u0442\u0440\u0438\u043D
      \u0438 \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F \u0441\u0430\u043C\u043E\u0439
      \u0441\u0435\u0431\u0435. \u0427\u0442\u043E-\u0447\u0442\u043E, \u0430 \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u0442\u044C
      \u043A\u0430\u043A \u0441 \u0438\u0433\u043E\u043B\u043E\u0447\u043A\u0438
      - \u0443 \u043D\u0435\u0451 \u0432 \u043A\u0440\u043E\u0432\u0438. \u0414\u0430\u0436\u0435
      \u0435\u0441\u043B\u0438 \u0432\u043D\u0443\u0442\u0440\u0438 \u0431\u0435\u0434\u043B\u0430\u043C,
      \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u0441\u0430\u043C \u0447\u0451\u0440\u0442
      \u0441\u043B\u043E\u043C\u0438\u0442 \u043E\u0431\u0435 \u043D\u043E\u0433\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0410 \u0432\u043D\u0443\u0442\u0440\u0438 \u0443 \u043D\u0435\u0451
      \u0441\u0435\u0439\u0447\u0430\u0441 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0431\u0430\u0440\u0434\u0430\u043A - \u0446\u0435\u043B\u0430\u044F \u043A\u0430\u043A\u043E\u0444\u043E\u043D\u0438\u044F
      \u0441\u0430\u043C\u044B\u0445 \u0440\u0430\u0437\u043D\u044B\u0445 \u0447\u0443\u0432\u0441\u0442\u0432,
      \u043D\u0430\u0447\u0438\u043D\u0430\u044F \u043E\u0442 \u0431\u0443\u0440\u043D\u043E\u0439
      \u0440\u0430\u0434\u043E\u0441\u0442\u0438, \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u044F
      \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0439 \u0442\u0440\u0435\u0432\u043E\u0433\u043E\u0439
      \u043D\u0430 \u0442\u0435\u043C\u0443 \xAB\u0430 \u0432\u0434\u0440\u0443\u0433
      \u043C\u0435\u043D\u044F \u043D\u0435 \u043F\u0440\u0438\u043C\u0443\u0442?\xBB."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0431\u0443\u0447\u0435\u043D\u0438\u0435: \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0432\u044B\u0431\u043E\u0440 \u043F\u043E\u043C\u043E\u0436\u0435\u0442 \u0432\u0430\u043C
      \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u044C \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440
      \u0433\u043B\u0430\u0432\u043D\u043E\u0439 \u0433\u0435\u0440\u043E\u0438\u043D\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u0442\u0430\u0442 \u041F\u0440\u0438\u043D\u0446\u0438\u043F\u044B
      \u043E\u0442\u0440\u0430\u0436\u0430\u0435\u0442 \u0435\u0451 \u0441\u043A\u043B\u043E\u043D\u043D\u043E\u0441\u0442\u044C
      \u043E\u0442\u043E\u0434\u0432\u0438\u0433\u0430\u0442\u044C \u044D\u043C\u043E\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u0443\u044E
      \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0449\u0443\u044E \u0432\u043E\u043F\u0440\u043E\u0441\u0430
      \u043D\u0430 \u0432\u0442\u043E\u0440\u043E\u0439 \u043F\u043B\u0430\u043D."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u0442\u0430\u0442 \u0427\u0443\u0432\u0441\u0442\u0432\u0430,
      \u043D\u0430\u043F\u0440\u043E\u0442\u0438\u0432, \u0434\u0435\u043B\u0430\u0435\u0442
      \u0433\u0435\u0440\u043E\u0438\u043D\u044E \u0431\u043E\u043B\u0435\u0435 \u044D\u043C\u043E\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0439."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u0442\u0430\u0442 \u0421\u0430\u043C\u043E\u043E\u0446\u0435\u043D\u043A\u0430
      \u043E\u0442\u0440\u0430\u0436\u0430\u0435\u0442 \u0442\u043E, \u043A\u0430\u043A
      \u0433\u0435\u0440\u043E\u0438\u043D\u044F \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0441\u044F
      \u0441\u0430\u043C\u0430 \u043A \u0441\u0435\u0431\u0435 \u0438 \u0442\u043E,
      \u043A\u0430\u043A \u043A \u043D\u0435\u0439 \u043E\u0442\u043D\u043E\u0441\u044F\u0442\u0441\u044F
      \u0444\u0430\u0432\u043E\u0440\u0438\u0442\u044B."
    style: {fileID: 0}
    authorComment: 
