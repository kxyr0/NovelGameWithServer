  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u041C\u042F \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
      \u0432 \u0443\u0447\u0430\u0441\u0442\u043E\u043A, \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u043F\u0440\u043E\u043F\u0443\u0441\u043A \u043A \u0432\u0430\u043B\u0438\u0434\u0430\u0442\u043E\u0440\u0443
      \u0438, \u0440\u0430\u0441\u043F\u0440\u0430\u0432\u0438\u0432 \u043F\u043B\u0435\u0447\u0438,
      \u0438\u0434\u0451\u0442 \u043A \u043D\u0443\u0436\u043D\u043E\u043C\u0443
      \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0443 - \u0435\u0451 \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0443."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
