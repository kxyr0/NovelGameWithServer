  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: pp_dialogue_cafeteria_001
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  - character: {fileID: 11400000, guid: 0134d31ffe795134da58a7dc3f8fbc02, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: pp_guy
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0431\u0435\u0434\u0435\u043D\u043D\u0430\u044F \u0437\u043E\u043D\u0430
      \u0448\u0443\u043C\u0438\u0442 \u0438 \u0433\u0440\u0435\u043C\u0438\u0442:
      \u043A\u0442\u043E-\u0442\u043E \u0431\u043E\u043B\u0442\u0430\u0435\u0442
      \u0443 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0430 \u0441 \u043A\u043E\u0444\u0435,
      \u043A\u0442\u043E-\u0442\u043E \u0437\u0430\u0432\u0438\u0441\u0430\u0435\u0442
      \u0432 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0435, \u043F\u043E\u043F\u0443\u0442\u043D\u043E
      \u043A\u043E\u0432\u044B\u0440\u044F\u044F \u0441\u0430\u043B\u0430\u0442,
      \u043A\u0442\u043E-\u0442\u043E \u0441\u043F\u043E\u0440\u0438\u0442 \u043E
      \u0431\u0435\u0439\u0441\u0431\u043E\u043B\u0435 \u0438\u043B\u0438 \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u0435\u0442
      \u043F\u0440\u0435\u0434\u0441\u0442\u043E\u044F\u0449\u0438\u0435 \u0432\u044B\u0445\u043E\u0434\u043D\u044B\u0435."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u041C\u042F \u0443\u043B\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u043E\u0431\u0440\u044B\u0432\u043A\u0438 \u0444\u0440\u0430\u0437 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E:
      \u0435\u0439 \u043D\u0435\u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B
      \u0447\u0443\u0436\u0438\u0435 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u044B,
      \u043D\u043E \u0444\u043E\u043D\u043E\u0432\u044B\u0439 \u0433\u0443\u043B
      \u043F\u043E\u0447\u0435\u043C\u0443-\u0442\u043E \u0435\u0435 \u0443\u0441\u043F\u043E\u043A\u0430\u0438\u0432\u0430\u0435\u0442
      - \u0441 \u043D\u0438\u043C \u0432\u043E\u043A\u0440\u0443\u0433 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0441\u044F
      \u0436\u0438\u0437\u043D\u044C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0414\u043E\u0436\u0434\u0430\u0432\u0448\u0438\u0441\u044C \u0441\u0432\u043E\u0435\u0439
      \u043E\u0447\u0435\u0440\u0435\u0434\u0438 \u0443 \u0441\u0442\u043E\u0439\u043A\u0438
      \u0441 \u0447\u0430\u0439\u043D\u0438\u043A\u043E\u043C, \u043E\u043D\u0430
      \u043D\u0430\u043B\u0438\u0432\u0430\u0435\u0442 \u043A\u0438\u043F\u044F\u0442\u043E\u043A
      \u0432 \u0441\u0442\u0430\u043A\u0430\u043D\u0447\u0438\u043A, \u043F\u043E\u0441\u043B\u0435
      \u0447\u0435\u0433\u043E \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442
      \u043A \u0432\u044B\u0431\u043E\u0440\u0443 \u0447\u0430\u0439\u043D\u043E\u0433\u043E
      \u043F\u0430\u043A\u0435\u0442\u0438\u043A\u0430 - \u0447\u0435\u0440\u043D\u044B\u0439,
      \u043C\u044F\u0442\u043D\u044B\u0439, \u0440\u043E\u043C\u0430\u0448\u043A\u043E\u0432\u044B\u0439,
      \u0444\u0440\u0443\u043A\u0442\u043E\u0432\u044B\u0439\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u043E\u0432\u0435\u0440\u043D\u0443\u0432\u0448\u0438\u0441\u044C,
      \u0447\u0442\u043E\u0431\u044B \u043E\u0441\u0432\u043E\u0431\u043E\u0434\u0438\u0442\u044C
      \u043C\u0435\u0441\u0442\u043E, \u043E\u043D\u0430 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E
      \u043E\u0441\u0442\u0443\u043F\u0430\u0435\u0442\u0441\u044F. \u0420\u0430\u0432\u043D\u043E\u0432\u0435\u0441\u0438\u0435
      \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0447\u0443\u0434\u043E\u043C, \u043D\u043E \u0447\u0430\u0441\u0442\u044C
      \u043A\u0438\u043F\u044F\u0442\u043A\u0430 \u0432\u044B\u043F\u043B\u0435\u0441\u043A\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u043F\u043E\u0434\u043E\u0448\u0435\u0434\u0448\u0435\u0433\u043E
      \u0441\u0437\u0430\u0434\u0438 \u043F\u0430\u0440\u043D\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u0443\u0441\u043F\u0435\u0432\u0430\u0435\u0442 \u043E\u0442\u0448\u0430\u0442\u043D\u0443\u0442\u044C\u0441\u044F,
      \u0435\u0434\u0432\u0430 \u043D\u0435 \u0443\u0440\u043E\u043D\u0438\u0432
      \u0442\u0435\u043B\u0435\u0444\u043E\u043D, \u043D\u043E \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043A\u0430\u043F\u0435\u043B\u044C \u043F\u043E\u043F\u0430\u0434\u0430\u044E\u0442
      \u043D\u0430 \u0434\u0436\u0438\u043D\u0441\u044B. \u041E\u043D \u0432\u0441\u043A\u0440\u0438\u043A\u0438\u0432\u0430\u0435\u0442
      - \u0441\u043A\u043E\u0440\u0435\u0435 \u043E\u0442 \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E\u0441\u0442\u0438,
      \u043D\u0435\u0436\u0435\u043B\u0438 \u043E\u0442 \u0431\u043E\u043B\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 8
    richText: "\u0411\u043E\u0436\u0435!"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u0441\u044F \u0435\u0435 \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E\u0441\u0442\u044C
      \u043B\u0435\u0442\u0438\u0442 \u043A\u043E\u0442\u0443 \u043F\u043E\u0434
      \u0445\u0432\u043E\u0441\u0442."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 8
    richText: "\u042F\u2026 \u044F\u2026 \u044F \u0431\u044B\u0432\u0430\u044E \u043E\u0447\u0435\u043D\u044C
      \u043D\u0435\u0443\u043A\u043B\u044E\u0436\u0435\u0439! \u0418\u0437\u0432\u0438\u043D\u0438\u0442\u0435!
      \u0412\u0441\u0451 \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435?"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0134d31ffe795134da58a7dc3f8fbc02, type: 2}
    emotion: 2
    richText: "\u0416\u0438\u0432."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0425\u043C\u044B\u043A\u043D\u0443\u0432, \u043F\u0430\u0440\u0435\u043D\u044C
      \u0444\u043B\u0435\u0433\u043C\u0430\u0442\u0438\u0447\u043D\u043E \u043E\u0442\u0440\u044F\u0445\u0438\u0432\u0430\u0435\u0442
      \u0434\u0436\u0438\u043D\u0441\u044B, \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E
      \u0431\u044B \u0432 \u044D\u0442\u043E\u043C \u0435\u0441\u0442\u044C \u0442\u043E\u043B\u043A.
      \u0417\u043B\u043E\u0441\u0442\u0438 \u0432 \u0435\u0433\u043E \u0433\u043E\u043B\u043E\u0441\u0435
      \u043D\u0435\u0442 - \u0435\u0433\u043E \u0442\u043E\u043D \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0431\u0443\u0434\u043D\u0438\u0447\u043D\u044B\u0439 \u0434\u043B\u044F \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430,
      \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u043E\u0433\u043E \u043D\u0430
      \u043A\u043E\u043D\u0444\u043B\u0438\u043A\u0442."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 8
    richText: "\u0415\u0449\u0451 \u0440\u0430\u0437 \u0438\u0437\u0432\u0438\u043D\u0438\u0442\u0435.
      \u042F, \u043F\u0440\u0430\u0432\u0434\u0430, \u043D\u0435 \u0445\u043E\u0442\u0435\u043B\u0430!"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0134d31ffe795134da58a7dc3f8fbc02, type: 2}
    emotion: 2
    richText: "\u0414\u0430 \u0431\u044B\u0432\u0430\u0435\u0442."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u043E\u0442\u043C\u0430\u0445\u0438\u0432\u0430\u0435\u0442\u0441\u044F,
      \u0434\u0435\u0440\u0433\u0430\u044F \u043F\u043B\u0435\u0447\u043E\u043C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0134d31ffe795134da58a7dc3f8fbc02, type: 2}
    emotion: 2
    richText: "\u0411\u0443\u0434\u0435\u043C \u0441\u0447\u0438\u0442\u0430\u0442\u044C,
      \u044D\u0442\u043E \u0431\u044B\u043B \u0442\u0430\u043A\u043E\u0439 \u0441\u043F\u043E\u0441\u043E\u0431
      \u0441\u043E \u043C\u043D\u043E\u0439 \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u0442\u044C\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u0437\u0433\u043B\u044F\u0434 \u0443 \u043D\u0435\u0433\u043E
      \u0441 \u0445\u0438\u0442\u0440\u0435\u0446\u043E\u0439."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 9
    richText: "\xAB\u0424\u043B\u0438\u0440\u0442 \u0438\u043B\u0438 \u0442\u0430\u043A\u0430\u044F
      \u043C\u0430\u043D\u0435\u0440\u0430 \u043E\u0431\u0449\u0435\u043D\u0438\u044F?
      \u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u0432\u0441\u0435 \u0436\u0435
      \u0432\u0442\u043E\u0440\u043E\u0435.\xBB"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 9
    richText: "\xAB\u0412\u043F\u0440\u043E\u0447\u0435\u043C, \u0432\u0441\u0435
      \u0440\u0430\u0432\u043D\u043E.\xBB"
    style: {fileID: 0}
    authorComment: 
