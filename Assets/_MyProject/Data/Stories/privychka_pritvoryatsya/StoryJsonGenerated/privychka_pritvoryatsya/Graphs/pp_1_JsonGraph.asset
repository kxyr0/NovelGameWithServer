  lines:
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 22
    richText: "\u042D\u0442\u043E \u0438\u0441\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u043B\u0430\u0434 \u043D\u0435 \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442.
      \u0412 \u043E\u0442\u0432\u0435\u0442 \u0437\u0432\u0443\u0447\u0438\u0442
      \u0442\u043E\u043B\u044C\u043A\u043E \u0449\u0435\u043B\u0447\u043E\u043A \u0440\u0443\u0447\u043A\u0438
      \u0438 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439 \u0432\u044B\u0434\u043E\u0445,
      \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u0432\u0440\u043E\u0434\u0435
      \u0431\u044B \u043D\u0435\u0442 \u043D\u0438\u0447\u0435\u0433\u043E\u2026
      \u043B\u0438\u0448\u043D\u0435\u0433\u043E. \u0412\u043E\u043E\u0431\u0449\u0435
      \u043D\u0438\u0447\u0435\u0433\u043E."
