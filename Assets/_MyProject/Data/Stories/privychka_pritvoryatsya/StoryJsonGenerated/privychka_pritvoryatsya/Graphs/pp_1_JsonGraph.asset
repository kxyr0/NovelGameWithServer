  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: pp_dialogue_vlad_rob_question_001
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: pp_vlad
  - character: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u043E\u0433\u0430\u0441\u0438\u0432 \u044D\u043A\u0440\u0430\u043D,
      \u043E\u043D\u0430 \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F \u0432\u0435\u0440\u043D\u0443\u0442\u044C
      \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0435 \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u0438\u0435
      \u043B\u0438\u0446\u0430, \u043D\u043E \u0434\u043E\u0433\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F,
      \u0447\u0442\u043E \u0435\u0439 \u044D\u0442\u043E \u043D\u0435 \u0443\u0434\u0430\u0435\u0442\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u0435\u043A\u0443\u043D\u0434\u043E\u0439 \u043F\u043E\u0437\u0436\u0435
      \u0434\u043E \u043D\u0435\u0451 \u0434\u043E\u043D\u043E\u0441\u0438\u0442\u0441\u044F
      \u043D\u0435\u0433\u0440\u043E\u043C\u043A\u0438\u0439, \u043F\u043E\u0447\u0442\u0438
      \u043B\u0435\u043D\u0438\u0432\u044B\u0439 \u0432\u043E\u043F\u0440\u043E\u0441."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 0
    richText: "\u041D\u0430\u0432\u044F\u0437\u0447\u0438\u0432\u044B\u0439 \u043F\u043E\u043A\u043B\u043E\u043D\u043D\u0438\u043A?"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0432\u0437\u0433\u043B\u044F\u0434."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u043B\u0430\u0434 \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F
      \u043A\u0440\u0438\u0432\u043E, \u043F\u043E\u0447\u0442\u0438 \u043F\u0440\u0435\u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u041C\u042F \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F
      \u0432 \u043E\u0442\u0432\u0435\u0442 - \u0443\u0436\u0435 \u0448\u0438\u0440\u0435,
      \u0447\u0443\u0442\u044C \u0434\u0440\u0430\u0437\u043D\u044F\u0449\u0435:"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 0
    richText: "\u0420\u0430\u0437\u0432\u0435 \u044F \u043F\u043E\u0445\u043E\u0436\u0430
      \u043D\u0430 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0442\u0435\u0440\u043F\u0438\u0442 \u043D\u0430\u0432\u044F\u0437\u0447\u0438\u0432\u044B\u0445?"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0422\u0435\u043B\u0435\u0444\u043E\u043D \u0432\u0438\u0431\u0440\u0438\u0440\u0443\u0435\u0442
      \u0432\u043D\u043E\u0432\u044C."
    style: {fileID: 0}
    authorComment: 
