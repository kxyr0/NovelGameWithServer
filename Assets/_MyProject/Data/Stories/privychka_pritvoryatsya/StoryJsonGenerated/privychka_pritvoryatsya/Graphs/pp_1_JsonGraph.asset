  lines:
  - speaker: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 30
    richText: "\u0422\u044B \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u043E \u0445\u043E\u0447\u0435\u0448\u044C
      \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043C\u043D\u0435 \u0432
      \u043F\u0430\u0440\u0443 \u043A\u0430\u043A\u0443\u044E-\u0442\u043E \u0434\u0435\u0432\u0447\u043E\u043D\u043A\u0443?"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: cf6c9294272a0684ba26784225cd9bbb, type: 2}
    emotion: 4
    richText: "\u041D\u0443 \u0442\u0430\u043A \u0442\u044B \u0436\u0435 \u0443 \u043D\u0430\u0441
      \u0433\u0440\u0435\u0431\u0430\u043D\u044B\u0439 \u0430\u0432\u0442\u043E\u0440\u0438\u0442\u0435\u0442.
      \u0412\u043E\u0442 \u0438 \u043F\u043E\u0434\u0435\u043B\u0438\u0448\u044C\u0441\u044F
      \u043E\u043F\u044B\u0442\u043E\u043C \u0441 \u043C\u043E\u043B\u043E\u0434\u043D\u044F\u043A\u043E\u043C!"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u041C\u042F \u0445\u043C\u0443\u0440\u0438\u0442\u0441\u044F,
      \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044F \u0432\u043D\u0443\u0442\u0440\u0438
      \u0443\u043A\u043E\u043B \u043E\u0431\u0438\u0434\u044B."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 30
    richText: "\xAB\u0414\u0435\u0432\u0447\u043E\u043D\u043A\u0430\u2026 \u041D\u0443
      \u043A\u043E\u043D\u0435\u0447\u043D\u043E. \u0427\u0435\u0433\u043E \u044F
      \u0435\u0449\u0451 \u043E\u0436\u0438\u0434\u0430\u043B\u0430, \u043A\u043E\u0433\u0434\u0430
      \u0441\u044E\u0434\u0430 \u0448\u043B\u0430?\xBB"
    style: {fileID: 0}
    authorComment: 
