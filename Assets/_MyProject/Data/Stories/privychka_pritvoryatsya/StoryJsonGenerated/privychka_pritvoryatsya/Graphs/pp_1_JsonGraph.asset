  guid: pp_after_take_coffee_001
  nodeTitle: 
  activeCharacters: []
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u043E \u043F\u0440\u0438\u0432\u044B\u0447\u043A\u0435 \u0432\u0437\u044F\u0432
      \u043B\u0430\u0442\u0442\u0435 \u043D\u0430 \u043A\u043E\u043A\u043E\u0441\u043E\u0432\u043E\u043C
      \u043C\u043E\u043B\u043E\u043A\u0435 \u0441 \u043A\u0430\u0440\u0430\u043C\u0435\u043B\u044C\u043D\u044B\u043C
      \u0441\u0438\u0440\u043E\u043F\u043E\u043C, \u0418\u041C\u042F \u0438\u0434\u0451\u0442
      \u043A \u043F\u043E\u043B\u0438\u0446\u0435\u0439\u0441\u043A\u043E\u043C\u0443
      \u0443\u0447\u0430\u0441\u0442\u043A\u0443. \u0422\u0451\u043F\u043B\u044B\u0439
      \u0441\u0442\u0430\u043A\u0430\u043D\u0447\u0438\u043A \u043F\u0440\u0438\u044F\u0442\u043D\u043E
      \u0441\u043E\u0433\u0440\u0435\u0432\u0430\u0435\u0442 \u0440\u0443\u043A\u0438.
      \u041E\u043D\u0430 \u0436\u043C\u0443\u0440\u0438\u0442\u0441\u044F \u043E\u0442
      \u0443\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0438\u044F, \u043F\u0435\u0440\u0435\u043A\u0430\u0442\u044B\u0432\u0430\u044F
      \u043D\u0430 \u044F\u0437\u044B\u043A\u0435 \u0432\u043A\u0443\u0441 \u043A\u043E\u0440\u0438\u0446\u044B
      \u0438 \u043A\u0430\u0440\u0430\u043C\u0435\u043B\u0438. \u0421\u043B\u0430\u0434\u043A\u043E\u0435
      \u0438 \u043C\u044F\u0433\u043A\u043E\u0435 \u0442\u0435\u043F\u043B\u043E
      \u0440\u0430\u0441\u0442\u0435\u043A\u0430\u0435\u0442\u0441\u044F \u043F\u043E
      \u0442\u0435\u043B\u0443, \u0438 \u0434\u0435\u043D\u044C \u0443\u0436\u0435
      \u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F \u0442\u0430\u043A\u0438\u043C
      \u0443\u043D\u044B\u043B\u044B\u043C."
    style: {fileID: 0}
    authorComment: 
