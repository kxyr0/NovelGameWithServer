  contactName: "\u0420\u043E\u0431"
  headerContactMode: 0
  contactAvatar: {fileID: 21300000, guid: 049e84c56498687488dcd5117449c9c7, type: 3}
  typingDelay: 0.15
  messages:
  - senderName: "\u0420\u043E\u0431"
    text: "\u0430 \u043A\u0430\u043A \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C,
      \u0447\u0442\u043E \u044F\u0439\u0446\u0430 \u0441\u0432\u0435\u0436\u0438\u0435?"
    timeText: 15:15
    side: 0
    attachment: {fileID: 0}
    usePhotoLayout: 0
  - senderName: "\u0420\u043E\u0431"
    text: "\u043E\u0442\u0431\u043E\u0439! \u044F \u0440\u0430\u0437\u0431\u0438\u043B
      - \u0432\u0441\u0451 \u043E\u043A, \u043D\u0435 \u0432\u043E\u043D\u044F\u044E\u0442,
      \u0437\u043D\u0430\u0447\u0438\u0442 \u0441\u044A\u0435\u0434\u043E\u0431\u043D\u044B\u0435"
    timeText: 15:16
    side: 0
    attachment: {fileID: 0}
    usePhotoLayout: 0
  - senderName: "\u0420\u043E\u0431"
    text: "\u0433\u0434\u0435 \u043B\u0435\u0436\u0438\u0442 \u0441\u043E\u043B\u044C?"
    timeText: 
    side: 0
    attachment: {fileID: 0}
    usePhotoLayout: 0
  - senderName: "\u0420\u043E\u0431"
    text: "\u043D\u0430\u0448\u0451\u043B"
    timeText: 
    side: 0
    attachment: {fileID: 0}
    usePhotoLayout: 0
  - senderName: "\u0420\u043E\u0431"
    text: "\u0430 \u0447\u0442\u043E \u0432 \u043D\u0430\u0447\u0430\u043B\u0435
      - \u043E\u0432\u043E\u0449\u043D\u0443\u044E \u0441\u043C\u0435\u0441\u044C
      \u0438\u043B\u0438 \u044F\u0438\u0447\u043D\u0443\u044E \u0436\u0438\u0436\u0443?"
    timeText: 
    side: 0
    attachment: {fileID: 0}
    usePhotoLayout: 0
  - senderName: "\u0420\u043E\u0431"
    text: ??????
    timeText: 
    side: 0
    attachment: {fileID: 0}
    usePhotoLayout: 0
  - senderName: "\u0420\u043E\u0431"
    text: "\u044D\u0439!! \u043C\u043E\u044F \u0433\u043E\u043B\u043E\u0434\u043D\u0430\u044F
      \u0441\u043C\u0435\u0440\u0442\u044C \u0431\u0443\u0434\u0435\u0442 \u043D\u0430
      \u0442\u0432\u043E\u0435\u0439 \u0441\u043E\u0432\u0435\u0441\u0442\u0438"
    timeText: 
    side: 0
    attachment: {fileID: 0}
    usePhotoLayout: 0
  - senderName: "\u0420\u043E\u0431"
    text: "\u043E\u043A\u0435\u0439, \u044F \u0437\u0430\u043A\u0438\u043D\u0443\u043B
      \u0432\u0441\u0451 \u0440\u0430\u0437\u043E\u043C. \u043E\u0442 \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u044B
      \u043C\u0435\u0441\u0442 \u0441\u043B\u0430\u0433\u0430\u0435\u043C\u044B\u0445
      \u0441\u0443\u043C\u043C\u0430 \u043D\u0435 \u043F\u043E\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F"
    timeText: 15:18
    side: 0
    attachment: {fileID: 0}
    usePhotoLayout: 0
  - senderName: "\u0420\u043E\u0431"
    text: "\u043D\u0430\u0434\u0435\u044E\u0441\u044C, \u043D\u0435 \u043E\u0442\u0440\u0430\u0432\u043B\u044E\u0441\u044C"
    timeText: 
    side: 0
    attachment: {fileID: 0}
    usePhotoLayout: 0
  - senderName: "\u0420\u043E\u0431"
    text: "\u043A\u0430\u043A \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0435?"
    timeText: 15:19
    side: 0
    attachment: {fileID: 0}
    usePhotoLayout: 0
  - senderName: "\u0420\u043E\u0431"
    text: "\u0442\u044B \u043F\u043E\u0437\u0434\u043D\u043E \u0431\u0443\u0434\u0435\u0448\u044C?"
    timeText: 
    side: 0
    attachment: {fileID: 0}
    usePhotoLayout: 0
  - senderName: "\u0420\u043E\u0431"
    text: "\u0445\u043E\u0447\u0435\u0448\u044C, \u044F \u0441\u0430\u043C \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
      \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u044E \u043D\u0430 \u0443\u0436\u0438\u043D?"
    timeText: 
    side: 0
    attachment: {fileID: 0}
    usePhotoLayout: 0
  - senderName: "\u0420\u043E\u0431"
    text: "\u0438\u043B\u0438 \u043F\u0438\u0446\u0446\u0443 \u0437\u0430\u043A\u0430\u0436\u0435\u043C??"
    timeText: 
    side: 0
    attachment: {fileID: 0}
    usePhotoLayout: 0
  - senderName: "\u0420\u043E\u0431"
    text: "\u0418\u041C\u042F \u0410\u0423"
    timeText: 15:20
    side: 0
    attachment: {fileID: 0}
    usePhotoLayout: 0
