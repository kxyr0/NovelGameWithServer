    emotion: 0
    richText: "\u041C\u043E\u0436\u0435\u0442, \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439
      \u0436\u0435\u0441\u0442 \u0434\u043E\u0431\u0440\u043E\u0439 \u0432\u043E\u043B\u0438
      \u043F\u043E\u043C\u043E\u0436\u0435\u0442 \u0440\u0430\u0441\u0442\u043E\u043F\u0438\u0442\u044C
