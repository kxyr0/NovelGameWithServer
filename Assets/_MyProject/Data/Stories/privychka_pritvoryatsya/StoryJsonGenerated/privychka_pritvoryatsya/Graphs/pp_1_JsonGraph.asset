  exit: {fileID: 0}
  guid: pp_branch_confront_vlad_001_text
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  - character: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: pp_vlad
  lines:
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 0
    richText: "\u041D\u0435 \u043D\u0443\u0436\u043D\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
      \u043E\u0431\u043E \u043C\u043D\u0435 \u0432 \u0442\u0430\u043A\u043E\u043C
      \u043F\u0440\u0435\u043D\u0435\u0431\u0440\u0435\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u043C
      \u0442\u043E\u043D\u0435. \u041F\u043E \u043A\u0440\u0430\u0439\u043D\u0435\u0439
      \u043C\u0435\u0440\u0435, \u0432 \u043C\u043E\u0435\u043C \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0414\u0436\u0435\u0439\u043C\u0441, \u0435\u0451 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A,
      \u0443\u0441\u043C\u0435\u0445\u0430\u0435\u0442\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u043B\u0430\u0434 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0438\u0442
      \u043D\u0430 \u043D\u0435\u0451 \u0432\u0437\u0433\u043B\u044F\u0434 - \u0442\u044F\u0436\u0435\u043B\u044B\u0439
      \u0438 \u0445\u043C\u0443\u0440\u044B\u0439. \u041D\u0430 \u0441\u0435\u043A\u0443\u043D\u0434\u0443
      \u0418\u041C\u042F \u0436\u0430\u043B\u0435\u0435\u0442, \u0447\u0442\u043E
      \u0432\u043E\u0432\u0440\u0435\u043C\u044F \u043D\u0435 \u043F\u0440\u0438\u043A\u0443\u0441\u0438\u043B\u0430
      \u044F\u0437\u044B\u043A, \u043D\u043E \u0432\u0438\u0434\u0443 \u043D\u0435
      \u043F\u043E\u0434\u0430\u0451\u0442 - \u0432\u0441\u043A\u0438\u043D\u0443\u0432
      \u043F\u043E\u0434\u0431\u043E\u0440\u043E\u0434\u043E\u043A, \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E, \u0438 \u0432 \u044D\u0442\u043E\u043C
      \u0432\u0437\u0433\u043B\u044F\u0434\u0435 \u043B\u0435\u0433\u043A\u043E \u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432\u043E\u043F\u0440\u043E\u0441: \u0438 \u0447\u0442\u043E \u0442\u044B
      \u043C\u043D\u0435 \u0441\u0434\u0435\u043B\u0430\u0435\u0448\u044C?"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 13
    richText: "\u0415\u0441\u043B\u0438 \u0447\u0442\u043E-\u0442\u043E \u043D\u0435
      \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F - \u0432\u044B\u0445\u043E\u0434
      \u0442\u0430\u043C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u043A\u0438\u0432\u043A\u043E\u043C \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u043D\u0430 \u0434\u0432\u0435\u0440\u044C."
    style: {fileID: 0}
    authorComment: 
