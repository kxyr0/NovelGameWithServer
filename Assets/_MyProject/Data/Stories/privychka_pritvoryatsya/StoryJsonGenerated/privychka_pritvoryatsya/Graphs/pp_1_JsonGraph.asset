    richText: "\xAB\u0422\u0430\u043A \u0441\u0435\u0440\u043E \u0438 \u0443\u0433\u0440\u044E\u043C\u043E\u2026\u041A\u0430\u0436\u0435\u0442\u0441\u044F,
