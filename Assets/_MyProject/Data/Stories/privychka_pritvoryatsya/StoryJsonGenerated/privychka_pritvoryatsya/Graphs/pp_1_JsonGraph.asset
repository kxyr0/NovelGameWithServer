  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: pp_after_character_axis_001
  nodeTitle: 
  activeCharacters: []
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0422\u0440\u0435\u0432\u043E\u0433\u0430, \u0432\u043F\u0440\u043E\u0447\u0435\u043C,
      \u0438\u043C\u0435\u0435\u0442 \u043F\u043E\u0434 \u0441\u043E\u0431\u043E\u0439
      \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0435, \u043F\u043E\u0442\u043E\u043C\u0443
      \u0447\u0442\u043E \u043D\u043E\u0432\u043E\u0435 - \u044D\u0442\u043E \u0432\u0441\u0435\u0433\u0434\u0430
      \u0441\u043B\u043E\u0436\u043D\u043E. \u0422\u0435\u043C \u0431\u043E\u043B\u0435\u0435,
      \u0435\u0441\u043B\u0438 \u0440\u0435\u0447\u044C \u043E \u043A\u043E\u043B\u043B\u0435\u043A\u0442\u0438\u0432\u0430\u0445.
      \u0422\u0435\u043C \u0431\u043E\u043B\u0435\u0435, \u0441\u043E\u0441\u0442\u043E\u044F\u0449\u0438\u0445
      \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E
      \u0438\u0437 \u0441\u043A\u0435\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438
      \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u044B\u0445 \u043C\u0443\u0436\u0447\u0438\u043D."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0420\u0430\u0437\u043C\u044B\u0448\u043B\u044F\u044F \u043E \u0441\u043A\u0435\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438
      \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u044B\u0445 \u043C\u0443\u0436\u0447\u0438\u043D\u0430\u0445,
      \u0418\u041C\u042F \u043D\u0438 \u0440\u0430\u0437\u0443 \u043D\u0435 \u043F\u0440\u0435\u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442.
      \u0418 \u043D\u0435\u0442, \u043E\u043D\u0430 \u043D\u0435 \u043C\u043D\u0438\u0442
      \u0432\u0441\u0435\u0445 \u043F\u043E\u0433\u043E\u043B\u043E\u0432\u043D\u043E
      \u0441\u0435\u043A\u0441\u0438\u0441\u0442\u0430\u043C\u0438, \u043F\u0440\u043E\u0441\u0442\u043E
      \u0432\u0447\u0435\u0440\u0430 \u0435\u0451 \u043D\u043E\u0432\u044B\u0439
      \u043D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0435\u0439 \u0438\u043C\u0435\u043D\u043D\u043E \u0442\u0430\u043A\u0438\u043C."
    style: {fileID: 0}
    authorComment: 
