  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: pp_after_vlad_coffee_block_001
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  - character: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: pp_vlad
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F,
      \u043E\u0442\u043F\u0438\u0432\u0430\u0435\u0442 \u0441\u0432\u043E\u0439 \u043A\u043E\u0444\u0435,
      \u0430 \u0437\u0430\u0442\u0435\u043C \u0441\u043A\u0438\u0434\u044B\u0432\u0430\u0435\u0442
      \u0441 \u043F\u043B\u0435\u0447 \u0442\u0440\u0435\u043D\u0447, \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044F
      \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0435 \u043D\u0430 \u043F\u0440\u0435\u0434\u043C\u0435\u0442
      \u0442\u043E\u0433\u043E, \u043A\u0443\u0434\u0430 \u0435\u0433\u043E \u043C\u043E\u0436\u043D\u043E
      \u043F\u043E\u0432\u0435\u0441\u0438\u0442\u044C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0415\u0451 \u0432\u0437\u0433\u043B\u044F\u0434 \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0441\u0442\u0430\u0440\u043E\u0439 \u043A\u0440\u0443\u0436\u043A\u0435,
      \u0438\u0437 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0442\u043E\u0440\u0447\u0430\u0442
      \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0432\u0448\u0438\u0435 \u043F\u0438\u0441\u0430\u0442\u044C
      \u0440\u0443\u0447\u043A\u0438 \u0438 \u043E\u0433\u0440\u044B\u0437\u043A\u0438
      \u043F\u0440\u043E\u0441\u0442\u044B\u0445 \u043A\u0430\u0440\u0430\u043D\u0434\u0430\u0448\u0435\u0439."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0417\u0430\u0442\u0435\u043C \u0441\u043A\u043E\u043B\u044C\u0437\u0438\u0442
      \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C \u043F\u043E \u0441\u0442\u043E\u043F\u043A\u0435
      \u043E\u0442\u0447\u0435\u0442\u043E\u0432, \u0433\u0440\u043E\u0437\u044F\u0449\u0435\u0439
      \u0432\u043E\u0442-\u0432\u043E\u0442 \u0440\u0443\u0445\u043D\u0443\u0442\u044C,
      \u043F\u043E \u0446\u0432\u0435\u0442\u043A\u0443, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430 \u043D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u043F\u043E\u043B\u0438\u0432\u0430\u0435\u0442, \u043F\u043E
      \u0437\u0430\u043D\u0430\u0432\u0435\u0448\u0435\u043D\u043D\u043E\u043C\u0443
      \u0441\u0442\u0430\u0440\u043E\u0439 \u043F\u044B\u043B\u044C\u043D\u043E\u0439
      \u0448\u0442\u043E\u0440\u043E\u0439 \u043E\u043A\u043D\u0443."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0422\u0440\u0435\u043D\u0447 \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E
      \u0443\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442 \u043D\u0430 \u0441\u043F\u0438\u043D\u043A\u0443
      \u043F\u043E\u0442\u0440\u0435\u043F\u0430\u043D\u043D\u043E\u0433\u043E \u0434\u0438\u0432\u0430\u043D\u0447\u0438\u043A\u0430,
      \u0441\u0442\u043E\u044F\u0449\u0435\u0433\u043E \u0432 \u0434\u0440\u0443\u0433\u043E\u043C
      \u043A\u043E\u043D\u0446\u0435 \u043A\u043E\u043C\u043D\u0430\u0442\u044B."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 2
    richText: "\u0421\u0438\u043C\u043F\u0430\u0442\u0438\u0447\u043D\u044B\u0439
      \u0443 \u0432\u0430\u0441 \u043A\u0430\u0431\u0438\u043D\u0435\u0442."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u044B\u0434\u0430\u0451\u0442 \u043E\u043D\u0430 \u043A\u0430\u043A
      \u0432\u0435\u0440\u0434\u0438\u043A\u0442."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 17
    richText: "\u0420\u0430\u0431\u043E\u0447\u0438\u0439."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0413\u043E\u0432\u043E\u0440\u0438\u0442 \u0441\u0443\u0445\u043E
      \u0438 \u043A\u043E\u0440\u043E\u0442\u043A\u043E."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 9
    richText: "\u0414\u0435\u043F\u0440\u0435\u0441\u0441\u0438\u0432\u043D\u044B\u0439."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412 \u0435\u0451 \u0433\u043E\u043B\u043E\u0441\u0435 \u043D\u0435\u0442
      \u043D\u0430\u0441\u043C\u0435\u0448\u043A\u0438 - \u0435\u0441\u0442\u044C
      \u0438\u043D\u0442\u0435\u0440\u0435\u0441, \u0435\u0441\u0442\u044C \u043E\u0449\u0443\u0442\u0438\u043C\u043E\u0435
      \u0436\u0435\u043B\u0430\u043D\u0438\u0435 \u0440\u0430\u0437\u0432\u0438\u0442\u044C
      \u0434\u0438\u0430\u043B\u043E\u0433. \u0412\u043B\u0430\u0434 \u0445\u043C\u0443\u0440\u0438\u0442
      \u0431\u0440\u043E\u0432\u0438 - \u043C\u0435\u0436\u0434\u0443 \u043D\u0438\u043C\u0438
      \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0441\u043A\u043B\u0430\u0434\u043A\u0430."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 2
    richText: "\xAB\u0412\u0438\u0434\u0438\u043C\u043E, \u044D\u0442\u043E \u0435\u0433\u043E
      \u043B\u044E\u0431\u0438\u043C\u043E\u0435 \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u0438\u0435
      \u043B\u0438\u0446\u0430\u2026 \u0420\u0430\u0437 \u0442\u0430\u043A, \u043D\u0430\u0434\u043E
      \u043F\u043E\u0441\u043E\u0432\u0435\u0442\u043E\u0432\u0430\u0442\u044C \u0435\u043C\u0443
      \u043A\u043E\u043B\u043E\u0442\u044C \u0431\u043E\u0442\u043E\u043A\u0441.
      \u0425\u043E\u0442\u044F-\u044F-\u044F\u2026 \u0435\u043C\u0443 \u044F\u0432\u043D\u043E
      \u0437\u0430 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C, \u0442\u0430\u043A
      \u0447\u0442\u043E \u0443\u0436\u0435 \u043F\u043E\u0437\u0434\u043D\u043E\u0432\u0430\u0442\u043E
      \u0431\u0443\u0434\u0435\u0442\u2026\xBB"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 17
    richText: "\u0422\u044B \u0432\u0441\u0451 \u0435\u0449\u0451 \u043C\u043E\u0436\u0435\u0448\u044C
      \u0443\u0439\u0442\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 0
    richText: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0415\u0451 \u0433\u043E\u043B\u043E\u0441 \u0442\u0435\u043F\u0435\u0440\u044C
      \u0437\u0432\u0443\u0447\u0438\u0442 \u0440\u043E\u0432\u043D\u043E \u0438
      \u0445\u043E\u043B\u043E\u0434\u043D\u043E - \u0440\u0430\u0432\u043D\u043E
      \u0432 \u0442\u043E\u043D \u0435\u043C\u0443."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 2
    richText: "\u041F\u0440\u0438\u0431\u0435\u0440\u0435\u0433\u0443 \u044D\u0442\u0443
      \u0438\u0434\u0435\u044E \u043D\u0430 \u0447\u0435\u0440\u043D\u044B\u0439
      \u0434\u0435\u043D\u044C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u0438\u043B\u044F\u0441\u044C \u0441\u043A\u0440\u044B\u0442\u044C
      \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0435 \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0435\u043D\u0438\u0435,
      \u043E\u043D\u0430 \u043D\u0430\u0442\u044F\u043D\u0443\u0442\u043E \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F
      - \u0447\u0438\u0441\u0442\u0430\u044F \u0444\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C,
      \u0436\u0435\u043B\u0430\u043D\u0438\u0435 \u043F\u043E\u0434\u0447\u0435\u0440\u043A\u043D\u0443\u0442\u044C,
      \u0447\u0442\u043E \u0435\u0433\u043E \u0441\u043B\u043E\u0432\u0430 \u043D\u0438\u043A\u0430\u043A
      \u0435\u0451 \u043D\u0435 \u0437\u0430\u0434\u0435\u043B\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 17
    richText: "\u0422\u043E\u0433\u0434\u0430 \u0437\u0430 \u0440\u0430\u0431\u043E\u0442\u0443."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u043A\u0438\u0432\u0430\u0435\u0442 \u0438 \u0443\u0441\u0430\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0437\u0430 \u0441\u0442\u043E\u043B, \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E
      \u0432\u0441\u0451 \u0442\u0430\u043A \u0438 \u0434\u043E\u043B\u0436\u043D\u043E
      \u0431\u044B\u0442\u044C, \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E
      \u0431\u044B \u043E\u043D\u0430 \u0432\u0441\u0435\u0433\u0434\u0430 \u0437\u0434\u0435\u0441\u044C
      \u0438 \u0431\u044B\u043B\u0430."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 17
    richText: "\u0417\u0430 \u0440\u0430\u0431\u043E\u0442\u0443."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u043E\u0436\u0438\u0434\u0430\u043B\u0430, \u0447\u0442\u043E
      \u0432 \u043F\u0435\u0440\u0432\u044B\u0439 \u0434\u0435\u043D\u044C \u0435\u0451
      \u0437\u0430\u0441\u0442\u0430\u0432\u044F\u0442 \u043A\u043E\u043F\u0430\u0442\u044C\u0441\u044F
      \u0432 \u0431\u0443\u043C\u0430\u0436\u043A\u0430\u0445. \u0418 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E,
      \u043F\u0435\u0440\u0435\u0434 \u043D\u0435\u0439 \u043B\u0435\u0436\u0438\u0442
      \u0446\u0435\u043B\u0430\u044F \u043F\u0430\u043F\u043A\u0430 \u0434\u0435\u043B,
      \u0432\u044B\u0434\u0430\u043D\u043D\u044B\u0445 \xAB\u0447\u0442\u043E\u0431\u044B
      \u043D\u0430\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u043E\u043F\u044B\u0442\u0430\xBB,
      \u0430 \u0435\u0441\u043B\u0438 \u0442\u043E\u0447\u043D\u0435\u0435, \u0442\u043E
      \u0447\u0442\u043E\u0431\u044B \u043D\u0435 \u043F\u0443\u0442\u0430\u043B\u0430\u0441\u044C
      \u043F\u043E\u0434 \u043D\u043E\u0433\u0430\u043C\u0438, \u043F\u043E\u0442\u043E\u043C\u0443
      \u0447\u0442\u043E \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0439
      \u0435\u0439 \u043F\u0440\u0438 \u044D\u0442\u043E\u043C \u043D\u0435 \u043E\u0437\u0432\u0443\u0447\u0438\u043B\u0438.
      \u0412\u043F\u0440\u043E\u0447\u0435\u043C, \u0433\u043B\u0443\u043F\u043E
      \u0431\u044B\u043B\u043E \u0431\u044B \u043E\u0436\u0438\u0434\u0430\u0442\u044C
      \u0447\u0435\u0433\u043E-\u0442\u043E \u0434\u0440\u0443\u0433\u043E\u0433\u043E
      \u043E\u0442 \u0435\u0451 \u0447\u0451\u0440\u0442\u043E\u0432\u0430 \xAB\u043D\u0430\u0441\u0442\u0430\u0432\u043D\u0438\u043A\u0430\xBB."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u043D\u0435 \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F
      \u0441\u043F\u043E\u0440\u0438\u0442\u044C. \u0412\u043C\u0435\u0441\u0442\u043E
      \u044D\u0442\u043E\u0433\u043E \u043F\u043E\u0441\u043B\u0443\u0448\u043D\u043E
      \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043F\u0430\u043F\u043A\u0443
      \u0438 \u0431\u0435\u0440\u0451\u0442\u0441\u044F \u0437\u0430 \u0434\u0435\u0442\u0430\u043B\u044C\u043D\u043E\u0435
      \u0438\u0437\u0443\u0447\u0435\u043D\u0438\u0435 \u0434\u0435\u043B."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u0435 \u0441\u043F\u0435\u0448\u0438\u0442, \u043B\u0438\u0448\u044C
      \u0431\u044B \u043F\u0440\u043E\u043B\u0438\u0441\u0442\u0430\u0442\u044C -
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0432\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0414\u043E\u0441\u0442\u0430\u0435\u0442 \u0438\u0437 \u0441\u0443\u043C\u043E\u0447\u043A\u0438
      \u0437\u0430\u043F\u0438\u0441\u043D\u0443\u044E \u043A\u043D\u0438\u0436\u043A\u0443
      \u0438 \u0442\u044F\u043D\u0435\u0442\u0441\u044F \u0437\u0430 \u0440\u0443\u0447\u043A\u043E\u0439."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412 \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0435 \u0442\u0438\u0445\u043E
      - \u043D\u0435 \u0432 \u043F\u0440\u0438\u043C\u0435\u0440 \u0442\u043E\u043C\u0443,
      \u0447\u0442\u043E \u0418\u041C\u042F \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u043B\u0430
      \u0447\u0430\u0441\u043E\u043C \u0440\u0430\u043D\u0435\u0435 \u0432 \u0434\u0440\u0443\u0433\u043E\u0439
      \u0447\u0430\u0441\u0442\u0438 \u043E\u0442\u0434\u0435\u043B\u0430."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041A\u0442\u043E-\u0442\u043E \u0441\u0435\u0442\u043E\u0432\u0430\u043B
      \u043D\u0430 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E \u043F\u0440\u043E\u043B\u0438\u0442\u044B\u0439
      \u043A\u043E\u0444\u0435, \u043A\u0442\u043E-\u0442\u043E \u0447\u0442\u043E-\u0442\u043E
      \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u043B \u0434\u0440\u0443\u0433\u0438\u043C
      \u0432 \u0441\u0432\u043E\u0435\u043C \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0435
      \u0438 \u0433\u0440\u043E\u043C\u043A\u043E \u0441\u043C\u0435\u044F\u043B\u0441\u044F,
      \u043F\u043E\u043F\u0443\u0442\u043D\u043E \u0443\u043C\u0443\u0434\u0440\u044F\u044F\u0441\u044C
      \u043A\u043E\u043C\u043C\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0417\u0434\u0435\u0441\u044C \u0436\u0435 \u0441\u043B\u044B\u0448\u0435\u043D
      \u0442\u043E\u043B\u044C\u043A\u043E \u0448\u0435\u043B\u0435\u0441\u0442 \u0431\u0443\u043C\u0430\u0433,
      \u0442\u0438\u043A\u0430\u043D\u044C\u0435 \u0447\u0430\u0441\u043E\u0432 \u0438
      \u043F\u0440\u0438\u0433\u043B\u0443\u0448\u0435\u043D\u043D\u044B\u0439 \u0443\u043B\u0438\u0447\u043D\u044B\u0439
      \u0448\u0443\u043C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412 \u0432\u043E\u0437\u0434\u0443\u0445\u0435 \u0441\u0432\u0438\u043D\u0446\u043E\u0432\u043E\u0439
      \u0442\u0443\u0447\u0435\u0439 \u0432\u0438\u0441\u0438\u0442 \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u0435,
      - \u043F\u043E\u0447\u0442\u0438 \u043E\u0441\u044F\u0437\u0430\u0435\u043C\u043E\u0435."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u041C\u042F \u043D\u0435\u0443\u044E\u0442\u043D\u043E, \u043D\u043E
      \u043E\u043D\u0430 \u0441\u0442\u0430\u0440\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u044D\u0442\u043E \u0438
      \u043F\u043E\u0433\u0440\u0443\u0436\u0430\u0435\u0442\u0441\u044F \u0432 \u0438\u0437\u0443\u0447\u0435\u043D\u0438\u0435
      \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u043E\u0432."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 30
    richText: "\xAB\u0427\u0443\u0432\u0441\u0442\u0432\u0443\u044E \u0441\u0435\u0431\u044F
      \u043A\u0430\u043A \u0432 \u043F\u0435\u0441\u043E\u0447\u043D\u0438\u0446\u0435\u2026\xBB"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u042D\u0442\u043E \u0437\u043B\u0438\u0442 \u0438 \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E
      \u0437\u0432\u0443\u0447\u0438\u0442 \u043A\u0430\u043A \u0432\u044B\u0437\u043E\u0432.
      \u0418\u041C\u042F \u043E\u0445\u043E\u0442\u043D\u043E \u0435\u0433\u043E
      \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442, \u043F\u043E\u0442\u043E\u043C\u0443
      \u0447\u0442\u043E \u0432\u044B\u0431\u043E\u0440\u0430 \u0443 \u043D\u0435\u0451
      \u043D\u0435 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F. \u041C\u043E\u043D\u043E\u0442\u043E\u043D\u043D\u0430\u044F
      \u0431\u0443\u043C\u0430\u0436\u043D\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430
      - \u0434\u0430\u043B\u0435\u043A\u043E \u043D\u0435 \u043F\u0440\u0435\u0434\u0435\u043B
      \u0435\u0451 \u043C\u0435\u0447\u0442\u0430\u043D\u0438\u0439, \u043D\u043E
      \u0441 \u0447\u0435\u0433\u043E-\u0442\u043E \u0436\u0435 \u043D\u0430\u0434\u043E
      \u043D\u0430\u0447\u0438\u043D\u0430\u0442\u044C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 0
    richText: "\u0422\u0435\u0431\u0435 \u043D\u0435 \u0441\u043A\u0443\u0447\u043D\u043E?"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u041C\u042F \u0432\u0437\u0434\u0440\u0430\u0433\u0438\u0432\u0430\u0435\u0442
      \u043E\u0442 \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E\u0441\u0442\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0413\u043E\u043B\u043E\u0441 \u0443 \u0412\u043B\u0430\u0434\u0430
      \u043D\u0438\u0437\u043A\u0438\u0439 \u0438 \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E
      \u043F\u0440\u0438\u044F\u0442\u043D\u044B\u0439, \u043D\u043E \u0440\u0435\u0447\u044C
      \u0437\u0432\u0443\u0447\u0438\u0442 \u0440\u0435\u0437\u043A\u043E, \u043E\u0442\u0440\u044B\u0432\u0438\u0441\u0442\u043E
      \u0438 \u0431\u0435\u0437 \u043A\u0430\u043F\u043B\u0438 \u0442\u0435\u043F\u043B\u0430."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0442 \u043D\u0435\u0433\u043E \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E
      \u0438\u0441\u0445\u043E\u0434\u0438\u0442 \u043F\u0440\u0435\u043D\u0435\u0431\u0440\u0435\u0436\u0435\u043D\u0438\u0435:
      \u0435\u0449\u0451 \u0432 \u043F\u0435\u0440\u0432\u0443\u044E \u0438\u0445
      \u0432\u0441\u0442\u0440\u0435\u0447\u0443 \u043E\u043D \u0437\u0430\u044F\u0432\u0438\u043B,
      \u0447\u0442\u043E \u043E\u043D\u0430 \u043D\u0435 \u043F\u0440\u043E\u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
      \u0437\u0434\u0435\u0441\u044C \u0434\u043E\u043B\u044C\u0448\u0435 \u043D\u0435\u0434\u0435\u043B\u0438,
      - \u0438 \u043F\u043E\u0432\u043E\u0434\u0430 \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C
      \u0441\u0432\u043E\u0435 \u043C\u043D\u0435\u043D\u0438\u0435 \u0443 \u043D\u0435\u0433\u043E
      \u043F\u043E\u043A\u0430 \u0435\u0449\u0435 \u043D\u0435 \u0431\u044B\u043B\u043E."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u041C\u042F \u043E\u0442\u0440\u044B\u0432\u0430\u0435\u0442
      \u0432\u0437\u0433\u043B\u044F\u0434 \u043E\u0442 \u0431\u0443\u043C\u0430\u0433
      \u0438 \u043A\u043E\u0440\u043E\u0442\u043A\u043E \u043F\u043E\u0436\u0438\u043C\u0430\u0435\u0442
      \u043F\u043B\u0435\u0447\u0430\u043C\u0438:"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 13
    richText: "\u0411\u044B\u043B\u043E \u0431\u044B \u0441\u043A\u0443\u0447\u043D\u043E,
      \u0435\u0441\u043B\u0438 \u0431\u044B \u044F \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u043B\u0430,
      \u0437\u0430\u0447\u0435\u043C \u0432\u0441\u0451 \u044D\u0442\u043E."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 26
    richText: "\u0418 \u0437\u0430\u0447\u0435\u043C?"
    style: {fileID: 0}
    authorComment: 
