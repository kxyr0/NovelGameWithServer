  guid: pp_dialogue_after_rob_pizza_001
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: pp_vlad
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u041C\u042F \u0446\u043E\u043A\u0430\u0435\u0442, \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u044F
      \u0432 \u043E\u0442\u0432\u0435\u0442 \u0437\u043B\u043E\u0439 \u0441\u043C\u0430\u0439\u043B\u0438\u043A."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 0
    richText: "\u041D\u0443, \u0432\u0438\u0434\u0438\u043C\u043E \u0442\u0435\u0440\u043F\u0438\u0448\u044C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0411\u0435\u0441\u0446\u0432\u0435\u0442\u043D\u043E \u0431\u0440\u043E\u0441\u0430\u0435\u0442
      \u0412\u043B\u0430\u0434. \u0413\u043E\u043B\u043E\u0441 \u0437\u0432\u0443\u0447\u0438\u0442
      \u0440\u043E\u0432\u043D\u043E, \u043E\u0442\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u043D\u043E,
      \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E \u043E\u043D, \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0435\u043D\u043D\u044B\u0439
      \u0435\u0451 \u043D\u0435\u0443\u043C\u0435\u0441\u0442\u043D\u044B\u043C \u0432\u0435\u0441\u0435\u043B\u044C\u0435\u043C,
      \u0440\u0435\u0448\u0438\u043B \u0432\u0434\u0440\u0443\u0433 \u043D\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u044C
      \u043E \u0441\u0443\u0431\u043E\u0440\u0434\u0438\u043D\u0430\u0446\u0438\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u041C\u042F \u0445\u043C\u0443\u0440\u0438\u0442\u0441\u044F,
      \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044F, \u0447\u0442\u043E \u0435\u0433\u043E
      \u0441\u043B\u043E\u0432\u0430 \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0438
      \u043A\u0430\u043A \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u0442\u0435\u043B\u044C
      - \u043E\u0442 \u0445\u043E\u0440\u043E\u0448\u0435\u0433\u043E \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044F
      \u043A \u043F\u043B\u043E\u0445\u043E\u043C\u0443. \u0412\u043E\u0442 \u0436\u0435
      \u0443\u043F\u044B\u0440\u044C."
    style: {fileID: 0}
    authorComment: 
