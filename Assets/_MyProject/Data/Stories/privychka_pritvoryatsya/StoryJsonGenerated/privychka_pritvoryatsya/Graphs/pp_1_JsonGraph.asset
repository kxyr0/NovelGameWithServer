  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: pp_after_corridor_self_esteem_001
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041A\u0430\u0431\u043B\u0443\u043A\u0438 \u0437\u0432\u0443\u0447\u043D\u043E
      \u0446\u043E\u043A\u0430\u044E\u0442 \u043E \u043F\u043B\u0438\u0442\u043E\u0447\u043D\u044B\u0439
      \u043F\u043E\u043B, \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430\u044F
      \u043A \u043D\u0435\u0439 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435.
      \u041E\u043D\u0430 \u0434\u0440\u0443\u0436\u0435\u043B\u044E\u0431\u043D\u043E
      \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F \u0438 \u0437\u0434\u043E\u0440\u043E\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441 \u043A\u0430\u0436\u0434\u044B\u043C, \u043A\u0442\u043E \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u043F\u0443\u0442\u0438. \u041E\u0442\u0432\u0435\u0442\u043D\u0443\u044E
      \u0443\u043B\u044B\u0431\u043A\u0443 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442
      \u043D\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 - \u043D\u0443 \u0438 \u043F\u0443\u0441\u0442\u044C
      \u0442\u0430\u043A: \u0443\u0442\u0440\u043E \u0431\u0443\u0434\u043D\u0435\u0433\u043E
      \u0434\u043D\u044F \u043D\u0435 \u0432\u0441\u0435\u0445 \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u0435\u0442
      \u043A \u0445\u043E\u0440\u043E\u0448\u0435\u043C\u0443 \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044E."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u041C\u042F \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0443 \u043D\u0443\u0436\u043D\u043E\u0439 \u0434\u0432\u0435\u0440\u0438
      \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u043D\u0435\u0451
      \u0441 \u0441\u043E\u043C\u043D\u0435\u043D\u0438\u0435\u043C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 9
    richText: "\xAB\u0415\u0449\u0451 \u0435\u0441\u0442\u044C \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C
      \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u044C \u043D\u0430\u0437\u0430\u0434\u2026\xBB"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0422\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0434\u0443\u043C\u0430\u0432
      \u043E\u0431 \u044D\u0442\u043E\u043C, \u043E\u043D\u0430 \u043C\u044B\u0441\u043B\u0435\u043D\u043D\u043E
      \u0434\u0430\u0435\u0442 \u0441\u0435\u0431\u0435 \u043E\u043F\u043B\u0435\u0443\u0445\u0443
      \u0438, \u043F\u043E\u0441\u0442\u0443\u0447\u0430\u0432\u0448\u0438\u0441\u044C
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0440\u0430\u0437,
      \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E \u0442\u043E\u043B\u043A\u0430\u0435\u0442
      \u0434\u0432\u0435\u0440\u044C, \u043E\u0442\u0440\u0435\u0437\u0430\u044F
      \u0441\u0435\u0431\u0435 \u0432\u0441\u0435 \u043F\u0443\u0442\u0438 \u043A
      \u043E\u0442\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u044E. \u0414\u0432\u0435\u0440\u044C
      \u0433\u043B\u0443\u0445\u043E \u0441\u043A\u0440\u0438\u043F\u0438\u0442,
      \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u044F \u0435\u0439 \u0432\u0438\u0434
      \u043D\u0430 \u043A\u0430\u0431\u0438\u043D\u0435\u0442."
    style: {fileID: 0}
    authorComment: 
