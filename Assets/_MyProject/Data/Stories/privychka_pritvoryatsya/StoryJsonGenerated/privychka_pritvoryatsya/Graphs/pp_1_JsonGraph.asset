  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: pp_dialogue_archive_work_001
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  - character: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: pp_vlad
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u043F\u0440\u043E\u0447\u0435\u043C, \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0435
      \u0441\u043F\u0443\u0441\u0442\u044F, \u043D\u0430 \u0435\u0433\u043E \u043B\u0438\u0446\u0435
      \u043D\u0435 \u043E\u0441\u0442\u0430\u0435\u0442\u0441\u044F \u0438 \u0442\u0435\u043D\u0438
      \u0432\u0435\u0441\u0435\u043B\u044C\u044F - \u043E\u043D \u0443\u0436\u0435
      \u043F\u043E\u0433\u0440\u0443\u0436\u0435\u043D \u0432 \u0441\u0432\u043E\u044E
      \u0440\u0430\u0431\u043E\u0442\u0443, \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E
      \u0438 \u043D\u0435 \u043E\u0442\u0432\u043B\u0435\u043A\u0430\u043B\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0415\u0439 \u043D\u0435 \u043C\u0435\u0448\u0430\u0435\u0442. \u041D\u043E
      \u0438 \u043D\u0435 \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442. \u041D\u0438
      \u0441\u043E\u0432\u0435\u0442\u043E\u043C, \u043D\u0438 \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 9
    richText: "\xAB\u0414\u0430\u0436\u0435 \u043D\u0435 \u0437\u043D\u0430\u044E,
      \u0447\u0442\u043E \u0431\u0435\u0441\u0438\u0442 \u043C\u0435\u043D\u044F
      \u0441\u0438\u043B\u044C\u043D\u0435\u0435 - \u0435\u0433\u043E \u0431\u0435\u0437\u0440\u0430\u0437\u043B\u0438\u0447\u0438\u0435
      \u0438\u043B\u0438 \u043C\u043E\u044F \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F
      \u0436\u0430\u0436\u0434\u0430 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
      \u0435\u0433\u043E \u043E\u0434\u043E\u0431\u0440\u0435\u043D\u0438\u0435.
      \u041D\u043E, \u0432\u043F\u0440\u043E\u0447\u0435\u043C, \u043F\u043B\u0435\u0432\u0430\u0442\u044C.
      \u041D\u0438 \u0442\u043E, \u043D\u0438 \u0434\u0440\u0443\u0433\u043E\u0435
      \u0432\u043E\u043E\u0431\u0449\u0435 \u043D\u0435 \u0434\u043E\u043B\u0436\u043D\u043E
      \u043C\u0435\u043D\u044F \u0432\u043E\u043B\u043D\u043E\u0432\u0430\u0442\u044C\xBB"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u043E\u043E\u0434\u0443\u0448\u0435\u0432\u043B\u0435\u043D\u043D\u0430\u044F
      \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C\u044E \u043D\u0430\u0439\u0442\u0438
      \u0445\u043E\u0442\u044C \u043A\u0430\u043A\u0443\u044E-\u0442\u043E \u0437\u0430\u0446\u0435\u043F\u043A\u0443,
      \u0418\u041C\u042F \u0442\u0430\u0449\u0438\u0442 \u0438\u0437 \u043F\u044B\u043B\u044C\u043D\u043E\u0433\u043E
      \u0430\u0440\u0445\u0438\u0432\u0430 \u0441\u0442\u043E\u043F\u043A\u0443 \u0434\u0435\u043B."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u043E\u0442\u0440\u0430\u0442\u0438\u0442\u044C \u0447\u0430\u0441
      \u043D\u0430 \u0441\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u043A\u0443 -
      \u043D\u0435 \u0441\u0430\u043C\u0430\u044F \u0431\u043E\u043B\u044C\u0448\u0430\u044F
      \u043F\u043B\u0430\u0442\u0430. \u0412 \u043F\u0430\u043F\u043A\u0435 \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u0434\u0430\u0436\u0435 \u0441\u043B\u0443\u0447\u0430\u0438 \u0441\u0430\u043C\u043E\u0443\u0431\u0438\u0439\u0441\u0442\u0432\u0430
      \u043C\u0443\u0436\u0447\u0438\u043D - \u0438\u0445 \u043C\u0435\u043D\u044C\u0448\u0435,
      \u043D\u043E \u043E\u043D\u0430 \u0443\u0432\u0435\u0440\u0435\u043D\u0430:
      \u0438\u0437\u0443\u0447\u0438\u0442\u044C \u043D\u0443\u0436\u043D\u043E \u0432\u0441\u0451."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0422\u043E, \u0447\u0442\u043E \u0412\u043B\u0430\u0434 \u043D\u0435
      \u043E\u0442\u043C\u0430\u0445\u043D\u0443\u043B\u0441\u044F \u043E\u0442 \u043D\u0435\u0435
      \u0438 \u043D\u0435 \u043F\u043E\u0434\u043D\u044F\u043B \u043D\u0430 \u0441\u043C\u0435\u0445,
      \u0432\u044B\u0437\u044B\u0432\u0430\u0435\u0442 \u0442\u0435\u043F\u043B\u043E\u0435
      \u0447\u0443\u0432\u0441\u0442\u0432\u043E \u0432 \u0433\u0440\u0443\u0434\u0438
      - \u0433\u043E\u0440\u0434\u043E\u0441\u0442\u044C \u0437\u0430 \u0441\u0430\u043C\u0443
      \u0441\u0435\u0431\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 9
    richText: "\xAB\u041D\u043E \u043D\u0435\u043B\u044C\u0437\u044F \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0440\u0430\u0434\u043E\u0432\u0430\u0442\u044C\u0441\u044F. \u041C\u043E\u0436\u0435\u0442,
      \u0434\u043B\u044F \u043D\u0435\u0433\u043E \u044D\u0442\u043E - \u0435\u0449\u0451
      \u043E\u0434\u0438\u043D \u0441\u043F\u043E\u0441\u043E\u0431 \u043E\u0442\u0432\u0430\u0434\u0438\u0442\u044C
      \u043C\u0435\u043D\u044F \u043E\u0442 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0441\u0442\u043E\u044F\u0449\u0438\u0445 \u0434\u0435\u043B?\xBB"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0414\u0443\u043C\u0430\u0442\u044C \u043E\u0431 \u044D\u0442\u043E\u043C
      \u0434\u043E\u043B\u0433\u043E \u043D\u0435 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F.
      \u041F\u0435\u0440\u0435\u0434 \u043D\u0435\u0439 \u0446\u0435\u043B\u0430\u044F
      \u0441\u0442\u043E\u043F\u043A\u0430 \u0430\u0440\u0445\u0438\u0432\u043D\u044B\u0445
      \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u043E\u0432 \u0438 \u043A\u0430\u0436\u0434\u044B\u0439
      \u0438\u0437 \u043D\u0438\u0445 \u0442\u0440\u0435\u0431\u0443\u0435\u0442
      \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
      \u0438\u0437\u0443\u0447\u0435\u043D\u0438\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0422\u0430\u043A \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
      \u0435\u0449\u0451 \u0434\u0432\u0430 \u0447\u0430\u0441\u0430, \u0438 \u044D\u0442\u043E
      \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0442\u044F\u0436\u0435\u043B\u043E."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0417\u0430 \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F \u0435\u0439
      \u0443\u0434\u0430\u0451\u0442\u0441\u044F \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C
      \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u0440\u0435\u0442\u044C \u0434\u0435\u043B."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0413\u043E\u043B\u043E\u0432\u0430 \u0433\u0443\u0434\u0438\u0442
      \u043E\u0442 \u043E\u0431\u0438\u043B\u0438\u044F \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438,
      \u0438 \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u0431\u0438\u0442\u044C\u0441\u044F
      \u043E \u0441\u0442\u0435\u043D\u043A\u0443: \u0437\u0430\u0446\u0435\u043F\u043E\u043A
      \u0432\u0441\u0435 \u0435\u0449\u0451 \u043D\u0435\u0442."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u043D\u0435 \u0437\u043D\u0430\u0435\u0442, \u043A\u0443\u0434\u0430
      \u0432\u0441\u0451 \u044D\u0442\u043E \u043F\u0440\u0438\u0432\u0435\u0434\u0451\u0442.
      \u041D\u043E \u0438\u043D\u0442\u0443\u0438\u0446\u0438\u044F \u0443\u0436\u0435
      \u0442\u043E\u043B\u043A\u043D\u0443\u043B\u0430 \u0435\u0451 \u0441\u044E\u0434\u0430-
      \u043F\u043E\u0437\u0434\u043D\u043E \u043A\u0440\u0438\u0447\u0430\u0442\u044C
      \xAB\u0441\u0442\u043E\u043F, \u043A\u0440\u0430\u0441\u043D\u044B\u0439!\xBB"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u041C\u042F \u043E\u0442\u043A\u0438\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0441\u043F\u0438\u043D\u043A\u0443 \u0441\u0442\u0443\u043B\u0430,
      \u0434\u0430\u0432\u0430\u044F \u0441\u0435\u0431\u0435 \u043F\u0430\u0440\u0443
      \u0441\u0435\u043A\u0443\u043D\u0434 \u043F\u0435\u0440\u0435\u0434\u044B\u0448\u043A\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0411\u0443\u043A\u0432\u044B \u043F\u0435\u0440\u0435\u0434 \u0433\u043B\u0430\u0437\u0430\u043C\u0438
      \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442 \u0440\u0430\u0441\u043F\u043B\u044B\u0432\u0430\u0442\u044C\u0441\u044F,
      \u0430 \u0432 \u0433\u043E\u043B\u043E\u0432\u0435 \u0437\u0432\u0443\u0447\u0438\u0442
      \u0442\u0438\u0445\u0438\u0439 \u0433\u0443\u043B: \u043E\u0431\u0440\u044B\u0432\u043A\u0438
      \u0434\u043D\u0435\u0432\u043D\u0438\u043A\u043E\u0432\u044B\u0445 \u0437\u0430\u043F\u0438\u0441\u0435\u0439,
      \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0441\u043A\u0438\u0445 \u0437\u0430\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0439,
      \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B\u043E\u0432\u2026 \u0412\u043D\u0435\u0437\u0430\u043F\u043D\u043E
      \u043E\u043D\u0430 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u0432\u0430\u0435\u0442,
      \u0447\u0442\u043E \u043D\u0430\u0432\u044F\u0437\u0447\u0438\u0432\u043E\u0435
      \u0436\u0443\u0436\u0436\u0430\u043D\u0438\u0435 \u0440\u0430\u0437\u0434\u0430\u0435\u0442\u0441\u044F
      \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0432 \u0435\u0451 \u0433\u043E\u043B\u043E\u0432\u0435.
      \u0418\u0437 \u0441\u0443\u043C\u043A\u0438, \u0441\u0442\u043E\u044F\u0449\u0435\u0439
      \u043F\u043E\u0434 \u0441\u0442\u043E\u043B\u043E\u043C \u0434\u043E\u043D\u043E\u0441\u044F\u0442\u0441\u044F
      \u043E\u0442\u0440\u044B\u0432\u0438\u0441\u0442\u044B\u0435 \u0437\u0432\u0443\u043A\u0438
      \u0432\u0438\u0431\u0440\u0430\u0446\u0438\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 0
    richText: "\u0422\u044B, \u0432\u0438\u0434\u0438\u043C\u043E, \u0432\u0430\u0436\u043D\u0430\u044F
      \u043F\u0435\u0440\u0441\u043E\u043D\u0430."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0415\u0433\u043E \u0433\u043E\u043B\u043E\u0441 \u0437\u0432\u0443\u0447\u0438\u0442
      \u0445\u043E\u043B\u043E\u0434\u043D\u043E."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0415\u0433\u043E, \u043F\u0440\u0438\u0432\u044B\u043A\u0448\u0435\u0433\u043E
      \u043A \u043E\u0434\u0438\u043D\u043E\u0447\u0435\u0441\u0442\u0432\u0443 \u0438
      \u0442\u0438\u0448\u0438\u043D\u0435, \u043D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430
      \u0441\u0442\u0440\u0430\u0448\u043D\u043E \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0430\u044E\u0442
      \u0437\u0432\u0443\u043A\u0438 \u0443\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u0438\u0439.
      \u0418\u041C\u042F \u044D\u0442\u043E \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442
      - \u0441\u0430\u043C\u0430 \u043D\u0435 \u0432\u044B\u043D\u043E\u0441\u0438\u0442
      \u043B\u0438\u0448\u043D\u0435\u0433\u043E, \u043A\u043E\u0433\u0434\u0430
      \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u043F\u043E\u0433\u0440\u0443\u0436\u0430\u0435\u0442\u0441\u044F
      \u0432 \u0440\u0430\u0431\u043E\u0442\u0443."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u042D\u043A\u0440\u0430\u043D \u043C\u0435\u0440\u0446\u0430\u0435\u0442,
      \u043A\u0430\u043A \u0433\u0438\u0440\u043B\u044F\u043D\u0434\u0430 - \u043E\u0434\u043D\u043E
      \u0443\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u0438\u0435 \u0437\u0430
      \u0434\u0440\u0443\u0433\u0438\u043C. \u0418\u041C\u042F \u0432\u044B\u0434\u044B\u0445\u0430\u0435\u0442
      \u0447\u0435\u0440\u0435\u0437 \u043D\u043E\u0441 \u0438 \u0442\u0443\u0442
      \u0436\u0435 \u0432\u044B\u043A\u043B\u044E\u0447\u0430\u0435\u0442 \u0437\u0432\u0443\u043A.
      \u041F\u0440\u043E\u043B\u0438\u0441\u0442\u044B\u0432\u0430\u0435\u0442 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u044F
      - \u0432 \u043C\u0435\u0441\u0441\u0435\u043D\u0434\u0436\u0435\u0440\u0435,
      \u043A\u0430\u043A \u0432\u0441\u0435\u0433\u0434\u0430 \u0445\u0430\u043E\u0441,
