  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: pp2_dialogue_phone_after_extended_001
  nodeTitle: 
  activeCharacters: []
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0417\u0432\u043E\u043D\u043E\u043A \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0430
      - \u0441\u0435\u0439\u0447\u0430\u0441 \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E
      \u043D\u0435 \u043A \u043C\u0435\u0441\u0442\u0443. \u041D\u043E \u043E\u043D
      \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C \u043E\u0431\u0440\u0430\u0437\u043E\u043C
      \u0440\u0430\u0437\u0440\u044F\u0436\u0430\u0435\u0442 \u043D\u0430\u043A\u0430\u043B\u0438\u0432\u0448\u0443\u044E\u0441\u044F
      \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0443. \u041E\u0442\u0442\u0430\u0441\u043A\u0438\u0432\u0430\u0435\u0442
      \u043E\u0442 \u0441\u0430\u043C\u043E\u0433\u043E \u043A\u0440\u0430\u044F,
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044F \u0432 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u0443\u044E
      \u0437\u043E\u043D\u0443. \u041F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
      \u0432\u044B\u0434\u043E\u0445\u043D\u0443\u0442\u044C \u0438 \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C
      \u0441\u043A\u043E\u0432\u0430\u0432\u0448\u0435\u0435 \u043E\u0431\u043E\u0438\u0445
      \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u0435."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u043B\u0430\u0434 \u043E\u0442\u043F\u0443\u0441\u043A\u0430\u0435\u0442
      \u0435\u0451 - \u0440\u0435\u0437\u043A\u043E, \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E
      \u043E\u0431\u0436\u0435\u0433\u0441\u044F. \u041E\u0442\u0441\u0442\u0443\u043F\u0430\u0435\u0442
      \u043D\u0430\u0437\u0430\u0434 \u043D\u0430 \u043F\u043E\u043B\u0448\u0430\u0433\u0430,
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044F
      \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u0443\u044E \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044E."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u041C\u042F \u0437\u0430\u0434\u0443\u043C\u0447\u0438\u0432\u043E
      \u043F\u043E\u0442\u0438\u0440\u0430\u0435\u0442 \u0437\u0430\u043F\u044F\u0441\u0442\u044C\u0435,
      \u0433\u0434\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0447\u0442\u043E
      \u0431\u044B\u043B\u0438 \u0435\u0433\u043E \u043F\u0430\u043B\u044C\u0446\u044B.
      \u041D\u0430 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u043D\u044B\u0439 \u0437\u0432\u043E\u043D\u043E\u043A
      \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442 \u043D\u0435 \u0441\u0440\u0430\u0437\u0443
      - \u0442\u043E\u043B\u044C\u043A\u043E \u043A\u043E\u0433\u0434\u0430 \u0440\u0438\u043D\u0433\u0442\u043E\u043D
      \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u043F\u0440\u043E\u0438\u0433\u0440\u044B\u0432\u0430\u0442\u044C\u0441\u044F
      \u0432 \u0442\u0440\u0435\u0442\u0438\u0439 \u0440\u0430\u0437."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u042D\u0442\u043E \u0420\u043E\u0431, \u043D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430
      \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u044E\u0449\u0438\u0439 \u0438\u0437-\u0437\u0430
      \u0435\u0451 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0438."
    style: {fileID: 0}
    authorComment: 
