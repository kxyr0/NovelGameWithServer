  guid: pp2_dialogue_rob_call_001
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  - character: {fileID: 11400000, guid: 0134d31ffe795134da58a7dc3f8fbc02, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: pp_rob
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u041C\u042F \u043F\u0440\u0438\u0436\u0438\u043C\u0430\u0435\u0442
      \u0442\u0435\u043B\u0435\u0444\u043E\u043D \u043A \u0443\u0445\u0443."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 2
    richText: "\u041F\u0440\u043E\u0441\u0442\u0438, \u044F \u0441\u043E\u0432\u0441\u0435\u043C
      \u0437\u0430\u0431\u044B\u043B\u0430, \u0447\u0442\u043E \u043E\u0431\u0435\u0449\u0430\u043B\u0430
      \u0442\u0435\u0431\u0435 \u043D\u0430 \u0443\u0436\u0438\u043D \u043F\u0430\u0441\u0442\u0443!"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041A\u0430\u043A \u0438 \u043C\u043D\u043E\u0433\u0438\u0435, \u0431\u043E\u043B\u0442\u0430\u044F
      \u043F\u043E \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0443, \u043E\u043D\u0430
      \u043D\u0430\u043C\u0430\u0442\u044B\u0432\u0430\u0435\u0442 \u043F\u043E \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044E
      \u043A\u0440\u0443\u0433\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0134d31ffe795134da58a7dc3f8fbc02, type: 2}
    emotion: 0
    richText: "\u041D\u0443 \u0434\u0430, \u043D\u0443 \u0434\u0430, \u043A\u043E\u043C\u0443
      \u043D\u0443\u0436\u0435\u043D \u043C\u043B\u0430\u0434\u0448\u0438\u0439 \u0431\u0440\u0430\u0442?"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u041C\u042F \u043D\u0435 \u0432\u0438\u0434\u0438\u0442, \u043D\u043E
      \u0437\u043D\u0430\u0435\u0442 - \u043E\u043D \u043D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430
      \u0437\u0430\u043A\u0430\u0442\u044B\u0432\u0430\u0435\u0442 \u0433\u043B\u0430\u0437\u0430.
      \u0422\u0443\u0442 \u0434\u0430\u0436\u0435 \u0434\u0443\u043C\u0430\u0442\u044C
      \u043D\u0435 \u043D\u0443\u0436\u043D\u043E: \u043E\u043D \u043F\u043E\u0434\u0440\u043E\u0441\u0442\u043E\u043A
      - \u044D\u0442\u043E \u0435\u0433\u043E \u043B\u044E\u0431\u0438\u043C\u043E\u0435
      \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u0438\u0435 \u043B\u0438\u0446\u0430."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0134d31ffe795134da58a7dc3f8fbc02, type: 2}
    emotion: 0
    richText: "\u041A\u0430\u043A \u0437\u043D\u0430\u043B, \u0447\u0442\u043E \u0442\u044B
      \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0448\u044C\u0441\u044F, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u0440\u0430\u0437\u043E\u0433\u0440\u0435\u043B \u0434\u043B\u044F \u0442\u0435\u0431\u044F
      \u043D\u0430\u0433\u0433\u0435\u0442\u0441\u044B. \u0426\u0435\u043D\u0438
      \u043C\u0435\u043D\u044F, \u044F - \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439,
      \u043A\u0442\u043E \u043E \u0442\u0435\u0431\u0435 \u0437\u0430\u0431\u043E\u0442\u0438\u0442\u0441\u044F\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0134d31ffe795134da58a7dc3f8fbc02, type: 2}
    emotion: 0
    richText: "\u041F\u0440\u0430\u0432\u0434\u0430, \u044F \u0443\u0436\u0435 \u0432\u0441\u0451
      \u0441\u044A\u0435\u043B. \u0412 \u0445\u043E\u043B\u043E\u0434\u0438\u043B\u044C\u043D\u0438\u043A\u0435
      \u043C\u044B\u0448\u044C \u043F\u043E\u0432\u0435\u0441\u0438\u043B\u0430\u0441\u044C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 2
    richText: "\u0414\u0430 \u0442\u044B \u0443 \u043C\u0435\u043D\u044F \u043F\u0440\u043E\u0441\u0442\u043E
      \u0431\u0440\u0438\u043B\u043B\u0438\u0430\u043D\u0442, \u0420\u043E\u0431,
      \u0430\u0433\u0430, \u0430 \u044F \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435
      \u0432\u0438\u0436\u0443, \u043A\u0430\u043A \u043C\u043D\u0435 \u043F\u043E\u0432\u0435\u0437\u043B\u043E."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0442\u0435\u0430\u0442\u0440\u0430\u043B\u044C\u043D\u043E
      \u0437\u0430\u043A\u0430\u0442\u044B\u0432\u0430\u0435\u0442 \u0433\u043B\u0430\u0437\u0430,
      \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E \u0431\u0435\u0437
      \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0435\u043D\u0438\u044F, \u0430
      \u0433\u0443\u0431\u044B \u0441\u0430\u043C\u0438 \u0441\u043E\u0431\u043E\u0439
      \u0440\u0430\u0441\u043F\u043B\u044B\u0432\u0430\u044E\u0442\u0441\u044F \u0432
      \u0443\u043B\u044B\u0431\u043A\u0435."
    style: {fileID: 0}
    authorComment: 
