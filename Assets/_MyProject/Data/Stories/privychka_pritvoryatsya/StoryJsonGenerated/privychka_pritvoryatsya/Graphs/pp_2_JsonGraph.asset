  guid: pp2_dialogue_after_will_messages_001
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u043D\u0443\u0442\u0440\u0438 \u0432\u0441\u0435 \u0445\u043E\u043B\u043E\u0434\u0435\u0435\u0442.
      \u0418\u041C\u042F \u0441\u0433\u043B\u0430\u0442\u044B\u0432\u0430\u0435\u0442,
      \u0441\u0436\u0438\u043C\u0430\u044F \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u043A\u043E\u0440\u043F\u0443\u0441 \u0441\u043C\u0430\u0440\u0442\u0444\u043E\u043D\u0430
      \u0432 \u043F\u0430\u043B\u044C\u0446\u0430\u0445. \u041B\u0430\u0434\u043E\u043D\u0438
      \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F \u043C\u043E\u043A\u0440\u044B\u043C\u0438
      - \u044D\u0442\u0430 \u043C\u0435\u043B\u043E\u0447\u044C \u0432\u0441\u0435\u0433\u0434\u0430
      \u0442\u0430\u043A \u043B\u0435\u0433\u043A\u043E \u0432\u044B\u0434\u0430\u0435\u0442
      \u0435\u0451 \u043D\u0435\u0440\u0432\u043E\u0437\u043D\u043E\u0441\u0442\u044C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u043D\u0435\u043D\u0430\u0432\u0438\u0434\u0438\u0442
      \u044D\u0442\u043E \u0447\u0443\u0432\u0441\u0442\u0432\u043E, \u043A\u043E\u0433\u0434\u0430
      \u0447\u0443\u0436\u043E\u0435 \u0438\u043C\u044F \u043D\u0430 \u044D\u043A\u0440\u0430\u043D\u0435
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E \u0437\u0430 \u0441\u0435\u043A\u0443\u043D\u0434\u0443
      \u0432\u044B\u0431\u0438\u0442\u044C \u043F\u043E\u0447\u0432\u0443 \u0438\u0437-\u043F\u043E\u0434
      \u043D\u043E\u0433."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u0435\u043D\u0430\u0432\u0438\u0434\u0438\u0442, \u0447\u0442\u043E
      \u0442\u0435\u043B\u043E \u0432\u0441\u0451 \u0435\u0449\u0451 \u043F\u043E\u043C\u043D\u0438\u0442
      \u0441\u0442\u0440\u0430\u0445 \u043B\u0443\u0447\u0448\u0435, \u0447\u0435\u043C
      \u0433\u043E\u043B\u043E\u0432\u0430."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041C\u043E\u0437\u0433 \u0441\u0430\u043C \u0441\u043E\u0431\u043E\u0439
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0435\u0451 \u043A
      \u0442\u043E\u043C\u0443 \u0434\u043D\u044E - \u0434\u043D\u044E, \u043A\u043E\u0433\u0434\u0430
      \u043E\u043D\u0430 \u0440\u0435\u0448\u0438\u043B\u0430 \u0443\u0439\u0442\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u0442\u043E\u0433\u0434\u0430 \u0432\u043F\u0435\u0440\u0432\u044B\u0435
      \u0435\u0451 \u0443\u0434\u0430\u0440\u0438\u043B."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0440\u0430\u0441\u0441\u0435\u044F\u043D\u043D\u043E
      \u043A\u0430\u0441\u0430\u0435\u0442\u0441\u044F \u0449\u0435\u043A\u0438 \u0438
      \u0437\u0430\u043C\u0438\u0440\u0430\u0435\u0442. \u041A\u043E\u0436\u0430
      \u043F\u043E\u0434 \u043F\u0430\u043B\u044C\u0446\u0430\u043C\u0438 \u0431\u0443\u0434\u0442\u043E
      \u0432\u0441\u043F\u044B\u0445\u0438\u0432\u0430\u0435\u0442 \u0441\u043D\u043E\u0432\u0430
      \u043E\u0442 \u0444\u0430\u043D\u0442\u043E\u043C\u043D\u043E\u0433\u043E \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u044F
      \u0442\u044F\u0436\u0435\u043B\u043E\u0439 \u0438 \u0445\u043B\u0435\u0441\u0442\u043A\u043E\u0439
      \u043F\u043E\u0449\u0435\u0447\u0438\u043D\u044B."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 28
    richText: ...
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u041C\u042F \u043D\u0435\u0432\u043E\u043B\u044C\u043D\u043E
      \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442, \u043A\u0430\u043A
      \u0442\u0435\u043C \u0436\u0435 \u0432\u0435\u0447\u0435\u0440\u043E\u043C,
      \u043F\u043E\u0441\u043B\u0435 \u0432\u0441\u0435\u0433\u043E, \u043E\u043D\u0430
      \u0431\u0435\u0437\u0437\u0432\u0443\u0447\u043D\u043E \u043F\u043B\u0430\u043A\u0430\u043B\u0430
      \u0432 \u0432\u0430\u043D\u043D\u043E\u0439, \u0441\u0442\u0430\u0440\u0430\u044F\u0441\u044C
      \u043D\u0435 \u043F\u043E\u0442\u0440\u0435\u0432\u043E\u0436\u0438\u0442\u044C
      \u0420\u043E\u0431\u0430, \u0438 \u043A\u043E\u0440\u0438\u043B\u0430 \u0441\u0435\u0431\u044F
      \u0437\u0430 \u0442\u043E, \u0447\u0442\u043E \u0438\u0437 \u0440\u0430\u0437\u0430
      \u0432 \u0440\u0430\u0437 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u043B\u0430
      \u043E\u0431\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F \u0441 \u0441\u043E\u0431\u043E\u0439
      \u0442\u0430\u043A\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 28
    richText: "\xAB\u041D\u0443\u0436\u043D\u043E \u0431\u044B\u043B\u043E \u0443\u0439\u0442\u0438,
      \u043A\u043E\u0433\u0434\u0430 \u043E\u043D \u0432 \u043F\u0435\u0440\u0432\u044B\u0439
      \u0440\u0430\u0437 \u043D\u0430 \u043C\u0435\u043D\u044F \u0437\u0430\u043C\u0430\u0445\u043D\u0443\u043B\u0441\u044F,
      \u0430 \u043F\u043E\u0442\u043E\u043C \u043E\u043F\u0440\u0430\u0432\u0434\u044B\u0432\u0430\u043B
      \u044D\u0442\u043E \u043A\u0430\u043A \u043C\u043E\u0433\u2026 \u0412\u043B\u044E\u0431\u043B\u0451\u043D\u043D\u0430\u044F
      \u0434\u0443\u0440\u0430!\xBB"
    style: {fileID: 0}
    authorComment: 
