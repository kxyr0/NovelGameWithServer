  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0442\u043A\u043B\u044E\u0447\u0438\u0432 \u0443\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u0438\u044F,
      \u0418\u041C\u042F \u0431\u0435\u0440\u0451\u0442\u0441\u044F \u0437\u0430
      \u0440\u0430\u0431\u043E\u0442\u0443 - \u0442\u043E\u0439 \u0443 \u043D\u0435\u0435
      \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043D\u0435\u043C\u0430\u043B\u043E.
      \u041E\u0431\u0435\u0449\u0430\u043D\u043D\u044B\u0435 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B
      \u043E\u043D\u0430 \u043F\u043E\u0434\u0433\u043E\u0442\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u0442\u043E\u043B\u044C\u043A\u043E \u0431\u043B\u0438\u0436\u0435 \u043A
      \u043F\u043E\u043B\u0443\u0434\u043D\u044E. \u0412\u043B\u0430\u0434 \u043E\u0442\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u043F\u0430\u043F\u043A\u0443 \u043D\u0430 \u0432\u0438\u0434\u043D\u043E\u0435
      \u043C\u0435\u0441\u0442\u043E, \u0441\u043A\u0430\u0437\u0430\u0432, \u0447\u0442\u043E
      \u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u0442\u0441\u044F \u0441 \u043D\u0438\u043C\u0438
      \u0447\u0443\u0442\u044C \u043F\u043E\u0437\u0436\u0435 - \u0443 \u043D\u0435\u0433\u043E
      \u0432\u043F\u0435\u0440\u0435\u0434\u0438 \u0446\u0435\u043B\u0430\u044F \u043D\u043E\u0447\u044C
      \u0434\u0435\u0436\u0443\u0440\u0441\u0442\u0432\u0430."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412 \u043F\u043E\u043B\u0434\u0435\u043D\u044C \u043E\u043D\u0430
      \u0443\u0445\u043E\u0434\u0438\u0442 \u043D\u0430 \u043E\u0431\u0435\u0434."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 9
    richText: "\xAB\u0416\u0438\u0432\u043E\u0442 \u0443\u0440\u0447\u0438\u0442,
      \u043A\u0430\u043A \u0441\u0442\u0430\u044F \u043A\u0438\u0442\u043E\u0432.
      \u0423\u0436\u0430\u0441\u043D\u043E \u043D\u0435\u043B\u043E\u0432\u043A\u043E\u2026\xBB"
    style: {fileID: 0}
    authorComment: 
--- !u!114 &3713458818108617649
