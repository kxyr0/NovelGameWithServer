  guid: pp2_dialogue_vlad_relationship_goodbye_001
  nodeTitle: 
  activeCharacters: []
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0417\u0432\u0443\u0447\u0438\u0442 \u0442\u0430\u043A, \u043A\u0430\u043A
      \u0431\u0443\u0434\u0442\u043E \u0431\u044B \u043E\u043F\u0440\u0430\u0432\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043F\u0435\u0440\u0435\u0434 \u043D\u0438\u043C, \u043D\u043E \u0435\u0439
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043D\u0435\u043B\u043E\u0432\u043A\u043E \u0443\u0445\u043E\u0434\u0438\u0442\u044C
      \u0432\u043E\u0442 \u0442\u0430\u043A \u043F\u043E\u0441\u043B\u0435 \u044D\u0442\u043E\u0439
      \u043D\u0435\u043B\u0435\u043F\u043E\u0439 \u0431\u043B\u0438\u0437\u043E\u0441\u0442\u0438,
      \u0447\u0442\u043E \u0432\u043E\u0437\u043D\u0438\u043A\u043B\u0430 \u043C\u0435\u0436\u0434\u0443
      \u043D\u0438\u043C\u0438 \u043F\u0430\u0440\u0443 \u043C\u0438\u043D\u0443\u0442
      \u043D\u0430\u0437\u0430\u0434 \u0438 \u0442\u0430\u043A \u0436\u0435 \u0431\u044B\u0441\u0442\u0440\u043E
      \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u0438\u043B\u0430\u0441\u044C."
    style: {fileID: 0}
    authorComment: 
