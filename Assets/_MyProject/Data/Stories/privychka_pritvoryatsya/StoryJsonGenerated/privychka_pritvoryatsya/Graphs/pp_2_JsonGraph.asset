  guid: pp2_dialogue_corridor_evening_001
  nodeTitle: 
  activeCharacters: []
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0438 \u0438\u0434\u0443\u0442 \u043F\u043E \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0443
      \u043C\u043E\u043B\u0447\u0430."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0422\u0438\u0448\u0438\u043D\u0443 \u043D\u0430\u0440\u0443\u0448\u0430\u0435\u0442
      \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043A\u0440\u0438\u043F \u0435\u0451
      \u043A\u0440\u043E\u0441\u0441\u043E\u0432\u043E\u043A \u0438 \u0433\u043B\u0443\u0445\u043E\u0439,
      \u0442\u044F\u0436\u0451\u043B\u044B\u0439 \u0437\u0432\u0443\u043A \u0435\u0433\u043E
      \u0448\u0430\u0433\u043E\u0432."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u041C\u042F \u043B\u043E\u0432\u0438\u0442 \u0441\u0435\u0431\u044F
      \u043D\u0430 \u043C\u044B\u0441\u043B\u0438, \u0447\u0442\u043E \u0440\u044F\u0434\u043E\u043C
      \u0441 \u0412\u043B\u0430\u0434\u043E\u043C \u0442\u0438\u0448\u0438\u043D\u0430
      \u043E\u0449\u0443\u0449\u0430\u0435\u0442\u0441\u044F \u0438\u043D\u0430\u0447\u0435
      - \u043A\u0430\u043A \u0447\u0442\u043E-\u0442\u043E, \u0432 \u0447\u0451\u043C
      \u043B\u0435\u0433\u043A\u043E \u0441\u043A\u0430\u0437\u0430\u0442\u044C \u043D\u0435
      \u0442\u043E, \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u043D\u0435 \u0442\u043E,
      \u0432\u0434\u043E\u0445\u043D\u0443\u0442\u044C \u043D\u0435 \u0432\u043E\u0432\u0440\u0435\u043C\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0432\u0437\u0434\u044B\u0445\u0430\u0435\u0442
      \u0438, \u043E\u0442\u043E\u0440\u0432\u0430\u0432 \u0432\u0437\u0433\u043B\u044F\u0434
      \u043E\u0442 \u043F\u043E\u043B\u0430, \u0432\u043F\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C \u0432 \u0435\u0433\u043E
      \u0448\u0438\u0440\u043E\u043A\u0443\u044E \u0441\u043F\u0438\u043D\u0443."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u043E\u0434 \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u043C
      \u0441\u0432\u0435\u0442\u043E\u043C \u0440\u0435\u0434\u043A\u0438\u0445 \u043B\u0430\u043C\u043F
      \u0438\u0445 \u0442\u0435\u043D\u0438 \u0442\u044F\u043D\u0443\u0442\u0441\u044F
      \u043F\u043E \u0441\u0442\u0435\u043D\u0430\u043C - \u0434\u043B\u0438\u043D\u043D\u044B\u0435,
      \u0447\u0443\u0436\u0438\u0435, \u043B\u043E\u043C\u0430\u043D\u044B\u0435."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041A\u0430\u0436\u0434\u044B\u0439 \u0438\u0437 \u043D\u0438\u0445
      \u0434\u0443\u043C\u0430\u0435\u0442 \u043E \u0441\u0432\u043E\u0451\u043C.
      \u0418\u041C\u042F - \u043E \u0442\u043E\u043C, \u0447\u0442\u043E \u0437\u0430\u0431\u044B\u043B\u0430
      \u0441\u043E\u043E\u0431\u0449\u0438\u0442\u044C \u0420\u043E\u0431\u0443,
      \u0447\u0442\u043E \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
      \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0435. \u0410 \u0412\u043B\u0430\u0434\u2026
      \u041E\u043D\u0430 \u043D\u0435 \u0437\u043D\u0430\u0435\u0442, \u0447\u0442\u043E
      \u0432 \u0435\u0433\u043E \u0433\u043E\u043B\u043E\u0432\u0435"
    style: {fileID: 0}
    authorComment: 
