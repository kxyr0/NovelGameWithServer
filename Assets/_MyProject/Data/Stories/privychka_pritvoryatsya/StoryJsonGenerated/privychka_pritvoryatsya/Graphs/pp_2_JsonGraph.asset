  guid: pp2_dialogue_final_001
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: pp_vlad
  lines:
  - speaker: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 17
    richText: "\u041F\u043E\u043D\u0438\u043C\u0430\u044E."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0431\u0435\u0437\u043E
      \u0432\u0441\u044F\u043A\u043E\u0433\u043E \u0443\u043F\u0440\u0451\u043A\u0430,
      \u043D\u043E \u0433\u0443\u0431\u044B \u0441\u0430\u043C\u0438 \u043A\u0440\u0438\u0432\u044F\u0442\u0441\u044F
      \u0432 \u0443\u0441\u0442\u0430\u043B\u043E\u0439 \u0438 \u0433\u0440\u0443\u0441\u0442\u043D\u043E\u0439
      \u0443\u043B\u044B\u0431\u043A\u0435."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 17
    richText: "\u0411\u0435\u0433\u0438, \u0441\u0442\u0430\u0436\u0435\u0440."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u041C\u042F \u0432 \u043E\u0447\u0435\u0440\u0435\u0434\u043D\u043E\u0439
      \u0440\u0430\u0437 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E
      \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F \u0435\u043C\u0443 \u0438
      \u043F\u043E\u043A\u0438\u0434\u0430\u0435\u0442 \u0437\u0430\u043B. \u0414\u0432\u0435\u0440\u044C
      \u0437\u0430 \u043D\u0435\u0439 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441 \u0433\u0440\u043E\u043C\u043A\u0438\u043C \u0445\u043B\u043E\u043F\u043A\u043E\u043C
      - \u0432\u0438\u043D\u043E\u0439 \u0442\u043E\u043C\u0443 \u0441\u043A\u0432\u043E\u0437\u043D\u044F\u043A."
    style: {fileID: 0}
    authorComment: 
