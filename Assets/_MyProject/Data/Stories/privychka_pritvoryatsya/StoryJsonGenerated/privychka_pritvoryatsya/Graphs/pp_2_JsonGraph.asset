  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: pp2_dialogue_protocol_feelings_001
  nodeTitle: 
  activeCharacters: []
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u041C\u042F \u0431\u0440\u043E\u0441\u0430\u0435\u0442 \u044D\u0442\u043E
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0440\u0435\u0437\u043A\u043E,
      \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u0443\u044F\u0441\u044C
      \u0438\u043C\u043F\u0443\u043B\u044C\u0441\u0438\u0432\u043D\u044B\u043C \u043F\u043E\u0440\u044B\u0432\u043E\u043C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043F\u0440\u043E
      \u043D\u0430\u0440\u0443\u0448\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B\u0430
      - \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u043E?"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E, \u043E\u043D\u0430 \u0441\u043B\u044B\u0448\u0430\u043B\u0430,
      \u043A\u0430\u043A \u0414\u0436\u0435\u0439\u043C\u0441 \u043E\u0442\u0447\u0438\u0442\u044B\u0432\u0430\u043B
      \u0435\u0433\u043E \u0437\u0430 \u0442\u043E, \u0447\u0442\u043E \u0442\u043E\u0442
      \u043F\u0440\u0438 \u0437\u0430\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0438
      \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u043B \u0433\u0440\u0443\u0431\u0443\u044E
      \u0441\u0438\u043B\u0443 - \u0438 \u0442\u0443\u0442 \u043D\u0435 \u043D\u0443\u0436\u043D\u043E
      \u0431\u044B\u043B\u043E \u0434\u0430\u0436\u0435 \u043F\u043E\u0434\u0441\u043B\u0443\u0448\u0438\u0432\u0430\u0442\u044C,
      \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0441\u043B\u044B\u0448\u0430\u043B\u0430
      \u044D\u0442\u043E \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u043D\u0430,
      \u043D\u043E \u0438 \u0432\u0435\u0441\u044C \u043E\u0442\u0434\u0435\u043B."
    style: {fileID: 0}
    authorComment: 
