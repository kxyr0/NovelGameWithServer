  guid: pp2_dialogue_outfit_runway_001
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: pp_vlad
  - character: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speaker: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 17
    richText: "\u0417\u0434\u0435\u0441\u044C \u043D\u0435 \u043A\u043E\u043D\u043A\u0443\u0440\u0441
      \u043A\u0440\u0430\u0441\u043E\u0442\u044B."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 26
    richText: "\u0422\u044B \u0442\u043E\u043B\u044C\u043A\u043E \u0447\u0442\u043E
      \u043D\u0430\u0437\u0432\u0430\u043B \u043C\u0435\u043D\u044F \u043A\u0440\u0430\u0441\u0438\u0432\u043E\u0439?"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0432\u0437\u0433\u043B\u044F\u0434 \u0438 \u043A\u043E\u043A\u0435\u0442\u043B\u0438\u0432\u043E
      \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F. \u041F\u043E\u0434\u043F\u0438\u0440\u0430\u0435\u0442
      \u0433\u043E\u043B\u043E\u0432\u0443 \u0440\u0443\u043A\u043E\u0439 - \u043F\u043E\u0434\u0432\u0435\u0441\u043A\u0438
      \u043D\u0430 \u0431\u0440\u0430\u0441\u043B\u0435\u0442\u0435 \u043D\u0435\u0433\u0440\u043E\u043C\u043A\u043E
      \u0437\u0432\u044F\u043A\u0430\u044E\u0442."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 13
    richText: "\u042F \u043F\u043E\u0448\u0443\u0442\u0438\u043B."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u043D\u0430\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442
      \u0438\u0437\u043B\u044E\u0431\u043B\u0435\u043D\u043D\u044B\u0439 \u043F\u043E\u043A\u0435\u0440-\u0444\u044D\u0439\u0441,
      \u0441\u043A\u0438\u0434\u044B\u0432\u0430\u0435\u0442 \u0441 \u043F\u043B\u0435\u0447
      \u043A\u0443\u0440\u0442\u043A\u0443. \u041D\u043E \u0443\u0433\u043E\u043B\u043A\u0438
      \u0435\u0433\u043E \u0433\u0443\u0431 \u0447\u0443\u0442\u044C \u043F\u043E\u0434\u0440\u0430\u0433\u0438\u0432\u0430\u044E\u0442
      \u0432 \u043F\u043E\u043B\u0443\u0443\u043B\u044B\u0431\u043A\u0435, \u0438
      \u044D\u0442\u043E \u043D\u0435 \u043E\u0441\u0442\u0430\u0435\u0442\u0441\u044F
      \u0434\u043B\u044F \u0418\u041C\u042F \u043D\u0435\u0437\u0430\u043C\u0435\u0447\u0435\u043D\u043D\u044B\u043C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0437\u0430\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442
      \u044D\u0442\u043E \u043A\u0430\u043A +1 \u0432 \u0441\u0432\u043E\u044E \u043F\u043E\u043B\u044C\u0437\u0443."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 13
    richText: "\u042F \u043E\u0446\u0435\u043D\u0438\u043B\u0430."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u041C\u042F \u0441\u0434\u0435\u0440\u0436\u0430\u043D\u043D\u043E
      \u043A\u0438\u0432\u0430\u0435\u0442, \u043D\u043E \u0435\u0451 \u0441\u0430\u043C\u043E\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u043E
      \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0441\u044F \u0437\u0430
      \u0432\u0435\u0440\u0441\u0442\u0443."
    style: {fileID: 0}
    authorComment: 
