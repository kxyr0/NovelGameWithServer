  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u043B\u0430\u0434 \u043E\u043F\u0430\u0441\u043D\u043E \u0449\u0443\u0440\u0438\u0442\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u041C\u042F \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430
      \u043D\u0435\u0433\u043E \u0441 \u0432\u044B\u0437\u043E\u0432\u043E\u043C,
      \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E - \u0440\u0430\u0441\u043F\u0430\u043B\u0438\u0432\u0448\u0438\u0441\u044C.
      \u0413\u043E\u0442\u043E\u0432\u0438\u0442\u0441\u044F \u043A \u043E\u0447\u0435\u0440\u0435\u0434\u043D\u043E\u043C\u0443
      \u0437\u0430\u0445\u0432\u0430\u0442\u0443 \u0438 \u0445\u043E\u0447\u0435\u0442
      \u0435\u0433\u043E \u0438\u0437\u0431\u0435\u0436\u0430\u0442\u044C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0415\u0451 \u0437\u0430\u0434\u043E\u0440 \u043F\u0435\u0440\u0435\u0434\u0430\u0435\u0442\u0441\u044F
      \u0438 \u0435\u043C\u0443."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F
      \u0435\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043B\u044E\u0431\u0438\u0442 \u0438\u0433\u0440\u0430\u0442\u044C: \u043D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430
      \u043F\u0440\u0438\u0432\u044B\u043A, \u0447\u0442\u043E\u0431\u044B \u0432\u0441\u0451
      \u0434\u0435\u043B\u0430\u043B\u043E\u0441\u044C \u0447\u0451\u0442\u043A\u043E
      \u0438 \u043F\u043E \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438
      - \u043D\u043E \u043E\u043D\u0430 \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u0435\u043C\u0443 \u0432\u044B\u0431\u043E\u0440\u0430."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0423\u043B\u0443\u0447\u0438\u0432 \u043C\u043E\u043C\u0435\u043D\u0442,
      \u043B\u043E\u0432\u0438\u0442 \u0435\u0451 \u0437\u0430 \u0440\u0443\u043A\u0443,
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u0432\u0432\u0435\u0440\u0445
      \u0438 \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u043A \u0441\u0435\u0431\u0435 \u0441\u043F\u0438\u043D\u043E\u0439, \u043F\u043E\u0447\u0442\u0438
      \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u043E\u0431\u0435\u0437\u0434\u0432\u0438\u0436\u0438\u0432\u0430\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 24
    richText: "\u042D\u0439!"
    style: {fileID: 0}
    authorComment: 
