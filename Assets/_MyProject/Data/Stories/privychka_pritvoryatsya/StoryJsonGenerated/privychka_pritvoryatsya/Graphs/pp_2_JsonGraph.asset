  lines:
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 2
    richText: "\u041D\u0438\u0447\u0435\u0433\u043E, \u0447\u0442\u043E \u043C\u044B
      \u0432 \u0440\u0430\u0437\u043D\u044B\u0445 \u0432\u0435\u0441\u043E\u0432\u044B\u0445
      \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u044F\u0445?"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u043D\u0430\u0440\u0443\u0448\u0430\u0435\u0442
      \u0442\u0438\u0448\u0438\u043D\u0443 \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E
      \u0434\u043B\u044F \u0441\u0435\u0431\u044F, \u043F\u0440\u043E\u0441\u0442\u043E
      \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0442\u0430 \u043A\u0430\u0436\u0435\u0442\u0441\u044F
      \u0435\u0439 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0442\u044F\u0436\u0435\u043B\u043E\u0439
      \u0438 \u0433\u0443\u0441\u0442\u043E\u0439."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u043B\u0430\u0434 \u043D\u0430\u0441\u043C\u0435\u0448\u043B\u0438\u0432\u043E
      \u0445\u043C\u044B\u043A\u0430\u0435\u0442."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 26
    richText: "\u0422\u043E \u0436\u0435 \u0441\u0430\u043C\u043E\u0435 \u0441\u043F\u0440\u043E\u0441\u0438\u0448\u044C,
      \u043A\u043E\u0433\u0434\u0430 \u043D\u0430 \u0442\u0435\u0431\u044F \u043D\u0430\u043F\u0430\u0434\u0443\u0442?"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u041C\u042F \u0446\u043E\u043A\u0430\u0435\u0442."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 30
    richText: "\u041D\u0435 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u044E,
      \u043A\u0430\u043A \u0442\u044B \u0435\u0449\u0451 \u043D\u0435 \u043F\u043E\u0440\u0435\u0437\u0430\u043B\u0441\u044F
      \u043E \u0441\u0432\u043E\u0439 \u043E\u0441\u0442\u0440\u044B\u0439 \u044F\u0437\u044B\u043A!"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 13
    richText: "\u0412 \u043E\u0442\u043B\u0438\u0447\u0438\u0435 \u043E\u0442 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0445,
      \u044F \u0437\u043D\u0430\u044E, \u043A\u043E\u0433\u0434\u0430 \u0435\u0433\u043E
      \u043F\u0440\u0438\u043A\u0443\u0441\u0438\u0442\u044C,"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0415\u0451 \u043E\u043F\u044F\u0442\u044C \u0449\u0435\u043B\u043A\u043D\u0443\u043B\u0438
      \u043F\u043E \u043D\u043E\u0441\u0443. \u041D\u0430\u043F\u043E\u043C\u043D\u0438\u043B\u0438
      \u043E \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u0438 \u0438\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u0442\u043E\u043B\u043A\u0430\u0435\u0442 \u043F\u043B\u0435\u0447\u043E\u043C
      \u0434\u0432\u0435\u0440\u044C \u0432 \u0441\u043F\u043E\u0440\u0442\u0438\u0432\u043D\u044B\u0439
      \u0437\u0430\u043B."
    style: {fileID: 0}
    authorComment: 
