  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: pp2_dialogue_training_core_001
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: pp_vlad
  - character: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speaker: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 17
    richText: "\u0422\u044B \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u043D\u043E\u0433\u043E
      \u0434\u0451\u0440\u0433\u0430\u0435\u0448\u044C\u0441\u044F. \u042D\u0442\u043E
      \u043F\u0443\u0441\u0442\u0430\u044F \u0442\u0440\u0430\u0442\u0430 \u0441\u0438\u043B.
      \u0420\u0443\u043A\u0443 - \u0432\u043E\u0442 \u0442\u0430\u043A."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u043D\u0430 \u0441\u0435\u0431\u0435."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 17
    richText: "\u0412\u0438\u0434\u0438\u0448\u044C? \u0421\u0433\u0438\u0431 - \u0441\u044E\u0434\u0430.
      \u0422\u043E\u043B\u0447\u043E\u043A - \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u043B\u0430\u0434 \u043B\u043E\u0432\u0438\u0442 \u0435\u0451
      \u0432\u0437\u0433\u043B\u044F\u0434."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 32
    richText: "\u041D\u0430 \u0440\u0443\u043A\u0438 \u0441\u043C\u043E\u0442\u0440\u0438,
      \u043D\u0435 \u043D\u0430 \u043C\u0435\u043D\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 17
    richText: "\u0414\u0430\u0432\u0430\u0439 \u0435\u0449\u0451 \u0440\u0430\u0437!"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u0435\u0442
      \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u0441\u043D\u043E\u0432\u0430
      - \u0443\u0436\u0435 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u0435\u0435,
      \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u0435\u0435, \u0431\u0435\u0437
      \u043B\u0438\u0448\u043D\u0435\u0439 \u0441\u0443\u0435\u0442\u044B."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u0430 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437 \u043A\u0438\u0441\u0442\u044C
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0447\u0443\u0442\u044C \u043F\u043E\u0434\u0434\u0430\u0451\u0442\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u041C\u042F \u0437\u0430\u043C\u0438\u0440\u0430\u0435\u0442,
      \u043F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u0432 \u044D\u0442\u043E
      \u043F\u0435\u0440\u0432\u043E\u0439."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0434\u0451\u0440\u0433\u0430\u0435\u0442 \u0440\u0435\u0437\u0447\u0435
      - \u0438 \u043F\u043E\u0447\u0442\u0438 \u0432\u044B\u0441\u043A\u0430\u043B\u044C\u0437\u044B\u0432\u0430\u0435\u0442
      \u0438\u0437 \u0445\u0432\u0430\u0442\u043A\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u043B\u0430\u0434 \u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u0435\u0442
      \u0435\u0451 \u043F\u0440\u0435\u0436\u0434\u0435, \u0447\u0435\u043C \u043E\u043D\u0430
      \u0443\u0441\u043F\u0435\u0432\u0430\u0435\u0442 \u043F\u043E\u0440\u0430\u0434\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u043F\u0435\u0440\u0432\u044B\u043C \u0443\u0441\u043F\u0435\u0445\u0430\u043C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 17
    richText: "\u0423\u0436\u0435 \u043B\u0443\u0447\u0448\u0435."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 13
    richText: "\u0425\u0432\u0430\u043B\u0438\u0448\u044C?"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 28
    richText: "\u041D\u0435 \u043F\u0440\u0438\u0432\u044B\u043A\u0430\u0439."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u0435\u0451
      \u0437\u0430 \u043A\u0438\u0441\u0442\u044C \u0432\u043D\u043E\u0432\u044C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0441\u043E\u0441\u0440\u0435\u0434\u043E\u0442\u043E\u0447\u0435\u043D\u043E,
      \u043A\u0430\u043A \u043F\u0440\u0438\u043B\u0435\u0436\u043D\u0430\u044F \u0443\u0447\u0435\u043D\u0438\u0446\u0430,
      \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u0435\u0442 \u043E\u0437\u0432\u0443\u0447\u0435\u043D\u043D\u044B\u0439
      \u0438\u043C \u0445\u043E\u0434 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439
      - \u0447\u0443\u0442\u044C \u043F\u043E\u0434\u0430\u0451\u0442\u0441\u044F
      \u0432\u043F\u0435\u0440\u0451\u0434, \u0441\u0433\u0438\u0431\u0430\u0435\u0442
      \u0440\u0443\u043A\u0443 \u0438 \u0434\u0451\u0440\u0433\u0430\u0435\u0442
      \u0432\u0432\u0435\u0440\u0445."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u043B\u0430\u0434 \u043D\u0435 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
      \u043E\u0442\u0432\u043B\u0435\u0447\u044C\u0441\u044F. \u041A\u0440\u0435\u043F\u043A\u043E
      \u0446\u0435\u043F\u043B\u044F\u0435\u0442\u0441\u044F \u0437\u0430 \u0434\u0440\u0443\u0433\u043E\u0435
      \u0435\u0451 \u0437\u0430\u043F\u044F\u0441\u0442\u044C\u0435 - \u0445\u0432\u0430\u0442\u043A\u0430
      \u0442\u0435\u043F\u0435\u0440\u044C \u0441\u0438\u043B\u044C\u043D\u0435\u0435."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u041C\u042F \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F
      \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C \u043F\u043E
      \u0442\u043E\u0439 \u0436\u0435 \u0441\u0445\u0435\u043C\u0435. \u041D\u0435
      \u0432\u044B\u0445\u043E\u0434\u0438\u0442: \u043E\u043D\u0430 \u0441\u043B\u0430\u0431\u0435\u0435."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u0435 \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u0432,
      \u043F\u043E \u0438\u043D\u0435\u0440\u0446\u0438\u0438 \u0437\u0430\u0432\u0430\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432\u043F\u0435\u0440\u0451\u0434 - \u043E\u043D \u043B\u043E\u0432\u0438\u0442
      \u0435\u0451, \u0438\u043D\u0441\u0442\u0438\u043D\u043A\u0442\u0438\u0432\u043D\u043E,
      \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u0439 \u0440\u0443\u043A\u043E\u0439."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0434\u0451\u0440\u0433\u0430\u0435\u0442\u0441\u044F
      \u0432 \u043F\u043E\u043F\u044B\u0442\u043A\u0435 \u043F\u0440\u0435\u0441\u0435\u0447\u044C
      \u0435\u0433\u043E \u043C\u0430\u043D\u0451\u0432\u0440 \u0438 \u0432\u044B\u0441\u0432\u043E\u0431\u043E\u0434\u0438\u0442\u044C\u0441\u044F,
      \u0438 \u0435\u0451 \u0432\u043E\u043B\u043E\u0441\u044B \u0437\u0430\u0434\u0435\u0432\u0430\u044E\u0442
      \u0435\u0433\u043E \u0449\u0435\u043A\u0443, \u0446\u0435\u043F\u043B\u044F\u044F\u0441\u044C
      \u0437\u0430 \u0442\u0440\u0435\u0445\u0434\u043D\u0435\u0432\u043D\u0443\u044E
      \u0449\u0435\u0442\u0438\u043D\u0443, \u0430 \u0448\u0435\u043B\u043A\u043E\u0432\u0438\u0441\u0442\u0430\u044F
      \u043F\u0440\u044F\u0434\u044C, \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E
      \u0432\u044B\u0431\u0438\u0432\u0448\u0430\u044F\u0441\u044F \u0438\u0437 \u0445\u0432\u043E\u0441\u0442\u0430,
      \u0449\u0435\u043A\u043E\u0447\u0435\u0442 \u043D\u043E\u0441."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u043B\u0430\u0434 \u043E\u0442\u0444\u044B\u0440\u043A\u0438\u0432\u0430\u0435\u0442\u0441\u044F,
      \u043D\u043E \u043D\u0435 \u043E\u0442\u043F\u0443\u0441\u043A\u0430\u0435\u0442."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 17
    richText: "\u042D\u0442\u043E \u043A\u0430\u043A \u0440\u0430\u0437 \u043E \u0440\u0430\u0437\u043D\u0438\u0446\u0435
      \u0432 \u0432\u0435\u0441\u0435. \u041F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A
      \u043F\u043E\u0447\u0442\u0438 \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u0442
      \u043A\u0440\u0443\u043F\u043D\u0435\u0435 \u0442\u0435\u0431\u044F - \u0441\u043C\u0438\u0440\u0438\u0441\u044C
      \u0441 \u044D\u0442\u0438\u043C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u043A\u0438\u0432\u043A\u043E\u043C \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u043D\u0430 \u0435\u0451 \u0432\u0442\u043E\u0440\u0443\u044E \u0440\u0443\u043A\u0443."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 17
    richText: "\u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439
      \u0432\u0442\u043E\u0440\u0443\u044E. \u0418 \u043D\u0435 \u0433\u0435\u0440\u043E\u0439\u0441\u0442\u0432\u0443\u0439."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u041C\u042F \u043F\u043E\u043D\u044F\u0442\u043B\u0438\u0432\u043E
      \u043A\u0438\u0432\u0430\u0435\u0442."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 17
    richText: "\u0422\u044B \u043A\u0443\u0440\u0438\u0448\u044C?"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 8
    richText: "\u0410?"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442
      \u0431\u044B\u0441\u0442\u0440\u043E: \u0432\u043E\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0432\u0448\u0438\u0441\u044C
      \u0435\u0433\u043E \u0441\u0435\u043A\u0443\u043D\u0434\u043D\u043E\u0439 \u0440\u0430\u0441\u0442\u0435\u0440\u044F\u043D\u043D\u043E\u0441\u0442\u044C\u044E,
      \u043F\u043E\u0434\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442 \u043B\u0430\u0434\u043E\u043D\u044C
      \u043F\u043E\u0434 \u0441\u0432\u043E\u0451 \u0437\u0430\u043F\u044F\u0441\u0442\u044C\u0435
      \u0438 \u0440\u0435\u0437\u043A\u043E \u0442\u044F\u043D\u0435\u0442 \u043B\u043E\u043A\u043E\u0442\u044C
      \u0432\u0432\u0435\u0440\u0445. \u0423\u0445\u043C\u044B\u043B\u044F\u0435\u0442\u0441\u044F:
      \u0435\u0439 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0432\u044B\u0441\u0432\u043E\u0431\u043E\u0434\u0438\u0442\u044C\u0441\u044F
      \u0441 \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0440\u0430\u0437\u0430."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 13
    richText: "\u0422\u0430\u0431\u0430\u043A\u043E\u043C \u043F\u0430\u0445\u043D\u0435\u0448\u044C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 13
    richText: "\u0414\u0435\u0448\u0451\u0432\u044B\u0439 \u0442\u0440\u044E\u043A."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 13
    richText: "\u0420\u0430\u0431\u043E\u0447\u0438\u0439 \u0436\u0435."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 13
    richText: "\u0422\u044B \u043D\u0435 \u0442\u0430\u043A \u0431\u0435\u0437\u043D\u0430\u0434\u0435\u0436\u043D\u0430,
      \u043A\u0430\u043A \u043C\u043D\u0435 \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C."
    style: {fileID: 0}
    authorComment: 
