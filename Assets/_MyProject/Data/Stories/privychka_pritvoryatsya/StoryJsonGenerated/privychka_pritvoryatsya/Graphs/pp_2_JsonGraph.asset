  guid: pp2_dialogue_phone_without_extended_001
  nodeTitle: 
  activeCharacters: []
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0417\u0432\u043E\u043D\u043E\u043A \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0430
      - \u0441\u0435\u0439\u0447\u0430\u0441 \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E
      \u043D\u0435 \u043A \u043C\u0435\u0441\u0442\u0443, \u043D\u043E \u0418\u041C\u042F
      \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442 \u043D\u0430 \u043D\u0435\u0433\u043E
      \u043F\u043E\u0447\u0442\u0438 \u0441\u0440\u0430\u0437\u0443, \u043C\u043E\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u043E
      \u043E\u0442\u0432\u043B\u0435\u043A\u0430\u044F\u0441\u044C \u043D\u0430 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440.
      \u042D\u0442\u043E \u0437\u0432\u043E\u043D\u0438\u0442 \u0420\u043E\u0431,
      \u043D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430 \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u044E\u0449\u0438\u0439
      \u0438\u0437-\u0437\u0430 \u0435\u0451 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0438."
    style: {fileID: 0}
    authorComment: 
