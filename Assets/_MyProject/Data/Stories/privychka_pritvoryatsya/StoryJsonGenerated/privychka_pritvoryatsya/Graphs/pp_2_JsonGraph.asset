  guid: pp2_after_case_choice_001
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 9
    richText: "\xAB\u041B\u0430\u0434\u043D\u043E, \u0431\u0443\u0434\u0443 \u0440\u0435\u0448\u0430\u0442\u044C
      \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B \u043F\u043E \u043C\u0435\u0440\u0435
      \u0438\u0445 \u043F\u043E\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u044F.\xBB"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0442\u0430\u043A \u0443\u0432\u043B\u0435\u0447\u0435\u043D\u043D\u043E
      \u0432\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0432 \u0443\u0436\u0435
      \u0437\u0430\u0443\u0447\u0435\u043D\u043D\u044B\u0435 \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438
      \u043D\u0430\u0438\u0437\u0443\u0441\u0442\u044C \u0441\u0442\u0440\u043E\u043A\u0438,
      \u0447\u0442\u043E \u043D\u0435 \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442
      \u043F\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u044F \u0432 \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0435
      \u0412\u043B\u0430\u0434\u0430."
    style: {fileID: 0}
    authorComment: 
