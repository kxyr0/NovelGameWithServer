  guid: pp2_dialogue_training_extended_feelings_001
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 9
    richText: "\xAB\u0412 \u0444\u0438\u043B\u044C\u043C\u0430\u0445 \u043F\u043E\u0441\u043B\u0435
      \u0442\u0430\u043A\u0438\u0445 \u043C\u043E\u043C\u0435\u043D\u0442\u043E\u0432
      \u043E\u0431\u044B\u0447\u043D\u043E \u0441\u043B\u0435\u0434\u0443\u0435\u0442
      \u0433\u043E\u0440\u044F\u0447\u0438\u0439 \u0441\u0435\u043A\u0441 \u0433\u0434\u0435-\u043D\u0438\u0431\u0443\u0434\u044C
      \u0432 \u0434\u0443\u0448\u0435\u0432\u043E\u0439\u2026\xBB"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412 \u0433\u043E\u043B\u043E\u0432\u0435 \u0442\u0443\u0442 \u0436\u0435
      \u0432\u0441\u043F\u044B\u0445\u0438\u0432\u0430\u044E\u0442 \u043E\u0431\u0440\u0430\u0437\u044B,
      \u043A\u0430\u043A \u043E\u043D \u043F\u0440\u0438\u0436\u0438\u043C\u0430\u0435\u0442
      \u0435\u0451 \u043A \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0439 \u043F\u043B\u0438\u0442\u043A\u0435,
      \u043F\u0430\u0440 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
      \u043A \u043F\u043E\u0442\u043E\u043B\u043A\u0443, \u0441\u043A\u0440\u044B\u0432\u0430\u044F
      \u043B\u0438\u0446\u0430, \u0430 \u0435\u0433\u043E \u043B\u0430\u0434\u043E\u043D\u0438
      \u043A\u0440\u0435\u043F\u043A\u043E \u0434\u0435\u0440\u0436\u0430\u0442 \u0435\u0451
      \u0437\u0430 \u0442\u0430\u043B\u0438\u044E\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u041C\u042F \u0432\u0441\u043F\u044B\u0445\u0438\u0432\u0430\u0435\u0442
      \u043E\u0442 \u0437\u043B\u043E\u0441\u0442\u0438 \u043D\u0430 \u0441\u0430\u043C\u0443
      \u0441\u0435\u0431\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 20
    richText: "\xAB\u041D\u0443 \u0434\u0430, \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0439
      \u0441\u0435\u043A\u0441 \u0441 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C
      \u043D\u0430\u0447\u0430\u043B\u044C\u0441\u0442\u0432\u043E\u043C. \u0412\u0435\u043B\u0438\u043A\u043E\u043B\u0435\u043F\u043D\u044B\u0439
      \u043F\u043B\u0430\u043D, \u0418\u041C\u042F. \xAB\u041D\u0430\u0434\u0435\u0436\u043D\u0435\u0435
      \u0448\u0432\u0435\u0439\u0446\u0430\u0440\u0441\u043A\u0438\u0445 \u0447\u0430\u0441\u043E\u0432!\xBB"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 17
    richText: "\xAB\u0422\u0430\u043A, \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E.
      \u042D\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u0433\u043B\u0443\u043F\u0430\u044F
      \u0444\u0430\u043D\u0442\u0430\u0437\u0438\u044F, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
      \u043D\u0435 \u0434\u043E\u043B\u0436\u043D\u0430 \u0431\u044B\u0442\u044C
      \u0442\u0430\u043A\u043E\u0439 \u044F\u0440\u043A\u043E\u0439\u2026\xBB"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E
      \u0441\u043C\u0443\u0449\u0430\u0435\u0442\u0441\u044F: \u0449\u0451\u043A\u0438
      \u0433\u043E\u0440\u044F\u0442, \u043D\u043E \u0412\u043B\u0430\u0434 , \u0435\u0441\u043B\u0438
      \u0438 \u0437\u0430\u043C\u0435\u0442\u0438\u0442, \u043D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430
      \u0440\u0435\u0448\u0438\u0442, \u0447\u0442\u043E \u044D\u0442\u043E \u043E\u0442
      \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 9
    richText: "\xAB\u0418\u043D\u043E\u0433\u0434\u0430 \u044F \u043C\u0435\u0447\u0442\u0430\u044E,
      \u0447\u0442\u043E\u0431\u044B \u043B\u044E\u0434\u0438 \u0441\u0442\u0430\u043B\u0438
      \u0442\u0435\u043B\u0435\u043F\u0430\u0442\u0430\u043C\u0438. \u0425\u043E\u0440\u043E\u0448\u043E,
      \u0447\u0442\u043E \u043C\u043E\u0438 \u043C\u0435\u0447\u0442\u044B \u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F
      \u0442\u043E\u043B\u044C\u043A\u043E \u043C\u0435\u0447\u0442\u0430\u043C\u0438\u2026\xBB"
    style: {fileID: 0}
    authorComment: 
--- !u!114 &7543062631831508271
