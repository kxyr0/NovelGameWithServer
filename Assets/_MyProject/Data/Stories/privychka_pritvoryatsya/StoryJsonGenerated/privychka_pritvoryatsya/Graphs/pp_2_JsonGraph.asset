  guid: pp2_branch_escape_principles_001
  nodeTitle: 
  activeCharacters: []
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u0442\u0449\u0435\u0442\u043D\u043E\u0441\u0442\u044C
      \u0435\u0451 \u043F\u043E\u043F\u044B\u0442\u043E\u043A, \u043E\u043D\u0430
      \u043F\u044B\u0445\u0442\u0438\u0442, \u0443\u043F\u043E\u0440\u043D\u043E
      \u043F\u044B\u0442\u0430\u044F\u0441\u044C \u0432\u044B\u0441\u0432\u043E\u0431\u043E\u0434\u0438\u0442\u044C\u0441\u044F,
      \u043D\u043E \u0432 \u043A\u043E\u043D\u0446\u0435 \u043A\u043E\u043D\u0446\u043E\u0432
      \u043F\u0440\u043E\u0441\u0438\u0442 \u043F\u0435\u0440\u0435\u0434\u044B\u0448\u043A\u0443."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u042D\u0442\u043E \u0431\u0435\u0441\u0438\u0442."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u0435\u0442, \u043D\u0435 \u0442\u043E, \u0447\u0442\u043E
      \u0443 \u043D\u0435\u0451 \u043D\u0435 \u0432\u044B\u0445\u043E\u0434\u0438\u0442
      - \u0430 \u0442\u043E, \u0447\u0442\u043E \u043D\u0435 \u0432\u044B\u0445\u043E\u0434\u0438\u0442
      \u043F\u0440\u044F\u043C\u043E \u0443 \u043D\u0435\u0433\u043E \u043D\u0430
      \u0433\u043B\u0430\u0437\u0430\u0445."
    style: {fileID: 0}
    authorComment: 
