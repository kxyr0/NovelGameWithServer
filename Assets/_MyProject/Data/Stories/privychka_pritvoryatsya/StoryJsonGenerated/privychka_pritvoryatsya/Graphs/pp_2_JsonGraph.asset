  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: pp2_dialogue_training_extended_principles_001
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 9
    richText: "\xAB\u0412 \u0444\u0438\u043B\u044C\u043C\u0430\u0445 \u0442\u0430\u043A\u0438\u0435
      \u043C\u043E\u043C\u0435\u043D\u0442\u044B - \u044F\u0440\u043A\u0430\u044F
      \u043F\u0440\u0435\u0434\u043F\u043E\u0441\u044B\u043B\u043A\u0430 \u043A \u043D\u0430\u0447\u0430\u043B\u0443
      \u0441\u043B\u0443\u0436\u0435\u0431\u043D\u043E\u0433\u043E \u0440\u043E\u043C\u0430\u043D\u0430.
      \u0410 \u043E\u043D\u0438 \u0434\u043E \u0434\u043E\u0431\u0440\u0430 \u043D\u0435
      \u0434\u043E\u0432\u043E\u0434\u044F\u0442\u2026\xBB"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 9
    richText: "\xAB\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u044D\u0442\u043E
      \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u0435.
      \u0421\u043B\u0438\u0448\u043A\u043E\u043C \u0434\u043E\u043B\u0433\u0438\u0435
      \u0432\u0437\u0433\u043B\u044F\u0434\u044B. \u0421\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0435
      \u043F\u0440\u0438\u043A\u043E\u0441\u043D\u043E\u0432\u0435\u043D\u0438\u044F.\xBB"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 12
    richText: "\xAB\u0410 \u043F\u043E\u0442\u043E\u043C \u0442\u044B \u0432\u0434\u0440\u0443\u0433
      \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0448\u044C \u0434\u0443\u043C\u0430\u0442\u044C
      \u043E \u0442\u043E\u043C, \u043A\u0430\u043A \u043E\u043D \u0434\u0435\u0440\u0436\u0438\u0442
      \u0442\u0435\u0431\u044F \u0437\u0430 \u0431\u0451\u0434\u0440\u0430, \u0432\u0436\u0438\u043C\u0430\u044F
      \u0432\u0441\u0435\u043C \u0442\u0435\u043B\u043E\u043C \u0432 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0443\u044E
      \u0441\u0442\u0435\u043D\u043A\u0443\u2026 \u0438 \u043F\u0440\u043E\u0447\u0438\u0445
      \u0432\u0435\u0449\u0430\u0445, \u043E \u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0435 \u0434\u0443\u043C\u0430\u0442\u044C
      \u0442\u043E\u0447\u043D\u043E \u043D\u0435 \u0441\u0442\u043E\u0438\u0442.\xBB"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 12
    richText: "\xAB\u0412\u043E\u0442 \u0434\u0443\u0440\u0430\u2026\xBB"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 9
    richText: "\xAB\u041C\u044D\u0433 \u043F\u0440\u0430\u0432\u0430, \u043A\u043E\u043D\u0435\u0447\u043D\u043E,
      \u043C\u043D\u0435 \u043D\u0435 \u043F\u043E\u043C\u0435\u0448\u0430\u0435\u0442
      \u0440\u0430\u0437\u0440\u044F\u0434\u043A\u0430\u2026\xBB"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 30
    richText: "\xAB\u0422\u0430\u043A, \u0445\u0432\u0430\u0442\u0438\u0442 \u043E\u0431
      \u044D\u0442\u043E\u043C \u0434\u0443\u043C\u0430\u0442\u044C!\xBB"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u043F\u0440\u0438\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u044D\u0442\u043E \u0441\u0435\u0431\u0435 \u0442\u0430\u043A, \u0431\u0443\u0434\u0442\u043E
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043C\u043E\u0436\u0435\u0442 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0444\u0438\u0437\u0438\u043A\u0443 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
      \u0442\u0435\u043B\u0430. \u0427\u0430\u0441\u0442\u043E \u043C\u043E\u0440\u0433\u0430\u0435\u0442,
      \u0441\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u044F \u0442\u0440\u0435\u043A\u043B\u044F\u0442\u043E\u0435
      \u043D\u0430\u0432\u0430\u0436\u0434\u0435\u043D\u0438\u0435."
    style: {fileID: 0}
    authorComment: 
