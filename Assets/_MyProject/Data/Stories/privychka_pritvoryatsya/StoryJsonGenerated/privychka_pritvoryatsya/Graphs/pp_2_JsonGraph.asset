  lines:
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 9
    richText: "\xAB\u0418 \u0420\u0435\u043C\u0438, \u0438 \u041C\u044D\u0433 \u0432\u0437\u0440\u043E\u0441\u043B\u044B\u0435
      \u043B\u044E\u0434\u0438. \u041E\u043D\u0438 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u044B
      \u0441\u0430\u043C\u0438 \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
      \u0432 \u0441\u0432\u043E\u0435\u0439 \u043B\u0438\u0447\u043D\u043E\u0439
      \u0436\u0438\u0437\u043D\u0438, \u0430 \u044F \u043D\u0435 \u0445\u043E\u0447\u0443
      \u0431\u044B\u0442\u044C \u0441\u0432\u043E\u0434\u043D\u0438\u0446\u0435\u0439
      \u0438, \u0432 \u0441\u043B\u0443\u0447\u0430\u0435 \u0447\u0435\u0433\u043E,
      \u043E\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F \u0432\u0438\u043D\u043E\u0432\u0430\u0442\u043E\u0439,
      \u0447\u0442\u043E \u0447\u044C\u0451-\u0442\u043E \u0441\u0435\u0440\u0434\u0446\u0435
      \u0440\u0430\u0437\u0431\u0438\u0442\u043E\u2026\xBB"
    style: {fileID: 0}
    authorComment: 
