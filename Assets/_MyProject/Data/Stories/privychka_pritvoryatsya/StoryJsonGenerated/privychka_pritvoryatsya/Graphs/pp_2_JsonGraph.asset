  guid: pp2_dialogue_vlad_relationship_corridor_001
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0425\u043E\u0442\u044F \u043F\u043E\u0440\u043E\u0439 \u0418\u041C\u042F
      \u043B\u043E\u0432\u0438\u0442 \u0441\u0435\u0431\u044F \u043D\u0430 \u043C\u044B\u0441\u043B\u0438,
      \u0447\u0442\u043E \u0435\u0439 \u043E\u0447\u0435\u043D\u044C \u0445\u043E\u0447\u0435\u0442\u0441\u044F
      \u0442\u0443\u0434\u0430 \u0437\u0430\u043B\u0435\u0437\u0442\u044C \u0438
      \u0443\u0437\u043D\u0430\u0442\u044C, \u0447\u0442\u043E \u043E\u043D \u043D\u0430
      \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435 \u043E \u043D\u0435\u0439
      \u0434\u0443\u043C\u0430\u0435\u0442: \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0430\u0435\u0442
      \u043B\u0438 \u043E\u043D\u0430 \u0435\u0433\u043E \u043D\u0430 \u0441\u0430\u043C\u043E\u043C
      \u0434\u0435\u043B\u0435 \u0442\u0430\u043A, \u043A\u0430\u043A \u043E\u043D
      \u043E\u0431 \u044D\u0442\u043E\u043C \u0433\u043E\u0432\u043E\u0440\u0438\u0442?
      \u0418\u043B\u0438 \u0436\u0435 \u043E\u043D \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E
      \u043A \u043D\u0435\u0439 \u0440\u0430\u0432\u043D\u043E\u0434\u0443\u0448\u0435\u043D?"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u041C\u042F \u043D\u0435 \u0437\u043D\u0430\u0435\u0442, \u0447\u0442\u043E
      \u043E\u0431\u0438\u0434\u0435\u043B\u043E \u0431\u044B \u0435\u0451 \u0431\u043E\u043B\u044C\u0448\u0435.
      \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435 \u0440\u0430\u0432\u043D\u043E\u0434\u0443\u0448\u0438\u0435,
      \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u043B\u044E\u0431\u0430\u044F
      \u044D\u043C\u043E\u0446\u0438\u044F, \u0431\u0443\u0434\u044C \u0442\u043E
      \u043B\u044E\u0431\u043E\u0432\u044C \u0438\u043B\u0438 \u043D\u0435\u043D\u0430\u0432\u0438\u0441\u0442\u044C,
      \u043B\u0443\u0447\u0448\u0435 \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0433\u043E
      \u0431\u0435\u0437\u0440\u0430\u0437\u043B\u0438\u0447\u0438\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u0430 \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435,
      \u043E\u043D\u0430 \u0432\u043E\u043E\u0431\u0449\u0435 \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442,
      \u043F\u043E\u0447\u0435\u043C\u0443 \u043E\u0431 \u044D\u0442\u043E\u043C
      \u0434\u0443\u043C\u0430\u0435\u0442."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 9
    richText: "\xAB\u041D\u0443\u0436\u043D\u043E \u044D\u0442\u043E \u043F\u0440\u0435\u043A\u0440\u0430\u0449\u0430\u0442\u044C\u2026\xBB"
    style: {fileID: 0}
    authorComment: 
