    richText: "\xAB\u0418 \u044D\u0442\u043E \u0443\u0436\u0435 \u043D\u0435 \u0436\u0435\u043B\u0430\u043D\u0438\u0435
      \u043A\u043E\u043C\u0443-\u0442\u043E \u0447\u0442\u043E-\u0442\u043E \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u044C.
