  guid: pp2_dialogue_gym_intro_001
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u0440\u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442 \u0435\u0451
      \u0432\u043F\u0435\u0440\u0451\u0434, \u0430 \u0443\u0436\u0435 \u043F\u043E\u0441\u043B\u0435
      \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u0441\u0430\u043C. \u041E\u043D\u0430
      \u043A\u043E\u0441\u0438\u0442\u0441\u044F \u043D\u0430 \u043D\u0435\u0433\u043E
      \u0443\u0434\u0438\u0432\u043B\u0435\u043D\u043D\u043E."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 13
    richText: "\xAB\u041D\u0443 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435,
      \u043A\u0430\u043A\u043E\u0432 \u0434\u0436\u0435\u043D\u0442\u043B\u044C\u043C\u0435\u043D!\xBB"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041A\u0430\u043A \u0431\u044B \u0442\u0430\u043C \u043D\u0438 \u0431\u044B\u043B\u043E,
      \u0432\u0441\u043B\u0443\u0445 \u043E\u043D\u0430 \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 - \u0432\u043C\u0435\u0441\u0442\u043E
      \u044D\u0442\u043E\u0433\u043E \u0443\u0445\u043E\u0434\u0438\u0442 \u0440\u0430\u0437\u043C\u0438\u043D\u0430\u0442\u044C\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u043F\u043E\u0440\u0442\u0438\u0432\u043D\u044B\u0439 \u0437\u0430\u043B
      \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0438 \u0442\u0451\u043F\u043B\u044B\u0439
      - \u043F\u0440\u043E\u0433\u0440\u0435\u043B\u0441\u044F \u043A \u0432\u0435\u0447\u0435\u0440\u0443
      \u0442\u0430\u043A, \u0447\u0442\u043E \u0441\u0442\u0430\u043B\u043E \u0434\u0430\u0436\u0435
      \u0434\u0443\u0448\u043D\u043E."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u0430\u0445\u043D\u0435\u0442 \u043F\u044B\u043B\u044C\u044E,
      \u043F\u043E\u0442\u043E\u043C \u0438 \u0440\u0435\u0437\u0438\u043D\u043E\u0439.
      \u041F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u043D\u0435\u043D\u0430\u0434\u043E\u043B\u0433\u043E
      \u043F\u043E\u0434\u043D\u044F\u0442\u044C \u0444\u0440\u0430\u043C\u0443\u0433\u0443
      \u043E\u043A\u043D\u0430 - \u043B\u0438\u0446\u043E \u0441\u0440\u0430\u0437\u0443
      \u043E\u0431\u0434\u0430\u0451\u0442 \u0441\u0432\u0435\u0436\u0435\u0441\u0442\u044C\u044E,
      \u043E\u0441\u0435\u043D\u043D\u0435\u0439 \u0441\u044B\u0440\u043E\u0441\u0442\u044C\u044E,
      \u043F\u0440\u043E\u0433\u043E\u043D\u044F\u044F, \u043F\u0443\u0441\u0442\u044C
      \u0438 \u043D\u0430 \u0432\u0440\u0435\u043C\u044F, \u0441\u0435\u0440\u0443\u044E
      \u043F\u0435\u0447\u0430\u043B\u044C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u0430\u043A\u0440\u0430\u043F\u044B\u0432\u0430\u0435\u0442
      \u043C\u0435\u043B\u043A\u0438\u0439 \u0434\u043E\u0436\u0434\u044C, \u0438
      \u0432 \u043F\u043E\u043F\u044B\u0442\u043A\u0430\u0445 \u043E\u0433\u043E\u043B\u0438\u0442\u044C
      \u0438 \u0431\u0435\u0437 \u0442\u043E\u0433\u043E \u0431\u0435\u0437\u043B\u0438\u0441\u0442\u043D\u044B\u0435
      \u0434\u0435\u0440\u0435\u0432\u044C\u044F \u0448\u0435\u043B\u0435\u0441\u0442\u0438\u0442
      \u0432\u0435\u0442\u0435\u0440."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0420\u0430\u0437\u043C\u0438\u043D\u0430\u0435\u0442\u0441\u044F
      \u0418\u041C\u042F \u043F\u043E \u043F\u0440\u0438\u0432\u044B\u0447\u043A\u0435
      \u0442\u0449\u0430\u0442\u0435\u043B\u044C\u043D\u043E, \u043D\u0435 \u043F\u044B\u0442\u0430\u044F\u0441\u044C
      \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u0441\u0435\u0431\u044F \xAB\u043A\u0440\u0430\u0441\u0438\u0432\u043E\xBB.
      \u041E\u043D\u0430 \u0441\u043E\u0441\u0440\u0435\u0434\u043E\u0442\u043E\u0447\u0435\u043D\u0430
      - \u043D\u0430 \u043B\u0438\u0446\u0435 \u043D\u0438 \u043D\u0430\u043C\u0451\u043A\u0430
      \u043D\u0430 \u0443\u043B\u044B\u0431\u043A\u0443."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u0434\u043E\u0445 - \u0435\u0451 \u0433\u0440\u0443\u0434\u044C
      \u0432\u0437\u0434\u044B\u043C\u0430\u0435\u0442\u0441\u044F, \u043A\u043E\u0433\u0434\u0430
      \u043B\u0451\u0433\u043A\u0438\u0435 \u043D\u0430\u0441\u044B\u0449\u0430\u044E\u0442\u0441\u044F
      \u043A\u0438\u0441\u043B\u043E\u0440\u043E\u0434\u043E\u043C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u044B\u0434\u043E\u0445 - \u043F\u043B\u0430\u0432\u043D\u043E
      \u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u0442\u0440\u043E\u0439\u043D\u044B\u0435 \u043D\u043E\u0433\u0438
      \u043D\u0430\u043F\u0440\u044F\u0433\u0430\u044E\u0442\u0441\u044F \u043E\u0442
      \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0439, \u043E\u0442 \u0447\u0435\u0433\u043E
      \u043D\u0430 \u043D\u0438\u0445 \u043F\u0440\u043E\u0441\u0442\u0443\u043F\u0430\u044E\u0442
      \u0447\u0435\u0442\u043A\u043E \u043E\u0447\u0435\u0440\u0447\u0435\u043D\u043D\u044B\u0435
      \u043C\u044B\u0448\u0446\u044B."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u0435\u043F\u043E\u0441\u043B\u0443\u0448\u043D\u0430\u044F
      \u043F\u0440\u044F\u0434\u043A\u0430 \u0432\u043E\u043B\u043E\u0441, \u0432\u044B\u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0443\u0432\u0448\u0430\u044F
      \u0438\u0437 \u0445\u0432\u043E\u0441\u0442\u0430, \u0441\u043F\u0430\u0434\u0430\u0435\u0442
      \u043D\u0430 \u043B\u043E\u0431 - \u043E\u043D\u0430 \u0441\u0434\u0443\u0432\u0430\u0435\u0442
      \u0435\u0451 \u0438\u0437\u044F\u0449\u043D\u044B\u043C \u0436\u0435\u0441\u0442\u043E\u043C
      \u0438 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F \u0437\u0430
      \u0440\u0430\u0441\u0442\u044F\u0436\u043A\u0443."
    style: {fileID: 0}
    authorComment: 
