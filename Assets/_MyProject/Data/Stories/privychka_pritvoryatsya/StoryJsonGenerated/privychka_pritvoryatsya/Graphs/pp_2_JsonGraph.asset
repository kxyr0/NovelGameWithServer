  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: pp2_dialogue_cabinet_intro_001
  nodeTitle: 
  activeCharacters: []
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0437\u0430\u0445\u043E\u0434\u0438\u0442 \u0432
      \u043A\u0430\u0431\u0438\u043D\u0435\u0442, \u0441\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442
      \u043F\u0430\u043B\u044C\u0442\u043E, \u0441\u0442\u0430\u0432\u0438\u0442
      \u0441\u0442\u0430\u043A\u0430\u043D\u0447\u0438\u043A \u0438\u0437 \u043C\u0435\u0441\u0442\u043D\u043E\u0439
      \u043A\u043E\u0444\u0435\u0439\u043D\u0438 \u043D\u0430 \u0441\u0432\u043E\u0439
      \u0441\u0442\u043E\u043B. \u0422\u0430\u043C \u043B\u0435\u0436\u0438\u0442
      \u0435\u0451 \u0431\u043B\u043E\u043A\u043D\u043E\u0442 \u0441\u043E \u0441\u0442\u0438\u043A\u0435\u0440\u0430\u043C\u0438
      \u043D\u0430 \u043E\u0431\u043B\u043E\u0436\u043A\u0435, \u0437\u0430\u0431\u044B\u0442\u044B\u0435
      \u0435\u044E \u0432\u0447\u0435\u0440\u0430 \u043E\u0447\u043A\u0438 \u0441
      \u0437\u043E\u043B\u043E\u0442\u044B\u043C\u0438 \u0434\u0443\u0436\u043A\u0430\u043C\u0438\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u041C\u042F \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E
      \u0437\u0434\u0435\u0441\u044C \u043E\u0431\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044F,
      \u0438 \u043A\u0430\u0431\u0438\u043D\u0435\u0442 \u043F\u043E\u0442\u0438\u0445\u043E\u043D\u044C\u043A\u0443
      \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0432\u0441\u0435
      \u0431\u043E\u043B\u0435\u0435 \u0443\u044E\u0442\u043D\u044B\u043C, \u0445\u043E\u0442\u044F
      \u0432 \u043D\u0451\u043C \u0432\u0441\u0435 \u0435\u0449\u0451 \u0438 \u043F\u0430\u0445\u043D\u0435\u0442
      \u0441\u0442\u0430\u0440\u043E\u0439 \u0431\u0443\u043C\u0430\u0433\u043E\u0439
      \u0438 - \u0440\u0435\u0437\u043A\u043E, \u0445\u0438\u043C\u0438\u0447\u0435\u0441\u043A\u0438
      - \u043C\u043E\u044E\u0449\u0438\u043C \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043E\u043C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0441\u0430\u0434\u0438\u0442\u0441\u044F \u0437\u0430
      \u0441\u0442\u043E\u043B, \u0447\u0442\u043E\u0431\u044B \u0432\u043D\u043E\u0432\u044C
      \u0432\u0437\u044F\u0442\u044C\u0441\u044F \u0437\u0430 \u0438\u0437\u0443\u0447\u0435\u043D\u0438\u0435
      \u0442\u043E\u0433\u043E \u0441\u0430\u043C\u043E\u0433\u043E \u0434\u0435\u043B\u0430,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0432\u043E\u0442 \u0443\u0436\u0435
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0434\u043D\u0435\u0439
      \u043D\u0435 \u0434\u0430\u0451\u0442 \u0435\u0439 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E
      \u0441\u043F\u0430\u0442\u044C."
    style: {fileID: 0}
    authorComment: 
