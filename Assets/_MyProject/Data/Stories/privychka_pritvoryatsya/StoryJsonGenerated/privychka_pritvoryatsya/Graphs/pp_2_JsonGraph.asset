  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: pp2_dialogue_entrance_intro_001
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: cf6c9294272a0684ba26784225cd9bbb, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: pp_james
  - character: {fileID: 11400000, guid: fa16c1a4b90070c4284eaa47c97763f0, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: pp_kurt
  - character: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: pp_vlad
  lines:
  - speaker: {fileID: 11400000, guid: cf6c9294272a0684ba26784225cd9bbb, type: 2}
    emotion: 2
    richText: "\u041C\u043E\u0436\u0435\u0442 \u043F\u043E\u0434 \u0436\u0435\u043D\u0441\u043A\u0438\u043C
      \u0432\u043B\u0438\u044F\u043D\u0438\u0435\u043C \u0442\u044B \u0441\u0434\u0435\u043B\u0430\u0435\u0448\u044C\u0441\u044F
      \u043C\u044F\u0433\u0447\u0435!"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u043B\u0430\u0434 \u043A\u0440\u0438\u0432\u043E \u0443\u0445\u043C\u044B\u043B\u044F\u0435\u0442\u0441\u044F,
      \u043E\u0442\u0432\u0435\u0447\u0430\u044F \u043D\u0430\u0447\u0430\u043B\u044C\u0441\u0442\u0432\u0443
      \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u044B\u043C \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u0435\u043C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: fa16c1a4b90070c4284eaa47c97763f0, type: 2}
    emotion: 2
    richText: "\u0422\u044B \u043A\u043E\u0433\u0434\u0430 \u0441\u043A\u0430\u043B\u0438\u0448\u044C\u0441\u044F,
      \u043D\u0430 \u0420\u0438\u0447\u0438 \u043F\u043E\u0445\u043E\u0436!"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u0441\u043C\u0435\u0451\u0442\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u043B\u0443\u0447\u0430\u0439\u043D\u043E \u0432\u044B\u0445\u0432\u0430\u0442\u0438\u0432
      \u043A\u0440\u0430\u0435\u043C \u0443\u0445\u043E\u043C \u043E\u0431\u0440\u044B\u0432\u043A\u0438
      \u0447\u0443\u0436\u043E\u0433\u043E \u0434\u0438\u0430\u043B\u043E\u0433\u0430,
      \u0418\u041C\u042F \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u043F\u0440\u043E\u043F\u0443\u0441\u043A \u043A \u0432\u0430\u043B\u0438\u0434\u0430\u0442\u043E\u0440\u0443
      \u0438 \u0434\u0443\u043C\u0430\u0435\u0442: \u0430 \u0431\u044B\u0432\u0430\u0435\u0442
      \u043B\u0438 \u0442\u043E\u0442 \u0432\u043E\u043E\u0431\u0449\u0435 \u043A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C
      \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u044B\u043C? \u0417\u0430 \u0442\u0440\u0438
      \u0434\u043D\u044F \u0440\u0430\u0431\u043E\u0442\u044B \u0437\u0434\u0435\u0441\u044C
      \u0442\u0430\u043A\u043E\u0432\u044B\u043C \u043E\u043D\u0430 \u0435\u0433\u043E
      \u043D\u0438 \u0440\u0430\u0437\u0443 \u043D\u0435 \u0432\u0438\u0434\u0435\u043B\u0430."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 2
    richText: "\u0422\u044B \u0442\u043E\u043B\u044C\u043A\u043E \u0447\u0442\u043E
      \u0441\u0440\u0430\u0432\u043D\u0438\u043B \u043C\u0435\u043D\u044F \u0441
      \u043F\u0441\u043E\u043C?"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u0437\u0432\u0443\u0447\u0438\u0442 \u043D\u0430\u0438\u0433\u0440\u0430\u043D\u043D\u043E
      \u043E\u0431\u0438\u0436\u0435\u043D\u043D\u043E, \u043D\u043E \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E
      \u0442\u0430\u043A\u043E\u0432\u044B\u043C \u043D\u0435 \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442.
      \u041D\u0430\u043F\u0440\u043E\u0442\u0438\u0432, \u0432 \u0433\u043B\u0430\u0437\u0430\u0445
      \u0443 \u043D\u0435\u0433\u043E \u043F\u043B\u044F\u0448\u0443\u0442 \u0441\u043C\u0435\u0448\u0438\u043D\u043A\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u041C\u042F \u0443\u0441\u043C\u0435\u0445\u0430\u0435\u0442\u0441\u044F
      \u043F\u0440\u043E \u0441\u0435\u0431\u044F, \u043D\u0435 \u0436\u0435\u043B\u0430\u044F
      \u0432\u044B\u0434\u0430\u0432\u0430\u0442\u044C \u0442\u043E\u0442 \u0444\u0430\u043A\u0442,
      \u0447\u0442\u043E \u0442\u0430\u043A \u043D\u0430\u0433\u043B\u043E, \u0438\u0441\u043F\u043E\u0434\u0442\u0438\u0448\u043A\u0430,
      \u043F\u043E\u0434\u0441\u043B\u0443\u0448\u0438\u0432\u0430\u0435\u0442 \u0447\u0443\u0436\u0443\u044E
      \u0431\u0435\u0441\u0435\u0434\u0443."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043B\u0438\u0448\u044C \u043D\u0430 \u043C\u0438\u043D\u0443\u0442\u0443
      - \u0438 \u0432\u043E\u0432\u0441\u0435 \u043D\u0435 \u0447\u0442\u043E\u0431\u044B
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u0441\u043B\u0443\u0448\u0430\u0442\u044C.
      \u041F\u0440\u043E\u0441\u0442\u043E \u0445\u043E\u0447\u0435\u0442 \u043F\u043E\u043F\u0440\u0430\u0432\u0438\u0442\u044C
      \u043E\u0434\u0435\u0436\u0434\u0443 \u0438 \u0440\u0430\u0441\u0442\u0440\u0435\u043F\u0430\u0432\u0448\u0443\u044E\u0441\u044F
      \u043D\u0430 \u0432\u0435\u0442\u0440\u0443 \u043F\u0440\u0438\u0447\u0435\u0441\u043A\u0443
      - \u0442\u043E\u043B\u044C\u043A\u043E \u0438 \u0432\u0441\u0435\u0433\u043E\u2026"
    style: {fileID: 0}
    authorComment: 
