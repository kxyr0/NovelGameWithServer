  guid: pp2_branch_matchmaker_good_001
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  - character: {fileID: 11400000, guid: c6da3c9ef9c7fe04e9de79dc6ed3c774, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: pp_remi
  lines:
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 2
    richText: "\u0421\u043B\u0443\u0448\u0430\u0439\u2026 \u042F \u0432\u043E\u0442
      \u0434\u0443\u043C\u0430\u044E, \u043C\u043E\u0436\u0435\u0442, \u0442\u0435\u0431\u044F
      \u0441 \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u0442\u044C \u0441
      \u043C\u043E\u0435\u0439 \u043F\u043E\u0434\u0440\u0443\u0433\u043E\u0439?
      \u041E\u043D\u0430 \u0443\u043C\u043D\u0430\u044F, \u043A\u0440\u0430\u0441\u0438\u0432\u0430\u044F\u2026
      \u041D\u0443, \u0435\u0441\u043B\u0438, \u043A\u043E\u043D\u0435\u0447\u043D\u043E,
      \u0442\u044B \u0435\u0449\u0435 \u043D\u0435 \u0443\u0441\u043F\u0435\u043B
      \u043D\u0430\u0439\u0442\u0438 \u0441\u0432\u043E\u0451 \u0441\u0447\u0430\u0441\u0442\u044C\u0435
      \u043D\u0430 \u0441\u0430\u0439\u0442\u0435 \u0437\u043D\u0430\u043A\u043E\u043C\u0441\u0442\u0432.
      \u0412 \u043A\u043E\u043D\u0446\u0435 \u043A\u043E\u043D\u0446\u043E\u0432,
      \u0437\u0430 \u043E\u0434\u0438\u043D \u0432\u0435\u0447\u0435\u0440 \u043C\u043D\u043E\u0433\u043E\u0435
      \u043C\u043E\u0433\u043B\u043E \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C\u0441\u044F\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: c6da3c9ef9c7fe04e9de79dc6ed3c774, type: 2}
    emotion: 2
    richText: "\u042D\u0442\u043E \u0442\u044B \u0442\u0430\u043A \u043C\u044F\u0433\u043A\u043E
      \u043D\u0430\u043C\u0435\u043A\u0430\u0435\u0448\u044C, \u0447\u0442\u043E
      \u044F \u0442\u0435\u0431\u0435 \u043D\u0435 \u043F\u043E\u0434\u0445\u043E\u0436\u0443?"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u0441\u043A\u043B\u043E\u043D\u044F\u0435\u0442 \u0433\u043E\u043B\u043E\u0432\u0443
      \u043D\u0430\u0431\u043E\u043A \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u0438\u0433\u0440\u0438\u0432\u043E."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u041C\u042F \u043D\u0430 \u0441\u0435\u043A\u0443\u043D\u0434\u0443
      \u0442\u0435\u0440\u044F\u0435\u0442\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 8
    richText: "\u041D\u0435\u0442, \u0432 \u0441\u043C\u044B\u0441\u043B\u0435, \u044F\u2026
      \u0422\u044B \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u0438\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: c6da3c9ef9c7fe04e9de79dc6ed3c774, type: 2}
    emotion: 2
    richText: "\u0420\u0430\u0441\u0441\u043B\u0430\u0431\u044C\u0441\u044F, \u044F
      \u043F\u043E\u0448\u0443\u0442\u0438\u043B."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u0441\u043C\u0435\u0451\u0442\u0441\u044F, \u0430 \u0418\u041C\u042F
      \u043E\u0431\u043B\u0435\u0433\u0447\u0435\u043D\u043D\u043E \u0432\u044B\u0434\u044B\u0445\u0430\u0435\u0442."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 8
    richText: "\xAB\u042F \u0438 \u043F\u0440\u0430\u0432\u0434\u0430 \u043D\u0435
      \u0445\u043E\u0442\u0435\u043B\u0430 \u0435\u0433\u043E \u043E\u0431\u0438\u0434\u0435\u0442\u044C\u2026\xBB"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 8
    richText: "\xAB\u0415\u0449\u0451 \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u043B\u043E
      \u043B\u0438\u0448\u0438\u0442\u044C\u0441\u044F \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430, \u0441 \u043A\u043E\u0442\u043E\u0440\u044B\u043C
      \u0437\u0434\u0435\u0441\u044C \u043C\u043E\u0436\u043D\u043E \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E
      \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\xBB"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: c6da3c9ef9c7fe04e9de79dc6ed3c774, type: 2}
    emotion: 2
    richText: "\u0410 \u0432\u043E\u0442 \u043E\u0442 \u0437\u043D\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u0430
      \u0441 \u043A\u0440\u0430\u0441\u0438\u0432\u043E\u0439 \u0434\u0435\u0432\u0443\u0448\u043A\u043E\u0439
      \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u043E\u0442\u043A\u0430\u0436\u0443\u0441\u044C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 2
    richText: "\u0417\u0430\u043C\u043E\u043B\u0432\u043B\u044E \u0437\u0430 \u0442\u0435\u0431\u044F
      \u0441\u043B\u043E\u0432\u0435\u0447\u043A\u043E."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: c6da3c9ef9c7fe04e9de79dc6ed3c774, type: 2}
    emotion: 2
    richText: "\u041B\u043E\u0432\u043B\u044E \u043D\u0430 \u0441\u043B\u043E\u0432\u0435."
    style: {fileID: 0}
    authorComment: 
