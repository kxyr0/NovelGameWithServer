  guid: pp2_dialogue_protocol_principles_001
  nodeTitle: 
  activeCharacters: []
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0424\u044B\u0440\u043A\u0430\u0435\u0442 \u0418\u041C\u042F, \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E
      \u043E\u0441\u043C\u0435\u043B\u0435\u0432. \u0415\u0433\u043E \u0441\u043A\u0435\u043F\u0442\u0438\u0446\u0438\u0437\u043C
      \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0430\u0442\u044C,
      \u0438 \u0432\u043E\u043E\u0431\u0449\u0435-\u0442\u043E \u0438\u0437 \u043D\u0438\u0445
      \u0434\u0432\u043E\u0438\u0445 \u043D\u0435 \u0435\u043C\u0443 \u0441\u0441\u044B\u043B\u0430\u0442\u044C\u0441\u044F
      \u043D\u0430 \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B: \u044D\u0442\u043E
      \u043D\u0435 \u0435\u0451 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C\u044E
      \u043C\u0438\u043D\u0443\u0442\u0430\u043C\u0438 \u0440\u0430\u043D\u0435\u0435
      \u043E\u0442\u0447\u0438\u0442\u044B\u0432\u0430\u043B\u0438 \u0437\u0430 \u043F\u0440\u0435\u0432\u044B\u0448\u0435\u043D\u0438\u0435
