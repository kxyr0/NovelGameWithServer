    emotion: 0
    richText: "\u0418\u041C\u042F \u043F\u0435\u0447\u0430\u0442\u0430\u0435\u0442
      \u044D\u0442\u043E \u0442\u043E\u0440\u043E\u043F\u043B\u0438\u0432\u043E,
