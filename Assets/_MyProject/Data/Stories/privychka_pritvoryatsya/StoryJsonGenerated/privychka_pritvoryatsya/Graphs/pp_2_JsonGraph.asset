  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 9
    richText: "\xAB\u041B\u0438\u0447\u043D\u0430\u044F \u0436\u0438\u0437\u043D\u044C\u2026
      \u041E\u0442 \u043D\u0435\u0451 \u043E\u0434\u043D\u0438 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B.\xBB"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 30
    richText: "\xAB\u0423\u0438\u043B\u043B \u043C\u0435\u043D\u044F \u0443\u0436\u0435
      \u0434\u043E\u0441\u0442\u0430\u043B. \u0415\u0441\u043B\u0438 \u0431\u044B
      \u043D\u0435 \u0420\u043E\u0431, \u043D\u0435 \u0437\u043D\u0430\u044E, \u0447\u0442\u043E
      \u0431\u044B \u044F \u0434\u0435\u043B\u0430\u043B\u0430\u2026\xBB"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 20
    richText: "\xAB\u042F \u0432\u0441\u0451 \u043C\u043E\u0433\u0443 \u043F\u043E\u043D\u044F\u0442\u044C,
      \u043D\u043E \u043A\u0430\u0440\u0430\u0443\u043B\u0438\u0442\u044C \u043C\u0435\u043D\u044F
      \u0432\u043E\u0437\u043B\u0435 \u0434\u043E\u043C\u0430 - \u044D\u0442\u043E
      \u0443\u0436\u0435 \u043F\u0435\u0440\u0435\u0431\u043E\u0440\u2026\xBB"
    style: {fileID: 0}
    authorComment: 
