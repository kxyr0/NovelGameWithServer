  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: pp2_after_matchmaker_choice_001
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: c6da3c9ef9c7fe04e9de79dc6ed3c774, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: pp_remi
  - character: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speaker: {fileID: 11400000, guid: c6da3c9ef9c7fe04e9de79dc6ed3c774, type: 2}
    emotion: 17
    richText: "\u041A\u0441\u0442\u0430\u0442\u0438, \u043A\u0430\u043A \u043F\u0440\u043E\u0434\u0432\u0438\u0433\u0430\u0435\u0442\u0441\u044F
      \u0442\u0432\u043E\u0451 \u0434\u0435\u043B\u043E? \u0412\u043B\u0430\u0434
      \u0442\u0435\u0431\u044F \u0441 \u043D\u0438\u043C \u043D\u0435 \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u043B?"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u041C\u042F \u043F\u043E\u0436\u0438\u043C\u0430\u0435\u0442
      \u043F\u043B\u0435\u0447\u0430\u043C\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 28
    richText: "\u0414\u0430 \u043D\u0438\u043A\u0430\u043A. \u042F \u043F\u044B\u0442\u0430\u044E\u0441\u044C
      \u043D\u0430\u0439\u0442\u0438 \u0447\u0442\u043E-\u0442\u043E \u043D\u0430
      \u043F\u0441\u0438\u0445\u043E\u043B\u043E\u0433\u0430, \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
      \u043F\u043E\u0441\u0435\u0449\u0430\u043B\u0438 \u0442\u0435 \u0434\u0435\u0432\u0443\u0448\u043A\u0438,
      \u043D\u043E \u043F\u043E\u043A\u0430 \u0447\u0442\u043E \u0432\u0441\u0435
      \u0431\u0435\u0437 \u0442\u043E\u043B\u043A\u0443 - \u043D\u0438\u0447\u0435\u0433\u043E,
      \u0437\u0430 \u0447\u0442\u043E \u043C\u043E\u0436\u043D\u043E \u0431\u044B\u043B\u043E
      \u0431\u044B \u0432\u0441\u0435\u0440\u044C\u0451\u0437 \u0437\u0430\u0446\u0435\u043F\u0438\u0442\u044C\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 9
    richText: "\u042F \u0443\u0436\u0435 \u0441\u0430\u043C\u0430 \u043D\u0430\u0447\u0438\u043D\u0430\u044E
      \u0434\u0443\u043C\u0430\u0442\u044C, \u0447\u0442\u043E \u0440\u0430\u0437\u0434\u0443\u0432\u0430\u044E
      \u0438\u0437 \u043C\u0443\u0445\u0438 \u0441\u043B\u043E\u043D\u0430"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: c6da3c9ef9c7fe04e9de79dc6ed3c774, type: 2}
    emotion: 2
    richText: "\u041F\u043E\u043A\u0430 \u0447\u0442\u043E \u043F\u043E\u0445\u043E\u0436\u0435
      \u043D\u0430 \u0442\u043E."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u0431\u0435\u0437\u0437\u0430\u0431\u043E\u0442\u043D\u043E
      \u043F\u043E\u0436\u0438\u043C\u0430\u0435\u0442 \u043F\u043B\u0435\u0447\u0430\u043C\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: c6da3c9ef9c7fe04e9de79dc6ed3c774, type: 2}
    emotion: 17
    richText: "\u041D\u043E, \u0435\u0441\u043B\u0438 \u0445\u043E\u0447\u0435\u0448\u044C,
      \u044F \u043C\u043E\u0433\u0443 \u0441\u0430\u043C \u043F\u043E\u043A\u043E\u043F\u0430\u0442\u044C\u0441\u044F.
      \u041C\u043E\u0436\u0435\u0442, \u0438 \u043D\u0430\u0439\u0434\u0435\u0442\u0441\u044F
      \u0447\u0442\u043E\u2026 \u041D\u043E \u043D\u0435 \u0445\u043E\u0447\u0443
      \u043E\u0431\u043D\u0430\u0434\u0435\u0436\u0438\u0432\u0430\u0442\u044C. \u0412\u043F\u043E\u043B\u043D\u0435
      \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E, \u044D\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E
      \u0441\u043E\u0432\u043F\u0430\u0434\u0435\u043D\u0438\u0435."
    style: {fileID: 0}
    authorComment: 
