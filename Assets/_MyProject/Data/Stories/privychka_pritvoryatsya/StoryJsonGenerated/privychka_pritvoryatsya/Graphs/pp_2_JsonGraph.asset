  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: pp2_dialogue_after_rob_call_001
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: 0134d31ffe795134da58a7dc3f8fbc02, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: pp_rob
  - character: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  - character: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: pp_vlad
  lines:
  - speaker: {fileID: 11400000, guid: 0134d31ffe795134da58a7dc3f8fbc02, type: 2}
    emotion: 0
    richText: "\u0413\u043E\u0440\u0430 \u043F\u043E\u0441\u0443\u0434\u044B \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u0442\u0432\u043E\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 20
    richText: "\u041D\u0443 \u0443\u0436 \u043D\u0435\u0442. \u0421\u0435\u0433\u043E\u0434\u043D\u044F
      \u0442\u0432\u043E\u044F \u043E\u0447\u0435\u0440\u0435\u0434\u044C! \u0422\u044B
      \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u043B \u043D\u0430 \u043F\u0440\u043E\u0448\u043B\u044B\u0445
      \u0432\u044B\u0445\u043E\u0434\u043D\u044B\u0445!"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0134d31ffe795134da58a7dc3f8fbc02, type: 2}
    emotion: 0
    richText: "\u041D\u0443 \u0431\u043B\u0438\u043D, \u044F \u0434\u0443\u043C\u0430\u043B,
      \u0442\u044B \u0437\u0430\u0431\u0443\u0434\u0435\u0448\u044C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 2
    richText: "\u0410\u0433\u0430, \u0434\u0430, \u043C\u0435\u0447\u0442\u0430\u0439
      \u0431\u043E\u043B\u044C\u0448\u0435\u2026 \u041B\u0430\u0434\u043D\u043E,
      \u0441\u043A\u043E\u0440\u043E \u0431\u0443\u0434\u0443, \u043D\u0435 \u0431\u0443\u0440\u0447\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u043B\u0430\u0434 \u0445\u043C\u0443\u0440\u0438\u0442\u0441\u044F,
      \u043A\u043E\u0432\u044B\u0440\u044F\u044F \u043D\u043E\u0441\u043A\u043E\u043C
      \u043A\u0440\u043E\u0441\u0441\u043E\u0432\u043A\u0430 \u043C\u0430\u0442 \u043D\u0430
      \u043F\u043E\u043B\u0443."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 32
    richText: "\u0414\u0430\u0432\u043D\u043E \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442\u0435\u0441\u044C?"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442 \u043E\u043D,
      \u043A\u043E\u0433\u0434\u0430 \u043E\u043D\u0430 \u0443\u0431\u0438\u0440\u0430\u0435\u0442
      \u0442\u0435\u043B\u0435\u0444\u043E\u043D \u0432 \u043A\u0430\u0440\u043C\u0430\u043D
      \u0441\u0443\u043C\u043A\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 26
    richText: "\u0421 \u043A\u0435\u043C?"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u043B\u0430\u0434 \u0434\u0451\u0440\u0433\u0430\u0435\u0442
      \u043F\u043B\u0435\u0447\u043E\u043C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 8
    richText: "\u041B\u0430\u0434\u043D\u043E, \u043D\u0435\u0432\u0430\u0436\u043D\u043E\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u041C\u042F \u0440\u0430\u0441\u0442\u0435\u0440\u044F\u043D\u043D\u043E
      \u043C\u043E\u0440\u0433\u0430\u0435\u0442."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 8
    richText: "\xAB\u042D\u0442\u043E \u0447\u0442\u043E\u2026 \u0431\u044B\u043B\u0430
      \u0440\u0435\u0432\u043D\u043E\u0441\u0442\u044C? \u041A \u0420\u043E\u0431\u0443?
      \u0418\u043B\u0438 \u044F \u043D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E
      \u0435\u0433\u043E \u043F\u043E\u043D\u044F\u043B\u0430?\xBB"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 9
    richText: "\xAB\u041D\u043E \u044F \u043E\u0431\u0435\u0449\u0430\u043B\u0430
      \u0441\u0435\u0431\u0435 \u043D\u0435 \u0434\u043E\u0434\u0443\u043C\u044B\u0432\u0430\u0442\u044C
      \u0437\u0430 \u0434\u0440\u0443\u0433\u0438\u0445. \u0418 \u0443\u0436 \u0442\u0435\u043C
      \u0431\u043E\u043B\u0435\u0435 \u043D\u0435 \u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F
      \u0438\u0445 \u0430\u043D\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u0442\u044C\xBB."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0441\u0430\u0434\u0438\u0432 \u0441\u0435\u0431\u044F, \u043E\u043D\u0430
      \u043B\u0438\u0448\u044C \u043F\u043E\u0436\u0438\u043C\u0430\u0435\u0442 \u043F\u043B\u0435\u0447\u0430\u043C\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 2
    richText: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E!"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u041C\u042F \u043B\u0435\u0433\u043A\u043E \u0442\u0440\u043E\u0433\u0430\u0435\u0442
      \u0435\u0433\u043E \u0437\u0430 \u043F\u043B\u0435\u0447\u043E."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 12
    richText: "\u041C\u043D\u0435 \u0431\u0435\u0436\u0430\u0442\u044C \u0443\u0436\u0435
      \u043D\u0430\u0434\u043E\u2026 \u041D\u0443 \u0442\u044B \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C."
    style: {fileID: 0}
    authorComment: 
