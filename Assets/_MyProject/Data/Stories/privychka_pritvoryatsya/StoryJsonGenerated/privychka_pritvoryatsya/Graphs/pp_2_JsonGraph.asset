  guid: pp2_dialogue_cafeteria_intro_001
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: c6da3c9ef9c7fe04e9de79dc6ed3c774, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: pp_remi
  - character: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0423\u0436\u0435 \u043F\u043E \u043F\u0440\u0438\u0432\u044B\u0447\u043A\u0435
      \u0418\u041C\u042F \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442 \u0441\u0442\u043E\u043B\u0438\u043A
      \u0441 \xAB\u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u044B\u043C\xBB
      \u0432\u0438\u0434\u043E\u043C \u043D\u0430 \u0441\u0442\u0435\u043D\u0443
      \u0438 \u0434\u043E\u0436\u0438\u0434\u0430\u0435\u0442\u0441\u044F, \u043A\u043E\u0433\u0434\u0430
      \u043A \u043D\u0435\u0439 \u043F\u043E\u0434\u0441\u044F\u0434\u0435\u0442
      \u0420\u0435\u043C\u0438. \u0417\u0430 \u044D\u0442\u0438 \u0434\u043D\u0438
      \u0438\u043C \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043D\u0435\u043F\u043B\u043E\u0445\u043E
      \u0441\u0434\u0440\u0443\u0436\u0438\u0442\u044C\u0441\u044F \u043D\u0430 \u043F\u043E\u0447\u0432\u0435
      \u043E\u0431\u043E\u044E\u0434\u043D\u043E\u0439 \u043E\u0442\u0447\u0443\u0436\u0434\u0435\u043D\u043D\u043E\u0441\u0442\u0438
      \u043E\u0442 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445. \u0420\u0435\u043C\u0438
      \u043A\u0430\u0436\u0435\u0442\u0441\u044F \u0445\u043E\u0440\u043E\u0448\u0438\u043C
      \u043F\u0430\u0440\u043D\u0435\u043C. \u041F\u043E \u043A\u0440\u0430\u0439\u043D\u0435\u0439
      \u043C\u0435\u0440\u0435, \u043E\u043D \u043D\u0435 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u043D\u0435\u0451 \u0441\u0432\u044B\u0441\u043E\u043A\u0430,
      \u043D\u0435 \u0437\u043E\u0432\u0451\u0442 \xAB\u0434\u0435\u0432\u0447\u043E\u043D\u043A\u043E\u0439
      \u0441 \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u043A\u0438\u043C\u0438
      \u0430\u043C\u0431\u0438\u0446\u0438\u044F\u043C\u0438\xBB \u0438 \u043D\u0435
      \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F \u0432\u043E \u0432\u0441\u0451\u043C
      \u043F\u043E\u0443\u0447\u0430\u0442\u044C. \u0423\u0436\u0435 \u0437\u0430
      \u044D\u0442\u043E\u0442 \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u0439
      \u043D\u0430\u0431\u043E\u0440 \u0418\u041C\u042F \u0433\u043E\u0442\u043E\u0432\u0430
      \u0435\u0433\u043E \u0443\u0432\u0430\u0436\u0430\u0442\u044C \u0438 \u043D\u0430\u0437\u044B\u0432\u0430\u0442\u044C
      \u0441\u0432\u043E\u0438\u043C \u0434\u043E\u0431\u0440\u044B\u043C \u043F\u0440\u0438\u044F\u0442\u0435\u043B\u0435\u043C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: c6da3c9ef9c7fe04e9de79dc6ed3c774, type: 2}
    emotion: 2
    richText: "\u041D\u0443 \u0447\u0442\u043E, \u043A\u0430\u043A\u0438\u0435 \u043F\u0435\u0440\u0432\u044B\u0435
      \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u0435\u043D\u0438\u044F \u043E\u0442
      \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u044B?"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u043E\u0442\u043F\u0438\u0432\u0430\u0435\u0442 \u0438\u0437
      \u0441\u0442\u0430\u043A\u0430\u043D\u0447\u0438\u043A\u0430 \u0441\u0432\u043E\u0439
      \u0438\u0437\u043B\u044E\u0431\u043B\u0435\u043D\u043D\u044B\u0439 \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u0438\u043C\u044B\u0439
      \u043A\u043E\u0444\u0435. \u0421\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430
      \u043D\u0435\u0451 \u0441 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043E\u043C,
      \u0431\u0443\u0434\u0442\u043E \u0431\u044B \u043E\u043D\u0430 \u043C\u043E\u0436\u0435\u0442
      \u0432\u044B\u0434\u0430\u0442\u044C \u0435\u043C\u0443 \u043A\u0430\u043A\u0443\u044E-\u0442\u043E
      \u0433\u043E\u0440\u044F\u0447\u0443\u044E \u0441\u043F\u043B\u0435\u0442\u043D\u044E."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 2
    richText: "\xAB\u041E\u043D \u0442\u043E\u0442 \u0435\u0449\u0451 \u043B\u044E\u0431\u0438\u0442\u0435\u043B\u044C
      \u043F\u0435\u0440\u0435\u043C\u044B\u0442\u044C \u0432\u0441\u0435\u043C \u043A\u043E\u0441\u0442\u043E\u0447\u043A\u0438\u2026\xBB"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 9
    richText: "\u041D\u0443, \u0447\u0442\u043E \u043C\u043E\u0433\u0443 \u0441\u043A\u0430\u0437\u0430\u0442\u044C\u2026"
    style: {fileID: 0}
    authorComment: 
