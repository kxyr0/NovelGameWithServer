  guid: pp2_branch_will_self_esteem_001
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0441 \u043F\u043E\u043B\u043C\u0438\u043D\u0443\u0442\u044B
      \u0434\u0443\u043C\u0430\u0435\u0442 \u043D\u0430\u0434 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435\u043C
      \u0438 \u0440\u0435\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0449\u0435\u043B\u043A\u0430\u0435\u0442
      \u043A\u043D\u043E\u043F\u043A\u0443 \xAB\u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C\xBB.
      \u0415\u0439 \u043D\u0435 \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u0435\u043C\u0443
      \u043D\u0438\u0447\u0435\u0433\u043E \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0442\u044C
      \u0438, \u0442\u0435\u043C \u0431\u043E\u043B\u0435\u0435, \u0434\u0430\u0432\u0430\u0442\u044C
      \u0432\u0442\u043E\u0440\u044B\u0435 \u0448\u0430\u043D\u0441\u044B."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 0
    richText: "\xAB\u041D\u0435 \u0434\u043B\u044F \u043D\u0435\u0433\u043E \u043C\u0430\u043C\u0430
      \u044F\u0433\u043E\u0434\u043A\u0443 \u0440\u0430\u0441\u0442\u0438\u043B\u0430\u2026\xBB"
    style: {fileID: 0}
