  guid: pp2_dialogue_vlad_relationship_smile_001
  nodeTitle: 
  activeCharacters: []
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u041C\u042F \u043B\u043E\u0432\u0438\u0442 \u0441\u0435\u0431\u044F
      \u043D\u0430 \u043C\u044B\u0441\u043B\u0438, \u0447\u0442\u043E \u044D\u0442\u043E
      \u043F\u0435\u0440\u0432\u044B\u0439 \u0440\u0430\u0437, \u043A\u043E\u0433\u0434\u0430
      \u043E\u043D \u0432\u043E\u043E\u0431\u0449\u0435 \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F
      \u0435\u0439 \u0442\u0430\u043A - \u0441 \u0442\u043E\u043B\u0438\u043A\u043E\u0439
      \u0442\u0435\u043F\u043B\u043E\u0442\u044B \u0438 \u0438\u0441\u043A\u0440\u0435\u043D\u043D\u043E\u0441\u0442\u0438."
    style: {fileID: 0}
    authorComment: 
