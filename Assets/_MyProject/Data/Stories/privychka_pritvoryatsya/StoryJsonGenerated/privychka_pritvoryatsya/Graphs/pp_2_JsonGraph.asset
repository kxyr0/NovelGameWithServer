  guid: pp2_dialogue_after_wardrobe_001
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: cf6c9294272a0684ba26784225cd9bbb, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: pp_james
  - character: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  - character: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: pp_vlad
  - character: {fileID: 11400000, guid: fa16c1a4b90070c4284eaa47c97763f0, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: pp_kurt
  lines:
  - speaker: {fileID: 11400000, guid: cf6c9294272a0684ba26784225cd9bbb, type: 2}
    emotion: 4
    richText: "\u0415\u0449\u0451 \u043E\u0434\u043D\u0430 \u0442\u0430\u043A\u0430\u044F
      \u0432\u044B\u0445\u043E\u0434\u043A\u0430 - \u043F\u043E\u043B\u0443\u0447\u0438\u0448\u044C
      \u043D\u043E\u0432\u0443\u044E \u0431\u043B\u0435\u0441\u0442\u044F\u0449\u0443\u044E
      \u0437\u0432\u0451\u0437\u0434\u043E\u0447\u043A\u0443 \u0438\u0437 \u0430\u043A\u0430\u0434\u0435\u043C\u0438\u0438\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 30
    richText: "\xAB\u0421\u0435\u043A\u0441\u0438\u0441\u0442\u044B\u2026\xBB"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 13
    richText: "\u0410 \u0432\u043E\u0442 \u044D\u0442\u043E \u0443\u0436\u0435 \u0441\u0442\u0440\u0430\u0448\u043D\u043E."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u0445\u043C\u044B\u043A\u0430\u0435\u0442."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u041C\u042F \u043E\u0431\u0438\u0436\u0435\u043D\u043D\u043E
      \u043F\u043E\u0434\u0436\u0438\u043C\u0430\u0435\u0442 \u0433\u0443\u0431\u044B."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: fa16c1a4b90070c4284eaa47c97763f0, type: 2}
    emotion: 9
    richText: "\u0421\u0442\u0440\u0430\u0448\u043D\u043E - \u044D\u0442\u043E \u0442\u043E,
      \u0447\u0442\u043E \u0442\u0435\u0431\u044F \u0432\u043E\u0442 \u0442\u0430\u043A
      \u0437\u0430\u043C\u044B\u043A\u0430\u0435\u0442"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 17
    richText: "\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: fa16c1a4b90070c4284eaa47c97763f0, type: 2}
    emotion: 9
    richText: "\u0422\u0435\u0431\u0435 \u0431\u044B \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u0435
      \u0441\u0431\u0440\u043E\u0441\u0438\u0442\u044C\u2026 \u041F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C,
      \u043E \u0447\u0435\u043C \u044F?"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 0d214cd18adc05a4aac632006f1bfb79, type: 2}
    emotion: 26
    richText: "\u041F\u0443\u0441\u0442\u044B\u0448\u043A\u0438 \u043D\u0430 \u043E\u0434\u043D\u0443
      \u043D\u043E\u0447\u044C? \u041E\u0441\u0442\u043E\u0447\u0435\u0440\u0442\u0435\u043B\u043E."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u043E\u0442\u043F\u0438\u0432\u0430\u0435\u0442 \u0438\u0437
      \u0431\u0443\u043C\u0430\u0436\u043D\u043E\u0433\u043E \u0441\u0442\u0430\u043A\u0430\u043D\u0447\u0438\u043A\u0430
      \u043A\u043E\u0444\u0435 \u0438 \u043C\u043E\u0440\u0449\u0438\u0442\u0441\u044F
      \u043E\u0442 \u0435\u0433\u043E \u0433\u043E\u0440\u0435\u0447\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: a7a0c5dda978fd34bbab5fe624bbf553, type: 2}
    emotion: 9
    richText: "\xAB\u0418 \u0437\u0430\u0447\u0435\u043C \u043F\u0438\u0442\u044C
      \u0442\u0430\u043A\u0443\u044E \u0431\u0443\u0440\u0434\u0443?\xBB"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: fa16c1a4b90070c4284eaa47c97763f0, type: 2}
    emotion: 2
    richText: "\u041D\u0443 \u0434\u0430, \u043D\u0443 \u0434\u0430, \u043A\u043E\u043B\u043E\u0442\u0438\u0442\u044C
      \u0433\u0440\u0443\u0448\u0443 \u043A\u0443\u0434\u0430 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u0435\u0435.
      \u0412\u043F\u0440\u043E\u0447\u0435\u043C, \u044D\u0442\u043E, \u0432\u0441\u0435
      \u0436\u0435, \u043B\u0443\u0447\u0448\u0435, \u0447\u0435\u043C \u0431\u0438\u0442\u044C
      \u0434\u0440\u0443\u0433\u0438\u0445 \u0438\u043B\u0438 \u0441\u0430\u043C\u043E\u0433\u043E
      \u0441\u0435\u0431\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u041C\u042F \u043F\u0440\u043E\u0441\u043A\u0430\u043B\u044C\u0437\u044B\u0432\u0430\u0435\u0442
      \u043C\u0438\u043C\u043E \u043D\u0438\u0445 \u043D\u0435\u0437\u0430\u043C\u0435\u0447\u0435\u043D\u043D\u043E\u0439
      \u0438 \u043E\u0441\u0442\u0430\u0432\u0448\u0443\u044E\u0441\u044F \u0447\u0430\u0441\u0442\u044C
      \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0430 \u0443\u0436\u0435 \u043D\u0435
      \u0441\u043B\u044B\u0448\u0438\u0442. \u0414\u0430 \u0438 \u0435\u0434\u0432\u0430
      \u043B\u0438 \u0435\u0451 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0443\u0435\u0442
      \u0447\u0443\u0436\u0430\u044F \u043B\u0438\u0447\u043D\u0430\u044F \u0436\u0438\u0437\u043D\u044C
      - \u0435\u0439 \u0431\u044B \u0434\u043B\u044F \u043D\u0430\u0447\u0430\u043B\u0430
      \u0432 \u0441\u0432\u043E\u0435\u0439 \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
