  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: pp2_dialogue_self_esteem_gym_001
  nodeTitle: 
  activeCharacters: []
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041A\u0440\u0430\u0435\u043C \u0433\u043B\u0430\u0437\u0430 \u043E\u043D\u0430
      \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442, \u043A\u0430\u043A \u0412\u043B\u0430\u0434
      \u0437\u0430\u0432\u0438\u0441\u0430\u0435\u0442, \u043D\u0430 \u0441\u0435\u043A\u0443\u043D\u0434\u0443
      \u043D\u0430 \u043D\u0435\u0451 \u0437\u0430\u0441\u043C\u043E\u0442\u0440\u0435\u0432\u0448\u0438\u0441\u044C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u0435\u0440\u043E\u044F\u0442\u043D\u043E, \u044D\u0442\u043E
      \u043D\u0435 \u0437\u043D\u0430\u0447\u0438\u0442 \u043D\u0438\u0447\u0435\u0433\u043E,
      \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u043B\u044E\u0434\u044F\u043C
      \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0435\u043D\u043D\u043E \u0437\u0430\u043B\u0438\u043F\u0430\u0442\u044C
      \u043D\u0430 \u0432\u0441\u0435 \u043A\u0440\u0430\u0441\u0438\u0432\u043E\u0435
      - \u0431\u0443\u0434\u044C \u0442\u043E \u0437\u0432\u0451\u0437\u0434\u043D\u043E\u0435
      \u043D\u0435\u0431\u043E \u0438\u043B\u0438 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0441\u0438\u043C\u043F\u0430\u0442\u0438\u0447\u043D\u0430\u044F \u0438 \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u0430\u044F
      \u0432 \u0441\u0435\u0431\u0435 \u0434\u0435\u0432\u0443\u0448\u043A\u0430."
    style: {fileID: 0}
    authorComment: 
