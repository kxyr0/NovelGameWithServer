  _gameName: "\u041F\u0440\u0438\u0432\u044B\u0447\u043A\u0430 \u043F\u0440\u0438\u0442\u0432\u043E\u0440\u044F\u0442\u044C\u0441\u044F"
  _genreText: "\u0414\u0440\u0430\u043C\u0430"
  _description: "\u0413\u043B\u0430\u0432\u043D\u0430\u044F \u0433\u0435\u0440\u043E\u0438\u043D\u044F
    \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442
    \u043F\u0443\u0442\u044C \u0432 \u043A\u0440\u0438\u043C\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0439
    \u043F\u0441\u0438\u0445\u043E\u043B\u043E\u0433\u0438\u0438 \u2014 \u043D\u043E
    \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u0441 \u0441\u0430\u043C\u043E\u0439
    \u0441\u043E\u0431\u043E\u0439 \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
    \u0441\u043B\u043E\u0436\u043D\u0435\u0435, \u0447\u0435\u043C \u043A\u043E\u043F\u0430\u0442\u044C\u0441\u044F
    \u0432 \u0447\u0443\u0436\u0438\u0445 \u043C\u043E\u0442\u0438\u0432\u0430\u0445\u2026"
