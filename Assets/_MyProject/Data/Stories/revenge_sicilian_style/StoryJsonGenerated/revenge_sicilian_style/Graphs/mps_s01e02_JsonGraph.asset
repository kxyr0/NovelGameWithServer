  - character: {fileID: 11400000, guid: c1aa0a96b5e41634f9a67516bdf5c696, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u0414\u0436\u0443\u0437\u0435\u043F\u043F\u0435"
  - character: {fileID: 11400000, guid: 097cc35ac53b27142b4a8e852f63fd8c, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u0422\u043E\u043D\u0438"
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0431\u0440\u0430\u0449\u0430\u044E\u0441\u044C \u043A \u043D\u0438\u043C
      \u0444\u0430\u043C\u0438\u043B\u044C\u044F\u0440\u043D\u043E \u0438, \u0441\u0442\u0430\u0440\u0430\u044F\u0441\u044C
      \u0432\u0435\u0441\u0442\u0438 \u0441\u0435\u0431\u044F \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E
      \u0438 \u043D\u0435\u043F\u0440\u0438\u043D\u0443\u0436\u0434\u0451\u043D\u043D\u043E,
      \u0443\u0437\u043D\u0430\u044E\u2026"
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\u041C\u044B \u0441 \u0432\u0430\u043C\u0438 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u043B\u0438\u0441\u044C
      \u0440\u0430\u043D\u0435\u0435. \u041D\u0430 \u043A\u043B\u0430\u0434\u0431\u0438\u0449\u0435."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 32
    richText: "\u0418 \u0442\u043E\u0433\u0434\u0430 \u0432\u044B \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u043B\u0438,
      \u0447\u0442\u043E \u0437\u043D\u0430\u0435\u0442\u0435 \u0447\u0442\u043E-\u0442\u043E
      \u043E \u043C\u043E\u0451\u043C \u043E\u0442\u0446\u0435."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041F\u0440\u0438\u0449\u0443\u0440"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 28
    richText: "\u042F \u0434\u043E\u043B\u0433\u043E \u0440\u0430\u0437\u043C\u044B\u0448\u043B\u044F\u043B\u0430,
      \u0441\u0438\u0434\u044F \u043D\u0430\u0434 \u0432\u0430\u0448\u0435\u0439
      \u0432\u0438\u0437\u0438\u0442\u043A\u043E\u0439, \u0438 \u0432\u0441\u0451-\u0442\u0430\u043A\u0438
      \u0441\u0434\u0435\u043B\u0430\u043B\u0430 \u0432\u044B\u0431\u043E\u0440."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u0437\u0433\u043B\u044F\u0434 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0414\u0436\u0443\u0437\u0435\u043F\u043F\u0435 \u043F\u0435\u0440\u0435\u0431\u0438\u0432\u0430\u0435\u0442
      \u043C\u0435\u043D\u044F, \u0443\u0445\u043C\u044B\u043B\u044F\u044F\u0441\u044C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u0414\u0436\u0443\u0437\u0435\u043F\u043F\u0435"
    speakerNameHint: "\u0414\u0436\u0443\u0437\u0435\u043F\u043F\u0435"
    speaker: {fileID: 11400000, guid: c1aa0a96b5e41634f9a67516bdf5c696, type: 2}
    emotion: 17
    richText: "\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439,
      \u0438\u043D\u0430\u0447\u0435 \u043D\u0435 \u0441\u0442\u043E\u0438\u0442
      \u0442\u0440\u0430\u0442\u0438\u0442\u044C \u043D\u0430\u0448\u0435 \u0434\u0440\u0430\u0433\u043E\u0446\u0435\u043D\u043D\u043E\u0435
      \u0432\u0440\u0435\u043C\u044F."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: "\u0414\u0436\u0443\u0437\u0435\u043F\u043F\u0435"
    speakerNameHint: "\u0414\u0436\u0443\u0437\u0435\u043F\u043F\u0435"
    speaker: {fileID: 11400000, guid: c1aa0a96b5e41634f9a67516bdf5c696, type: 2}
    emotion: 13
    richText: "\u0414\u043E\u043A\u0430\u0436\u0438\u0442\u0435, \u0447\u0442\u043E
      \u0432\u044B \u043D\u0435 \u043E\u0442\u0432\u043B\u0435\u043A\u0430\u0435\u0442\u0435
      \u043D\u0430\u0441 \u043E\u0442 \u0432\u0430\u0436\u043D\u043E\u0433\u043E
      \u0432\u0435\u0447\u0435\u0440\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0431\u044B\u043B \u0437\u0430\u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043D
      \u0438\u0437\u0434\u0430\u043B\u0435\u043A\u0430."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0415\u0445\u0438\u0434\u043D\u0430\u044F \u0443\u043B\u044B\u0431\u043A\u0430"
  - speakerId: "\u0422\u043E\u043D\u0438"
    speakerNameHint: "\u0422\u043E\u043D\u0438"
    speaker: {fileID: 11400000, guid: 097cc35ac53b27142b4a8e852f63fd8c, type: 2}
    emotion: 30
    richText: "\u0414\u0436\u0443\u0437\u0435\u043F\u043F\u0435. \u0414\u0430\u0439\u0442\u0435
      \u0434\u0430\u043C\u0435 \u0432\u044B\u0441\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041B\u0451\u0433\u043A\u043E\u0435 \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u043E"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0414\u0436\u0443\u0437\u0435\u043F\u043F\u0435 \u0437\u0430\u043C\u043E\u043B\u043A\u0430\u0435\u0442,
      \u043D\u043E \u043D\u0435 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0451\u0442
      \u0442\u0435\u0440\u0435\u0431\u0438\u0442\u044C \u0443\u0441\u044B."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043F\u043E\u043E\u0447\u0435\u0440\u0451\u0434\u043D\u043E
      \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044E \u043C\u0443\u0436\u0447\u0438\u043D.
      \u0412\u0441\u0451, \u043A\u0430\u043A \u0438 \u0442\u043E\u0433\u0434\u0430:
      \u0443 \u043E\u0434\u043D\u043E\u0433\u043E \u2014 \u0445\u043E\u043B\u043E\u0434\u043D\u0430\u044F
      \u0441\u0434\u0435\u0440\u0436\u0430\u043D\u043D\u043E\u0441\u0442\u044C, \u0443
      \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u2014 \u0432\u0441\u043F\u044B\u043B\u044C\u0447\u0438\u0432\u044B\u0439
      \u043D\u0440\u0430\u0432."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\u0412 \u043E\u0431\u0449\u0435\u043C, \u044F \u0441\u043E\u0433\u043B\u0430\u0441\u043D\u0430."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
