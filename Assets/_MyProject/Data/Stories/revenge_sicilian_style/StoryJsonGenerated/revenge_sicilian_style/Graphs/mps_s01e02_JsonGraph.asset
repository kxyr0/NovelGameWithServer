  guid: mps_s01e02_l0282_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 19
    richText: "\xAB\u0412\u0441\u0451. \u0411\u043E\u043B\u044C\u0448\u0435 \u043D\u0438
      \u043A\u0430\u043F\u043B\u0438 \u0432 \u0440\u043E\u0442\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u0437\u0433\u043B\u044F\u0434 \u0432 \u0432\u0435\u0440\u0445\u043D\u0438\u0439
      \u0443\u0433\u043E\u043B"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 19
    richText: "\xAB\u041D\u0435 \u043D\u0443\u0436\u043D\u043E \u0443\u0447\u0438\u0442\u044C\u0441\u044F
      \u0441\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C\u0441\u044F \u0441 \u0442\u0440\u0443\u0434\u043D\u043E\u0441\u0442\u044F\u043C\u0438
      \u0442\u0430\u043A\u0438\u043C \u0443\u0436\u0430\u0441\u043D\u044B\u043C \u0441\u043F\u043E\u0441\u043E\u0431\u043E\u043C\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u0437\u0433\u043B\u044F\u0434 \u0432 \u0432\u0435\u0440\u0445\u043D\u0438\u0439
      \u0443\u0433\u043E\u043B"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041A \u043C\u043E\u0435\u0439 \u043D\u043E\u0433\u0435 \u0442\u0443\u0442
      \u0436\u0435 \u043F\u0440\u0438\u043F\u0430\u0434\u0430\u0435\u0442 \u041C\u0443\u0440\u043B\u044B\u043A\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u043A\u0440\u0443\u0436\u0438\u0442\u0441\u044F \u0440\u044F\u0434\u043E\u043C,
      \u0449\u0435\u043A\u043E\u0447\u0430 \u0433\u043E\u043B\u0443\u044E \u043A\u043E\u0436\u0443
      \u043C\u044F\u0433\u043A\u043E\u0439 \u0448\u0435\u0440\u0441\u0442\u044C\u044E
      \u0438 \u043D\u0430\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u044F
      \u043E \u0441\u0432\u043E\u0451\u043C \u0437\u0430\u043A\u043E\u043D\u043D\u043E\u043C
      \u0437\u0430\u0432\u0442\u0440\u0430\u043A\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\xAB\u041F\u043E\u0439\u0434\u0451\u043C\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\xAB\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C, \u043A\u0442\u043E
      \u043A \u043D\u0430\u043C \u043B\u043E\u043C\u0438\u043B\u0441\u044F, \u0438
      \u0437\u0430\u043E\u0434\u043D\u043E \u043F\u043E\u043A\u043E\u0440\u043C\u0438\u043C
      \u0442\u0435\u0431\u044F\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043F\u0440\u0438\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u044E
      \u043D\u0435\u0434\u043E\u043F\u0438\u0442\u0443\u044E \u0431\u0443\u0442\u044B\u043B\u043A\u0443
      \u0438, \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E \u043C\u0438\u043D\u0443\u044F
      \u043B\u0430\u0431\u0438\u0440\u0438\u043D\u0442 \u0438\u0437 \u043E\u0441\u043A\u043E\u043B\u043A\u043E\u0432
      \u043D\u0430 \u043F\u043E\u043B\u0443, \u0438\u0434\u0443 \u043A \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u0435
      \u043D\u0430 \u043D\u0438\u0436\u043D\u0438\u0439 \u044D\u0442\u0430\u0436."
    style: {fileID: 0}
    authorComment: 
