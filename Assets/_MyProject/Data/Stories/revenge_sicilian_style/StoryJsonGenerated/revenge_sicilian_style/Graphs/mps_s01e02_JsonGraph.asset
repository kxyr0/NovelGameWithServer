    emotion: 0
    richText: "\u041E\u043D \u0432\u0441\u0435\u0433\u0434\u0430 \u043E\u0431\u0438\u0436\u0430\u043B\u0441\u044F:
      \u043A \u0441\u0432\u043E\u0435\u0439 \u043F\u0440\u0438\u0447\u0451\u0441\u043A\u0435
      \u043E\u043D \u043E\u0442\u043D\u043E\u0441\u0438\u043B\u0441\u044F \u0441
      \u043F\u043E\u0447\u0442\u0438 \u0431\u043E\u043B\u0435\u0437\u043D\u0435\u043D\u043D\u044B\u043C
      \u0442\u0440\u0435\u043F\u0435\u0442\u043E\u043C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0434\u043D\u0430\u043A\u043E \u0431\u044B\u0441\u0442\u0440\u043E
      \u043E\u0442\u0445\u043E\u0434\u0438\u043B, \u0443\u0433\u0440\u043E\u0436\u0430\u044F
      \u043E\u0442\u0440\u0435\u0437\u0430\u0442\u044C \u043D\u043E\u0436\u043D\u0438\u0446\u0430\u043C\u0438
      \u043E\u0434\u043D\u0443 \u0438\u0437 \u043C\u043E\u0438\u0445 \u043A\u043E\u0441."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043B\u0438\u0448\u044C \u0434\u0435\u043B\u0430\u043B\u0430
      \u0432\u0438\u0434, \u0447\u0442\u043E \u043C\u043D\u0435 \u0431\u044B\u043B\u043E
      \u0441\u0442\u0440\u0430\u0448\u043D\u043E, \u0434\u0443\u0440\u0430\u0447\u0430\u0441\u044C
      \u0438 \u0443\u0431\u0435\u0433\u0430\u044F, \u043E\u0434\u043D\u0430\u043A\u043E
      \u0432\u0437\u044A\u0435\u0440\u043E\u0448\u0438\u0432\u0430\u0442\u044C \u0435\u0433\u043E
      \u043D\u0435 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412 \u043A\u043E\u043D\u0446\u0435 \u043A\u043E\u043D\u0446\u043E\u0432
      \u041B\u0443\u043A\u0430 \u0442\u0430\u043A \u0438 \u043D\u0435 \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u043B
      \u0443\u0433\u0440\u043E\u0437\u0443. \u041D\u043E \u043A\u0440\u044B\u0441\u0443
      \u0432 \u043C\u043E\u044E \u043B\u044E\u0431\u0438\u043C\u0443\u044E \u0441\u0443\u043C\u043E\u0447\u043A\u0443
      \u043F\u043E\u043B\u043E\u0436\u0438\u043B."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041C\u0435\u0441\u0442\u044C \u0443 \u043D\u0435\u0433\u043E \u0442\u0430\u043A\u0430\u044F
      \u0431\u044B\u043B\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u0442\u043E\u0433\u0434\u0430 \u043E\u0447\u0435\u043D\u044C
      \u0441\u0438\u043B\u044C\u043D\u043E \u043A\u0440\u0438\u0447\u0430\u043B\u0430
      \u0438 \u0432 \u0438\u0442\u043E\u0433\u0435 \u0432\u0437\u0431\u0435\u0441\u0438\u043B\u0430\u0441\u044C,
      \u043D\u0430\u0434\u0430\u0432\u0430\u0432 \u0435\u043C\u0443 \u043F\u0438\u043D\u043A\u043E\u0432
      \u043F\u043E\u0434 \u0437\u0430\u0434 \u044D\u0442\u043E\u0439 \u0436\u0435
      \u0441\u0443\u043C\u043A\u043E\u0439."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u043E\u0442\u043E\u043C \u043C\u044B, \u043A\u043E\u043D\u0435\u0447\u043D\u043E,
      \u043F\u043E\u043C\u0438\u0440\u0438\u043B\u0438\u0441\u044C, \u043B\u0435\u0436\u0430\u043B\u0438
      \u043D\u0430 \u0437\u0435\u043C\u043B\u0435 \u0438 \u0441\u0447\u0438\u0442\u0430\u043B\u0438
      \u0437\u0432\u0451\u0437\u0434\u044B. \u0422\u0430\u043A \u043C\u044B \u0434\u0435\u043B\u0430\u043B\u0438
      \u0447\u0430\u0441\u0442\u043E, \u043F\u043E\u043A\u0430\u2026 \u043F\u043E\u043A\u0430
      \u043E\u043D \u0441 \u0441\u0435\u043C\u044C\u0451\u0439 \u043D\u0435 \u043F\u0435\u0440\u0435\u0435\u0445\u0430\u043B\u0438
      \u0432 \u0434\u0440\u0443\u0433\u043E\u0439 \u0433\u043E\u0440\u043E\u0434."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 19
    richText: "\xAB\u0422\u043E\u0433\u0434\u0430 \u044F \u043E\u0447\u0435\u043D\u044C
      \u0441\u0438\u043B\u044C\u043D\u043E \u0440\u0430\u0441\u0441\u0442\u0440\u043E\u0438\u043B\u0430\u0441\u044C\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u0437\u0433\u043B\u044F\u0434 \u0432 \u0432\u0435\u0440\u0445\u043D\u0438\u0439
      \u0443\u0433\u043E\u043B"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 3
    richText: "\xAB\u0425\u043E\u0442\u0435\u043B\u0430 \u0437\u0430\u043F\u0440\u044B\u0433\u043D\u0443\u0442\u044C
      \u0432 \u0441\u0443\u043D\u0434\u0443\u043A \u0438 \u0443\u0435\u0445\u0430\u0442\u044C
      \u0441 \u043D\u0438\u043C\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041F\u0435\u0447\u0430\u043B\u044C"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 3
    richText: "\xAB\u0414\u0430 \u0432\u043E\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043A\u0442\u043E \u0431\u044B \u043C\u0435\u043D\u044F \u0442\u0430\u043A
      \u043F\u0440\u043E\u0441\u0442\u043E \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u043B?\xBB"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041F\u0435\u0447\u0430\u043B\u044C"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 19
    richText: "\xAB\u0410 \u043C\u043D\u0435 \u0432\u043E\u0442 \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C
      \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u0437\u0433\u043B\u044F\u0434 \u0432\u043D\u0438\u0437"
