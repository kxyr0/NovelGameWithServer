  guid: mps_s01e02_l0181_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412 \u043F\u043E\u0440\u044B\u0432\u0435 \u0437\u043B\u043E\u0441\u0442\u0438
      \u044F \u0448\u0432\u044B\u0440\u044F\u044E \u0441\u0442\u0430\u043A\u0430\u043D
      \u0432 \u0441\u0442\u0435\u043D\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u0440\u0430\u0437\u043B\u0435\u0442\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0441\u043E\u0442\u043D\u0438 \u043C\u0435\u043B\u043A\u0438\u0445
      \u043E\u0441\u043A\u043E\u043B\u043A\u043E\u0432."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0434\u0438\u043D \u0438\u0437 \u043D\u0438\u0445, \u043E\u0441\u0442\u0440\u044B\u0439
      \u043A\u0430\u043A \u0431\u0440\u0438\u0442\u0432\u0430, \u043F\u0440\u043E\u043B\u0435\u0442\u0430\u0435\u0442
      \u0441\u043E\u0432\u0441\u0435\u043C \u0440\u044F\u0434\u043E\u043C \u0438
      \u0435\u0434\u0432\u0430 \u043D\u0435 \u0446\u0430\u0440\u0430\u043F\u0430\u0435\u0442
      \u043C\u043D\u0435 \u0449\u0451\u043A\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 4
    richText: "\xAB\u041B\u044E\u0434\u0438 \u0442\u043E\u0436\u0435 \u0445\u043E\u0440\u043E\u0448\u0438\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0417\u043B\u043E\u0441\u0442\u044C"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 30
    richText: "\xAB\u041F\u0440\u0438\u0432\u044B\u043A\u043B\u0438 \u0432\u0435\u0448\u0430\u0442\u044C
      \u0441\u0432\u043E\u0438 \u0431\u0435\u0434\u044B \u043D\u0430 \u0431\u043E\u0433\u043E\u0432,
      \u0441\u043B\u043E\u0432\u043D\u043E \u0442\u0435 \u2014 \u0432\u043E\u043B\u0448\u0435\u0431\u043D\u044B\u0435
      \u043F\u0430\u043B\u043E\u0447\u043A\u0438, \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u044B\u0435
      \u0432\u0441\u0451 \u0438\u0441\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0432
      \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0435 \u043E\u043A\u0430\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u0430\u044F"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 28
    richText: "\xAB\u041E\u0442\u0435\u0446 \u043F\u043E\u0433\u0438\u0431 \u043D\u0435
      \u043F\u0440\u043E\u0441\u0442\u043E \u0442\u0430\u043A. \u0412 \u043D\u0435\u0433\u043E
      \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0438\u043B\u0438\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u0437\u0433\u043B\u044F\u0434 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 3
    richText: "\xAB\u0423\u0431\u0438\u043B\u0438\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041F\u0435\u0447\u0430\u043B\u044C"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 28
    richText: "\xAB\u0417\u043D\u0430\u0447\u0438\u0442, \u0431\u044B\u043B\u043E
      \u0437\u0430 \u0447\u0442\u043E\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u0437\u0433\u043B\u044F\u0434 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u0434\u043E\u0441\u0442\u0430\u044E \u0438\u0437 \u043A\u0430\u0440\u043C\u0430\u043D\u0430
      \u0432\u0438\u0437\u0438\u0442\u043A\u0443 \u2014 \u0442\u0443 \u0441\u0430\u043C\u0443\u044E,
      \u0447\u0442\u043E \u0432\u0440\u0443\u0447\u0438\u043B \u043C\u043D\u0435
      \u043C\u0443\u0436\u0447\u0438\u043D\u0430 \u0432 \u043F\u043B\u0430\u0449\u0435
      \u043D\u0430 \u043F\u043E\u0445\u043E\u0440\u043E\u043D\u0430\u0445."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u044E
      \u0435\u0451, \u0440\u0430\u0437 \u0437\u0430 \u0440\u0430\u0437\u043E\u043C
      \u043F\u0435\u0440\u0435\u0447\u0438\u0442\u044B\u0432\u0430\u044F \u0441\u043B\u043E\u0432\u0430
      \xAB\u041A\u043E\u0437\u0430 \u041D\u043E\u0441\u0442\u0440\u0430\xBB \u0438
      \u043D\u043E\u043C\u0435\u0440 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0430,
      \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043D\u044B\u0439 \u043D\u0438\u0436\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 19
    richText: "\xAB\u041D\u0435\u0443\u0436\u0442\u043E \u043B\u044E\u0434\u0438
      \u0438\u0437 \xAB\u041A\u043E\u0437\u0430 \u041D\u043E\u0441\u0442\u0440\u0430\xBB
      \u0437\u043D\u0430\u043B\u0438, \u0447\u0442\u043E \u043E\u0442\u0446\u0443
      \u0433\u0440\u043E\u0437\u0438\u0442 \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C?\xBB"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u0437\u0433\u043B\u044F\u0434 \u0432 \u0432\u0435\u0440\u0445\u043D\u0438\u0439
      \u0443\u0433\u043E\u043B"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 8
    richText: "\xAB\u041C\u043E\u0436\u0435\u0442, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u043E\u043D\u0438 \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u043B\u0438
      \u0435\u043C\u0443 \u0437\u0430\u0449\u0438\u0442\u0443? \u0410 \u043C\u043E\u0439
      \u0443\u043F\u0440\u044F\u043C\u044B\u0439 \u043E\u0442\u0435\u0446... \u043E\u0442\u043A\u0430\u0437\u0430\u043B\u0441\u044F\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0432\u0437\u0433\u043B\u044F\u0434"
