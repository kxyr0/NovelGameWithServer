  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: mps_s01e02_l0242_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters: []
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u043E\u0447\u044C \u043F\u0440\u043E\u043B\u0435\u0442\u0430\u0435\u0442,
      \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u0438\u0432 \u0438 \u0441\u043B\u0435\u0434\u0430,
      \u043A\u0440\u043E\u043C\u0435 \u0442\u044F\u0436\u0435\u0441\u0442\u0438 \u0432
      \u0432\u0438\u0441\u043A\u0430\u0445."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0423\u0442\u0440\u0435\u043D\u043D\u0435\u0435 \u0441\u043E\u043B\u043D\u0446\u0435
      \u0443\u0436\u0435 \u0431\u044C\u0451\u0442 \u0432 \u043E\u043A\u043D\u043E,
      \u0431\u0435\u0437\u0436\u0430\u043B\u043E\u0441\u0442\u043D\u043E \u0446\u0435\u043B\u044F\u0441\u044C
      \u0432 \u0433\u043B\u0430\u0437\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0413\u043E\u043B\u043E\u0432\u0430 \u043F\u043E\u0441\u043B\u0435
      \u0432\u0447\u0435\u0440\u0430\u0448\u043D\u0435\u0433\u043E \u0431\u0443\u0434\u0442\u043E
      \u0441\u0432\u0438\u043D\u0446\u043E\u0432\u0430\u044F, \u043D\u043E \u044F
      \u043F\u043E\u0447\u0442\u0438 \u043D\u0435 \u043E\u0431\u0440\u0430\u0449\u0430\u044E
      \u043D\u0430 \u044D\u0442\u043E \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F,
      \u043B\u0438\u0448\u044C \u0438\u0437\u0440\u0435\u0434\u043A\u0430 \u0449\u0443\u0440\u044E\u0441\u044C
      \u043E\u0442 \u044F\u0440\u043A\u043E\u0433\u043E \u0441\u0432\u0435\u0442\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0420\u044F\u0434\u043E\u043C \u0441\u0438\u0434\u0438\u0442 \u041C\u0443\u0440\u043B\u044B\u043A\u0430
      \u0438 \u043C\u043E\u043B\u0447\u0430 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u043C\u0435\u043D\u044F, \u0441\u043B\u043E\u0432\u043D\u043E
      \u043E\u0441\u0443\u0436\u0434\u0430\u044F \u0437\u0430 \u0431\u0435\u0441\u043F\u043E\u0440\u044F\u0434\u043E\u043A."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043D\u0435 \u0440\u0435\u0430\u0433\u0438\u0440\u0443\u044E,
      \u0438 \u043E\u043D, \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E
      \u0434\u0451\u0440\u043D\u0443\u0432 \u0445\u0432\u043E\u0441\u0442\u043E\u043C,
      \u043E\u0431\u0445\u043E\u0434\u0438\u0442 \u0441\u0442\u0443\u043B \u0438
      \u0433\u043E\u0440\u0434\u043E \u0443\u0434\u0430\u043B\u044F\u0435\u0442\u0441\u044F
      \u0432 \u0434\u0440\u0443\u0433\u0443\u044E \u043A\u043E\u043C\u043D\u0430\u0442\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u043E \u043D\u0435 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
      \u0438 \u043C\u0438\u043D\u0443\u0442\u044B, \u043A\u0430\u043A \u043E\u043D
      \u043F\u0443\u043B\u0435\u0439 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u043E\u0431\u0440\u0430\u0442\u043D\u043E."
    style: {fileID: 0}
    authorComment: 
