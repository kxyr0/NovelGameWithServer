  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: mps_s01e02_l0302_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u043F\u0443\u0441\u0442\u0438\u0432\u0448\u0438\u0441\u044C
      \u043F\u043E \u0441\u043A\u0440\u0438\u043F\u0443\u0447\u0435\u0439 \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u0435
      \u0432 \u043F\u043E\u043B\u0443\u0442\u0451\u043C\u043D\u0443\u044E \u0437\u0430\u043B\u0443,
      \u044F \u0441\u0442\u0430\u0432\u043B\u044E \u0431\u0443\u0442\u044B\u043B\u043A\u0443
      \u043D\u0430 \u0441\u0442\u043E\u043B\u0438\u043A\u0435, \u0440\u044F\u0434\u043E\u043C
      \u0441 \u0442\u0430\u043A \u0438 \u043D\u0435 \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u043D\u043D\u043E\u0439
      \u0433\u0430\u0437\u0435\u0442\u043E\u0439."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0420\u0430\u043D\u0435\u0435 \u043D\u0430 \u043D\u0435\u0451 \u043D\u0435
      \u043D\u0430\u0448\u043B\u043E\u0441\u044C \u0432\u0440\u0435\u043C\u0435\u043D\u0438
      \u2014 \u0434\u0435\u043B\u0430 \u043F\u043E\u0432\u0430\u0436\u043D\u0435\u0435
      \u0437\u0430\u043D\u0438\u043C\u0430\u043B\u0438 \u0433\u043E\u043B\u043E\u0432\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u043E \u0438 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043B\u0435\u0433\u0447\u0435
      \u043D\u0435 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F:
      \u043F\u0440\u043E\u0431\u043B\u0435\u043C \u043B\u0438\u0448\u044C \u043F\u0440\u0438\u0431\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F,
      \u0438 \u043D\u0430 \u0431\u0430\u043D\u0430\u043B\u044C\u043D\u043E\u0435
      \u0447\u0442\u0435\u043D\u0438\u0435 \u043D\u043E\u0432\u043E\u0441\u0442\u0435\u0439
      \u044F \u043D\u0438\u043A\u0430\u043A \u043D\u0435 \u0432\u044B\u043A\u0440\u043E\u0438\u0442\u044C
      \u0438 \u043C\u0438\u043D\u0443\u0442\u044B."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041C\u0438\u043D\u043E\u0432\u0430\u0432 \u0430\u043D\u0444\u0438\u043B\u0430\u0434\u0443
      \u043A\u043E\u043C\u043D\u0430\u0442, \u044F \u0432\u044B\u0445\u043E\u0436\u0443
      \u0432 \u043F\u0440\u043E\u0445\u043B\u0430\u0434\u043D\u0443\u044E \u043F\u0440\u0438\u0445\u043E\u0436\u0443\u044E
      \u0438 \u0442\u0443\u0442 \u0436\u0435 \u0437\u0430\u043C\u0435\u0447\u0430\u044E
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0431\u0435\u043B\u044B\u0445
      \u043A\u043E\u043D\u0432\u0435\u0440\u0442\u043E\u0432, \u043B\u0435\u0436\u0430\u0449\u0438\u0445
      \u043F\u043E\u0434 \u0434\u0432\u0435\u0440\u044C\u044E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u043E\u0434\u0445\u043E\u0436\u0443 \u0431\u043B\u0438\u0436\u0435,
      \u043D\u043E \u043F\u0440\u0435\u0436\u0434\u0435, \u0447\u0435\u043C \u043F\u043E\u0434\u043D\u044F\u0442\u044C
      \u0438\u0445, \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E \u0432\u044B\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044E
      \u043D\u0430 \u0443\u043B\u0438\u0446\u0443 \u0447\u0435\u0440\u0435\u0437
      \u0443\u0437\u043A\u0443\u044E \u0449\u0435\u043B\u044C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u0443\u0441\u0442\u043E \u0438 \u0431\u0435\u0437\u043C\u043E\u043B\u0432\u043D\u043E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u0435\u0440\u043D\u0443\u0432\u0448\u0438\u0441\u044C, \u044F
      \u043F\u0440\u0438\u0441\u0435\u0434\u0430\u044E \u0438 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044E
      \u043F\u0430\u0440\u0443 \u043F\u0438\u0441\u0435\u043C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 19
    richText: "\xAB\u0412\u0435\u0440\u043E\u044F\u0442\u043D\u043E, \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u043E\u043C
      \u0448\u0443\u043C\u0430 \u0431\u044B\u043B \u043F\u043E\u0447\u0442\u0430\u043B\u044C\u043E\u043D\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u0437\u0433\u043B\u044F\u0434 \u0432 \u0432\u0435\u0440\u0445\u043D\u0438\u0439
      \u0443\u0433\u043E\u043B"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 8
    richText: "\xAB\u0422\u043E\u043B\u044C\u043A\u043E \u0432\u043E\u0442 \u043A\u0430\u043A\u0438\u0435
      \u0432\u0435\u0441\u0442\u0438 \u043E\u043D \u043C\u043E\u0433 \u043F\u0440\u0438\u043D\u0435\u0441\u0442\u0438?\xBB"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0432\u0437\u0433\u043B\u044F\u0434"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\xAB\u041C\u044B \u0441 \u043E\u0442\u0446\u043E\u043C \u043D\u0438\u043A\u043E\u0433\u0434\u0430
      \u043D\u0435 \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0438\u0441\u044C
      \u0443\u0441\u043B\u0443\u0433\u0430\u043C\u0438 \u043F\u043E\u0447\u0442\u044B\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u043E\u0434\u043D\u044F\u0432\u0448\u0438\u0441\u044C, \u044F
      \u0448\u0430\u0433\u0430\u044E \u0432 \u0437\u0430\u043B\u0443 \u0438 \u043A\u043B\u0430\u0434\u0443
      \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043D\u0443\u044E \u043F\u043E\u0447\u0442\u0443
      \u043D\u0430 \u0442\u043E\u0442 \u0436\u0435 \u0441\u0442\u043E\u043B\u0438\u043A,
      \u0433\u0434\u0435 \u0441\u0442\u043E\u0438\u0442 \u0431\u0443\u0442\u044B\u043B\u043A\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\xAB\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u0440\u0438\u0432\u0435\u0434\u0443
      \u0441\u0435\u0431\u044F \u0432 \u043F\u043E\u0440\u044F\u0434\u043E\u043A\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
