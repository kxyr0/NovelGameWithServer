  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: mps_s01e02_l0366_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: e96ccda94a6eeb24cadaed510065fd46, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u041A\u0442\u043E-\u0442\u043E"
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u0444\u043E\u043A\u0443\u0441\u0438\u0440\u043E\u0432\u0430\u0432
      \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435 \u043D\u0430 \u043B\u0435\u0432\u043E\u043C
      \u043F\u0438\u0441\u044C\u043C\u0435, \u044F \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u044E
      \u0431\u0443\u043C\u0430\u0433\u0443 \u0438 \u0447\u0438\u0442\u0430\u044E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u041A\u0442\u043E-\u0442\u043E"
    speakerNameHint: "\u041A\u0442\u043E-\u0442\u043E"
    speaker: {fileID: 11400000, guid: e96ccda94a6eeb24cadaed510065fd46, type: 2}
    emotion: 17
    richText: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430, \u0434\u043E\u0440\u043E\u0433\u0430\u044F
      \u043C\u043E\u044F, \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0427\u0435\u0440\u043D\u044B\u0439 \u0441\u0438\u043B\u0443\u044D\u0442"
  - speakerId: "\u041A\u0442\u043E-\u0442\u043E"
    speakerNameHint: "\u041A\u0442\u043E-\u0442\u043E"
    speaker: {fileID: 11400000, guid: e96ccda94a6eeb24cadaed510065fd46, type: 2}
    emotion: 17
    richText: "\u042F \u0442\u0430\u043A \u043D\u0435 \u0445\u043E\u0442\u0435\u043B
      \u043F\u0438\u0441\u0430\u0442\u044C \u044D\u0442\u043E \u043F\u0438\u0441\u044C\u043C\u043E,
      \u0432\u0435\u0434\u044C \u043F\u0440\u0438\u0432\u044B\u043A \u043A \u0436\u0438\u0432\u043E\u043C\u0443
      \u043E\u0431\u0449\u0435\u043D\u0438\u044E."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0427\u0435\u0440\u043D\u044B\u0439 \u0441\u0438\u043B\u0443\u044D\u0442"
  - speakerId: "\u041A\u0442\u043E-\u0442\u043E"
    speakerNameHint: "\u041A\u0442\u043E-\u0442\u043E"
    speaker: {fileID: 11400000, guid: e96ccda94a6eeb24cadaed510065fd46, type: 2}
    emotion: 17
    richText: "\u041E\u0434\u043D\u0430\u043A\u043E \u043D\u0435 \u043C\u043E\u0433
      \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u0442\u044C \u0438\u043D\u0430\u0447\u0435,
      \u0432\u0435\u0434\u044C \u0432\u0441\u0451 \u0435\u0449\u0451 \u043D\u0430\u0445\u043E\u0436\u0443\u0441\u044C
      \u0432 \u043F\u0443\u0442\u0438 \u0438, \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E,
      \u043D\u0435 \u0443\u0441\u043F\u0435\u0432\u0430\u044E \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
      \u0434\u043E \u041F\u0430\u043B\u0435\u0440\u043C\u043E."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0427\u0435\u0440\u043D\u044B\u0439 \u0441\u0438\u043B\u0443\u044D\u0442"
  - speakerId: "\u041A\u0442\u043E-\u0442\u043E"
    speakerNameHint: "\u041A\u0442\u043E-\u0442\u043E"
    speaker: {fileID: 11400000, guid: e96ccda94a6eeb24cadaed510065fd46, type: 2}
    emotion: 17
    richText: "\u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u0438 \u0440\u0435\u0448\u0438\u043B
      \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0442\u0435\u0431\u0435
      \u0432\u0435\u0441\u0442\u043E\u0447\u043A\u0443, \u0447\u0442\u043E\u0431\u044B
      \u043A \u043C\u043E\u0435\u043C\u0443 \u043F\u0440\u0438\u0435\u0437\u0434\u0443
      \u0442\u044B \u0431\u044B\u043B\u0430 \u0441\u043E\u0431\u0440\u0430\u043D\u0430."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0427\u0435\u0440\u043D\u044B\u0439 \u0441\u0438\u043B\u0443\u044D\u0442"
  - speakerId: "\u041A\u0442\u043E-\u0442\u043E"
    speakerNameHint: "\u041A\u0442\u043E-\u0442\u043E"
    speaker: {fileID: 11400000, guid: e96ccda94a6eeb24cadaed510065fd46, type: 2}
    emotion: 17
    richText: "\u042F \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u043D\u0430 \u0434\u043D\u044F\u0445
      \u0442\u0440\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438 \u043F\u043E\u0433\u0438\u0431
      \u0442\u0432\u043E\u0439 \u043E\u0442\u0435\u0446. \u041F\u0440\u0438\u043C\u0438
      \u043C\u043E\u0438 \u0441\u043E\u0431\u043E\u043B\u0435\u0437\u043D\u043E\u0432\u0430\u043D\u0438\u044F."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0427\u0435\u0440\u043D\u044B\u0439 \u0441\u0438\u043B\u0443\u044D\u0442"
  - speakerId: "\u041A\u0442\u043E-\u0442\u043E"
    speakerNameHint: "\u041A\u0442\u043E-\u0442\u043E"
    speaker: {fileID: 11400000, guid: e96ccda94a6eeb24cadaed510065fd46, type: 2}
    emotion: 17
    richText: "\u041E\u043D \u0431\u044B\u043B \u043E\u0442\u043B\u0438\u0447\u043D\u044B\u043C
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C \u0438 \u0431\u0438\u0437\u043D\u0435\u0441\u043C\u0435\u043D\u043E\u043C."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0427\u0435\u0440\u043D\u044B\u0439 \u0441\u0438\u043B\u0443\u044D\u0442"
  - speakerId: "\u041A\u0442\u043E-\u0442\u043E"
    speakerNameHint: "\u041A\u0442\u043E-\u0442\u043E"
    speaker: {fileID: 11400000, guid: e96ccda94a6eeb24cadaed510065fd46, type: 2}
    emotion: 17
    richText: "\u041C\u0435\u0441\u0442\u0430\u043C\u0438 \u044F \u0434\u0430\u0436\u0435
      \u043C\u0443\u0447\u0430\u044E\u0441\u044C, \u0447\u0442\u043E \u043D\u0435
      \u043F\u0440\u0438\u043D\u044F\u043B \u0435\u0433\u043E \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u044F,
      \u043E \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u043A\u043E\u0433\u0434\u0430-\u0442\u043E
      \u043D\u0435 \u0441\u0442\u0430\u043B \u0442\u0435\u0431\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0427\u0435\u0440\u043D\u044B\u0439 \u0441\u0438\u043B\u0443\u044D\u0442"
  - speakerId: "\u041A\u0442\u043E-\u0442\u043E"
    speakerNameHint: "\u041A\u0442\u043E-\u0442\u043E"
    speaker: {fileID: 11400000, guid: e96ccda94a6eeb24cadaed510065fd46, type: 2}
    emotion: 17
    richText: "\u041E\u0434\u043D\u0430\u043A\u043E, \u0443\u0437\u043D\u0430\u0432
      \u043E \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u0438, \u044F \u043F\u043E\u0434\u0443\u043C\u0430\u043B,
      \u0447\u0442\u043E \u043D\u0435 \u043C\u043E\u0433\u0443 \u043D\u0435 \u043F\u0440\u0438\u0435\u0445\u0430\u0442\u044C."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0427\u0435\u0440\u043D\u044B\u0439 \u0441\u0438\u043B\u0443\u044D\u0442"
  - speakerId: "\u041A\u0442\u043E-\u0442\u043E"
    speakerNameHint: "\u041A\u0442\u043E-\u0442\u043E"
    speaker: {fileID: 11400000, guid: e96ccda94a6eeb24cadaed510065fd46, type: 2}
    emotion: 17
    richText: "\u0414\u0430\u0432\u0430\u0439 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043C\u0441\u044F
      \u0432 \u0447\u0435\u0442\u0432\u0435\u0440\u0433, \u043E\u043A\u043E\u043B\u043E
      \u0441\u0435\u043C\u0438 \u0447\u0430\u0441\u043E\u0432 \u0432 \u043F\u0430\u0431\u0435
      \xAB\u041E\u0441\u0442\u0435\u0440\u0438\u044F \u041B\u0443\u043D\u044B\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0427\u0435\u0440\u043D\u044B\u0439 \u0441\u0438\u043B\u0443\u044D\u0442"
  - speakerId: "\u041A\u0442\u043E-\u0442\u043E"
    speakerNameHint: "\u041A\u0442\u043E-\u0442\u043E"
    speaker: {fileID: 11400000, guid: e96ccda94a6eeb24cadaed510065fd46, type: 2}
    emotion: 17
    richText: "\u042F \u0434\u0443\u043C\u0430\u044E, \u043A \u044D\u0442\u043E\u043C\u0443
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0443\u0441\u043F\u0435\u044E \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F.
      \u0410 \u0435\u0441\u043B\u0438 \u043D\u0435\u0442 \u2014 \u043D\u0430\u0432\u0435\u0449\u0443
      \u043B\u0438\u0447\u043D\u043E. \u0425\u043E\u0440\u043E\u0448\u043E?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0427\u0435\u0440\u043D\u044B\u0439 \u0441\u0438\u043B\u0443\u044D\u0442"
  - speakerId: "\u041A\u0442\u043E-\u0442\u043E"
    speakerNameHint: "\u041A\u0442\u043E-\u0442\u043E"
    speaker: {fileID: 11400000, guid: e96ccda94a6eeb24cadaed510065fd46, type: 2}
    emotion: 17
    richText: "\u041D\u0435 \u043E\u043F\u043E\u0437\u0434\u0430\u0439."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0427\u0435\u0440\u043D\u044B\u0439 \u0441\u0438\u043B\u0443\u044D\u0442"
