  - character: {fileID: 11400000, guid: 88ab372d37d4ecb4fa9362f48f0ced63, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0443\u0441\u0430\u043C\u0438"
  - character: {fileID: 11400000, guid: 7a64daf2d25859d4aab34520bad5552d, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u0435\u0440\u0432\u0438\u0442\u0440\u0438\u0441\u0441\u0430,
      \u0447\u0442\u043E \u0437\u0430\u043D\u0438\u043C\u0430\u043B\u0430\u0441\u044C
      \u043D\u0430\u0448\u0438\u043C \u0437\u0430\u043A\u0430\u0437\u043E\u043C,
      \u0442\u0443\u0442 \u0436\u0435 \u0431\u0440\u043E\u0441\u0430\u0435\u0442
      \u0435\u0433\u043E \u0438 \u043F\u043E\u0447\u0442\u0438 \u0431\u0435\u0436\u0438\u0442
      \u043A \u0438\u0445 \u0441\u0442\u043E\u043B\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\xAB\u0422\u0430\u043A \u0432\u043E\u0442 \u0447\u0435\u0439 \u044D\u0442\u043E
      \u0431\u044B\u043B \u0441\u0442\u043E\u043B...\xBB"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u0441\u0435 \u0441\u043C\u043E\u0442\u0440\u044F\u0442 \u0432
      \u0438\u0445 \u0441\u0442\u043E\u0440\u043E\u043D\u0443. \u041C\u0443\u0436\u0447\u0438\u043D\u0430
      \u0441 \u0442\u043E\u043D\u043A\u0438\u043C\u0438 \u0443\u0441\u0430\u043C\u0438
      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u043E\u0431\u0432\u043E\u0434\u0438\u0442
      \u0437\u0430\u043B \u0442\u044F\u0436\u0435\u043B\u044B\u043C, \u043D\u0435\u043C\u0438\u0433\u0430\u044E\u0449\u0438\u043C
      \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u0430 \u0435\u0433\u043E \u0433\u0443\u0431\u0430\u0445 \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0445\u043E\u043B\u043E\u0434\u043D\u0430\u044F \u0443\u043B\u044B\u0431\u043A\u0430,
      \u043D\u0435 \u0437\u0430\u0442\u0440\u0430\u0433\u0438\u0432\u0430\u044E\u0449\u0430\u044F
      \u0433\u043B\u0430\u0437."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u0435\u0434\u0432\u0430 \u0437\u0430\u043C\u0435\u0442\u043D\u043E
      \u043F\u043E\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442 \u043F\u0438\u0434\u0436\u0430\u043A
      \u043D\u0430 \u0431\u043E\u043A\u0443, \u0438 \u044D\u0442\u043E\u0433\u043E
      \u0436\u0435\u0441\u0442\u0430 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E:
      \u043B\u044E\u0431\u043E\u043F\u044B\u0442\u043D\u044B\u0435 \u0442\u0443\u0442
      \u0436\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044E\u0442\u0441\u044F
      \u043A \u0441\u0432\u043E\u0438\u043C \u0434\u0435\u043B\u0430\u043C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0443\u0441\u0430\u043C\u0438"
    speakerNameHint: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0443\u0441\u0430\u043C\u0438"
    speaker: {fileID: 11400000, guid: 88ab372d37d4ecb4fa9362f48f0ced63, type: 2}
    emotion: 4
    richText: "\u2026"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0437\u043B\u043E\u0441\u0442\u044C"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 2
    richText: "\xAB\u041F\u0430\u0441\u0442\u0443\u0445 \u0440\u0430\u0441\u0441\u0442\u0430\u0432\u0438\u043B
      \u043E\u0432\u0435\u0446 \u043F\u043E \u043C\u0435\u0441\u0442\u0430\u043C\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 28
    richText: "\xAB\u041E\u043D \u044F\u0432\u043D\u043E \u0432\u043B\u0438\u044F\u0442\u0435\u043B\u0435\u043D,
      \u0440\u0430\u0437 \u043B\u0438\u0448\u044C \u043E\u0434\u043D\u0438\u043C
      \u043A\u0443\u043B\u0430\u043A\u043E\u043C \u0438 \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C
      \u043F\u043E\u043A\u0430\u0437\u0430\u043B \u0432\u0441\u0435\u043C, \u0433\u0434\u0435
      \u0438\u0445 \u0442\u0443\u0442 \u043C\u0435\u0441\u0442\u043E\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u0437\u0433\u043B\u044F\u0434 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u0437\u0430\u0432\u043E\u0440\u043E\u0436\u0451\u043D\u043D\u043E
      \u0441\u043C\u043E\u0442\u0440\u044E \u043D\u0430 \u0441\u0442\u043E\u043B,
      \u0437\u0430 \u043A\u043E\u0442\u043E\u0440\u044B\u043C \u0440\u0430\u0437\u043C\u0435\u0441\u0442\u0438\u043B\u0430\u0441\u044C
      \u041A\u043E\u0437\u0430 \u041D\u043E\u0441\u0442\u0440\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u044E \u043B\u0438\u0446\u043E
      \u043A\u0430\u0436\u0434\u043E\u0433\u043E, \u043F\u043E\u043A\u0430 \u043D\u0435
      \u0437\u0430\u043C\u0435\u0447\u0430\u044E, \u043A\u0430\u043A \u043D\u0430
      \u043C\u0435\u043D\u044F \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0434\u0435\u0432\u0443\u0448\u043A\u0430
      \u0438\u0437 \u0438\u0445 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F
      \u0435\u0445\u0438\u0434\u043D\u043E, \u0441\u043B\u043E\u0432\u043D\u043E
      \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442, \u043A\u0430\u043A
      \u044F \u0432\u0441\u043F\u044B\u0445\u0438\u0432\u0430\u044E \u043D\u0430
      \u0440\u043E\u0432\u043D\u043E\u043C \u043C\u0435\u0441\u0442\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speakerNameHint: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speaker: {fileID: 11400000, guid: 7a64daf2d25859d4aab34520bad5552d, type: 2}
    emotion: 2
    richText: .
    style: {fileID: 0}
