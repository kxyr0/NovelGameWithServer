      \u043D\u0435 \u0434\u043E\u0440\u043E\u0433\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0417\u043B\u043E\u0441\u0442\u044C"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043D\u0435 \u0431\u043E\u044F\u043B\u0430\u0441\u044C \u043D\u0430\u0437\u044B\u0432\u0430\u0442\u044C
      \u0435\u0451 \u0442\u0430\u043A, \u0432\u0435\u0434\u044C \u0432 \u043C\u043E\u0451\u043C
      \u0441\u0435\u0440\u0434\u0446\u0435 \u043E\u043D\u0430 \u0434\u0430\u0432\u043D\u043E
      \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B\u0430 \u0431\u044B\u0442\u044C
      \u043C\u0430\u0442\u0435\u0440\u044C\u044E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 4
    richText: "\xAB\u0412\u0441\u0451, \u0447\u0442\u043E \u0435\u0439 \u0431\u044B\u043B\u043E
      \u043D\u0443\u0436\u043D\u043E \u043E\u0442 \u043D\u0435\u0433\u043E, - \u044D\u0442\u043E
      \u0430\u0432\u0442\u043E\u0441\u0430\u043B\u043E\u043D\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0417\u043B\u043E\u0441\u0442\u044C"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 4
    richText: "\xAB\u0422\u043E\u043B\u044C\u043A\u043E \u043A \u043D\u0435\u043C\u0443
      \u043E\u043D\u0430 \u043F\u0438\u0442\u0430\u043B\u0430 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0443\u044E
      \u0441\u0442\u0440\u0430\u0441\u0442\u044C, \u0430 \u043D\u0435 \u043A \u043E\u0442\u0446\u0443\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0417\u043B\u043E\u0441\u0442\u044C"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 28
    richText: "\xAB\u0415\u0451 \u0440\u0430\u0437\u0443\u043C \u0431\u044B\u043B
      \u0437\u0430\u0442\u0443\u043C\u0430\u043D\u0435\u043D \u0436\u0430\u0436\u0434\u043E\u0439
      \u043D\u0430\u0436\u0438\u0432\u044B. \u041E\u043D\u0430 \u0432\u0438\u0434\u0435\u043B\u0430
      \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u044B\u0432\u0435\u0441\u043A\u0443
      \u043D\u0430\u0434 \u0432\u043E\u0440\u043E\u0442\u0430\u043C\u0438 \u0438
      \u043D\u0435 \u0437\u0430\u043C\u0435\u0447\u0430\u043B\u0430 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0432\u0435\u0440\u0438\u043B \u0435\u0439
      \u0434\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u0437\u0433\u043B\u044F\u0434 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443"
