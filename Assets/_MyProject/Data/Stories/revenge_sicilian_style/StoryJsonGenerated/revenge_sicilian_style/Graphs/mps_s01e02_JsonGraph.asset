    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 8
    richText: "\u041F\u043E\u0447\u0435\u043C\u0443?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0432\u0437\u0433\u043B\u044F\u0434"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 6
    richText: "\u0420\u0430\u0434\u0430, \u043A\u043E\u043D\u0435\u0447\u043D\u043E,
      \u043F\u0440\u043E\u0441\u0442\u043E \u044D\u0442\u043E \u0442\u0430\u043A
      \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u0434\u0438\u0432\u043B\u0435\u043D\u0438\u0435"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 8
    richText: "\u0427\u0435\u0433\u043E \u0432\u0434\u0440\u0443\u0433 \u0442\u044B
      \u0440\u0435\u0448\u0438\u043B \u043F\u0435\u0440\u0435\u0431\u0440\u0430\u0442\u044C\u0441\u044F?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0432\u0437\u0433\u043B\u044F\u0434"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 32
    richText: "\u041D\u0435\u0443\u0436\u0442\u043E \u0438\u0437-\u0437\u0430 \u043C\u0435\u043D\u044F?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041F\u0440\u0438\u0449\u0443\u0440"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041B\u0443\u043A\u0430 \u043E\u0442\u0441\u0442\u0440\u0430\u043D\u044F\u0435\u0442\u0441\u044F
      \u043E\u0442 \u0441\u043F\u0438\u043D\u043A\u0438 \u0438 \u043B\u0435\u0433\u043E\u043D\u044C\u043A\u043E
      \u043F\u0438\u0445\u0430\u0435\u0442 \u043C\u0435\u043D\u044F \u0432 \u043F\u043B\u0435\u0447\u043E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u041B\u0443\u043A\u0430"
    speakerNameHint: "\u041B\u0443\u043A\u0430"
    speaker: {fileID: 11400000, guid: 95d1e47740b729147bcd7d679212dd21, type: 2}
    emotion: 2
    richText: "\u0412\u043E\u0442 \u0440\u0430\u0437\u043C\u0435\u0447\u0442\u0430\u043B\u0430\u0441\u044C,
