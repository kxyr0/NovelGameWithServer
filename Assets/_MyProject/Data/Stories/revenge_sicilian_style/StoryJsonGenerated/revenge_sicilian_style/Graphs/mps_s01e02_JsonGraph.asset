      \u0431\u044B \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u043C\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041A\u0430\u043A \u0431\u044B \u043C\u043D\u0435 \u043D\u0438 \u0445\u043E\u0442\u0435\u043B\u043E\u0441\u044C
      \u043F\u0440\u043E\u0443\u0447\u0438\u0442\u044C \u044D\u0442\u0438\u0445 \u0444\u0430\u0448\u0438\u0441\u0442\u0441\u043A\u0438\u0445
      \u043C\u043E\u043B\u043E\u0434\u0447\u0438\u043A\u043E\u0432, \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F
      \u043F\u0440\u043E\u0433\u043B\u043E\u0442\u0438\u0442\u044C \u043E\u0431\u0438\u0434\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 28
    richText: "\xAB\u0410 \u043C\u043E\u0436\u0435\u0442, \u044D\u0442\u043E \u0438
      \u043A \u043B\u0443\u0447\u0448\u0435\u043C\u0443\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u0437\u0433\u043B\u044F\u0434 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 19
    richText: "\xAB\u041A\u0442\u043E \u0437\u043D\u0430\u0435\u0442, \u043A \u043A\u0430\u043A\u0438\u043C
      \u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u044F\u043C \u043C\u043E\u0433\u043B\u0430
      \u0431\u044B \u043F\u0440\u0438\u0432\u0435\u0441\u0442\u0438 \u0441\u043A\u0440\u044B\u0442\u0430\u044F
      \u0441\u044A\u0451\u043C\u043A\u0430\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u0437\u0433\u043B\u044F\u0434 \u0432 \u0432\u0435\u0440\u0445\u043D\u0438\u0439
      \u0443\u0433\u043E\u043B"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 2
    richText: "\xAB\u041D\u0430\u0448\u043B\u0438 \u0431\u044B \u0433\u0434\u0435-\u043D\u0438\u0431\u0443\u0434\u044C
      \u0437\u0430 \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440\u043E\u043C
      \u0432 \u043F\u0435\u0440\u0435\u0443\u043B\u043A\u0435\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\xAB\u0418 \u0434\u0430\u0436\u0435 \u043D\u0435 \u0441\u0442\u0430\u043B\u0438
      \u0431\u044B \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0442\u044C\u0441\u044F,
      \u043A\u0442\u043E \u0438 \u043F\u043E\u0447\u0435\u043C\u0443 \u0442\u0443\u0442
      \u043B\u0435\u0436\u0438\u0442\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041C\u043D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F
      \u0440\u0430\u0437\u043C\u044B\u0448\u043B\u044F\u0442\u044C \u043E \u0442\u043E\u043C,
      \u0441\u043A\u043E\u043B\u044C\u043A\u0438\u043C\u0438 \u0441\u043F\u043E\u0441\u043E\u0431\u0430\u043C\u0438
      \u043C\u043E\u0436\u043D\u043E \u0431\u044B\u043B\u043E \u0431\u044B \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
      \u0441 \u0444\u0430\u0448\u0438\u0441\u0442\u0441\u043A\u0438\u043C\u0438 \u0441\u043E\u043B\u0434\u0430\u0442\u0430\u043C\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042D\u0442\u0430 \u0447\u0435\u0440\u0442\u0430 \u043F\u0440\u043E\u0440\u043E\u0441\u043B\u0430
      \u0432\u043E \u043C\u043D\u0435 \u0432\u043C\u0435\u0441\u0442\u0435 \u0441
      \u0434\u0438\u043A\u0442\u0430\u0442\u0443\u0440\u043E\u0439. \u041A\u043E\u0433\u0434\u0430
      \u0411\u0435\u043D\u0438\u0442\u043E \u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u043F\u0440\u0438\u0431\u0440\u0430\u043B \u0432\u043B\u0430\u0441\u0442\u044C
      \u043A \u0440\u0443\u043A\u0430\u043C, \u044F \u043D\u0430\u0443\u0447\u0438\u043B\u0430\u0441\u044C
      \u043C\u043E\u043B\u0447\u0430\u0442\u044C \u0438 \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0442\u044C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0420\u0430\u043D\u044C\u0448\u0435 \u044F \u043D\u0435 \u0431\u044B\u043B\u0430
      \u0442\u0430\u043A\u043E\u0439 \u043E\u0442 \u0441\u043B\u043E\u0432\u0430
      \u0441\u043E\u0432\u0441\u0435\u043C, \u043D\u043E \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E
      \u043D\u0430\u0446\u0438\u0441\u0442\u044B \u0438 \u0438\u0445 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F
      \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438\u0441\u044C \u043D\u0435\u0432\u044B\u043D\u043E\u0441\u0438\u043C\u044B\u043C\u0438,
      \u0445\u043E\u0442\u044C \u0438 \u0431\u043E\u043B\u0435\u0435-\u043C\u0435\u043D\u0435\u0435
      \u043F\u0440\u0438\u0435\u043C\u043B\u0435\u043C\u044B\u043C\u0438 \u0434\u043B\u044F
      \u0436\u0438\u0437\u043D\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u044F \u043D\u0435 \u043C\u043E\u0433\u0443
      \u043D\u0435 \u043D\u0430\u0447\u0430\u0442\u044C \u0434\u0443\u043C\u0430\u0442\u044C,
      \u043A\u0430\u043A \u0431\u044B \u043B\u0438\u0448\u043D\u0438\u0439 \u0440\u0430\u0437
      \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u0441\u0435\u0431\u0435 \u0436\u0438\u0437\u043D\u044C
      \u043F\u0440\u043E\u0449\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 30
    richText: "\xAB\u042F \u043D\u0435 \u0431\u043E\u044E\u0441\u044C \u0438\u0445\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u0430\u044F"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\xAB\u0421\u0438\u0446\u0438\u043B\u0438\u044F \u2014 \u043C\u043E\u0439
      \u043E\u0441\u0442\u0440\u043E\u0432. \u041C\u043E\u0439 \u0434\u043E\u043C\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
