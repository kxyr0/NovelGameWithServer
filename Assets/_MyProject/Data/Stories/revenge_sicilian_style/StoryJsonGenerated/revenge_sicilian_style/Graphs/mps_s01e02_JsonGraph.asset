  guid: mps_s01e02_l0835_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u044F\u0441\u043D\u043E \u0434\u0430\u043B\u0430
      \u043C\u043D\u0435 \u043F\u043E\u043D\u044F\u0442\u044C, \u0447\u0442\u043E
      \u043F\u043E\u043E\u0431\u0449\u0430\u0442\u044C\u0441\u044F \u0441 \u043D\u0435\u0439
      \u0441\u0435\u0439\u0447\u0430\u0441 \u044F \u043D\u0435 \u0441\u043C\u043E\u0433\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041A\u043E\u043D\u0435\u0447\u043D\u043E, \u043C\u043E\u0436\u043D\u043E
      \u0431\u044B\u043B\u043E \u0431\u044B \u043D\u0430\u0441\u0442\u043E\u044F\u0442\u044C,
      \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0434\u0438\u0442\u044C \u043E
      \u0442\u043E\u043C, \u043A\u0442\u043E \u0442\u0430\u043A\u043E\u0439 \u041A\u0443\u0440\u0446,
      \u043E\u0434\u043D\u0430\u043A\u043E \u0437\u043D\u0430\u044E, \u0447\u0442\u043E
      \u0414\u0436\u0443\u043B\u0438\u044F \u2014 \u0441\u0438\u043B\u044C\u043D\u0430\u044F
      \u0434\u0435\u0432\u0443\u0448\u043A\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u043E \u0434\u0430\u0436\u0435 \u043D\u0430\u0434 \u0442\u0430\u043A\u0438\u043C\u0438
      \u043C\u043E\u0436\u043D\u043E \u0432\u0437\u044F\u0442\u044C \u0432\u043B\u0430\u0441\u0442\u044C,
      \u0438 \u044F \u044D\u0442\u043E\u0433\u043E \u0431\u043E\u044E\u0441\u044C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0411\u043E\u044E\u0441\u044C, \u0447\u0442\u043E \u043E\u043D \u0441
      \u043D\u0435\u0439 \u0447\u0442\u043E-\u0442\u043E \u0441\u0434\u0435\u043B\u0430\u0435\u0442."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 32
    richText: "\xAB\u041F\u043E \u043A\u0440\u0430\u0439\u043D\u0435\u0439 \u043C\u0435\u0440\u0435,
      \u043E\u043D\u0430 \u043C\u043D\u0435 \u0441\u043A\u0430\u0437\u0430\u043B\u0430,
      \u0447\u0442\u043E \u0431\u0443\u0434\u0435\u0442 \u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u0435\u0435\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041F\u0440\u0438\u0449\u0443\u0440"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 28
    richText: "\xAB\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u043E\u043D\u0430
      \u0431\u044B\u0441\u0442\u0440\u043E \u043E\u0441\u043E\u0437\u043D\u0430\u0435\u0442,
      \u0447\u0442\u043E \u041A\u0443\u0440\u0446 - \u043D\u0435 \u0442\u043E\u0442,
      \u043A\u0442\u043E \u0435\u0439 \u043D\u0443\u0436\u0435\u043D\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u0437\u0433\u043B\u044F\u0434 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 30
    richText: "\xAB\u0427\u0442\u043E \u043E\u043D \u0442\u043E\u0442, \u043E\u0442
      \u043A\u043E\u0433\u043E \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
      \u0431\u0435\u0436\u0430\u0442\u044C\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u0430\u044F"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043F\u0440\u043E\u0432\u043E\u0436\u0430\u044E \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C
      \u043F\u0430\u0440\u043E\u0447\u043A\u0443, \u043F\u043E\u043A\u0430 \u043E\u043D\u0438
      \u043D\u0435 \u0441\u043A\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F \u0437\u0430
      \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u043E\u043C, \u0430 \u043F\u043E\u0441\u043B\u0435
      \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0441\u044C \u0432\u043D\u0443\u0442\u0440\u044C
      \u043F\u0430\u0431\u0430 \u043D\u0430 \u043F\u043E\u0438\u0441\u043A\u0438
      \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044F \u043F\u0438\u0441\u044C\u043C\u0430."
    style: {fileID: 0}
    authorComment: 
