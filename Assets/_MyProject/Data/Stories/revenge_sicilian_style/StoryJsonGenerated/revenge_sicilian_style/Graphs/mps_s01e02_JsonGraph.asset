  guid: mps_s01e02_l0693_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  - character: {fileID: 11400000, guid: e706e7d1a91e19d4abff1ac05facf1ab, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u0414\u0436\u0443\u043B\u0438\u044F"
  lines:
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 30
    richText: "\xAB\u0421\u0442\u043E\u0438\u043B\u043E \u0436\u0435 \u043D\u0430\u0442\u043A\u043D\u0443\u0442\u044C\u0441\u044F\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u0430\u044F"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043F\u0440\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u044E
      \u0440\u0443\u043A\u0443 \u041A\u0443\u0440\u0446\u0443, \u0438 \u0432 \u044D\u0442\u043E\u0442
      \u043C\u0438\u0433 \u0435\u0433\u043E \u043F\u0430\u043B\u044C\u0446\u044B
      \u0433\u0440\u0443\u0431\u043E \u0432\u043F\u0438\u0432\u0430\u044E\u0442\u0441\u044F
      \u0432 \u0431\u0435\u0434\u0440\u043E \u0414\u0436\u0443\u043B\u0438\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0435\u0434\u0432\u0430 \u0437\u0430\u043C\u0435\u0442\u043D\u043E
      \u0432\u0437\u0434\u0440\u0430\u0433\u0438\u0432\u0430\u0435\u0442, \u0438
      \u0432 \u0435\u0451 \u0433\u043B\u0430\u0437\u0430\u0445 \u043D\u0430 \u0434\u043E\u043B\u044E
      \u0441\u0435\u043A\u0443\u043D\u0434\u044B \u043C\u0435\u043B\u044C\u043A\u0430\u0435\u0442
      \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435 \u2014
      \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E\u0435 \u043E\u0441\u043E\u0437\u043D\u0430\u043D\u0438\u0435
      \u0442\u043E\u0433\u043E, \u0447\u0442\u043E \u0438\u043C \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043F\u043E\u0440\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u0414\u0436\u0443\u043B\u0438\u044F"
    speakerNameHint: "\u0414\u0436\u0443\u043B\u0438\u044F"
    speaker: {fileID: 11400000, guid: e706e7d1a91e19d4abff1ac05facf1ab, type: 2}
    emotion: 3
    richText: "\u041F\u0440\u043E\u0441\u0442\u0438, \u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041F\u0435\u0447\u0430\u043B\u044C"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0415\u0451 \u0433\u043E\u043B\u043E\u0441 \u0437\u0432\u0443\u0447\u0438\u0442
      \u0440\u043E\u0432\u043D\u043E \u0438 \u043F\u043E-\u0434\u0435\u043B\u043E\u0432\u043E\u043C\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u0414\u0436\u0443\u043B\u0438\u044F"
    speakerNameHint: "\u0414\u0436\u0443\u043B\u0438\u044F"
    speaker: {fileID: 11400000, guid: e706e7d1a91e19d4abff1ac05facf1ab, type: 2}
    emotion: 17
    richText: "\u041C\u044B \u043E\u0447\u0435\u043D\u044C \u0441\u043F\u0435\u0448\u0438\u043C."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u043D\u0435 \u043F\u0435\u0440\u0435\u043C\u0438\u043D\u0430\u0435\u0442\u0441\u044F
      \u0441 \u043D\u043E\u0433\u0438 \u043D\u0430 \u043D\u043E\u0433\u0443, \u0430
      \u0441\u0442\u043E\u0438\u0442 \u043F\u0440\u044F\u043C\u043E, \u043B\u0438\u0448\u044C
      \u043A\u0440\u0435\u043F\u0447\u0435 \u0441\u0436\u0438\u043C\u0430\u0435\u0442
      \u0441\u0443\u043C\u043E\u0447\u043A\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u043C\u043E\u0442\u0440\u0438\u0442 \u043C\u043D\u0435 \u0432
      \u0433\u043B\u0430\u0437\u0430, \u043D\u043E \u0432\u0437\u0433\u043B\u044F\u0434
      \u0443 \u043D\u0435\u0451 \u043E\u0442\u0441\u0442\u0440\u0430\u043D\u0451\u043D\u043D\u044B\u0439,
      \u0443\u0436\u0435 \u043F\u043E\u0433\u0440\u0443\u0436\u0451\u043D\u043D\u044B\u0439
      \u0432 \u043F\u0440\u0435\u0434\u0441\u0442\u043E\u044F\u0449\u0438\u0435 \u0437\u0430\u0431\u043E\u0442\u044B."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u0414\u0436\u0443\u043B\u0438\u044F"
    speakerNameHint: "\u0414\u0436\u0443\u043B\u0438\u044F"
    speaker: {fileID: 11400000, guid: e706e7d1a91e19d4abff1ac05facf1ab, type: 2}
    emotion: 17
    richText: "\u0423 \u043D\u0430\u0441 \u0434\u0435\u043B\u0430."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: "\u0414\u0436\u0443\u043B\u0438\u044F"
    speakerNameHint: "\u0414\u0436\u0443\u043B\u0438\u044F"
    speaker: {fileID: 11400000, guid: e706e7d1a91e19d4abff1ac05facf1ab, type: 2}
    emotion: 17
    richText: "\u0415\u0449\u0451 \u0440\u0430\u0437 \u0438\u0437\u0432\u0438\u043D\u0438."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0448\u0435\u043F\u0447\u0435\u0442, \u043F\u044B\u0442\u0430\u044F\u0441\u044C
      \u043F\u0440\u043E\u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0443\u0442\u044C
      \u043C\u0438\u043C\u043E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043D\u0435 \u043C\u043E\u0433\u0443 \u043F\u0440\u043E\u043C\u043E\u043B\u0447\u0430\u0442\u044C.
      \u0420\u0435\u0437\u043A\u043E \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u044E\u0441\u044C
      \u0438\u2026"
    style: {fileID: 0}
    authorComment: 
