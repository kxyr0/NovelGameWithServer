  guid: mps_s01e02_l1349_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: b27e7dab8348bb74dadb44a55332325d, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u0414\u043E\u043D"
  - character: {fileID: 11400000, guid: 88ab372d37d4ecb4fa9362f48f0ced63, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0443\u0441\u0430\u043C\u0438"
  - character: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0423 \u0432\u0445\u043E\u0434\u0430 \u043C\u0435\u043D\u044F \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044E\u0442
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0447\u0451\u0440\u043D\u044B\u0445
      \u0430\u0432\u0442\u043E\u043C\u043E\u0431\u0438\u043B\u0435\u0439. \u0422\u0430\u043A\u0438\u0445,
      \u0447\u0442\u043E \u044F \u0443\u0436\u0435 \u0432\u0438\u0434\u0435\u043B\u0430
      \u043F\u0440\u0435\u0436\u0434\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041B\u044E\u0434\u0435\u0439 \u043D\u0430 \u0443\u043B\u0438\u0446\u0435
      \u0441\u0442\u0430\u043B\u043E \u043C\u0435\u043D\u044C\u0448\u0435: \u043F\u043E\u0445\u043E\u043B\u043E\u0434\u0430\u043B\u043E,
      \u0438 \u043A\u0442\u043E-\u0442\u043E \u0443\u0448\u0451\u043B \u0434\u043E\u043C\u043E\u0439,
      \u0430 \u043A\u0442\u043E-\u0442\u043E \u043D\u0430\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F
      \u0432\u043D\u0443\u0442\u0440\u044C, \u0433\u0440\u0435\u0442\u044C\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043E\u0431\u0445\u043E\u0436\u0443 \u0437\u0434\u0430\u043D\u0438\u0435
      \u0438 \u043D\u0430\u0447\u0438\u043D\u0430\u044E \u0445\u043E\u0434\u0438\u0442\u044C
      \u0432\u0437\u0430\u0434-\u0432\u043F\u0435\u0440\u0451\u0434, \u0440\u0430\u0437\u043C\u044B\u0448\u043B\u044F\u044F,
      \u0432\u0435\u0440\u043D\u044B\u0439 \u043B\u0438 \u0441\u0434\u0435\u043B\u0430\u043B\u0430
      \u0432\u044B\u0431\u043E\u0440."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0434\u043D\u0430\u043A\u043E \u043C\u0435\u043D\u044F \u0432\u044B\u0431\u0438\u0432\u0430\u044E\u0442
      \u0438\u0437 \u0440\u0430\u0437\u0434\u0443\u043C\u0438\u0439 \u0434\u0432\u0430
      \u0440\u0435\u0437\u043A\u0438\u0445 \u0433\u043E\u043B\u043E\u0441\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u0414\u043E\u043D"
    speakerNameHint: "\u0414\u043E\u043D"
    speaker: {fileID: 11400000, guid: b27e7dab8348bb74dadb44a55332325d, type: 2}
    emotion: 17
    richText: "\u041C\u0438\u043B\u0435\u0434\u0438."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0443\u0441\u0430\u043C\u0438"
    speakerNameHint: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0443\u0441\u0430\u043C\u0438"
    speaker: {fileID: 11400000, guid: 88ab372d37d4ecb4fa9362f48f0ced63, type: 2}
    emotion: 13
    richText: "\u0414\u043E\u0431\u0440\u043E\u0433\u043E \u0432\u0435\u0447\u0435\u0440\u0430,
      \u0441\u0438\u043D\u044C\u043E\u0440\u0438\u0442\u0430."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0415\u0445\u0438\u0434\u043D\u0430\u044F \u0443\u043B\u044B\u0431\u043A\u0430"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u0435\u0440\u0434\u0446\u0435 \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432 \u043F\u044F\u0442\u043A\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0438 \u2014 \u0442\u0435, \u043A\u0442\u043E \u0447\u0442\u043E-\u0442\u043E
      \u0437\u043D\u0430\u0435\u0442 \u043E\u0431 \u043E\u0442\u0446\u0435, \u0438
      \u0441\u0435\u0439\u0447\u0430\u0441 \u043C\u043E\u0439 \u0448\u0430\u043D\u0441
      \u0432\u044B\u044F\u0441\u043D\u0438\u0442\u044C, \u0447\u0442\u043E \u0438\u043C\u0435\u043D\u043D\u043E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435\u2026"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u0434\u0435\u043B\u0430\u044E \u043F\u0430\u0443\u0437\u0443,
      \u043F\u044B\u0442\u0430\u044F\u0441\u044C \u043F\u043E\u043D\u044F\u0442\u044C,
      \u043A\u0430\u043A \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E \u043A
      \u043D\u0438\u043C \u043E\u0431\u0440\u0430\u0442\u0438\u0442\u044C\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u0414\u043E\u043D"
    speakerNameHint: "\u0414\u043E\u043D"
    speaker: {fileID: 11400000, guid: b27e7dab8348bb74dadb44a55332325d, type: 2}
    emotion: 17
    richText: "\u0422\u043E\u043D\u0438 \u0420\u0438\u0446\u0446\u043E."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0443\u0441\u0430\u043C\u0438"
    speakerNameHint: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0443\u0441\u0430\u043C\u0438"
    speaker: {fileID: 11400000, guid: 88ab372d37d4ecb4fa9362f48f0ced63, type: 2}
    emotion: 9
    richText: "\u0414\u0436\u0443\u0437\u0435\u043F\u043F\u0435 \u0424\u0430\u0431\u0440\u0438\u0446\u0438\u043E."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0417\u0430\u0434\u0443\u043C\u0447\u0438\u0432\u044B\u0439
      \u0432\u0437\u0433\u043B\u044F\u0434 \u0432\u0432\u0435\u0440\u0445 \u0432\u043B\u0435\u0432\u043E"
