    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 2
    richText: "\xAB\u0414\u0430\u0436\u0435 \u0441\u0435\u0439\u0447\u0430\u0441
      \u044F \u0441\u0438\u0436\u0443 \u0441 \u0447\u0435\u043C-\u0442\u043E \u043A\u0440\u0435\u043F\u043A\u0438\u043C
      \u0432 \u0431\u043E\u043A\u0430\u043B\u0435, \u0430 \u043D\u0435 \u0441 \u043F\u0440\u043E\u0441\u0442\u044B\u043C
      \u0447\u0430\u0435\u043C\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 2
    richText: "\xAB\u0427\u0442\u043E \u0436 \u043F\u043E\u0434\u0435\u043B\u0430\u0442\u044C
      \u2014 \u043F\u043E\u0432\u043E\u0434\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 21
    richText: "\xAB\u0413\u043B\u0430\u0432\u043D\u043E\u0435 \u2014 \u043D\u0435
      \u043F\u0440\u0438\u0441\u0442\u0440\u0430\u0441\u0442\u0438\u0442\u044C\u0441\u044F
      \u0435\u0449\u0451 \u0438 \u043A \u043E\u043F\u0440\u0430\u0432\u0434\u0430\u043D\u0438\u044F\u043C
      \u043C\u043E\u0435\u0439 \u0438\u0437\u043B\u0438\u0448\u043D\u0435\u0439 \u0442\u044F\u0433\u0438
      \u043A \u0441\u043F\u0438\u0440\u0442\u043D\u043E\u043C\u0443\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0417\u0430\u043A\u0430\u0442\u0438\u043B\u0430
      \u0433\u043B\u0430\u0437\u0430"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u0434\u0435\u043B\u0430\u044E \u043F\u0430\u0440\u0443 \u0433\u043B\u043E\u0442\u043A\u043E\u0432,
      \u043D\u0430\u0441\u043B\u0430\u0436\u0434\u0430\u044F\u0441\u044C \u0432\u043A\u0443\u0441\u043E\u043C
      \u0438\u0437\u044B\u0441\u043A\u0430\u043D\u043D\u043E\u0433\u043E \u0432\u0438\u043D\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 2
    richText: "\xAB\u0414\u0440\u0443\u0433 \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u0431\u0430\u043B\u0443\u0435\u0442\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 27
    richText: "\xAB\u0412 \u0434\u0435\u0442\u0441\u0442\u0432\u0435 \u043E\u043D
      \u043B\u0438\u0448\u044C \u043F\u0435\u0441\u043A\u043E\u043C \u043C\u0435\u043D\u044F
      \u043C\u043E\u0433 \u0443\u0433\u043E\u0441\u0442\u0438\u0442\u044C\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430 \u0441 \u0437\u0443\u0431\u0430\u043C\u0438"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 8
    richText: "\xAB\u041D\u0435\u0443\u0436\u0442\u043E \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0430\u043C
      \u043D\u044B\u043D\u0447\u0435 \u0442\u0430\u043A \u0449\u0435\u0434\u0440\u043E
      \u043F\u043B\u0430\u0442\u044F\u0442?\xBB"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0432\u0437\u0433\u043B\u044F\u0434"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u0442\u0430\u0432\u043B\u044E \u0431\u043E\u043A\u0430\u043B
      \u043E\u0431\u0440\u0430\u0442\u043D\u043E \u043D\u0430 \u0441\u0442\u043E\u043B\u0438\u043A
      \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u044E \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440
      \u0441 \u041B\u0443\u043A\u043E\u0439."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\u041D\u0430 \u043F\u043E\u0445\u043E\u0440\u043E\u043D\u0430\u0445
      \u0431\u044B\u043B\u043E \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043D\u0430\u0440\u043E\u0434\u0443."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\u041F\u0430\u0440\u0430 \u0435\u0433\u043E \u043A\u043E\u043B\u043B\u0435\u0433,
      \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0445, \u0410\u043D\u0442\u043E\u043D\u0438\u043E
      \u0442\u043E\u0436\u0435 \u043F\u0440\u0438\u0448\u0451\u043B."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E \u0433\u043E\u0441\u0442\u044F\u0445 \u0432 \u0447\u0451\u0440\u043D\u044B\u0445
      \u043F\u0438\u0434\u0436\u0430\u043A\u0430\u0445 \u044F \u043F\u0440\u0435\u0434\u043F\u043E\u0447\u0438\u0442\u0430\u044E
      \u0443\u043C\u043E\u043B\u0447\u0430\u0442\u044C."
    style: {fileID: 0}
    authorComment: 
