  guid: mps_s01e02_l1248_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0414\u043E\u0440\u043E\u0433\u043E\u0435 \u043F\u043B\u0430\u0442\u044C\u0435,
      \u043F\u0440\u044F\u043C\u0430\u044F \u0441\u043F\u0438\u043D\u0430, \u043E\u0441\u0442\u0440\u044B\u0435
      \u0443\u043B\u044B\u0431\u043A\u0438 \u0438 \u0447\u0451\u0440\u043D\u044B\u0435,
      \u0432\u0437\u0432\u0438\u043D\u0447\u0435\u043D\u043D\u044B\u0435 \u0443\u0441\u044B
      \u2014 \u043E\u043D\u0438 \u043F\u0440\u043E\u0445\u043E\u0434\u044F\u0442
      \u043C\u0438\u043C\u043E \u043B\u044E\u0434\u0435\u0439 \u043A \u0434\u0440\u0443\u0433\u043E\u043C\u0443
      \u043A\u043E\u043D\u0446\u0443 \u0437\u0430\u043B\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0427\u0435\u0442\u0432\u0435\u0440\u044B\u0445 \u0438\u0437 \u043D\u0438\u0445
      \u044F \u0443\u0436\u0435 \u0432\u0438\u0434\u0435\u043B\u0430, \u0441 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C\u0438
      \u043D\u0435 \u0437\u043D\u0430\u043A\u043E\u043C\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 6
    richText: "\xAB\u041C\u0443\u0436\u0447\u0438\u043D\u044B \u0441 \u043A\u043B\u0430\u0434\u0431\u0438\u0449\u0430!\xBB"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u0434\u0438\u0432\u043B\u0435\u043D\u0438\u0435"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 32
    richText: "\xAB\u0410 \u0441 \u043D\u0438\u043C\u0438 \u0434\u0430\u043C\u0430
      \u0438 \u043F\u0430\u0440\u0435\u043D\u0451\u043A, \u0447\u0442\u043E \u043F\u0440\u0438\u0435\u0437\u0436\u0430\u043B\u0438
      \u043A \u0410\u043D\u0442\u043E\u043D\u0438\u043E!\xBB"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041F\u0440\u0438\u0449\u0443\u0440"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u0430\u0440\u043E\u0434 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u043D\u0438\u0445 \u043F\u043E-\u0440\u0430\u0437\u043D\u043E\u043C\u0443:
      \u043A\u0442\u043E-\u0442\u043E \u0441 \u0438\u0441\u043F\u0443\u0433\u043E\u043C,
      \u043A\u0442\u043E-\u0442\u043E \u0441 \u0432\u043E\u043E\u0434\u0443\u0448\u0435\u0432\u043B\u0435\u043D\u0438\u0435\u043C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0434\u043D\u0430\u043A\u043E \u0443 \u0444\u0430\u0448\u0438\u0441\u0442\u043E\u0432
      \u043D\u0430 \u043B\u0438\u0446\u0430\u0445 \u043E\u0434\u043D\u0430 \u0438
      \u0442\u0430 \u0436\u0435 \u044D\u043C\u043E\u0446\u0438\u044F \u2014 \u043D\u0435\u043F\u0440\u0438\u044F\u0437\u043D\u044C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041A\u043E\u0437\u0430 \u041D\u043E\u0441\u0442\u0440\u0430, \u0441\u043B\u043E\u0432\u043D\u043E
      \u043F\u043B\u044B\u0432\u044F \u043F\u043E \u0442\u0435\u0447\u0435\u043D\u0438\u044E,
      \u0434\u043E\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F \u0434\u043E \u0412\u0418\u041F-\u0441\u0442\u043E\u043B\u0430
      \u0438 \u0440\u0430\u0441\u0441\u0430\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432 \u0441\u0432\u043E\u0451\u043C \u043F\u043E\u0440\u044F\u0434\u043A\u0435."
    style: {fileID: 0}
    authorComment: 
