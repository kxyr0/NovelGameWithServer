    speaker: {fileID: 11400000, guid: 46089e6d6a61b544fb64ae4a472e10b4, type: 2}
    emotion: 17
    richText: "\u0412\u0430\u0448 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0439
      \u043D\u0430\u043B\u043E\u0433\u043E\u0432\u044B\u0439 \u043A\u043E\u0434."
