    richText: "\xAB\u042D\u0442\u0430 \u0437\u043C\u0435\u044F \u0441\u0438\u0434\u0435\u043B\u0430
      \u043D\u0430\u043F\u0440\u043E\u0442\u0438\u0432, \u043D\u0430\u0433\u043B\u043E
