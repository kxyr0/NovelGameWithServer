  - character: {fileID: 11400000, guid: b87e1e261798dbd4a8835e60e453fe98, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430"
  lines:
  - speakerId: "\u041B\u0443\u043A\u0430"
    speakerNameHint: "\u041B\u0443\u043A\u0430"
    speaker: {fileID: 11400000, guid: 95d1e47740b729147bcd7d679212dd21, type: 2}
    emotion: 3
    richText: "\u0415\u0441\u043B\u0438 \u0431\u044B \u044F \u0443\u0437\u043D\u0430\u043B
      \u0440\u0430\u043D\u044C\u0448\u0435, \u043F\u0440\u0438\u043C\u0447\u0430\u043B\u0441\u044F
      \u0431\u044B \u0441\u0430\u043C\u044B\u043C \u0431\u044B\u0441\u0442\u0440\u044B\u043C
      \u0432\u0435\u0442\u0440\u043E\u043C \u0432 \u041F\u0430\u043B\u0435\u0440\u043C\u043E
      \u0438 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u043B \u0442\u0435\u0431\u044F."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0413\u0440\u0443\u0441\u0442\u044C"
  - speakerId: "\u041B\u0443\u043A\u0430"
    speakerNameHint: "\u041B\u0443\u043A\u0430"
    speaker: {fileID: 11400000, guid: 95d1e47740b729147bcd7d679212dd21, type: 2}
    emotion: 28
    richText: "\u041D\u043E \u043F\u043E\u0447\u0442\u0430 \u0445\u043E\u0434\u0438\u0442
      \u043D\u0435 \u0442\u0430\u043A \u0431\u044B\u0441\u0442\u0440\u043E, \u043A\u0430\u043A
      \u0445\u043E\u0442\u0435\u043B\u043E\u0441\u044C \u0431\u044B, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u044F \u043F\u0440\u0438\u0435\u0445\u0430\u043B, \u043A\u0430\u043A \u0442\u043E\u043B\u044C\u043A\u043E
      \u0441\u043C\u043E\u0433."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u0437\u0433\u043B\u044F\u0434 \u0432\u043F\u0440\u0430\u0432\u043E"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 2
    richText: "\u041D\u0438\u0447\u0435\u0433\u043E \u0441\u0442\u0440\u0430\u0448\u043D\u043E\u0433\u043E,
      \u041B\u0443\u043A\u0430."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 28
    richText: "\u042F, \u043D\u0430\u043E\u0431\u043E\u0440\u043E\u0442, \u043F\u0440\u0435\u0434\u043F\u043E\u0447\u043B\u0430
      \u0431\u044B, \u0447\u0442\u043E\u0431\u044B \u0442\u0430\u043C \u043D\u0435
      \u0441\u043E\u0431\u0438\u0440\u0430\u043B\u043E\u0441\u044C \u0441\u0442\u043E\u043B\u044C\u043A\u043E
      \u043D\u0430\u0440\u043E\u0434\u0443."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u0437\u0433\u043B\u044F\u0434 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 19
    richText: "\u0425\u043E\u0442\u0435\u043B\u043E\u0441\u044C \u043F\u043E\u0431\u044B\u0442\u044C
      \u0441 \u043D\u0438\u043C \u043D\u0430\u0435\u0434\u0438\u043D\u0435."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u0437\u0433\u043B\u044F\u0434 \u0432\u043D\u0438\u0437"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 2
    richText: "\u0414\u0430 \u0438 \u0442\u0435\u043C \u0431\u043E\u043B\u0435\u0435,
      \u0442\u044B \u0432\u0435\u0434\u044C \u043F\u0440\u0438\u0435\u0445\u0430\u043B,
      \u043F\u0443\u0441\u0442\u044C \u0438 \u043D\u0435 \u0441\u0440\u0430\u0437\u0443."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 2
    richText: "\u0410 \u0434\u043B\u044F \u043C\u0435\u043D\u044F \u044D\u0442\u043E
      \u043C\u043D\u043E\u0433\u043E\u0435 \u0437\u043D\u0430\u0447\u0438\u0442."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: "\u041B\u0443\u043A\u0430"
    speakerNameHint: "\u041B\u0443\u043A\u0430"
    speaker: {fileID: 11400000, guid: 95d1e47740b729147bcd7d679212dd21, type: 2}
    emotion: 2
    richText: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u0434\u0435\u043B\u0430\u044E \u0435\u0449\u0451 \u0433\u043B\u043E\u0442\u043E\u043A
      \u0438 \u0432\u043D\u043E\u0432\u044C \u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u044E
      \u0437\u0430\u043B."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u0435\u043C\u0438 \u0438\u0433\u0440\u0430\u0435\u0442, \u041F\u0430\u043B\u0435\u0440\u043C\u043E
      \u0436\u0438\u0432\u0451\u0442 \u0432\u0435\u0447\u0435\u0440\u043E\u043C,
      \u0430 \u043A\u043E\u0433\u043E-\u0442\u043E \u0434\u0430\u0436\u0435 \u0434\u043E\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442
      \u043A\u0430\u043A\u043E\u0439-\u0442\u043E \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u044B\u0439
      \u043C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u043B\u044C\u0432\u0438\u043D\u043E\u0439
      \u043F\u0440\u0438\u0447\u0451\u0441\u043A\u043E\u0439."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430"
    speakerNameHint: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: b87e1e261798dbd4a8835e60e453fe98, type: 2}
    emotion: 17
    richText: "\u2026"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u0432 \u0447\u0451\u043C
      \u0431\u0435\u0434\u043D\u044F\u0433\u0430 \u0443\u0441\u043F\u0435\u043B \u043F\u0440\u043E\u0432\u0438\u043D\u0438\u0442\u044C\u0441\u044F?"
    style: {fileID: 0}
    authorComment: 
