  lines:
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 30
    richText: "\xAB\u041D\u0435 \u0445\u043E\u0447\u0443 \u0441\u0435\u0439\u0447\u0430\u0441
      \u0437\u0430\u0431\u0438\u0432\u0430\u0442\u044C \u0441\u0435\u0431\u0435 \u044D\u0442\u0438\u043C
      \u0433\u043E\u043B\u043E\u0432\u0443\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u0430\u044F"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\xAB\u0420\u0430\u0437\u0431\u0435\u0440\u0443\u0441\u044C \u0441
      \u044D\u0442\u0438\u043C \u043F\u043E\u0437\u0434\u043D\u0435\u0435. \u0412
      \u043A\u043E\u043D\u0446\u0435 \u043A\u043E\u043D\u0446\u043E\u0432, \u0435\u0441\u0442\u044C
      \u0435\u0449\u0451 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u0434\u043D\u0435\u0439
      \u0432 \u0437\u0430\u043F\u0430\u0441\u0435\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 2
    richText: "\xAB\u0411\u043B\u0430\u0433\u043E, \u0447\u0442\u043E \u0435\u0441\u0442\u044C
      \u043A\u043E\u043C\u0443 \u0434\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u0434\u0435\u043B\u0430
      \u0432 \u043C\u043E\u0451 \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435.
      \u041D\u0435 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u044E,
      \u043A\u0430\u043A \u0431\u044B \u044F \u0441\u0435\u0439\u0447\u0430\u0441
      \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0430\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u043E\u0434\u043D\u044F\u0432\u0448\u0438\u0441\u044C \u0441
      \u043A\u0440\u0435\u0441\u043B\u0430, \u044F \u0443\u0431\u0438\u0440\u0430\u044E
      \u043F\u0438\u0441\u044C\u043C\u0430 \u0432 \u044F\u0449\u0438\u043A \u0441\u0435\u043A\u0440\u0435\u0442\u0435\u0440\u0430,
      \u0440\u0435\u0448\u0438\u0432 \u0437\u0430\u043D\u044F\u0442\u044C\u0441\u044F
      \u0443\u0431\u043E\u0440\u043A\u043E\u0439."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0417\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435
      \u0432\u0440\u0435\u043C\u044F \u043D\u0438\u043A\u0442\u043E \u043D\u0435
      \u0441\u043B\u0435\u0434\u0438\u043B \u0437\u0430 \u0434\u043E\u043C\u043E\u043C
      \u2014 \u043D\u0430 \u044D\u0442\u043E \u0441\u043E\u0432\u0441\u0435\u043C
      \u043D\u0435 \u0431\u044B\u043B\u043E \u043D\u0438 \u0441\u0438\u043B, \u043D\u0438
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0410 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u0434\u0432\u0430
      \u0434\u043D\u044F \u044F \u0438 \u0441\u0430\u043C\u0430 \u0434\u043E\u0431\u0430\u0432\u0438\u043B\u0430
      \u043A\u043E\u043C\u043D\u0430\u0442\u0430\u043C \u0445\u0430\u043E\u0441\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u0440\u0438\u0448\u043B\u043E \u0432\u0440\u0435\u043C\u044F
      \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C \u0435\u0433\u043E."
    style: {fileID: 0}
    authorComment: 
