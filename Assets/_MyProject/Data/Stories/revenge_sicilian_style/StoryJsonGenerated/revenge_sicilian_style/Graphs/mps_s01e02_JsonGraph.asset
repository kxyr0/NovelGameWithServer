  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: mps_s01e02_l0054_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: bb87cc9663406034d82c0ff90ef0dfcf, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u041E\u0442\u0435\u0446"
  - character: {fileID: 11400000, guid: 9008b6e1b9b04464787ca16ebd4272e5, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u041C\u0430\u0442\u044C"
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0442\u0435\u0446 \u0438 \u043C\u0430\u0442\u044C \u0441\u0438\u0434\u0435\u043B\u0438
      \u043D\u0430 \u0431\u0435\u0440\u0435\u0433\u0443 \u0421\u0440\u0435\u0434\u0438\u0437\u0435\u043C\u043D\u043E\u0433\u043E
      \u043C\u043E\u0440\u044F, \u0443 \u0441\u0430\u043C\u043E\u0439 \u043A\u0440\u043E\u043C\u043A\u0438
      \u0432\u043E\u0434\u044B, \u0433\u0434\u0435 \u043F\u0435\u0441\u043E\u043A
      \u0435\u0449\u0451 \u0445\u0440\u0430\u043D\u0438\u043B \u0434\u043D\u0435\u0432\u043D\u043E\u0435
      \u0442\u0435\u043F\u043B\u043E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u043E\u043B\u043D\u044B \u043B\u0435\u043D\u0438\u0432\u043E
      \u043D\u0430\u043A\u0430\u0442\u044B\u0432\u0430\u043B\u0438 \u043D\u0430 \u0431\u0435\u0440\u0435\u0433,
      \u0438\u0445 \u0442\u0438\u0445\u0438\u0439 \u0448\u0451\u043F\u043E\u0442
      \u0441\u043B\u0438\u0432\u0430\u043B\u0441\u044F \u0441 \u0442\u0440\u0435\u0441\u043A\u043E\u043C
      \u043A\u043E\u0441\u0442\u0440\u0430, \u043F\u043B\u0430\u043C\u044F \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
      \u043F\u043B\u044F\u0441\u0430\u043B\u043E \u0432 \u0432\u0435\u0447\u0435\u0440\u043D\u0435\u043C
      \u0432\u043E\u0437\u0434\u0443\u0445\u0435, \u0431\u0440\u043E\u0441\u0430\u044F
      \u043D\u0430 \u043B\u0438\u0446\u0430 \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0435\u0439
      \u043C\u044F\u0433\u043A\u0438\u0435, \u0437\u043E\u043B\u043E\u0442\u0438\u0441\u0442\u044B\u0435
      \u043E\u0442\u0431\u043B\u0435\u0441\u043A\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u0431\u0440\u043E\u0434\u0438\u043B\u0430 \u043D\u0435\u043F\u043E\u0434\u0430\u043B\u0451\u043A\u0443,
      \u0443 \u0441\u0430\u043C\u043E\u0439 \u0432\u043E\u0434\u044B, \u0431\u043E\u0441\u044B\u043C\u0438
      \u043D\u043E\u0433\u0430\u043C\u0438 \u043E\u0449\u0443\u0449\u0430\u044F \u043F\u0440\u043E\u0445\u043B\u0430\u0434\u0443
      \u043F\u0440\u0438\u0431\u043E\u044F."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412 \u0440\u0443\u043A\u0430\u0445 \u0431\u044B\u043B\u0430 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F
      \u043F\u043B\u0435\u0442\u0451\u043D\u0430\u044F \u043A\u043E\u0440\u0437\u0438\u043D\u043A\u0430
      - \u044F \u0438\u0441\u043A\u0430\u043B\u0430 \u0441\u0430\u043C\u044B\u0435
      \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u0435, \u0440\u0430\u0441\u043F\u0438\u0441\u043D\u044B\u0435
      \u0440\u0430\u043A\u0443\u0448\u043A\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043C\u043E\u0440\u0435 \u0438\u043D\u043E\u0433\u0434\u0430 \u0434\u0430\u0440\u0438\u043B\u043E
      \u0431\u0435\u0440\u0435\u0433\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0420\u043E\u0434\u0438\u0442\u0435\u043B\u0438 \u0431\u044B\u043B\u0438
      \u0437\u0430\u043D\u044F\u0442\u044B \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u043E\u043C,
      \u0438 \u044F \u0441\u0442\u0430\u0440\u0430\u043B\u0430\u0441\u044C \u043D\u0435
      \u0432\u0441\u043B\u0443\u0448\u0438\u0432\u0430\u0442\u044C\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u0445 \u0434\u0435\u043B\u043E\u0432\u044B\u0435 \u043E\u0431\u0441\u0443\u0436\u0434\u0435\u043D\u0438\u044F
      \u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C \u0441\u043A\u0443\u0447\u043D\u044B\u043C\u0438
      \u0438 \u0441\u043E\u043D\u043D\u044B\u043C\u0438, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u044F \u0432\u0441\u0435\u0433\u0434\u0430 \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0430
      \u043A\u0430\u043A\u043E\u0435-\u043D\u0438\u0431\u0443\u0434\u044C \u0437\u0430\u043D\u044F\u0442\u0438\u0435,
      \u043B\u0438\u0448\u044C \u0431\u044B \u043D\u0435 \u043F\u043E\u0433\u0440\u0443\u0436\u0430\u0442\u044C\u0441\u044F
      \u0432 \u043C\u0438\u0440 \u0432\u0437\u0440\u043E\u0441\u043B\u044B\u0445
      \u0437\u0430\u0431\u043E\u0442."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u043E \u0433\u043E\u043B\u043E\u0441\u0430 \u0434\u043E\u043B\u0435\u0442\u0430\u043B\u0438
      \u0434\u043E \u043C\u0435\u043D\u044F, \u043F\u0440\u043E\u0440\u044B\u0432\u0430\u044F\u0441\u044C
      \u0441\u043A\u0432\u043E\u0437\u044C \u0448\u0443\u043C \u0432\u043E\u043B\u043D
      \u0438 \u0432\u0435\u0442\u0440\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u041E\u0442\u0435\u0446"
    speakerNameHint: "\u041E\u0442\u0435\u0446"
    speaker: {fileID: 11400000, guid: bb87cc9663406034d82c0ff90ef0dfcf, type: 2}
    emotion: 2
    richText: "\u042F \u043F\u043E\u0447\u0442\u0438 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u043F\u043E\u0434\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u043B
      \u0432 \u043A\u043E\u0441\u0442\u0451\u0440 \u0441\u0443\u0445\u0443\u044E
      \u0432\u0435\u0442\u043A\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u0441\u043A\u0440\u044B \u0432\u0437\u043B\u0435\u0442\u0430\u043B\u0438
      \u0432\u0432\u0435\u0440\u0445, \u0443\u0442\u043E\u043F\u0430\u044F \u0432
      \u043D\u043E\u0447\u043D\u043E\u043C \u043D\u0435\u0431\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u041E\u0442\u0435\u0446"
    speakerNameHint: "\u041E\u0442\u0435\u0446"
    speaker: {fileID: 11400000, guid: bb87cc9663406034d82c0ff90ef0dfcf, type: 2}
    emotion: 2
    richText: "\u0421\u043A\u043E\u0440\u043E \u0441\u043C\u043E\u0436\u0435\u043C
      \u043D\u0430\u0437\u043D\u0430\u0447\u0430\u0442\u044C \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u0435."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: "\u041C\u0430\u0442\u044C"
    speakerNameHint: "\u041C\u0430\u0442\u044C"
    speaker: {fileID: 11400000, guid: 9008b6e1b9b04464787ca16ebd4272e5, type: 2}
    emotion: 2
    richText: "\u042D\u0442\u043E \u0432\u0435\u043B\u0438\u043A\u043E\u043B\u0435\u043F\u043D\u0430\u044F
      \u043D\u043E\u0432\u043E\u0441\u0442\u044C."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
