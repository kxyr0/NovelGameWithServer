    emotion: 0
    richText: "\u041E\u0434\u043D\u0430\u043A\u043E \u0441\u0442\u0443\u043A \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u0435\u0442\u0441\u044F,
      \u0430 \u043F\u043E\u0441\u043B\u0435 \u2014 \u043E\u0431\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u0430 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437 \u043E\u043D
      \u0432\u044B\u0434\u0435\u0440\u0433\u0438\u0432\u0430\u0435\u0442 \u043C\u0435\u043D\u044F
      \u0438\u0437 \u043E\u0446\u0435\u043F\u0435\u043D\u0435\u043D\u0438\u044F."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 21
    richText: ...
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0440\u0430\u0441\u0442\u0440\u0451\u043F\u0430\u043D\u043D\u044B\u0435
      \u0432\u043E\u043B\u043E\u0441\u044B, \u043D\u043E\u0447\u043D\u0443\u0448\u043A\u0430,
      \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0435 \u0433\u043B\u0430\u0437\u0430"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\xAB\u041A\u0442\u043E \u0442\u0430\u043C?\xBB"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u044C\u043D\u043E"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u0441 \u0442\u0440\u0443\u0434\u043E\u043C \u043E\u0442\u0440\u044B\u0432\u0430\u044E\u0441\u044C
      \u043E\u0442 \u0441\u0442\u043E\u043B\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u043E\u0437\u0432\u043E\u043D\u043E\u0447\u043D\u0438\u043A
      \u043F\u0440\u043E\u0442\u0435\u0441\u0442\u0443\u044E\u0449\u0435 \u0445\u0440\u0443\u0441\u0442\u0438\u0442
      \u2014 \u0442\u0435\u043B\u043E \u0437\u0430\u0442\u0435\u043A\u043B\u043E
      \u043E\u0442 \u0434\u043E\u043B\u0433\u043E\u0439, \u043D\u0435\u0443\u0434\u043E\u0431\u043D\u043E\u0439
      \u043D\u043E\u0447\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u043E\u043B\u043E\u0441\u044B, \u0441\u043F\u0443\u0442\u0430\u043D\u043D\u044B\u0435
      \u0438 \u0431\u0435\u0437\u0436\u0438\u0437\u043D\u0435\u043D\u043D\u044B\u0435,
      \u0441\u0432\u0438\u0441\u0430\u044E\u0442 \u043F\u0430\u043A\u043B\u0435\u0439,
      \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u044F \u043C\u0435\u043D\u044F
      \u0432 \u043F\u043E\u0434\u043E\u0431\u0438\u0435 \u043E\u0433\u043E\u0440\u043E\u0434\u043D\u043E\u0433\u043E
      \u043F\u0443\u0433\u0430\u043B\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041C\u0435\u043B\u044C\u043A\u043E\u043C \u0433\u043B\u044F\u043D\u0443\u0432
      \u0432 \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043D\u043E\u0435 \u0437\u0435\u0440\u043A\u0430\u043B\u043E,
      \u044F \u043D\u0435 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044E\u0441\u044C
      \u043E\u0442 \u0435\u0434\u043A\u043E\u0433\u043E \u043A\u043E\u043C\u043C\u0435\u043D\u0442\u0430\u0440\u0438\u044F:"
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 2
    richText: "\xAB\u0412\u043E\u0442 \u044D\u0442\u043E \u044F \u043F\u043E\u043D\u0438\u043C\u0430\u044E,
      \u0441\u0438\u0446\u0438\u043B\u0438\u0439\u0441\u043A\u0430\u044F \u043A\u0440\u0430\u0441\u0430\u0432\u0438\u0446\u0430.
      \u0414\u0435\u0432\u0430 \u041C\u0430\u0440\u0438\u044F \u0431\u044B \u043E\u0431\u0437\u0430\u0432\u0438\u0434\u043E\u0432\u0430\u043B\u0430\u0441\u044C\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u043E\u0434\u043D\u044F\u0432\u0448\u0438\u0441\u044C \u0441\u043E
      \u0441\u0442\u0443\u043B\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0432\u0441\u044E \u043D\u043E\u0447\u044C \u0441\u043B\u0443\u0436\u0438\u043B
      \u043C\u043D\u0435 \u043D\u0435 \u0441\u0430\u043C\u043E\u0439 \u043C\u044F\u0433\u043A\u043E\u0439
      \u043A\u0440\u043E\u0432\u0430\u0442\u044C\u044E, \u044F \u043F\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u044E\u0441\u044C,
      \u0440\u0430\u0437\u043C\u0438\u043D\u0430\u044F \u043E\u0434\u0435\u0440\u0435\u0432\u0435\u043D\u0435\u0432\u0448\u0438\u0435
      \u043C\u044B\u0448\u0446\u044B."
    style: {fileID: 0}
    authorComment: 
