    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043D\u0435 \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u044F\u044E\u0441\u044C,
      \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044F, \u043A\u0430\u043A \u043C\u0435\u043D\u044F
      \u0442\u0430\u0449\u0430\u0442 \u043A \u0437\u0430\u0431\u0440\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u043C\u0443
      \u0441\u0442\u043E\u043B\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u041B\u0443\u043A\u0430"
    speakerNameHint: "\u041B\u0443\u043A\u0430"
    speaker: {fileID: 11400000, guid: 95d1e47740b729147bcd7d679212dd21, type: 2}
    emotion: 17
    richText: "\u0414\u043B\u044F \u043D\u0430\u0447\u0430\u043B\u0430 \u0434\u0430\u0432\u0430\u0439
      \u0432\u044B\u043F\u044C\u0435\u043C."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: "\u041B\u0443\u043A\u0430"
    speakerNameHint: "\u041B\u0443\u043A\u0430"
    speaker: {fileID: 11400000, guid: 95d1e47740b729147bcd7d679212dd21, type: 2}
    emotion: 21
    richText: "\u0410 \u0434\u0430\u043B\u044C\u0448\u0435 \u043E\u0431\u0441\u0443\u0434\u0438\u043C
      \u0441\u043E\u0442\u043D\u0438 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u043E\u0432
      \u0440\u0430\u0441\u043F\u0440\u0430\u0432\u044B \u043D\u0430\u0434\u043E \u043C\u043D\u043E\u0439."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0417\u0430\u043A\u0430\u0442\u0438\u0432 \u0433\u043B\u0430\u0437\u0430"
  - speakerId: "\u041B\u0443\u043A\u0430"
    speakerNameHint: "\u041B\u0443\u043A\u0430"
    speaker: {fileID: 11400000, guid: 95d1e47740b729147bcd7d679212dd21, type: 2}
    emotion: 2
    richText: "\u041F\u043E\u043B\u043E\u0432\u0438\u043D\u0443 \u0438\u0437 \u043D\u0438\u0445
      \u044F, \u043A\u043E\u043D\u0435\u0447\u043D\u043E, \u043E\u0442\u0441\u0435\u044E,
      \u0430 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443, \u043C\u043E\u0436\u0435\u0442,
      \u0438 \u0440\u0430\u0441\u0441\u043C\u043E\u0442\u0440\u044E."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u0442\u043E\u043B\u043A\u0430\u044E \u0435\u0433\u043E \u0432\u0442\u043E\u0440\u043E\u0439
      \u0440\u0430\u0437, \u0438 \u043E\u043D \u0437\u0430\u043C\u043E\u043B\u043A\u0430\u0435\u0442."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 2
    richText: "\u0414\u0430\u0432\u0430\u0439 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0431\u0435\u0437 \u0433\u043B\u0443\u043F\u044B\u0445 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u043E\u0432,
      \u0445\u043E\u0440\u043E\u0448\u043E?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u0432\u0438\u0436\u0443, \u043A\u0430\u043A \u043E\u043D \u0440\u0430\u0441\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442\u0441\u044F,
      \u043D\u043E \u0432 \u0442\u0443 \u0436\u0435 \u0441\u0435\u043A\u0443\u043D\u0434\u0443
      \u0432\u043D\u043E\u0432\u044C \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u041B\u0443\u043A\u0430"
    speakerNameHint: "\u041B\u0443\u043A\u0430"
    speaker: {fileID: 11400000, guid: 95d1e47740b729147bcd7d679212dd21, type: 2}
    emotion: 3
    richText: "\u042D\u0445, \u0441\u0430\u043C\u044B\u0435 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u0435
      \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u044B \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F
      \u043E\u0442\u0431\u0440\u043E\u0441\u0438\u0442\u044C."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0413\u0440\u0443\u0441\u0442\u044C"
