  guid: mps_s01e02_l0431_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: 46089e6d6a61b544fb64ae4a472e10b4, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u0410\u0433\u0435\u043D\u0442\u0441\u0442\u0432\u043E"
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u0444\u043E\u043A\u0443\u0441\u0438\u0440\u043E\u0432\u0430\u0432
      \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435 \u043D\u0430 \u043F\u0440\u0430\u0432\u043E\u043C
      \u043F\u0438\u0441\u044C\u043C\u0435, \u044F \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u044E
      \u0431\u0443\u043C\u0430\u0433\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u0410\u0433\u0435\u043D\u0442\u0441\u0442\u0432\u043E"
    speakerNameHint: "\u0410\u0433\u0435\u043D\u0442\u0441\u0442\u0432\u043E"
    speaker: {fileID: 11400000, guid: 46089e6d6a61b544fb64ae4a472e10b4, type: 2}
    emotion: 17
    richText: "\u0421\u0435\u043D\u044C\u043E\u0440\u0438\u0442\u0430 \u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430
      \u0412\u0438\u043B\u043B\u0430\u0440\u0435\u0430\u043B."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0427\u0435\u0440\u043D\u044B\u0439 \u0441\u0438\u043B\u0443\u044D\u0442"
  - speakerId: "\u0410\u0433\u0435\u043D\u0442\u0441\u0442\u0432\u043E"
    speakerNameHint: "\u0410\u0433\u0435\u043D\u0442\u0441\u0442\u0432\u043E"
    speaker: {fileID: 11400000, guid: 46089e6d6a61b544fb64ae4a472e10b4, type: 2}
    emotion: 17
    richText: "\u0412 \u0441\u0432\u044F\u0437\u0438 \u0441 \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u0435\u043C
      \u043D\u0430\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
      \u0434\u0435\u043B\u0430 \u043F\u043E \u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0443
      \u043F\u043E\u043A\u043E\u0439\u043D\u043E\u0433\u043E \u0441\u0438\u043D\u044C\u043E\u0440\u0430
      \u041A\u0430\u0440\u043C\u0435\u043B\u043E \u0412\u0438\u043B\u043B\u0430\u0440\u0435\u0430\u043B\u0430
      \u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043D\u0430\u043B\u043E\u0433\u043E\u0432\u043E\u0439
      \u0441\u043B\u0443\u0436\u0431\u044B \u041F\u0430\u043B\u0435\u0440\u043C\u043E
      \u0443\u0432\u0435\u0434\u043E\u043C\u043B\u044F\u0435\u0442 \u0412\u0430\u0441
      \u043E \u043D\u0430\u043B\u0438\u0447\u0438\u0438 \u0437\u0430\u043A\u043E\u043D\u043D\u043E\u0433\u043E
      \u043F\u0440\u0430\u0432\u0430 \u043D\u0430 \u0432\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u0435
      \u0432 \u043D\u0430\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u043E."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0427\u0435\u0440\u043D\u044B\u0439 \u0441\u0438\u043B\u0443\u044D\u0442"
  - speakerId: "\u0410\u0433\u0435\u043D\u0442\u0441\u0442\u0432\u043E"
    speakerNameHint: "\u0410\u0433\u0435\u043D\u0442\u0441\u0442\u0432\u043E"
    speaker: {fileID: 11400000, guid: 46089e6d6a61b544fb64ae4a472e10b4, type: 2}
    emotion: 17
    richText: "\u0421\u043E\u0433\u043B\u0430\u0441\u043D\u043E \u0438\u043C\u0435\u044E\u0449\u0438\u043C\u0441\u044F
      \u0443 \u043D\u0430\u0441 \u0434\u0430\u043D\u043D\u044B\u043C, \u0443\u0441\u043E\u043F\u0448\u0438\u0439
      \u0437\u0430\u0431\u043B\u0430\u0433\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E
      \u0441\u043E\u0441\u0442\u0430\u0432\u0438\u043B \u0437\u0430\u0432\u0435\u0449\u0430\u043D\u0438\u0435,
      \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u0412\u044B \u0443\u043A\u0430\u0437\u0430\u043D\u044B
      \u043A\u0430\u043A \u043F\u0440\u0430\u0432\u043E\u043F\u0440\u0435\u0435\u043C\u043D\u0438\u043A."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0427\u0435\u0440\u043D\u044B\u0439 \u0441\u0438\u043B\u0443\u044D\u0442"
  - speakerId: "\u0410\u0433\u0435\u043D\u0442\u0441\u0442\u0432\u043E"
    speakerNameHint: "\u0410\u0433\u0435\u043D\u0442\u0441\u0442\u0432\u043E"
    speaker: {fileID: 11400000, guid: 46089e6d6a61b544fb64ae4a472e10b4, type: 2}
    emotion: 17
    richText: "\u0414\u043B\u044F \u043E\u0444\u043E\u0440\u043C\u043B\u0435\u043D\u0438\u044F
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0430 \u043F\u0440\u0430\u0432\u0430
      \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u0438
      \u0438 \u0443\u0440\u0435\u0433\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F
      \u043D\u0430\u043B\u043E\u0433\u043E\u0432\u044B\u0445 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432
      \u0412\u0430\u043C \u043D\u0430\u0434\u043B\u0435\u0436\u0438\u0442 \u044F\u0432\u0438\u0442\u044C\u0441\u044F
      \u0432 \u043D\u0430\u0448\u0435 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0427\u0435\u0440\u043D\u044B\u0439 \u0441\u0438\u043B\u0443\u044D\u0442"
  - speakerId: 
    speakerNameHint: 
