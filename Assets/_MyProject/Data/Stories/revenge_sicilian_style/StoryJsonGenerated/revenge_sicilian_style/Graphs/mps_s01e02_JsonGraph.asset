  guid: mps_s01e02_l1029_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: 95d1e47740b729147bcd7d679212dd21, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u041B\u0443\u043A\u0430"
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F,
      \u043A\u043B\u0430\u0434\u0435\u0442 \u043E\u0434\u043D\u0443 \u0440\u0443\u043A\u0443
      \u043C\u043D\u0435 \u043D\u0430 \u043F\u043B\u0435\u0447\u043E \u0438 \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u043F\u0443\u0441\u0442\u043E\u0433\u043E
      \u0441\u0442\u043E\u043B\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u041B\u0443\u043A\u0430"
    speakerNameHint: "\u041B\u0443\u043A\u0430"
    speaker: {fileID: 11400000, guid: 95d1e47740b729147bcd7d679212dd21, type: 2}
    emotion: 2
    richText: "\u041F\u043E\u0439\u0434\u0451\u043C. \u042F \u0437\u0430\u0431\u0440\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u043B
      \u0441\u0442\u043E\u043B."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
