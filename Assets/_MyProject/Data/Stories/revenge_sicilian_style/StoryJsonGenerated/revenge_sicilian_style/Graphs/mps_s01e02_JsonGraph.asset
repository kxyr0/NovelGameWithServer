  guid: mps_s01e02_l0490_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 4
    richText: "\xAB\u041D\u0435 \u043D\u0443\u0436\u043D\u043E \u0431\u044B\u043B\u043E
      \u0441\u0442\u0435\u043B\u0438\u0442\u044C\u0441\u044F \u043F\u043E\u0434 \u043A\u0430\u0436\u0434\u044B\u0439
      \u043A\u043E\u0448\u0435\u043B\u0451\u043A\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0417\u043B\u043E\u0441\u0442\u044C"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 2
    richText: "\xAB\u0411\u043E\u0433 \u043D\u0430\u043A\u0430\u0437\u0430\u043B
      \u0442\u0435\u0431\u044F \u0437\u0430 \u0442\u0432\u043E\u0438 \u043F\u0440\u043E\u0441\u0442\u0443\u043F\u043A\u0438\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 27
    richText: "\xAB\u0422\u0435\u043F\u0435\u0440\u044C \u0442\u0435\u0431\u0435
      \u043C\u0435\u0441\u0442\u043E \u0432 \u0441\u0430\u043C\u043E\u043C \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u043C
      \u043C\u0435\u0441\u0442\u0435 \u0437\u0435\u043C\u043B\u0438\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430 \u0441 \u0437\u0443\u0431\u0430\u043C\u0438"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 13
    richText: "\xAB\u0417\u043D\u0430\u0439, \u044F \u043D\u0435 \u043F\u0440\u0438\u0434\u0443
      \u043A \u0442\u0435\u0431\u0435, \u0432\u043E \u0447\u0442\u043E \u0431\u044B
      \u0442\u043E \u043D\u0438 \u0441\u0442\u0430\u043B\u043E\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0415\u0445\u0438\u0434\u043D\u0430\u044F \u0443\u043B\u044B\u0431\u043A\u0430"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 13
    richText: "\xAB\u0421\u0442\u0430\u043D\u044C \u043A\u043E\u0440\u043C\u043E\u043C
      \u0434\u043B\u044F \u0447\u0435\u0440\u0432\u0435\u0439, \u0445\u043E\u0442\u044F
      \u0438 \u043E\u043D\u0438, \u043D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430,
      \u043E\u0442\u043A\u0430\u0436\u0443\u0442\u0441\u044F \u043E\u0442 \u0442\u0430\u043A\u043E\u0439
      \u0433\u043D\u0438\u043B\u043E\u0439 \u0442\u0440\u0430\u043F\u0435\u0437\u044B\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0415\u0445\u0438\u0434\u043D\u0430\u044F \u0443\u043B\u044B\u0431\u043A\u0430"
