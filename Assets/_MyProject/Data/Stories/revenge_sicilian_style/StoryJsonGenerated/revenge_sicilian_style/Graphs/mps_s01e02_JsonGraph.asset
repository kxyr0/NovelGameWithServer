    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043D\u0435 \u0437\u0430\u043C\u0435\u0447\u0430\u044E, \u043A\u0430\u043A
      \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u0432\u0430\u044E\u0441\u044C \u0432
      \u0442\u044F\u0436\u0451\u043B\u044B\u0439 \u0441\u043E\u043D \u043F\u0440\u044F\u043C\u043E
      \u0437\u0434\u0435\u0441\u044C, \u043D\u0430 \u0441\u0442\u043E\u043B\u0435,
      \u043F\u0440\u0438\u0434\u0430\u0432\u0438\u0432 \u0430\u043B\u044C\u0431\u043E\u043C
      \u0441 \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u044F\u043C\u0438
      \u2014 \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C \u0431\u044B, \u0446\u0435\u043D\u043D\u044B\u043C\u0438,
      \u043D\u043E \u0442\u0435\u043F\u0435\u0440\u044C \u0432\u044B\u0437\u044B\u0432\u0430\u044E\u0449\u0438\u043C\u0438
      \u043B\u0438\u0448\u044C \u0431\u043E\u043B\u044C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u0441\u0451 \u0432\u043E\u043A\u0440\u0443\u0433 \u043A\u0440\u0438\u0447\u0438\u0442
      \u043E \u0442\u043E\u043C, \u043A\u0430\u043A \u044F \u0441\u0435\u0439\u0447\u0430\u0441
      \u0441\u043B\u043E\u043C\u043B\u0435\u043D\u0430."
    style: {fileID: 0}
    authorComment: 
