    emotion: 17
    richText: "\u041E\u0440\u0438\u0433\u0438\u043D\u0430\u043B \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430
      \u043E \u0441\u043C\u0435\u0440\u0442\u0438 \u043D\u0430\u0441\u043B\u0435\u0434\u043E\u0434\u0430\u0442\u0435\u043B\u044F."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0427\u0435\u0440\u043D\u044B\u0439 \u0441\u0438\u043B\u0443\u044D\u0442"
  - speakerId: "\u0410\u0433\u0435\u043D\u0442\u0441\u0442\u0432\u043E"
    speakerNameHint: "\u0410\u0433\u0435\u043D\u0442\u0441\u0442\u0432\u043E"
    speaker: {fileID: 11400000, guid: 46089e6d6a61b544fb64ae4a472e10b4, type: 2}
    emotion: 17
    richText: "\u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B, \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044E\u0449\u0438\u0435
      \u043F\u0440\u0430\u0432\u043E \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u0438
      \u043D\u0430 \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u043E\u0435 \u0432
      \u0437\u0430\u0432\u0435\u0449\u0430\u043D\u0438\u0438 \u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0427\u0435\u0440\u043D\u044B\u0439 \u0441\u0438\u043B\u0443\u044D\u0442"
  - speakerId: "\u0410\u0433\u0435\u043D\u0442\u0441\u0442\u0432\u043E"
    speakerNameHint: "\u0410\u0433\u0435\u043D\u0442\u0441\u0442\u0432\u043E"
    speaker: {fileID: 11400000, guid: 46089e6d6a61b544fb64ae4a472e10b4, type: 2}
    emotion: 17
    richText: "\u042F\u0432\u043A\u0430 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u0430
      \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u0438
      \u0434\u043D\u0435\u0439 \u0441 \u043C\u043E\u043C\u0435\u043D\u0442\u0430
      \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u044F \u0434\u0430\u043D\u043D\u043E\u0433\u043E
      \u0443\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u0438\u044F."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0427\u0435\u0440\u043D\u044B\u0439 \u0441\u0438\u043B\u0443\u044D\u0442"
