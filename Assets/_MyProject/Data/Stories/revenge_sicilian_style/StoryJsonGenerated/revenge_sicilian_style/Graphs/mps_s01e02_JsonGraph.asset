  exit: {fileID: 0}
  guid: mps_s01e02_l0140_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\xAB\u041E\u043D\u0430 \u0441\u0438\u0434\u0435\u043B\u0430 \u0441
      \u043C\u0430\u0441\u043A\u043E\u0439, \u0434\u0435\u043B\u0430\u044F \u0432\u0438\u0434,
      \u0447\u0442\u043E \u043E\u043D \u0435\u0439 \u0434\u043E\u0440\u043E\u0433\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 28
    richText: "\xAB\u041D\u043E \u044F \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u0432\u0430\u043B\u0430,
      \u0447\u0442\u043E \u0447\u0442\u043E-\u0442\u043E \u043D\u0435 \u0442\u0430\u043A\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u0437\u0433\u043B\u044F\u0434 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 4
    richText: "\xAB\u041E\u043D\u0430 \u0441\u043B\u043E\u0432\u043D\u043E \u0431\u044B\u043B\u0430
      \u0437\u0430\u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043E\u0432\u0430\u043D\u0430
      \u0447\u0435\u043C-\u0442\u043E \u0434\u0440\u0443\u0433\u0438\u043C, \u043D\u043E
      \u043D\u0435 \u043E\u0442\u0446\u043E\u043C\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0417\u043B\u043E\u0441\u0442\u044C"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 28
    richText: "\xAB\u0422\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0442\u043E\u043C
      \u044F \u043F\u043E\u043D\u044F\u043B\u0430, \u0447\u0442\u043E \u043E\u043D\u0430
      \u0434\u0430\u0432\u043D\u043E \u0435\u0433\u043E \u0443\u0436\u0435 \u043D\u0435
      \u043B\u044E\u0431\u0438\u043B\u0430\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u0437\u0433\u043B\u044F\u0434 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 4
    richText: "\xAB\u0412\u0441\u0451, \u0447\u0442\u043E \u0435\u0439 \u0431\u044B\u043B\u043E
      \u043D\u0443\u0436\u043D\u043E - \u0434\u043E\u0436\u0434\u0430\u0442\u044C\u0441\u044F,
      \u043F\u043E\u043A\u0430 \u0431\u0438\u0437\u043D\u0435\u0441 \u043E\u0442\u0446\u0430
      \u0432\u044B\u0440\u0430\u0441\u0442\u0435\u0442\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0417\u043B\u043E\u0441\u0442\u044C"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 19
    richText: "\xAB\u0414\u043B\u044F \u0442\u043E\u0433\u043E, \u0447\u0442\u043E\u0431\u044B
      \u043F\u0435\u0440\u0435\u043D\u044F\u0442\u044C \u0435\u0433\u043E \u043D\u0430
      \u0441\u0435\u0431\u044F\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u0437\u0433\u043B\u044F\u0434 \u0432 \u0432\u0435\u0440\u0445\u043D\u0438\u0439
      \u0443\u0433\u043E\u043B"
