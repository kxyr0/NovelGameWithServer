  - character: {fileID: 11400000, guid: 9299239046f0fa1429d83b021b03fc77, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u0424\u0430\u0448\u0438\u0441\u0442 \u0441 \u043F\u043B\u043E\u0449\u0430\u0434\u0438"
  - character: {fileID: 11400000, guid: e706e7d1a91e19d4abff1ac05facf1ab, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u0414\u0436\u0443\u043B\u0438\u044F"
  lines:
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 2
    richText: "\xAB\u0410 \u043E\u043D\u0438 \u2014 \u0432\u0442\u043E\u0440\u0436\u0435\u043D\u0446\u044B.
      \u041A\u043E\u0442\u043E\u0440\u044B\u0435 \u0440\u0430\u043D\u043E \u0438\u043B\u0438
      \u043F\u043E\u0437\u0434\u043D\u043E \u043F\u043E\u043F\u043B\u0430\u0442\u044F\u0442\u0441\u044F
      \u0437\u0430 \u0441\u0432\u043E\u0438 \u0434\u0435\u044F\u043D\u0438\u044F\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 28
    richText: "\xAB\u0413\u043B\u0430\u0432\u043D\u043E\u0435 \u2014 \u043D\u0435
      \u0437\u0430\u0431\u044B\u0432\u0430\u0442\u044C \u0434\u0440\u0443\u0436\u0438\u0442\u044C
      \u0441 \u0433\u043E\u043B\u043E\u0432\u043E\u0439, \u0430 \u0442\u043E \u044F
      \u043C\u043E\u0433\u0443 \u0438 \u043D\u0435 \u0434\u043E\u0436\u0438\u0442\u044C
      \u0434\u043E \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0445 \u0432\u0440\u0435\u043C\u0451\u043D\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u0437\u0433\u043B\u044F\u0434 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 19
    richText: "\xAB\u0415\u0441\u043B\u0438 \u0442\u0430\u043A\u043E\u0432\u044B\u0435
      \u0435\u0449\u0451 \u043D\u0430\u0441\u0442\u0443\u043F\u044F\u0442, \u043A\u043E\u043D\u0435\u0447\u043D\u043E\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u0437\u0433\u043B\u044F\u0434 \u0432 \u0432\u0435\u0440\u0445\u043D\u0438\u0439
      \u0443\u0433\u043E\u043B"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u043E\u043A\u0430 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u0438\u0434\u0443 \u043A \u0432\u0445\u043E\u0434\u043D\u043E\u0439 \u0434\u0432\u0435\u0440\u0438,
      \u044F \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u0440\u0430\u0441\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u044E
      \u0443\u043B\u0438\u0446\u0443, \u043D\u0435 \u0436\u0434\u0451\u0442 \u043B\u0438
      \u043C\u0435\u043D\u044F \u043A\u0442\u043E \u0443 \u0432\u0445\u043E\u0434\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u043E, \u043A\u0440\u043E\u043C\u0435 \u0444\u0430\u0448\u0438\u0441\u0442\u043E\u0432
      \u0438 \u0435\u0449\u0451 \u043F\u0430\u0440\u044B \u0436\u0438\u0442\u0435\u043B\u0435\u0439
      \u041F\u0430\u043B\u0435\u0440\u043C\u043E, \u0442\u0443\u0442 \u043D\u0438\u043A\u043E\u0433\u043E
      \u043D\u0435\u0442."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\xAB\u0412\u0435\u0440\u043E\u044F\u0442\u043D\u043E, \u043E\u043D
      \u0436\u0434\u0451\u0442 \u0432\u043D\u0443\u0442\u0440\u0438?\xBB"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u0442\u044F\u043D\u0443 \u043D\u0430 \u0441\u0435\u0431\u044F
      \u0434\u0432\u0435\u0440\u043D\u0443\u044E \u0440\u0443\u0447\u043A\u0443,
      \u043E\u0434\u043D\u0430\u043A\u043E \u043D\u0430\u0442\u044B\u043A\u0430\u044E\u0441\u044C
      \u043D\u0430 \u0443\u0436\u0435 \u0437\u043D\u0430\u043A\u043E\u043C\u043E\u0435
      \u043B\u0438\u0446\u043E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418 \u043A\u0430\u043A\u043E\u0435 \u0436\u0435 \u043C\u043E\u0451
      \u0443\u0434\u0438\u0432\u043B\u0435\u043D\u0438\u0435, \u043A\u043E\u0433\u0434\u0430
      \u043E\u043D \u0432\u043E\u0437\u043D\u0438\u043A \u0432 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438
      \u0441\u2026"
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u0424\u0430\u0448\u0438\u0441\u0442 \u0441 \u043F\u043B\u043E\u0449\u0430\u0434\u0438"
    speakerNameHint: "\u0424\u0430\u0448\u0438\u0441\u0442 \u0441 \u043F\u043B\u043E\u0449\u0430\u0434\u0438"
    speaker: {fileID: 11400000, guid: 9299239046f0fa1429d83b021b03fc77, type: 2}
    emotion: 6
    richText: "\u2026"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u0434\u0438\u0432\u043B\u0435\u043D\u0438\u0435"
  - speakerId: "\u0414\u0436\u0443\u043B\u0438\u044F"
    speakerNameHint: "\u0414\u0436\u0443\u043B\u0438\u044F"
    speaker: {fileID: 11400000, guid: e706e7d1a91e19d4abff1ac05facf1ab, type: 2}
    emotion: 6
    richText: "\u2026"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u0434\u0438\u0432\u043B\u0435\u043D\u0438\u0435"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041C\u043E\u0451 \u0441\u0435\u0440\u0434\u0446\u0435 \u0443\u0445\u043D\u0443\u043B\u043E
      \u0432 \u043F\u0443\u0441\u0442\u043E\u0442\u0443, \u0430 \u0437\u0440\u0430\u0447\u043A\u0438
      \u0440\u0430\u0441\u043F\u0430\u0445\u043D\u0443\u043B\u0438\u0441\u044C, \u043A\u0430\u043A
      \u0434\u0432\u0430 \u0447\u0451\u0440\u043D\u044B\u0445 \u043A\u043E\u043B\u043E\u0434\u0446\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u0430\u043B\u044C\u0446\u044B \u0441\u0430\u043C\u0438 \u0441\u043E\u0431\u043E\u0439
      \u0441\u0436\u0438\u043C\u0430\u044E\u0442\u0441\u044F \u0432 \u043A\u0443\u043B\u0430\u043A\u0438."
    style: {fileID: 0}
    authorComment: 
