  guid: mps_s01e02_l0389_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters: []
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043D\u0430 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0435
      \u0437\u0430\u0434\u0443\u043C\u044B\u0432\u0430\u044E\u0441\u044C, \u043F\u0435\u0440\u0435\u0431\u0438\u0440\u0430\u044F
      \u0432 \u043F\u0430\u043C\u044F\u0442\u0438 \u043B\u0438\u0446\u0430 \u0442\u0435\u0445,
      \u0441 \u043A\u0435\u043C \u043A\u043E\u0433\u0434\u0430-\u0442\u043E \u0440\u0430\u0441\u043F\u0440\u043E\u0449\u0430\u043B\u0430\u0441\u044C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0422\u0430\u043A\u0438\u0445 \u043D\u0435\u043C\u043D\u043E\u0433\u043E.
      \u041D\u043E \u0434\u043E\u0433\u0430\u0434\u043A\u0438 \u0432\u0441\u0451
      \u0436\u0435 \u0435\u0441\u0442\u044C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418 \u0440\u0430\u0437 \u044D\u0442\u043E\u0442 \u043D\u0435\u043A\u0442\u043E
      \u0445\u043E\u0447\u0435\u0442 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C\u0441\u044F,
      \u0442\u043E \u044F \u0435\u043C\u0443 \u043D\u0435 \u043E\u0442\u043A\u0430\u0436\u0443."
    style: {fileID: 0}
    authorComment: 
