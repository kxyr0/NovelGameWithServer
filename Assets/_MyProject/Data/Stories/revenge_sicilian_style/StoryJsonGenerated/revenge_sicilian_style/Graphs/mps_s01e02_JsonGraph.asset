  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: mps_s01e02_l0929_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u0431\u0440\u043E\u0441\u0430\u044E\u0441\u044C \u0435\u043C\u0443
      \u043D\u0430 \u0448\u0435\u044E, \u043A\u0440\u0435\u043F\u043A\u043E, \u0434\u043E
      \u0445\u0440\u0443\u0441\u0442\u0430, \u0441\u0436\u0438\u043C\u0430\u044E
      \u2014 \u043D\u0435 \u0432\u0438\u0436\u0443, \u043D\u043E \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E,
      \u043A\u0430\u043A \u043E\u043D \u043C\u043E\u0440\u0449\u0438\u0442\u0441\u044F,
      \u0437\u0430\u0434\u044B\u0445\u0430\u044F\u0441\u044C, \u0434\u0430 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043C\u043D\u0435 \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u043B\u0438\u0448\u043A\u043E\u043C \u0434\u043E\u043B\u0433\u043E
      \u044F \u0435\u0433\u043E \u043D\u0435 \u0432\u0438\u0434\u0435\u043B\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u0435\u0434\u044C \u044D\u0442\u043E\u0442 \u043F\u043E\u0433\u0430\u043D\u0435\u0446
      \u0441\u0431\u0435\u0436\u0430\u043B \u043E\u0442 \u043C\u0435\u043D\u044F,
      \u043F\u043E \u0432\u0438\u043D\u0435 \u0441\u0432\u043E\u0438\u0445 \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0435\u0439,
      \u043E\u0441\u0442\u0430\u0432\u0438\u043B \u043C\u0435\u043D\u044F \u0441\u043E\u0432\u0441\u0435\u043C
      \u043E\u0434\u043D\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0410 \u043E\u043D \u0432\u0435\u0434\u044C \u0431\u044B\u043B \u043B\u0443\u0447\u0448\u0438\u043C
      \u0434\u0440\u0443\u0433\u043E\u043C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u043E\u043B\u043D\u0446\u0435\u043C, \u043E\u043F\u043E\u0440\u043E\u0439,
      \u043A\u0435\u043C-\u0442\u043E \u0431\u043B\u0438\u0437\u043A\u0438\u043C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u043E\u0442 \u0442\u0435\u043F\u0435\u0440\u044C \u043F\u0443\u0441\u0442\u044C
      \u044D\u0442\u0430 \u043E\u043F\u043E\u0440\u0430 \u043F\u043E\u0441\u0442\u043E\u0438\u0442
      \u0438 \u043F\u043E\u0442\u0435\u0440\u043F\u0438\u0442."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 2
    richText: "\xAB\u0412\u0435\u0440\u043D\u0443\u043B\u0441\u044F, \u0434\u0443\u0440\u0430\u043A\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0434\u043D\u0430\u043A\u043E \u043E\u043D \u043A\u043B\u0430\u0434\u0451\u0442
      \u043B\u0430\u0434\u043E\u043D\u0438 \u043C\u043D\u0435 \u043D\u0430 \u043F\u043B\u0435\u0447\u0438,
      \u043E\u0431\u043D\u0438\u043C\u0430\u0435\u0442 \u0438 \u043F\u0440\u0438\u0436\u0438\u043C\u0430\u0435\u0442
      \u043A \u0441\u0435\u0431\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0413\u043E\u0432\u043E\u0440\u0438\u0442 \u0447\u0442\u043E-\u0442\u043E
      \u043F\u043E-\u0438\u0442\u0430\u043B\u044C\u044F\u043D\u0441\u043A\u0438,
      \u043D\u043E \u044F \u043D\u0435 \u0441\u043B\u0443\u0448\u0430\u044E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u0435\u0439\u0447\u0430\u0441 \u0434\u043B\u044F \u043C\u0435\u043D\u044F
      \u0432\u0430\u0436\u043D\u043E \u043E\u0434\u043D\u043E \u2014 \u0447\u0442\u043E
      \u043E\u043D \u0437\u0434\u0435\u0441\u044C, \u043F\u0443\u0441\u0442\u044C
      \u0434\u0430\u0436\u0435 \u043D\u0435\u043D\u0430\u0434\u043E\u043B\u0433\u043E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0422\u0430\u043A \u043C\u044B \u0441\u0442\u043E\u0438\u043C \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u043E\u0435
      \u0432\u0440\u0435\u043C\u044F, \u043F\u043E\u043A\u0430 \u0421\u0435\u043C\u0438
      \u0441\u043E \u0441\u0432\u043E\u0435\u0439 \u043A\u043E\u043C\u0430\u043D\u0434\u043E\u0439
      \u043C\u0435\u043D\u044F\u044E\u0442 \u043C\u0443\u0437\u044B\u043A\u0430\u043B\u044C\u043D\u044B\u0439
      \u043D\u0430\u0441\u0442\u0440\u043E\u0439."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u043C\u043E\u0436\u0435\u0442
      \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F, \u0447\u0442\u043E
      \u0434\u0432\u043E\u0435 \u0432\u043B\u044E\u0431\u043B\u0451\u043D\u043D\u044B\u0445
      \u043C\u0438\u043B\u0443\u044E\u0442\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
