  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: mps_s01e02_l0399_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: 0c671a61053962a43938a5ae296b6847, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u041D\u0435\u043A\u0442\u043E"
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u0444\u043E\u043A\u0443\u0441\u0438\u0440\u043E\u0432\u0430\u0432
      \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435 \u043D\u0430 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u043C
      \u043F\u0438\u0441\u044C\u043C\u0435, \u044F \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u044E
      \u0431\u0443\u043C\u0430\u0433\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u043E \u0441\u0442\u0440\u043E\u043A \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441\u043E\u0432\u0441\u0435\u043C \u043D\u0435\u043C\u043D\u043E\u0433\u043E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418 \u0447\u0435\u043C \u0434\u0430\u043B\u044C\u0448\u0435 \u044F
      \u0447\u0438\u0442\u0430\u044E, \u0442\u0435\u043C \u0448\u0438\u0440\u0435
      \u0440\u0430\u0441\u043F\u0430\u0445\u0438\u0432\u0430\u044E \u0433\u043B\u0430\u0437\u0430,
      \u0430 \u043B\u0438\u0446\u043E \u043A\u0430\u043C\u0435\u043D\u0435\u0435\u0442
      \u043E\u0442 \u0441\u0442\u0440\u0430\u0445\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u041D\u0435\u043A\u0442\u043E"
    speakerNameHint: "\u041D\u0435\u043A\u0442\u043E"
    speaker: {fileID: 11400000, guid: 0c671a61053962a43938a5ae296b6847, type: 2}
    emotion: 17
    richText: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439, \u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0427\u0435\u0440\u043D\u044B\u0439 \u0441\u0438\u043B\u0443\u044D\u0442"
  - speakerId: "\u041D\u0435\u043A\u0442\u043E"
    speakerNameHint: "\u041D\u0435\u043A\u0442\u043E"
    speaker: {fileID: 11400000, guid: 0c671a61053962a43938a5ae296b6847, type: 2}
    emotion: 17
    richText: "\u041D\u0443 \u043A\u0430\u043A \u0442\u044B? \u0414\u0435\u0440\u0436\u0438\u0448\u044C\u0441\u044F?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0427\u0435\u0440\u043D\u044B\u0439 \u0441\u0438\u043B\u0443\u044D\u0442"
  - speakerId: "\u041D\u0435\u043A\u0442\u043E"
    speakerNameHint: "\u041D\u0435\u043A\u0442\u043E"
    speaker: {fileID: 11400000, guid: 0c671a61053962a43938a5ae296b6847, type: 2}
    emotion: 17
    richText: "\u041D\u0435 \u0443\u043D\u044B\u0432\u0430\u0435\u0448\u044C \u043F\u043E
      \u043F\u043E\u0433\u0438\u0431\u0448\u0435\u043C\u0443 \u043E\u0442\u0446\u0443?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0427\u0435\u0440\u043D\u044B\u0439 \u0441\u0438\u043B\u0443\u044D\u0442"
  - speakerId: "\u041D\u0435\u043A\u0442\u043E"
    speakerNameHint: "\u041D\u0435\u043A\u0442\u043E"
    speaker: {fileID: 11400000, guid: 0c671a61053962a43938a5ae296b6847, type: 2}
    emotion: 17
    richText: "\u0418\u043B\u0438 \u0443\u0436\u0435 \u0433\u043E\u0442\u043E\u0432\u0430
      \u0440\u0435\u0437\u0430\u0442\u044C \u0432\u0435\u043D\u044B, \u0432\u0435\u0434\u044C
      \u0443 \u0442\u0435\u0431\u044F \u043D\u0438\u043A\u043E\u0433\u043E \u0431\u043E\u043B\u044C\u0448\u0435
      \u043D\u0435 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0427\u0435\u0440\u043D\u044B\u0439 \u0441\u0438\u043B\u0443\u044D\u0442"
  - speakerId: "\u041D\u0435\u043A\u0442\u043E"
    speakerNameHint: "\u041D\u0435\u043A\u0442\u043E"
    speaker: {fileID: 11400000, guid: 0c671a61053962a43938a5ae296b6847, type: 2}
    emotion: 17
    richText: "\u041D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u044F \u0437\u043D\u0430\u044E,
      \u0442\u0432\u043E\u044F \u043C\u0430\u0442\u044C \u0442\u043E\u0436\u0435
      \u043F\u043E\u0433\u0438\u0431\u043B\u0430."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0427\u0435\u0440\u043D\u044B\u0439 \u0441\u0438\u043B\u0443\u044D\u0442"
  - speakerId: "\u041D\u0435\u043A\u0442\u043E"
    speakerNameHint: "\u041D\u0435\u043A\u0442\u043E"
    speaker: {fileID: 11400000, guid: 0c671a61053962a43938a5ae296b6847, type: 2}
    emotion: 17
    richText: "\u0410\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0435\u0446 \u0437\u0430\u0431\u0438\u043B
      \u0435\u0451 \u0434\u043E \u0441\u043C\u0435\u0440\u0442\u0438, \u0437\u0430\u0441\u0442\u0430\u0432
      \u0437\u0430 \u043B\u044E\u0431\u0438\u043C\u044B\u043C \u0437\u0430\u043D\u044F\u0442\u0438\u0435\u043C
      \u2014 \u0431\u044B\u0442\u044C \xAB\u0434\u0435\u0432\u0443\u0448\u043A\u043E\u0439
      \u0434\u043B\u044F \u0443\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0438\u044F\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0427\u0435\u0440\u043D\u044B\u0439 \u0441\u0438\u043B\u0443\u044D\u0442"
  - speakerId: "\u041D\u0435\u043A\u0442\u043E"
    speakerNameHint: "\u041D\u0435\u043A\u0442\u043E"
    speaker: {fileID: 11400000, guid: 0c671a61053962a43938a5ae296b6847, type: 2}
    emotion: 17
    richText: "\u041E\u043D\u0430 \u0447\u0430\u0441\u0442\u043E \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435
      \u0432\u0440\u0435\u043C\u044F \u0441\u0442\u0430\u043B\u0430 \u0434\u0430\u0432\u0430\u0442\u044C
      \u0441\u0435\u0431\u044F \u043E\u0446\u0435\u043D\u0438\u0442\u044C \u043D\u0435
      \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0442\u0430\u0442\u0443\u0441\u043D\u044B\u043C
      \u043C\u0443\u0436\u0447\u0438\u043D\u0430\u043C, \u043D\u043E \u0438 \u0433\u0440\u044F\u0437\u043D\u044B\u043C
      \u0440\u0430\u0431\u043E\u0442\u044F\u0433\u0430\u043C."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0427\u0435\u0440\u043D\u044B\u0439 \u0441\u0438\u043B\u0443\u044D\u0442"
  - speakerId: "\u041D\u0435\u043A\u0442\u043E"
    speakerNameHint: "\u041D\u0435\u043A\u0442\u043E"
    speaker: {fileID: 11400000, guid: 0c671a61053962a43938a5ae296b6847, type: 2}
    emotion: 17
    richText: "\u0416\u0430\u0434\u043D\u043E\u0441\u0442\u044C \u0435\u0451 \u0438
      \u0441\u0433\u0443\u0431\u0438\u043B\u0430, \u0434\u0430 \u0435\u0449\u0451
      \u0442\u0430\u043A \u0436\u0435\u0441\u0442\u043E\u043A\u043E."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0427\u0435\u0440\u043D\u044B\u0439 \u0441\u0438\u043B\u0443\u044D\u0442"
  - speakerId: "\u041D\u0435\u043A\u0442\u043E"
    speakerNameHint: "\u041D\u0435\u043A\u0442\u043E"
    speaker: {fileID: 11400000, guid: 0c671a61053962a43938a5ae296b6847, type: 2}
    emotion: 17
    richText: "\u0422\u0432\u043E\u0439 \u043E\u0442\u0435\u0446 \u0442\u043E\u0436\u0435
      \u0431\u044B\u043B \u0436\u0430\u0434\u0435\u043D. \u041D\u0435 \u0445\u043E\u0442\u0435\u043B
      \u0434\u0435\u043B\u0438\u0442\u044C\u0441\u044F \u043F\u0440\u0438\u0431\u044B\u043B\u044C\u044E,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0438 \u043F\u043E\u0433\u0438\u0431."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0427\u0435\u0440\u043D\u044B\u0439 \u0441\u0438\u043B\u0443\u044D\u0442"
