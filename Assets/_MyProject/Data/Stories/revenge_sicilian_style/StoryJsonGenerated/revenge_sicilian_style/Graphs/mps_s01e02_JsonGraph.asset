  guid: mps_s01e02_l1421_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: 097cc35ac53b27142b4a8e852f63fd8c, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u0422\u043E\u043D\u0438"
  - character: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speakerId: "\u0422\u043E\u043D\u0438"
    speakerNameHint: "\u0422\u043E\u043D\u0438"
    speaker: {fileID: 11400000, guid: 097cc35ac53b27142b4a8e852f63fd8c, type: 2}
    emotion: 17
    richText: "\u0410 \u043C\u044B \u0442\u0435\u043C \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C
      \u0440\u0430\u0441\u043A\u0440\u043E\u0435\u043C \u0432\u0441\u0435 \u043A\u0430\u0440\u0442\u044B
      \u043D\u0430 \u0441\u0442\u043E\u043B, \u0432\u044B\u043B\u043E\u0436\u0438\u043C
      \u043F\u0440\u0430\u0432\u0434\u0443 \u043E \u0432\u0430\u0448\u0435\u043C
      \u043E\u0442\u0446\u0435."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 8
    richText: "\u042D\u0442\u043E \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0432\u0437\u0433\u043B\u044F\u0434"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\u042F \u043D\u0435 \u0433\u043E\u043B\u043E\u0434\u043D\u0430 \u0438
      \u0443\u0436 \u0442\u0435\u043C \u0431\u043E\u043B\u0435\u0435 \u043D\u0435
      \u0437\u0430\u043C\u0451\u0440\u0437\u043B\u0430."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\u041C\u043E\u0433\u0443 \u0432\u044B\u0441\u043B\u0443\u0448\u0430\u0442\u044C
      \u0438 \u0442\u0443\u0442."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0422\u043E\u043D\u0438 \u043F\u043E\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442
      \u0433\u0430\u043B\u0441\u0442\u0443\u043A \u0438 \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043A \u0414\u0436\u0443\u0437\u0435\u043F\u043F\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u0422\u043E\u043D\u0438"
    speakerNameHint: "\u0422\u043E\u043D\u0438"
    speaker: {fileID: 11400000, guid: 097cc35ac53b27142b4a8e852f63fd8c, type: 2}
    emotion: 17
    richText: "\u0422\u043E\u0433\u0434\u0430, \u0443\u0432\u044B, \u043C\u044B \u043D\u0438\u0447\u0435\u043C
      \u043F\u043E\u043C\u043E\u0447\u044C \u043D\u0435 \u0441\u043C\u043E\u0436\u0435\u043C."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: "\u0422\u043E\u043D\u0438"
    speakerNameHint: "\u0422\u043E\u043D\u0438"
    speaker: {fileID: 11400000, guid: 097cc35ac53b27142b4a8e852f63fd8c, type: 2}
    emotion: 2
    richText: "\u0412\u0435\u0434\u044C \u043C\u043E\u0439 \u043A\u043E\u043B\u043B\u0435\u0433\u0430
      \u044F\u0441\u043D\u043E \u0434\u0430\u043B \u043F\u043E\u043D\u044F\u0442\u044C:
      \u0432\u0435\u0447\u0435\u0440 \u0443 \u043D\u0430\u0441 \u0437\u0430\u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439,
      \u0438 \u043D\u0435\u043F\u0440\u0435\u0434\u0432\u0438\u0434\u0435\u043D\u043D\u044B\u0435
      \u043E\u0431\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430
      \u0432 \u043D\u0430\u0448\u0438 \u043F\u043B\u0430\u043D\u044B \u043D\u0435
      \u0432\u0445\u043E\u0434\u0438\u043B\u0438."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041B\u0451\u0433\u043A\u0430\u044F \u0443\u043B\u044B\u0431\u043A\u0430"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u0441\u043C\u043E\u0442\u0440\u044E, \u043A\u0430\u043A \u0414\u0436\u0443\u0437\u0435\u043F\u043F\u0435
      \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F. \u0421\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u043D\u0435 \u043F\u043E \u0441\u0435\u0431\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0434\u043D\u0430\u043A\u043E \u043E\u043D\u0438 \u043F\u0440\u0430\u0432\u044B:
      \u0435\u0441\u043B\u0438 \u0441\u0435\u0439\u0447\u0430\u0441 \u043D\u0435
      \u0441\u043E\u0433\u043B\u0430\u0448\u0443\u0441\u044C, \u0440\u0438\u0441\u043A\u0443\u044E
      \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C \u0446\u0435\u043D\u043D\u0443\u044E
      \u043F\u0440\u0430\u0432\u0434\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0410 \u044D\u0442\u043E\u0433\u043E \u044F \u043D\u0435 \u0445\u043E\u0442\u0435\u043B\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 28
    richText: "\u042F \u0441\u043E\u0433\u043B\u0430\u0441\u043D\u0430."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u0437\u0433\u043B\u044F\u0434 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041A\u041E\u041D\u0415\u0426 \u0421\u0415\u0420\u0418\u0418!"
    style: {fileID: 0}
    authorComment: 
