  guid: mps_s01e02_l0027_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters: []
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043D\u0435 \u0441\u043F\u0430\u043B\u0430 \u0443\u0436\u0435
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0447\u0430\u0441, \u0441\u0438\u0434\u044F
      \u0443 \u0441\u0442\u043E\u043B\u0430 \u043D\u0430\u0434 \u043D\u0435\u0437\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u044B\u043C
      \u0444\u043E\u0442\u043E\u0430\u043B\u044C\u0431\u043E\u043C\u043E\u043C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0415\u0433\u043E \u0431\u0435\u043B\u044B\u0435 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u044B,
      \u0438\u0441\u043F\u0435\u0449\u0440\u0451\u043D\u043D\u044B\u0435 \u0441\u0435\u043C\u0435\u0439\u043D\u044B\u043C\u0438
      \u0441\u043D\u0438\u043C\u043A\u0430\u043C\u0438, \u0432\u043F\u0438\u0442\u044B\u0432\u0430\u043B\u0438
      \u043C\u043E\u0438 \u0441\u043E\u043B\u0451\u043D\u044B\u0435 \u0441\u043B\u0451\u0437\u044B."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412 \u0440\u0443\u043A\u0430\u0445 \u0434\u0435\u0440\u0436\u0430\u043B\u0430
      \u0432\u044B\u0446\u0432\u0435\u0442\u0448\u0443\u044E \u0447\u0451\u0440\u043D\u043E-\u0431\u0435\u043B\u0443\u044E
      \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u044E - \u043D\u0430
      \u043D\u0435\u0439 \u044F \u0431\u044B\u043B\u0430 \u0441 \u043D\u0435\u0439\u2026
      \u0441 \u0442\u043E\u0439, \u043A\u043E\u0433\u043E \u043A\u043E\u0433\u0434\u0430-\u0442\u043E
      \u043D\u0430\u0437\u044B\u0432\u0430\u043B\u0430 \u043C\u0430\u0442\u0435\u0440\u044C\u044E,
      \u0438 \u043A\u0442\u043E \u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
      \u043C\u043D\u0435 \u0432\u0441\u0435\u043C \u0432 \u044D\u0442\u043E\u0439
      \u0436\u0438\u0437\u043D\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u0430 \u0441\u043D\u0438\u043C\u043A\u0435 \u044F \u0441\u0442\u043E\u044F\u043B\u0430
      \u043F\u043E\u0434\u0440\u043E\u0441\u0442\u043A\u043E\u043C \u0443 \u0435\u0451
      \u043D\u043E\u0433\u0438, \u0435\u0434\u0432\u0430 \u0434\u043E\u0441\u0442\u0430\u0432\u0430\u044F
      \u043C\u0430\u043A\u0443\u0448\u043A\u043E\u0439 \u0434\u043E \u0440\u0435\u043C\u043D\u044F
      \u043F\u043B\u0430\u0442\u044C\u044F, \u0438 \u0443\u043B\u044B\u0431\u0430\u043B\u0430\u0441\u044C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0436\u0435 \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0430
      \u043D\u0430 \u043C\u0435\u043D\u044F \u0441\u0432\u0435\u0440\u0445\u0443
      \u0432\u043D\u0438\u0437, \u043C\u044F\u0433\u043A\u043E \u043F\u0435\u0440\u0435\u0431\u0438\u0440\u0430\u044F
      \u043C\u043E\u0438 \u0432\u043E\u043B\u043E\u0441\u044B."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0415\u0451 \u043B\u0438\u0446\u043E \u0441\u0432\u0435\u0442\u0438\u043B\u043E\u0441\u044C
      \u043D\u0435\u043F\u043E\u0434\u0434\u0435\u043B\u044C\u043D\u044B\u043C \u0441\u0447\u0430\u0441\u0442\u044C\u0435\u043C,
      \u0430 \u0432 \u0433\u043B\u0430\u0437\u0430\u0445 \u0447\u0438\u0442\u0430\u043B\u0430\u0441\u044C
      \u0431\u0435\u0437\u0433\u0440\u0430\u043D\u0438\u0447\u043D\u0430\u044F \u043D\u0435\u0436\u043D\u043E\u0441\u0442\u044C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412 \u0442\u043E\u0442 \u043C\u0438\u0433 \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C,
      \u0447\u0442\u043E \u0442\u0430\u043A \u0431\u0443\u0434\u0435\u0442 \u0432\u0441\u0435\u0433\u0434\u0430:
      \u043E\u043D\u0430 \u0438 \u044F. \u0420\u0443\u043A\u0430 \u043D\u0430 \u043C\u043E\u0435\u0439
      \u0433\u043E\u043B\u043E\u0432\u0435, \u0442\u0435\u043F\u043B\u043E \u0440\u044F\u0434\u043E\u043C,
      \u0433\u043E\u043B\u043E\u0441 - \u0446\u0435\u043D\u0442\u0440, \u0432\u043E\u043A\u0440\u0443\u0433
      \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0432\u0440\u0430\u0449\u0430\u043B\u0441\u044F
      \u043C\u043E\u0439 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u043C\u0438\u0440."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u043E \u0442\u0435\u043F\u0435\u0440\u044C \u043E\u0442 \u0432\u0441\u0435\u0433\u043E
      \u044D\u0442\u043E\u0433\u043E \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C
      \u043B\u0438\u0448\u044C \u043F\u043E\u0436\u0435\u043B\u0442\u0435\u0432\u0448\u0438\u0435
      \u043A\u0440\u0430\u044F \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0438
      \u0438 \u0433\u043E\u0440\u044C\u043A\u0430\u044F \u043F\u0430\u043C\u044F\u0442\u044C,
      \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043D\u0435 \u0441\u0442\u0435\u0440\u0435\u0442\u044C
      \u043D\u0438 \u0441\u043B\u0435\u0437\u0430\u043C\u0438, \u043D\u0438 \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C."
    style: {fileID: 0}
    authorComment: 
