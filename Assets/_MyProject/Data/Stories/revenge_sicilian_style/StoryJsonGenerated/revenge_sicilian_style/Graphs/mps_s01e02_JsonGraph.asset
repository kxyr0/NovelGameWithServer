  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: mps_s01e02_l1289_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: b27e7dab8348bb74dadb44a55332325d, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u0414\u043E\u043D"
  - character: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  - character: {fileID: 11400000, guid: 95d1e47740b729147bcd7d679212dd21, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u041B\u0443\u043A\u0430"
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u043D\u0430\u043A\u043B\u043E\u043D\u044F\u0435\u0442\u0441\u044F
      \u043A \u043C\u0443\u0436\u0447\u0438\u043D\u0435 \u043F\u043E \u0446\u0435\u043D\u0442\u0440\u0443
      \u0438 \u0447\u0442\u043E-\u0442\u043E \u0448\u0435\u043F\u0447\u0435\u0442
      \u043D\u0430 \u0443\u0445\u043E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D, \u0437\u0430\u043D\u044F\u0442\u044B\u0439 \u0437\u0430\u043A\u0430\u0437\u043E\u043C,
      \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u0432 \u043C\u043E\u044E \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u0433\u043E\u043B\u043E\u0432\u0443
      \u0438\u2026 \u0441\u043B\u0435\u0433\u043A\u0430 \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F?"
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u0414\u043E\u043D"
    speakerNameHint: "\u0414\u043E\u043D"
    speaker: {fileID: 11400000, guid: b27e7dab8348bb74dadb44a55332325d, type: 2}
    emotion: 2
    richText: "\u2026"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041B\u0451\u0433\u043A\u0430\u044F \u0443\u043B\u044B\u0431\u043A\u0430"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 32
    richText: "\xAB\u0410 \u044D\u0442\u043E, \u0432\u0438\u0434\u0438\u043C\u043E,
      \u0438\u0445 \u043B\u0438\u0434\u0435\u0440\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041F\u0440\u0438\u0449\u0443\u0440"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u0440\u0435\u0437\u043A\u043E \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u044E\u0441\u044C
      \u043A \u041B\u0443\u043A\u0435, \u0442\u0430\u043A, \u0447\u0442\u043E \u043E\u043D
      \u043F\u0440\u043E\u043B\u0438\u0432\u0430\u0435\u0442 \u043D\u0430 \u0441\u0435\u0431\u044F
      \u0432\u0438\u043D\u043E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u041B\u0443\u043A\u0430"
    speakerNameHint: "\u041B\u0443\u043A\u0430"
    speaker: {fileID: 11400000, guid: 95d1e47740b729147bcd7d679212dd21, type: 2}
    emotion: 8
    richText: "\u0422\u044B \u0447\u0435\u0433\u043E, amica del cuore?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0432\u0437\u0433\u043B\u044F\u0434"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043C\u0430\u0448\u0438\u043D\u0430\u043B\u044C\u043D\u043E
      \u0445\u0432\u0430\u0442\u0430\u044E \u0441\u0430\u043B\u0444\u0435\u0442\u043A\u0443
      \u0441\u043E \u0441\u0442\u043E\u043B\u0430 \u0438 \u043D\u0435\u0440\u0432\u043D\u043E
      \u043F\u044B\u0442\u0430\u044E\u0441\u044C \u0441\u0442\u0435\u0440\u0435\u0442\u044C
      \u0441 \u0435\u0433\u043E \u043E\u0434\u0435\u0436\u0434\u044B \u0441\u043B\u0435\u0434\u044B
      \u0432\u0438\u043D\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u0430 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0435
      \u0441\u043C\u043E\u0442\u0440\u044E \u043D\u0430 \u0412\u0418\u041F-\u043C\u0435\u0441\u0442\u043E
      \u0438 \u0437\u0430\u043C\u0435\u0447\u0430\u044E, \u0447\u0442\u043E \u0443\u043B\u044B\u0431\u043A\u0430
      \u043C\u0443\u0436\u0447\u0438\u043D\u044B \u0441\u0442\u0430\u043B\u0430 \u0435\u0449\u0451
      \u0448\u0438\u0440\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u0441\u043E\u0441\u0440\u0435\u0434\u043E\u0442\u0430\u0447\u0438\u0432\u0430\u044E\u0441\u044C
      \u043D\u0430 \u041B\u0443\u043A\u0435, \u0442\u0430\u043A \u0438 \u043D\u0435
      \u0441\u043F\u0440\u0430\u0432\u0438\u0432\u0448\u0438\u0441\u044C \u0441 \u043F\u044F\u0442\u043D\u043E\u043C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 3
    richText: "\u041F\u0440\u043E\u0441\u0442\u0438\u2026 \u0418\u0437\u0432\u0438\u043D\u0438\u2026"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041F\u0435\u0447\u0430\u043B\u044C"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 3
    richText: "\u042F \u043D\u0435 \u0445\u043E\u0442\u0435\u043B\u0430."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041F\u0435\u0447\u0430\u043B\u044C"
  - speakerId: "\u041B\u0443\u043A\u0430"
    speakerNameHint: "\u041B\u0443\u043A\u0430"
    speaker: {fileID: 11400000, guid: 95d1e47740b729147bcd7d679212dd21, type: 2}
    emotion: 8
    richText: "\u0412\u0441\u0451 \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E?
      \u0422\u044B \u0441\u0435\u0431\u044F \u043A\u0430\u043A-\u0442\u043E \u0441\u0442\u0440\u0430\u043D\u043D\u043E
      \u0432\u0435\u0434\u0451\u0448\u044C."
    style: {fileID: 0}
