  guid: mps_s01e02_l0953_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: 95d1e47740b729147bcd7d679212dd21, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u041B\u0443\u043A\u0430"
  - character: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0434\u043D\u0430\u043A\u043E \u044D\u0442\u043E \u0431\u044B\u043B\u0430
      \u043B\u0438\u0448\u044C \u0440\u0430\u0434\u043E\u0441\u0442\u044C \u0434\u043E\u043B\u0433\u043E\u0436\u0434\u0430\u043D\u043D\u043E\u0439
      \u0432\u0441\u0442\u0440\u0435\u0447\u0438 \u0434\u0430\u0432\u043D\u0438\u0445
      \u0434\u0440\u0443\u0437\u0435\u0439."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u043E\u0442\u043F\u0443\u0441\u043A\u0430\u0435\u0442
      \u043C\u0435\u043D\u044F \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u0432 \u0433\u043B\u0430\u0437\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0438 \u0443 \u043D\u0435\u0433\u043E \u0441\u0438\u044F\u044E\u0442
      \u2014 \u0442\u0430\u043A \u0436\u0435, \u043A\u0430\u043A \u0438 \u0443 \u043C\u0435\u043D\u044F.
      \u0410 \u0437\u0430\u0442\u0435\u043C \u0440\u0435\u0437\u043A\u043E, \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E,
      \u0431\u044C\u044E \u0435\u0433\u043E \u0432 \u043F\u043B\u0435\u0447\u043E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u0432\u0441\u043A\u0440\u0438\u043A\u0438\u0432\u0430\u0435\u0442,
      \u043D\u043E \u043D\u0435 \u0432\u043E\u0437\u0440\u0430\u0436\u0430\u0435\u0442
      \u2014 \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442, \u0437\u0430 \u0447\u0442\u043E
      \u043F\u043E\u043B\u0443\u0447\u0438\u043B."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u041B\u0443\u043A\u0430"
    speakerNameHint: "\u041B\u0443\u043A\u0430"
    speaker: {fileID: 11400000, guid: 95d1e47740b729147bcd7d679212dd21, type: 2}
    emotion: 21
    richText: "\u042F \u0432\u0438\u0436\u0443, \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u043F\u043E\u043C\u0435\u043D\u044F\u043B\u043E\u0441\u044C."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0417\u0430\u043A\u0430\u0442\u0438\u0432 \u0433\u043B\u0430\u0437\u0430"
  - speakerId: "\u041B\u0443\u043A\u0430"
    speakerNameHint: "\u041B\u0443\u043A\u0430"
    speaker: {fileID: 11400000, guid: 95d1e47740b729147bcd7d679212dd21, type: 2}
    emotion: 2
    richText: "\u041A\u0430\u043A \u0434\u0440\u0430\u043B\u0430\u0441\u044C, \u0442\u0430\u043A
      \u0438 \u0434\u0435\u0440\u0451\u0448\u044C\u0441\u044F."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 27
    richText: "\u0415\u0441\u0442\u044C \u0437\u0430 \u0447\u0442\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430 \u0441 \u0437\u0443\u0431\u0430\u043C\u0438"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 13
    richText: "\u0418 \u044D\u0442\u043E \u043D\u0435 \u043E\u0434\u0438\u043D \u0443\u0434\u0430\u0440."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0415\u0445\u0438\u0434\u043D\u0430\u044F \u0443\u043B\u044B\u0431\u043A\u0430"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 2
    richText: "\u0422\u0435\u0431\u044F \u0436\u0434\u0451\u0442 \u0435\u0449\u0451
      \u0441\u0432\u044F\u0437\u043A\u0430 \u0437\u0430 \u043D\u0435 \u043F\u0440\u0438\u0441\u043B\u0430\u043D\u043D\u044B\u0435
      \u043F\u0438\u0441\u044C\u043C\u0430."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 13
    richText: "\u0425\u043E\u0447\u0435\u0448\u044C, \u0441\u0435\u0439\u0447\u0430\u0441
      \u0432\u0440\u0443\u0447\u0443?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0415\u0445\u0438\u0434\u043D\u0430\u044F \u0443\u043B\u044B\u0431\u043A\u0430"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u0441\u043C\u0435\u0451\u0442\u0441\u044F \u2014 \u0441\u0432\u043E\u0438\u043C
      \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u044B\u043C \u0438\u0442\u0430\u043B\u044C\u044F\u043D\u0441\u043A\u0438\u043C
      \u0441\u043C\u0435\u0445\u043E\u043C, \u043D\u043E \u0432\u0434\u0440\u0443\u0433
      \u0432\u043F\u0430\u0434\u0430\u0435\u0442 \u0432 \u043D\u0435\u043B\u043E\u0432\u043A\u043E\u0441\u0442\u044C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u041B\u0443\u043A\u0430"
    speakerNameHint: "\u041B\u0443\u043A\u0430"
    speaker: {fileID: 11400000, guid: 95d1e47740b729147bcd7d679212dd21, type: 2}
    emotion: 19
    richText: "\u042F \u043F\u0440\u0435\u0434\u043F\u043E\u0447\u0442\u0443 \u043E\u043F\u043B\u0430\u0442\u0438\u0442\u044C
      \u0434\u0440\u0443\u0433\u0438\u043C \u0441\u043F\u043E\u0441\u043E\u0431\u043E\u043C."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u043B\u043E\u0432\u043A\u0438\u0439
      \u0432\u0437\u0433\u043B\u044F\u0434 \u0432\u0432\u0435\u0440\u0445, \u0432\u043B\u0435\u0432\u043E"
--- !u!114 &745308566032628733
MonoBehaviour:
