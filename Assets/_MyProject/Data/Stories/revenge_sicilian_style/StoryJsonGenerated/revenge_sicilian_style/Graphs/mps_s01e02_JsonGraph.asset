    emotion: 0
    richText: "\u041D\u0430 \u0435\u0433\u043E \u043B\u0438\u0446\u0435 \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0432\u0435\u0436\u043B\u0438\u0432\u0430\u044F \u0443\u043B\u044B\u0431\u043A\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u0435\u043C\u0435\u0446 \u043F\u043E\u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F
      \u043F\u043E\u0432\u0442\u043E\u0440\u0438\u0442\u044C \u043C\u043E\u0451 \u0438\u043C\u044F,
      \u0441 \u0442\u0440\u0443\u0434\u043E\u043C \u0432\u044B\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u044F
      \u043D\u0435\u043F\u0440\u0438\u0432\u044B\u0447\u043D\u044B\u0435 \u0437\u0432\u0443\u043A\u0438\u2026."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u041A\u0443\u0440\u0446"
    speakerNameHint: "\u041A\u0443\u0440\u0446"
    speaker: {fileID: 11400000, guid: cd409d2f77838f54b83d81055d42cc35, type: 2}
    emotion: 19
    richText: "\u042D\u043B\u2026\u043C\u0435\u043D\u0442."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u0437\u0433\u043B\u044F\u0434 \u0432 \u0432\u0435\u0440\u0445\u043D\u0438\u0439
      \u043B\u0435\u0432\u044B\u0439 \u0443\u0433\u043E\u043B"
  - speakerId: "\u041A\u0443\u0440\u0446"
    speakerNameHint: "\u041A\u0443\u0440\u0446"
    speaker: {fileID: 11400000, guid: cd409d2f77838f54b83d81055d42cc35, type: 2}
    emotion: 8
    richText: "\u2026\u043C\u0435\u043D\u0442\u0438\u043D\u0430."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0420\u0430\u0441\u0442\u0435\u0440\u044F\u043D\u043D\u043E\u0441\u0442\u044C"
  - speakerId: "\u041A\u0443\u0440\u0446"
    speakerNameHint: "\u041A\u0443\u0440\u0446"
    speaker: {fileID: 11400000, guid: cd409d2f77838f54b83d81055d42cc35, type: 2}
    emotion: 2
    richText: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430!"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0423 \u043D\u0435\u0433\u043E \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F
      \u043D\u0435 \u0441\u0440\u0430\u0437\u0443, \u043D\u043E \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u0432\u044B\u0434\u0430\u0432\u043B\u0438\u0432\u0430\u044E
      \u043B\u0451\u0433\u043A\u0443\u044E \u0443\u043B\u044B\u0431\u043A\u0443,
      \u0434\u0430\u0432\u0430\u044F \u043F\u043E\u043D\u044F\u0442\u044C, \u0447\u0442\u043E
      \u043E\u043D \u0441\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F, \u0445\u043E\u0442\u044C
      \u0438 \u043D\u0435 \u0431\u0435\u0437 \u0442\u0440\u0443\u0434\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 19
    richText: "\xAB\u041D\u0443 \u0432\u043E\u0442, \u0442\u0435\u043F\u0435\u0440\u044C
      \u044D\u0442\u043E\u0442 \u043F\u043E\u043B\u0437\u0443\u043D \u0437\u043D\u0430\u0435\u0442,
      \u043A\u0430\u043A \u043C\u0435\u043D\u044F \u0437\u043E\u0432\u0443\u0442\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u0437\u0433\u043B\u044F\u0434 \u0432 \u0432\u0435\u0440\u0445\u043D\u0438\u0439
      \u0443\u0433\u043E\u043B"
