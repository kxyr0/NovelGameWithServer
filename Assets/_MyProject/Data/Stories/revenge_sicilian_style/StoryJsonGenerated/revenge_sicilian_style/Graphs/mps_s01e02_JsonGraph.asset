  guid: mps_s01e02_l1230_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: 95d1e47740b729147bcd7d679212dd21, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u041B\u0443\u043A\u0430"
  - character: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speakerId: "\u041B\u0443\u043A\u0430"
    speakerNameHint: "\u041B\u0443\u043A\u0430"
    speaker: {fileID: 11400000, guid: 95d1e47740b729147bcd7d679212dd21, type: 2}
    emotion: 17
    richText: "\u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u044F \u043F\u043E\u043A\u0430
      \u0440\u0435\u0448\u0438\u043B \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F
      \u0442\u0430\u043C, \u0430 \u0434\u0430\u043B\u044C\u0448\u0435 \u0432\u0438\u0434\u043D\u043E
      \u0431\u0443\u0434\u0435\u0442."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 2
    richText: "\u041F\u0440\u043E\u0431\u043B\u0435\u043C \u043D\u0435 \u043D\u0430\u0439\u0434\u0451\u0442\u0441\u044F?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: "\u041B\u0443\u043A\u0430"
    speakerNameHint: "\u041B\u0443\u043A\u0430"
    speaker: {fileID: 11400000, guid: 95d1e47740b729147bcd7d679212dd21, type: 2}
    emotion: 17
    richText: "\u041F\u043E \u0437\u0430\u043A\u043E\u043D\u0443 \u043E\u043D \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F
      \u043D\u0438\u0447\u0435\u0439\u043D\u044B\u043C, \u0432\u0435\u0434\u044C
      \u043D\u0430\u0441\u043B\u0435\u0434\u043D\u0438\u043A\u043E\u0432 \u043D\u0435\u0442."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: "\u041B\u0443\u043A\u0430"
    speakerNameHint: "\u041B\u0443\u043A\u0430"
    speaker: {fileID: 11400000, guid: 95d1e47740b729147bcd7d679212dd21, type: 2}
    emotion: 21
    richText: "\u0418\u043C, \u043A\u043E\u043D\u0435\u0447\u043D\u043E, \u043C\u043E\u0433
      \u0431\u044B \u0441\u0442\u0430\u0442\u044C \u044F, \u043D\u043E \u0443 \u043D\u0430\u0441
      \u0431\u044B\u043B\u0438 \u0448\u0430\u0442\u043A\u0438\u0435 \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043D\u0430 \u043C\u0435\u043D\u044F
      \u0435\u0433\u043E \u043D\u0435 \u043E\u0444\u043E\u0440\u043C\u0438\u043B\u0438."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0417\u0430\u043A\u0430\u0442\u0438\u0432 \u0433\u043B\u0430\u0437\u0430"
  - speakerId: "\u041B\u0443\u043A\u0430"
    speakerNameHint: "\u041B\u0443\u043A\u0430"
    speaker: {fileID: 11400000, guid: 95d1e47740b729147bcd7d679212dd21, type: 2}
    emotion: 30
    richText: "\u041D\u0443 \u043D\u0438\u0447\u0435\u0433\u043E, \u044F \u0435\u0449\u0451
      \u043F\u043E\u0431\u043E\u0440\u044E\u0441\u044C \u0437\u0430 \u0434\u043E\u043C."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u043E"
  - speakerId: "\u041B\u0443\u043A\u0430"
    speakerNameHint: "\u041B\u0443\u043A\u0430"
    speaker: {fileID: 11400000, guid: 95d1e47740b729147bcd7d679212dd21, type: 2}
    emotion: 2
    richText: "\u0422\u0430\u043A \u0447\u0442\u043E \u0440\u0430\u0434\u0443\u0439\u0441\u044F.
      \u0422\u0432\u043E\u0439 \u0432\u0435\u0440\u043D\u044B\u0439 \u0434\u0440\u0443\u0433
      \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u0443\u043B\u044B\u0431\u0430\u044E\u0441\u044C, \u0437\u0430\u043F\u0438\u0432\u0430\u044F
      \u0435\u0433\u043E \u0441\u043B\u043E\u0432\u0430 \u0432\u0438\u043D\u043E\u043C.
      \u041C\u044B \u0437\u0430\u043C\u043E\u043B\u043A\u0430\u0435\u043C \u043D\u0430
      \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0432\u0440\u0435\u043C\u044F,
      \u043B\u044E\u0431\u0443\u044F\u0441\u044C \u0432\u0438\u0434\u0430\u043C\u0438,
      \u043F\u043E\u043A\u0430 \u043D\u0435 \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u043C
      \u043D\u0430 \u0432\u0445\u043E\u0434\u0435 \u0442\u043E\u043B\u043F\u0443
      \u043B\u044E\u0434\u0435\u0439 \u0432 \u0447\u0451\u0440\u043D\u044B\u0445
      \u043F\u0438\u0434\u0436\u0430\u043A\u0430\u0445."
    style: {fileID: 0}
    authorComment: 
