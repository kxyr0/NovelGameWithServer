    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u0410\u0433\u0435\u043D\u0442\u0441\u0442\u0432\u043E"
    speakerNameHint: "\u0410\u0433\u0435\u043D\u0442\u0441\u0442\u0432\u043E"
    speaker: {fileID: 11400000, guid: 46089e6d6a61b544fb64ae4a472e10b4, type: 2}
    emotion: 17
    richText: "\u041F\u0440\u0438 \u0441\u0435\u0431\u0435 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
      \u0438\u043C\u0435\u0442\u044C\u2026"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0427\u0435\u0440\u043D\u044B\u0439 \u0441\u0438\u043B\u0443\u044D\u0442"
  - speakerId: "\u0410\u0433\u0435\u043D\u0442\u0441\u0442\u0432\u043E"
    speakerNameHint: "\u0410\u0433\u0435\u043D\u0442\u0441\u0442\u0432\u043E"
    speaker: {fileID: 11400000, guid: 46089e6d6a61b544fb64ae4a472e10b4, type: 2}
    emotion: 17
    richText: "\u0414\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0439
      \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442, \u0443\u0434\u043E\u0441\u0442\u043E\u0432\u0435\u0440\u044F\u044E\u0449\u0438\u0439
      \u0412\u0430\u0448\u0443 \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u044C."
    style: {fileID: 0}
