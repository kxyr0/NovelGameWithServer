  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0432 \u0432\u0441\u0435
      \u043F\u0438\u0441\u044C\u043C\u0430, \u044F \u0434\u043E \u043A\u0440\u0430\u0451\u0432
      \u043F\u043E\u043B\u043D\u0430 \u0442\u0430\u043A\u0438\u043C \u0441\u0443\u043C\u0431\u0443\u0440\u043E\u043C
      \u0447\u0443\u0432\u0441\u0442\u0432 \u0438 \u044D\u043C\u043E\u0446\u0438\u0439,
      \u0447\u0442\u043E \u0443\u0436\u0435 \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u044E,
      \u043A\u0430\u043A \u0440\u0435\u0430\u0433\u0438\u0440\u043E\u0432\u0430\u0442\u044C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0417\u0430 \u0441\u0442\u043E\u043B\u044C \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0435
      \u0432\u0440\u0435\u043C\u044F \u043D\u0430 \u043C\u0435\u043D\u044F \u043E\u0431\u0440\u0443\u0448\u0438\u043B\u0441\u044F
      \u0446\u0435\u043B\u044B\u0439 \u0432\u043E\u0434\u043E\u043F\u0430\u0434 \u043D\u043E\u0432\u043E\u0441\u0442\u0435\u0439:
      \u0441\u043C\u0435\u0440\u0442\u044C \u043C\u0430\u0442\u0435\u0440\u0438,
      \u0443\u0433\u0440\u043E\u0437\u044B \u043E\u0442 \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0433\u043E
      \u043B\u0438\u0446\u0430, \u0441\u043A\u043E\u0440\u044B\u0439 \u043F\u0440\u0438\u0435\u0437\u0434
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u0438\u0437 \u043F\u0440\u043E\u0448\u043B\u043E\u0433\u043E...
      \u0418, \u043D\u0430\u043A\u043E\u043D\u0435\u0446, \u043D\u0430\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u043E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
