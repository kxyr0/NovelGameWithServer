  exit: {fileID: 0}
  guid: mps_s01e02_l0422_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: 0c671a61053962a43938a5ae296b6847, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u041D\u0435\u043A\u0442\u043E"
  lines:
  - speakerId: "\u041D\u0435\u043A\u0442\u043E"
    speakerNameHint: "\u041D\u0435\u043A\u0442\u043E"
    speaker: {fileID: 11400000, guid: 0c671a61053962a43938a5ae296b6847, type: 2}
    emotion: 17
    richText: "\u0422\u0435\u043F\u0435\u0440\u044C \u0432\u044B\u0431\u043E\u0440
      \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u0437\u0430 \u0442\u043E\u0431\u043E\u0439.
      \u0425\u043E\u0447\u0435\u0448\u044C \u043B\u0438 \u0442\u044B \u0436\u0430\u0434\u043D\u0438\u0447\u0430\u0442\u044C,
      \u043A\u0430\u043A \u043E\u043D\u0438, \u0438 \u0443\u043C\u0435\u0440\u0435\u0442\u044C?
      \u0418\u043B\u0438 \u043F\u0440\u0435\u0434\u043F\u043E\u0447\u0442\u0451\u0448\u044C
      \u043F\u043E\u0434\u0435\u043B\u0438\u0442\u044C\u0441\u044F \u0438 \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F
      \u0432 \u0436\u0438\u0432\u044B\u0445?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0427\u0435\u0440\u043D\u044B\u0439 \u0441\u0438\u043B\u0443\u044D\u0442"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u0430 \u044D\u0442\u043E\u043C \u0442\u0435\u043A\u0441\u0442
      \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F.
      \u042F \u043D\u0435 \u0441\u0440\u0430\u0437\u0443 \u043E\u0441\u043E\u0437\u043D\u0430\u044E,
      \u043A\u0430\u043A \u0443\u0447\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u043F\u0443\u043B\u044C\u0441,
      \u0430 \u043A\u043E\u0436\u0443 \u043D\u0430 \u043B\u0431\u0443 \u0441\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442
      \u043E\u0442 \u043B\u0435\u0434\u044F\u043D\u043E\u0439 \u0438\u0441\u043F\u0430\u0440\u0438\u043D\u044B."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0423\u0431\u0440\u0430\u0432 \u043F\u0438\u0441\u044C\u043C\u043E
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443, \u044F \u043F\u044B\u0442\u0430\u044E\u0441\u044C
      \u043E\u0442\u0434\u044B\u0448\u0430\u0442\u044C\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
