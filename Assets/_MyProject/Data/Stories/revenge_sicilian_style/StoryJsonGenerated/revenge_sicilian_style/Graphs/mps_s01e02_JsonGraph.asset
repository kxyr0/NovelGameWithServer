  guid: mps_s01e02_l1337_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\u0414\u043E \u0441\u043A\u043E\u0440\u043E\u0433\u043E, \u0438\u0437\u0432\u0438\u043D\u0438."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043F\u0440\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u043E
      \u0441\u043C\u043E\u0442\u0440\u044E \u0432 \u0433\u043B\u0430\u0437\u0430
      \u0447\u043B\u0435\u043D\u0430\u043C \u041A\u043E\u0437\u0430 \u041D\u043E\u0441\u0442\u0440\u044B,
      \u044F\u0441\u043D\u043E \u0434\u0430\u0432\u0430\u044F \u043F\u043E\u043D\u044F\u0442\u044C,
      \u0447\u0442\u043E \u0438\u043C \u0441\u0442\u043E\u0438\u0442 \u043F\u043E\u0439\u0442\u0438
      \u0437\u0430 \u043C\u043D\u043E\u0439."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0414\u0432\u043E\u0435 \u0438\u0437 \u043D\u0438\u0445 \u043F\u043E\u043D\u0438\u043C\u0430\u044E\u0442
      \u043C\u0435\u043D\u044F \u0431\u0435\u0437 \u0441\u043B\u043E\u0432. \u042F
      \u0432\u044B\u0445\u043E\u0436\u0443 \u0438\u0437 \u043F\u0430\u0431\u0430
      \u043F\u0435\u0440\u0432\u043E\u0439, \u043B\u044E\u0434\u0438 \u041A\u043E\u0437\u0430
      \u041D\u043E\u0441\u0442\u0440\u044B \u2014 \u0441\u043B\u0435\u0434\u043E\u043C."
    style: {fileID: 0}
    authorComment: 
