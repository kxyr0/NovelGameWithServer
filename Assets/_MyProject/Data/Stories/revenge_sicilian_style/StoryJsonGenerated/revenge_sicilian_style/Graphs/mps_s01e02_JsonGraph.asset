  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 3
    richText: "\xAB\u042F \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u043F\u0438\u0442\u0430\u044E
      \u043A \u043D\u0435\u0439 \u0442\u0451\u043F\u043B\u044B\u0445 \u0447\u0443\u0432\u0441\u0442\u0432,
      \u043D\u043E... \u043C\u043D\u0435 \u043E\u0431\u0438\u0434\u043D\u043E \u0437\u0430
      \u0435\u0451 \u0441\u0443\u0434\u044C\u0431\u0443\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041F\u0435\u0447\u0430\u043B\u044C"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 28
    richText: "\xAB\u0414\u0430, \u044F \u0441\u0447\u0438\u0442\u0430\u043B\u0430
      \u0435\u0451 \u0432\u0441\u0435\u043C. \u041D\u043E \u0442\u0435\u043F\u0435\u0440\u044C
      \u043E\u043D\u0430 \u0434\u043B\u044F \u043C\u0435\u043D\u044F \u2014 \u043F\u0443\u0441\u0442\u043E\u0435
      \u043C\u0435\u0441\u0442\u043E. \u0425\u043E\u0442\u044F... \u0437\u0430\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u0435\u0442
      \u043B\u0438 \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0442\u0430\u043A\u043E\u0433\u043E
      \u043A\u043E\u043D\u0446\u0430?\xBB"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u0437\u0433\u043B\u044F\u0434 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 4
    richText: "\xAB\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u044D\u0442\u043E\u0442
      \u0430\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0435\u0446 \u0443\u0436\u0435
      \u043F\u043E\u043F\u043B\u0430\u0442\u0438\u043B\u0441\u044F \u0437\u0430 \u0441\u043E\u0434\u0435\u044F\u043D\u043D\u043E\u0435
      \u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u043F\u0440\u0438\u0433\u043E\u0432\u043E\u0440
      \u043F\u043E \u0432\u0441\u0435\u0439 \u0441\u0442\u0440\u043E\u0433\u043E\u0441\u0442\u0438
      \u0437\u0430\u043A\u043E\u043D\u0430\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0417\u043B\u043E\u0441\u0442\u044C"
