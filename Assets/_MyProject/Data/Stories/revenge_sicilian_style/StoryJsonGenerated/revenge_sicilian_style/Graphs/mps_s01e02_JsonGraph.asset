  guid: mps_s01e02_l1166_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  - character: {fileID: 11400000, guid: 95d1e47740b729147bcd7d679212dd21, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u041B\u0443\u043A\u0430"
  lines:
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\u0417\u043D\u0430\u0447\u0438\u0442, \u0442\u044B \u0431\u0440\u043E\u0441\u0438\u043B
      \u0432\u0441\u0435 \u0434\u0435\u043B\u0430 \u0438 \u043F\u0440\u0438\u0435\u0445\u0430\u043B
      \u0441\u044E\u0434\u0430, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u0442\u044C
      \u043C\u0435\u043D\u044F."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 8
    richText: "\u041D\u0430\u0434\u043E\u043B\u0433\u043E?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0432\u0437\u0433\u043B\u044F\u0434"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u0434\u043E\u043F\u0438\u0432\u0430\u0435\u0442 \u043D\u0430\u043F\u0438\u0442\u043E\u043A
      \u0438 \u043E\u0442\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0431\u043E\u043A\u0430\u043B
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u041B\u0443\u043A\u0430"
    speakerNameHint: "\u041B\u0443\u043A\u0430"
    speaker: {fileID: 11400000, guid: 95d1e47740b729147bcd7d679212dd21, type: 2}
    emotion: 21
    richText: "\u041D\u0443\u0443... \u0412\u043E\u043E\u0431\u0449\u0435-\u0442\u043E,
      \u0432\u0440\u043E\u0434\u0435 \u043A\u0430\u043A, \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0417\u0430\u043A\u0430\u0442\u0438\u0432 \u0433\u043B\u0430\u0437\u0430"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u0447\u0443\u0442\u044C \u043B\u0438 \u043D\u0435 \u0434\u0430\u0432\u043B\u044E\u0441\u044C
      \u0432\u043E\u0437\u0434\u0443\u0445\u043E\u043C \u2014 \u043D\u0435 \u0442\u0430\u043A\u043E\u0433\u043E
      \u043E\u0436\u0438\u0434\u0430\u043B\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 6
    richText: "\u041F\u0440\u043E\u0441\u0442\u0438..."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u0434\u0438\u0432\u043B\u0435\u043D\u0438\u0435"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 8
    richText: "\u0422\u044B \u0441\u043A\u0430\u0437\u0430\u043B \u2014 \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0432\u0437\u0433\u043B\u044F\u0434"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 32
    richText: "\u041C\u043D\u0435 \u043D\u0435 \u043F\u043E\u0441\u043B\u044B\u0448\u0430\u043B\u043E\u0441\u044C?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041F\u0440\u0438\u0449\u0443\u0440"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041B\u0443\u043A\u0430 \u043E\u0431\u043B\u043E\u043A\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0441\u043F\u0438\u043D\u043A\u0443 \u0434\u0438\u0432\u0430\u043D\u0430,
      \u0440\u0430\u0441\u043A\u0438\u043D\u0443\u0432 \u0440\u0443\u043A\u0438 \u043F\u043E
      \u0441\u0442\u043E\u0440\u043E\u043D\u0430\u043C, \u0438 \u0435\u0445\u0438\u0434\u043D\u043E
      \u0443\u0445\u043C\u044B\u043B\u044F\u0435\u0442\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u041B\u0443\u043A\u0430"
    speakerNameHint: "\u041B\u0443\u043A\u0430"
    speaker: {fileID: 11400000, guid: 95d1e47740b729147bcd7d679212dd21, type: 2}
    emotion: 13
    richText: "\u0410 \u0447\u0442\u043E? \u0422\u044B \u0441\u043E\u0432\u0441\u0435\u043C
      \u043D\u0435 \u0440\u0430\u0434\u0430 \u0441\u0432\u043E\u0435\u043C\u0443
      \u0434\u0430\u0432\u043D\u0435\u043C\u0443 \u0437\u043D\u0430\u043A\u043E\u043C\u043E\u043C\u0443?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0415\u0445\u0438\u0434\u043D\u0430\u044F \u0443\u043B\u044B\u0431\u043A\u0430"
  - speakerId: "\u041B\u0443\u043A\u0430"
    speakerNameHint: "\u041B\u0443\u043A\u0430"
    speaker: {fileID: 11400000, guid: 95d1e47740b729147bcd7d679212dd21, type: 2}
    emotion: 2
    richText: "\u0414\u043B\u044F \u043D\u0435\u0433\u043E \u043C\u0435\u0441\u0442\u0435\u0447\u043A\u0430
      \u0432 \u041F\u0430\u043B\u0435\u0440\u043C\u043E \u0443\u0436\u0435 \u043D\u0435
      \u043D\u0430\u0439\u0434\u0451\u0442\u0441\u044F?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u0441\u0430\u0436\u0443\u0441\u044C \u0431\u043E\u043A\u043E\u043C,
      \u043E\u0431\u0440\u0430\u0449\u0430\u044F \u0432\u0441\u0451 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435
      \u043B\u0438\u0448\u044C \u043D\u0430 \u0434\u0440\u0443\u0433\u0430."
    style: {fileID: 0}
    authorComment: 
