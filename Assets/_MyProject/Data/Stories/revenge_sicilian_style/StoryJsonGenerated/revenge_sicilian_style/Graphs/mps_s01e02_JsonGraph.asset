  guid: mps_s01e02_l1040_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: a8933a6c5a91b174da5d185422ada7c4, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u0421\u0435\u0440\u0432\u0438\u0442\u0440\u0438\u0441\u0430"
  - character: {fileID: 11400000, guid: 95d1e47740b729147bcd7d679212dd21, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u041B\u0443\u043A\u0430"
  - character: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041C\u044B \u0441\u0430\u0434\u0438\u043C\u0441\u044F \u0437\u0430
      \u043F\u0443\u0441\u0442\u043E\u0439 \u0441\u0442\u043E\u043B\u0438\u043A."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u0438\u0434\u0435\u043D\u044C\u044F \u0443\u0434\u043E\u0431\u043D\u044B\u0435,
      \u043C\u0435\u0441\u0442\u0430 \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
      \u2014 \u041B\u0443\u043A\u0430 \u044F\u0432\u043D\u043E \u0437\u043D\u0430\u0435\u0442,
      \u043A\u0430\u043A \u043F\u043E\u0437\u0430\u0431\u043E\u0442\u0438\u0442\u044C\u0441\u044F
      \u043E \u043A\u043E\u043C\u0444\u043E\u0440\u0442\u0435. \u0412\u0435\u0434\u044C
      \u044D\u0442\u043E \u0431\u044B\u043B\u0430 \u043E\u0434\u043D\u0430 \u0438\u0437
      \u043E\u0442\u043B\u0438\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
      \u0447\u0435\u0440\u0442 \u044D\u0442\u043E\u0433\u043E \u0441\u0438\u0446\u0438\u043B\u0438\u0439\u0441\u043A\u043E\u0433\u043E
      \u043A\u0440\u0430\u0441\u0430\u0432\u0447\u0438\u043A\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u043C\u0430\u0448\u0435\u0442 \u0440\u0443\u043A\u043E\u0439,
      \u043F\u043E\u0434\u0437\u044B\u0432\u0430\u044F \u0441\u0435\u0440\u0432\u0438\u0442\u0440\u0438\u0441\u0443
      - \u0434\u0435\u0432\u0443\u0448\u043A\u0443, \u0447\u0442\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u0437\u0434\u0435\u0441\u044C \u0434\u043B\u044F \u0433\u043E\u0441\u0442\u0435\u0439."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430\u043C, \u0437\u0430\u0432\u0435\u0440\u0448\u0430\u044F \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u0435
      \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u0441\u0442\u043E\u043B\u0430,
      \u0438 \u0431\u044B\u0441\u0442\u0440\u043E \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
      \u043A \u043D\u0430\u0448\u0435\u043C\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u0421\u0435\u0440\u0432\u0438\u0442\u0440\u0438\u0441\u0430"
    speakerNameHint: "\u0421\u0435\u0440\u0432\u0438\u0442\u0440\u0438\u0441\u0430"
    speaker: {fileID: 11400000, guid: a8933a6c5a91b174da5d185422ada7c4, type: 2}
    emotion: 2
    richText: "\u0414\u043E\u0431\u0440\u044B\u0439 \u0432\u0435\u0447\u0435\u0440,
      \u0447\u0435\u043C \u043C\u043E\u0433\u0443 \u0431\u044B\u0442\u044C \u043E\u0431\u044F\u0437\u0430\u043D\u0430?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: "\u041B\u0443\u043A\u0430"
    speakerNameHint: "\u041B\u0443\u043A\u0430"
    speaker: {fileID: 11400000, guid: 95d1e47740b729147bcd7d679212dd21, type: 2}
    emotion: 17
    richText: "\u041D\u0430\u043C, \u0431\u0443\u0434\u044C\u0442\u0435 \u043B\u044E\u0431\u0435\u0437\u043D\u044B,
      \u0434\u0432\u0430 \u0431\u043E\u043A\u0430\u043B\u0430 \u0432\u0438\u043D\u0430
      Nero d'Avola."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0434\u0435\u043B\u0430\u0435\u0442 \u0434\u043B\u044F
      \u0441\u0435\u0431\u044F \u043F\u043E\u043C\u0435\u0442\u043A\u0443, \u0447\u0442\u043E\u0431\u044B
      \u043D\u0435 \u0437\u0430\u0431\u044B\u0442\u044C \u0437\u0430\u043A\u0430\u0437:
      \u043D\u0430\u0440\u043E\u0434\u0443 \u0432 \u0437\u0430\u043B\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442,
      \u043E\u0448\u0438\u0431\u0438\u0442\u044C\u0441\u044F \u043D\u0438\u043A\u0430\u043A
      \u043D\u0435\u043B\u044C\u0437\u044F."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u0435\u0441\u043B\u0438
      \u0437\u0430\u043A\u0430\u0437 \u0441\u0434\u0435\u043B\u0430\u043D \u043D\u0435\u043C\u0446\u0435\u043C
      \u2014 \u0438\u0445 \u0442\u0443\u0442, \u043A\u0441\u0442\u0430\u0442\u0438,
      \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C \u043D\u0435 \u0440\u0435\u0434\u043A\u043E\u0441\u0442\u044C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u0421\u0435\u0440\u0432\u0438\u0442\u0440\u0438\u0441\u0430"
    speakerNameHint: "\u0421\u0435\u0440\u0432\u0438\u0442\u0440\u0438\u0441\u0430"
    speaker: {fileID: 11400000, guid: a8933a6c5a91b174da5d185422ada7c4, type: 2}
    emotion: 8
    richText: "\u0415\u0449\u0451 \u0447\u0435\u0433\u043E-\u043D\u0438\u0431\u0443\u0434\u044C?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0432\u0437\u0433\u043B\u044F\u0434"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 2
    richText: "\u041D\u0435\u0442, \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u043C."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 2
    richText: "\u041D\u0430 \u044D\u0442\u043E\u043C \u0432\u0441\u0451."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: "\u0421\u0435\u0440\u0432\u0438\u0442\u0440\u0438\u0441\u0430"
    speakerNameHint: "\u0421\u0435\u0440\u0432\u0438\u0442\u0440\u0438\u0441\u0430"
    speaker: {fileID: 11400000, guid: a8933a6c5a91b174da5d185422ada7c4, type: 2}
    emotion: 2
    richText: "\u0425\u043E\u0440\u043E\u0448\u043E! \u041E\u0436\u0438\u0434\u0430\u0439\u0442\u0435!"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
