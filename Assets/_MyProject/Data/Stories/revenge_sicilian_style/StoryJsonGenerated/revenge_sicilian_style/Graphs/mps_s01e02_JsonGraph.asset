  guid: mps_s01e02_l0830_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters: []
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043F\u0440\u043E\u0432\u043E\u0436\u0430\u044E \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C
      \u0444\u0438\u0433\u0443\u0440\u044B, \u043F\u043E\u043A\u0430 \u043E\u043D\u0438
      \u043D\u0435 \u0441\u043A\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F \u0437\u0430
      \u0443\u0433\u043B\u043E\u043C, \u043F\u043E\u0441\u043B\u0435 \u0447\u0435\u0433\u043E
      \u0440\u0435\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0441\u044C
      \u0432\u043D\u0443\u0442\u0440\u044C \u0437\u0434\u0430\u043D\u0438\u044F."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041C\u043E\u044F \u0446\u0435\u043B\u044C - \u043D\u0430\u0439\u0442\u0438
      \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044F \u043F\u0438\u0441\u044C\u043C\u0430."
    style: {fileID: 0}
    authorComment: 
--- !u!114 &7638138060783007364
