  guid: mps_s01e02_l0749_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  - character: {fileID: 11400000, guid: e706e7d1a91e19d4abff1ac05facf1ab, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u0414\u0436\u0443\u043B\u0438\u044F"
  lines:
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 32
    richText: "\u0417\u043D\u0430\u044E, \u0442\u044B \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u0430,
      \u0447\u0442\u043E \u043F\u043E\u0434\u0440\u0443\u0433\u0430 \u043B\u0435\u0437\u0435\u0442
      \u0432 \u0442\u0432\u043E\u044E \u0436\u0438\u0437\u043D\u044C..."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041F\u0440\u0438\u0449\u0443\u0440"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 28
    richText: "\u0427\u0442\u043E \u0441\u0442\u0430\u0440\u0430\u0435\u0442\u0441\u044F
      \u0440\u0435\u0448\u0438\u0442\u044C \u0437\u0430 \u0442\u0435\u0431\u044F."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u0437\u0433\u043B\u044F\u0434 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\u0427\u0442\u043E \u0434\u0430\u0451\u0442 \u043D\u0435\u043F\u0440\u043E\u0448\u0435\u043D\u043D\u044B\u0435
      \u0441\u043E\u0432\u0435\u0442\u044B, \u043E\u0434\u043D\u0430\u043A\u043E..."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043D\u0430 \u0441\u0435\u043A\u0443\u043D\u0434\u0443 \u043E\u0442\u0432\u043E\u0436\u0443
      \u0432\u0437\u0433\u043B\u044F\u0434."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041C\u043E\u0433\u0443 \u0441\u0435\u0439\u0447\u0430\u0441 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u0438 \u043D\u0435
      \u0440\u0435\u0448\u0430\u0442\u044C \u0437\u0430 \u043D\u0435\u0451, \u043D\u043E
      \u043D\u0435\u0442, \u044D\u0442\u043E \u043D\u0435 \u043F\u0440\u043E \u043C\u0435\u043D\u044F.."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u043C\u043D\u0435 \u043D\u0435 \u0447\u0443\u0436\u043E\u0439
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A, \u0438 \u043C\u043D\u0435 \u0445\u043E\u0447\u0435\u0442\u0441\u044F
      \u0434\u043B\u044F \u043D\u0435\u0451 \u0441\u0447\u0430\u0441\u0442\u044C\u044F."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043F\u043E\u043D\u0438\u043C\u0430\u044E, \u0447\u0442\u043E,
      \u043C\u043E\u0436\u0435\u0442, \u0441\u0435\u0439\u0447\u0430\u0441 \u043E\u043D\u0430
      \u0438 \u043D\u0435 \u043F\u0440\u0438\u0441\u043B\u0443\u0448\u0430\u0435\u0442\u0441\u044F,
      \u043D\u043E \u0441\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C
      \u043F\u043E\u0439\u043C\u0451\u0442 \u043C\u043E\u044E \u043F\u0440\u0430\u0432\u043E\u0442\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\u041E\u0434\u043D\u0430\u043A\u043E \u044F \u043D\u0435 \u043C\u043E\u0433\u0443
      \u043D\u0435 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0434\u0438\u0442\u044C..."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0414\u0436\u0443\u043B\u0438\u044F \u043F\u0435\u0440\u0435\u0431\u0438\u0432\u0430\u0435\u0442
      \u043C\u0435\u043D\u044F."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u0414\u0436\u0443\u043B\u0438\u044F"
    speakerNameHint: "\u0414\u0436\u0443\u043B\u0438\u044F"
    speaker: {fileID: 11400000, guid: e706e7d1a91e19d4abff1ac05facf1ab, type: 2}
    emotion: 8
    richText: "\u041E \u0447\u0451\u043C?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0432\u0437\u0433\u043B\u044F\u0434"
  - speakerId: "\u0414\u0436\u0443\u043B\u0438\u044F"
    speakerNameHint: "\u0414\u0436\u0443\u043B\u0438\u044F"
    speaker: {fileID: 11400000, guid: e706e7d1a91e19d4abff1ac05facf1ab, type: 2}
    emotion: 8
    richText: "\u041E \u0442\u043E\u043C, \u0447\u0442\u043E \u041A\u0443\u0440\u0446
      \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u043E\u043F\u0430\u0441\u0435\u043D?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0432\u0437\u0433\u043B\u044F\u0434"
  - speakerId: "\u0414\u0436\u0443\u043B\u0438\u044F"
    speakerNameHint: "\u0414\u0436\u0443\u043B\u0438\u044F"
    speaker: {fileID: 11400000, guid: e706e7d1a91e19d4abff1ac05facf1ab, type: 2}
    emotion: 17
    richText: "\u0415\u0441\u043B\u0438 \u0442\u044B \u0445\u043E\u0447\u0435\u0448\u044C
      \u043F\u043E\u0432\u0442\u043E\u0440\u0438\u0442\u044C\u0441\u044F \u043E\u0431
      \u044D\u0442\u043E\u043C, \u043D\u0435 \u0442\u0440\u0430\u0442\u044C, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430,
      \u043D\u0438 \u043C\u043E\u0451 \u0432\u0440\u0435\u043C\u044F, \u043D\u0438
      \u0441\u0432\u043E\u0451."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
