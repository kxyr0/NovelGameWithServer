  guid: mps_s01e01_l1054_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: e706e7d1a91e19d4abff1ac05facf1ab, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u0414\u0436\u0443\u043B\u0438\u044F"
  - character: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  - character: {fileID: 11400000, guid: f6f28a20d33c88c458b4a76052a9b054, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u0414\u043E\u043A\u0442\u043E\u0440"
  lines:
  - speakerId: "\u0414\u0436\u0443\u043B\u0438\u044F"
    speakerNameHint: "\u0414\u0436\u0443\u043B\u0438\u044F"
    speaker: {fileID: 11400000, guid: e706e7d1a91e19d4abff1ac05facf1ab, type: 2}
    emotion: 17
    richText: "\u0418 \u0447\u0442\u043E \u0436\u0435 \u043E\u043D \u0441\u0434\u0435\u043B\u0430\u043B?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 2
    richText: "\u0421\u043B\u0430\u0432\u0430 \u0414\u0435\u0432\u0435 \u041C\u0430\u0440\u0438\u0438,
      \u043D\u0438\u0447\u0435\u0433\u043E \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u043E\u0433\u043E."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0414\u0436\u0443\u043B\u0438\u044F \u0434\u043E\u043A\u0443\u0440\u0438\u0432\u0430\u0435\u0442
      \u0441\u0438\u0433\u0430\u0440\u0435\u0442\u0443 \u0438 \u0432\u0441\u0442\u0430\u0451\u0442.
      \u0412 \u044D\u0442\u043E\u0442 \u0436\u0435 \u043C\u043E\u043C\u0435\u043D\u0442
      \u0432 \u0434\u0432\u0435\u0440\u044F\u0445 \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0433\u043E\u043B\u043E\u0432\u0430 \u0434\u043E\u043A\u0442\u043E\u0440\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u0414\u043E\u043A\u0442\u043E\u0440"
    speakerNameHint: "\u0414\u043E\u043A\u0442\u043E\u0440"
    speaker: {fileID: 11400000, guid: f6f28a20d33c88c458b4a76052a9b054, type: 2}
    emotion: 17
    richText: "\u0414\u0436\u0443\u043B\u0438\u044F! \u041A \u0432\u0430\u043C \u043F\u0430\u0446\u0438\u0435\u043D\u0442
      \u0441 \u0442\u044F\u0436\u0451\u043B\u044B\u043C \u0440\u0430\u043D\u0435\u043D\u0438\u0435\u043C!"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: "\u0414\u043E\u043A\u0442\u043E\u0440"
    speakerNameHint: "\u0414\u043E\u043A\u0442\u043E\u0440"
    speaker: {fileID: 11400000, guid: f6f28a20d33c88c458b4a76052a9b054, type: 2}
    emotion: 17
    richText: "\u0421\u0440\u043E\u0447\u043D\u043E \u0432 \u043F\u0430\u043B\u0430\u0442\u0443!"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: "\u0414\u0436\u0443\u043B\u0438\u044F"
    speakerNameHint: "\u0414\u0436\u0443\u043B\u0438\u044F"
    speaker: {fileID: 11400000, guid: e706e7d1a91e19d4abff1ac05facf1ab, type: 2}
    emotion: 17
    richText: "\u0425\u043E\u0440\u043E\u0448\u043E."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u0432\u0441\u0442\u0430\u044E \u0441\u043B\u0435\u0434\u043E\u043C.
      \u0414\u0436\u0443\u043B\u0438\u044F \u043A\u0438\u0432\u0430\u0435\u0442 \u0434\u043E\u043A\u0442\u043E\u0440\u0443
      \u0438 \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043A\u043E \u043C\u043D\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u0414\u0436\u0443\u043B\u0438\u044F"
    speakerNameHint: "\u0414\u0436\u0443\u043B\u0438\u044F"
    speaker: {fileID: 11400000, guid: e706e7d1a91e19d4abff1ac05facf1ab, type: 2}
    emotion: 17
    richText: "\u041D\u0435 \u0432\u0441\u0435 \u043B\u044E\u0434\u0438 \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u044B,
      \u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: "\u0414\u0436\u0443\u043B\u0438\u044F"
    speakerNameHint: "\u0414\u0436\u0443\u043B\u0438\u044F"
    speaker: {fileID: 11400000, guid: e706e7d1a91e19d4abff1ac05facf1ab, type: 2}
    emotion: 3
    richText: "\u041C\u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u0436\u0430\u043B\u044C,
      \u0447\u0442\u043E \u0442\u044B \u043F\u043E\u043F\u0430\u043B\u0430 \u0432
      \u0442\u0430\u043A\u0443\u044E \u0438\u0441\u0442\u043E\u0440\u0438\u044E."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041F\u0435\u0447\u0430\u043B\u044C"
  - speakerId: "\u0414\u0436\u0443\u043B\u0438\u044F"
    speakerNameHint: "\u0414\u0436\u0443\u043B\u0438\u044F"
    speaker: {fileID: 11400000, guid: e706e7d1a91e19d4abff1ac05facf1ab, type: 2}
    emotion: 17
    richText: "\u041D\u043E \u043F\u043E\u0439\u043C\u0438, \u043D\u0435 \u0432\u0441\u0435
      \u043B\u044E\u0434\u0438 \u043F\u043B\u043E\u0445\u0438\u0435. \u041D\u0435\u0432\u0430\u0436\u043D\u043E,
      \u043D\u0435\u043C\u0446\u044B \u043E\u043D \u0438\u043B\u0438 \u0438\u0442\u0430\u043B\u044C\u044F\u043D\u0446\u044B."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 3
    richText: "\u0414\u0436\u0443\u043B\u0438\u044F..."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041F\u0435\u0447\u0430\u043B\u044C"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
      \u0431\u043B\u0438\u0436\u0435 \u0438 \u0431\u0435\u0440\u0451\u0442 \u043C\u0435\u043D\u044F
      \u0437\u0430 \u0440\u0443\u043A\u0438."
    style: {fileID: 0}
    authorComment: 
