  lines:
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 30
    richText: "\u041E\u0434\u0438\u043D \u0442\u0430\u043A\u043E\u0439 \u0445\u043E\u0442\u0435\u043B
      \u043C\u043D\u0435 \u043F\u043E\u043C\u043E\u0447\u044C, \u043A\u043E\u0433\u0434\u0430
      \u044F \u0440\u0430\u0441\u0441\u044B\u043F\u0430\u043B\u0430 \u0430\u043F\u0435\u043B\u044C\u0441\u0438\u043D\u044B
      \u0438\u0437 \u043A\u043E\u0440\u0437\u0438\u043D\u044B."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u0430\u044F"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\u042F \u043E\u0442\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
      \u043E\u0442 \u043F\u043E\u043C\u043E\u0449\u0438 \u0438 \u0445\u043E\u0442\u0435\u043B\u0430
      \u043F\u043E\u0439\u0442\u0438 \u0434\u0430\u043B\u044C\u0448\u0435, \u043D\u043E
      \u043E\u043D \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u043B \u0433\u0440\u0443\u0431\u0443\u044E
      \u0441\u0438\u043B\u0443 \u0438 \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u043B
      \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F \u043D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u0438
      \u0438 \u0441\u043B\u0443\u0448\u0430\u0442\u044C \u0440\u0435\u0447\u044C
      \u041C\u0443\u0441\u0441\u043E\u043B\u0438\u043D\u0438."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
