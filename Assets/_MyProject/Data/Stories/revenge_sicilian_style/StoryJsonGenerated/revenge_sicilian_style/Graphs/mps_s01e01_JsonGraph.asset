  guid: mps_s01e01_l0404_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  - character: {fileID: 11400000, guid: 0d74ce51fe0a954408fea0cfa1c4bfc8, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u0410\u043D\u0442\u043E\u043D\u0438\u043E"
  lines:
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 28
    richText: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0442\u044C \u043C\u0430\u0433\u0430\u0437\u0438\u043D
      \u0432 \u043E\u0434\u0438\u043D\u043E\u0447\u043A\u0443."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0432\u0437\u0433\u043B\u044F\u0434 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\u041E\u0431\u044B\u0447\u043D\u043E \u044D\u0442\u0438\u043C \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
      \u043E\u0442\u0435\u0446, \u043D\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u043E\u043D \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E \u043E\u0442\u043B\u0443\u0447\u0438\u043B\u0441\u044F
      \u043F\u043E \u0434\u0435\u043B\u0430\u043C \u0438 \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B
      \u043C\u0435\u043D\u044F \u043F\u043E\u0437\u0430\u0431\u043E\u0442\u0438\u0442\u044C\u0441\u044F
      \u043E\u0431\u043E \u0432\u0441\u0435\u043C \u0441\u0430\u043C\u043E\u0439."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 19
    richText: "\u042F \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u0440\u0430\u043D\u044C\u0448\u0435
      \u043D\u0435 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u043B\u0430 \u0435\u0433\u043E,
      \u0430 \u0442\u0443\u0442 \u0435\u0449\u0451 \u043F\u043E\u0434 \u043A\u043E\u043D\u0435\u0446
      \u0434\u043D\u044F \u044F\u0432\u0438\u043B\u0441\u044F \u0432\u0441\u043F\u044B\u043B\u044C\u0447\u0438\u0432\u044B\u0439
      \u043A\u043B\u0438\u0435\u043D\u0442."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0432\u0437\u0433\u043B\u044F\u0434 \u0432 \u0432\u0435\u0440\u0445\u043D\u0438\u0439
      \u0443\u0433\u043E\u043B"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 2
    richText: "\u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u043F\u0440\u0438\u043B\u043E\u0436\u0438\u0442\u044C
      \u043D\u0435\u043C\u0430\u043B\u043E \u0443\u0441\u0438\u043B\u0438\u0439,
      \u0447\u0442\u043E\u0431\u044B \u0441\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F
      \u0441 \u0435\u0433\u043E \u043D\u0430\u043F\u043E\u0440\u043E\u043C."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 13
    richText: "\u041E\u0434\u043D\u0430\u043A\u043E \u0443 \u043C\u0435\u043D\u044F
      \u0432\u0441\u0451 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C
      \u2014 \u043D\u0430\u0448\u043B\u0430 \u043D\u0443\u0436\u043D\u044B\u0435
      \u0441\u043B\u043E\u0432\u0430, \u0441\u0443\u043C\u0435\u0432 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C
      \u0432\u0435\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u044C \u0438 \u0434\u043E\u0441\u0442\u043E\u0438\u043D\u0441\u0442\u0432\u043E."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0415\u0445\u0438\u0434\u043D\u0430\u044F \u0443\u043B\u044B\u0431\u043A\u0430"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0410\u043D\u0442\u043E\u043D\u0438\u043E, \u043F\u0435\u0440\u0435\u0434\u0430\u0432
      \u0433\u0430\u0437\u0435\u0442\u0443 \u043F\u0440\u043E\u0445\u043E\u0436\u0435\u043C\u0443
      \u0438 \u0441\u043F\u0440\u044F\u0442\u0430\u0432 \u0434\u0435\u043D\u044C\u0433\u0438
      \u0432 \u043A\u0430\u0440\u043C\u0430\u043D, \u0432\u043D\u043E\u0432\u044C
      \u043E\u0431\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u043A\u043E \u043C\u043D\u0435
      \u0441 \u0443\u043B\u044B\u0431\u043A\u043E\u0439."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u0410\u043D\u0442\u043E\u043D\u0438\u043E"
    speakerNameHint: "\u0410\u043D\u0442\u043E\u043D\u0438\u043E"
    speaker: {fileID: 11400000, guid: 0d74ce51fe0a954408fea0cfa1c4bfc8, type: 2}
    emotion: 2
    richText: "\u0423\u043C\u043D\u0438\u0446\u0430."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: "\u0410\u043D\u0442\u043E\u043D\u0438\u043E"
    speakerNameHint: "\u0410\u043D\u0442\u043E\u043D\u0438\u043E"
    speaker: {fileID: 11400000, guid: 0d74ce51fe0a954408fea0cfa1c4bfc8, type: 2}
    emotion: 27
    richText: "\u042F \u0432 \u0442\u0435\u0431\u0435 \u043D\u0435 \u0441\u043E\u043C\u043D\u0435\u0432\u0430\u043B\u0441\u044F."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430 \u0441 \u0437\u0443\u0431\u0430\u043C\u0438"
  - speakerId: "\u0410\u043D\u0442\u043E\u043D\u0438\u043E"
    speakerNameHint: "\u0410\u043D\u0442\u043E\u043D\u0438\u043E"
    speaker: {fileID: 11400000, guid: 0d74ce51fe0a954408fea0cfa1c4bfc8, type: 2}
    emotion: 2
    richText: "\u0422\u044B \u0432\u0441\u0435\u0433\u0434\u0430 \u0443\u043C\u0435\u043B\u0430
      \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C \u0432\u044B\u0445\u043E\u0434
      \u0438\u0437 \u0441\u0430\u043C\u044B\u0445 \u043D\u0435\u043F\u0440\u043E\u0441\u0442\u044B\u0445
      \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0439 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
      \u0440\u0435\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
      \u0438 \u043F\u0440\u044F\u043C\u043E\u0442\u0435."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u0443\u043B\u044B\u0431\u043D\u0443\u043B\u0430\u0441\u044C
      \u0432 \u043E\u0442\u0432\u0435\u0442, \u0441\u0442\u0430\u0440\u0430\u044F\u0441\u044C
      \u0441\u043A\u0440\u044B\u0442\u044C \u0442\u0440\u0435\u0432\u043E\u0433\u0443
      \u0432\u043E \u0432\u0437\u0433\u043B\u044F\u0434\u0435 \u2014 \u043E\u0442\u0433\u043E\u043B\u043E\u0441\u043E\u043A
      \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u043E\u0433\u043E \u0441\u043B\u0443\u0447\u0430\u044F
      \u043D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0415\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E,
      \u044F \u043D\u0435 \u0441\u0442\u0430\u043B\u0430 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C
      \u0435\u043C\u0443 \u043E\u0431 \u044D\u0442\u043E\u043C."
    style: {fileID: 0}
