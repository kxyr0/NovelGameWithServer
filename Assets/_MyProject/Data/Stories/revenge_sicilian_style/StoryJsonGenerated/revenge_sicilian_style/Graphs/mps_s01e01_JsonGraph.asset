  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: mps_s01e01_l0439_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: 0d74ce51fe0a954408fea0cfa1c4bfc8, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u0410\u043D\u0442\u043E\u043D\u0438\u043E"
  - character: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u043D\u0435 \u0443\u0441\u043F\u0435\u0432\u0430\u0435\u0442
      \u043E\u0442\u0432\u0435\u0442\u0438\u0442\u044C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041C\u044B \u043E\u0431\u0430 \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u043C
      \u0433\u043E\u043B\u043E\u0432\u044B \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443,
      \u043E\u0442\u043A\u0443\u0434\u0430 \u0434\u043E\u043D\u043E\u0441\u0438\u0442\u0441\u044F
      \u0448\u0443\u043C \u043C\u043E\u0442\u043E\u0440\u0430, \u0438 \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u043C
      \u043F\u043E\u0434\u044A\u0435\u0445\u0430\u0432\u0448\u0438\u0439 \u043A \u043D\u0430\u043C
      \u0434\u043E\u0440\u043E\u0433\u043E\u0439, \u0447\u0451\u0440\u043D\u044B\u0439,
      \u043A\u0430\u043A \u0441\u043C\u043E\u043B\u044C, \u0430\u0432\u0442\u043E\u043C\u043E\u0431\u0438\u043B\u044C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u043A\u0432\u043E\u0437\u044C \u0441\u0442\u0451\u043A\u043B\u0430
      \u044F \u0441 \u0442\u0440\u0443\u0434\u043E\u043C \u0440\u0430\u0437\u043B\u0438\u0447\u0430\u044E
      \u0441\u0438\u043B\u0443\u044D\u0442\u044B, \u043D\u043E \u0432\u0438\u0436\u0443:
      \u0437\u0430 \u0440\u0443\u043B\u0451\u043C \u2014 \u043C\u0443\u0436\u0447\u0438\u043D\u0430
      \u0432 \u0448\u043B\u044F\u043F\u0435, \u043D\u0430\u0434\u0432\u0438\u043D\u0443\u0442\u043E\u0439
      \u0442\u0430\u043A \u043D\u0438\u0437\u043A\u043E, \u0447\u0442\u043E \u043E\u043D\u0430
      \u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443
      \u043B\u0438\u0446\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421 \u043F\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u0441\u043A\u043E\u0433\u043E
      \u0441\u0438\u0434\u0435\u043D\u044C\u044F, \u043B\u0435\u043D\u0438\u0432\u043E
      \u0440\u0430\u0441\u043F\u0430\u0445\u043D\u0443\u0432 \u0434\u0432\u0435\u0440\u044C,
      \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u0436\u0435\u043D\u0449\u0438\u043D\u0430."
