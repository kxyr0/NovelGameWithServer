  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u043D\u0430\u043A\u043B\u043E\u043D\u044F\u0435\u0442\u0441\u044F
      \u0438 \u043D\u0435\u0436\u043D\u043E \u0446\u0435\u043B\u0443\u0435\u0442
      \u043C\u0435\u043D\u044F \u0432 \u043B\u043E\u0431, \u0430 \u0437\u0430\u0442\u0435\u043C,
      \u043D\u0430\u0441\u0432\u0438\u0441\u0442\u044B\u0432\u0430\u044F \u043A\u0430\u043A\u0443\u044E-\u0442\u043E
      \u043F\u0440\u0438\u044F\u0442\u043D\u0443\u044E \u043C\u0435\u043B\u043E\u0434\u0438\u044E,
      \u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0432 \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u0439
      \u043A\u043E\u043C\u043D\u0430\u0442\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 2
    richText: "\u0418 \u044F \u0442\u0435\u0431\u044F \u043B\u044E\u0431\u043B\u044E,
      \u043F\u0430\u043F."
    style: {fileID: 0}
