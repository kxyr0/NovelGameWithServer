  guid: mps_s01e01_l0205_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\xAB\u041D\u0435\u0441\u043E\u043C\u043D\u0435\u043D\u043D\u043E,
      \u0435\u0433\u043E \u043B\u044E\u0434\u0438 \u043E\u043A\u0440\u0443\u0436\u0438\u043B\u0438
      \u043F\u043B\u043E\u0449\u0430\u0434\u044C \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0442\u0430\u043A\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u044C\u043D\u0430\u044F"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 19
    richText: "\xAB\u041E\u043D \u0445\u043E\u0447\u0435\u0442, \u0447\u0442\u043E\u0431\u044B
      \u0435\u0433\u043E \u0441\u043B\u043E\u0432\u0430 \u0443\u0441\u043B\u044B\u0448\u0430\u043B
      \u043A\u0430\u0436\u0434\u044B\u0439\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0432\u0437\u0433\u043B\u044F\u0434 \u0432 \u0432\u0435\u0440\u0445\u043D\u0438\u0439
      \u0443\u0433\u043E\u043B"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u0434\u0435\u043B\u0430\u0432 \u043D\u0430\u0434 \u0441\u043E\u0431\u043E\u0439
      \u0443\u0441\u0438\u043B\u0438\u0435, \u044F \u0434\u0430\u044E \u043D\u0430\u0446\u0438\u0441\u0442\u0443
      \u043F\u043E\u043D\u044F\u0442\u044C, \u0447\u0442\u043E \u043D\u0435 \u0431\u0443\u0434\u0443
      \u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F \u0443\u0439\u0442\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u043A\u0438\u0432\u0430\u0435\u0442,
      \u0443\u0431\u0438\u0440\u0430\u0435\u0442 \u0440\u0443\u043A\u0443 \u0438
      \u0432\u043D\u043E\u0432\u044C \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442
      \u0441\u0432\u043E\u044E \u043F\u043E\u0437\u0438\u0446\u0438\u044E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\xAB\u042F \u0443\u0433\u0430\u0434\u0430\u043B\u0430\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C\u043D\u043E"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u043E\u0431\u0440\u0430\u0432 \u0430\u043F\u0435\u043B\u044C\u0441\u0438\u043D\u044B,
      \u044F \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u044E\u0441\u044C
      \u043A \u043F\u043E\u043C\u043E\u0441\u0442\u0443 \u0438 \u0434\u0435\u043B\u0430\u044E
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0448\u0430\u0433\u043E\u0432
      \u0432 \u0435\u0433\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u0443, \u043F\u0440\u0438\u0441\u043B\u0443\u0448\u0438\u0432\u0430\u044F\u0441\u044C
      \u043A \u0441\u043B\u043E\u0432\u0430\u043C \u041C\u0443\u0441\u0441\u043E\u043B\u0438\u043D\u0438."
    style: {fileID: 0}
    authorComment: 
