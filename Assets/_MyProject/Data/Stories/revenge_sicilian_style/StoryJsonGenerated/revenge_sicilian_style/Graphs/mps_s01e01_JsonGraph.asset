  exit: {fileID: 0}
  guid: mps_s01e01_l0144_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  - character: {fileID: 11400000, guid: badc95f619d9f6c47a2786eff391fe12, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u041D\u0430\u0446\u0438\u0441\u0442"
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044E \u043D\u0430
      \u043D\u0435\u0433\u043E \u0440\u0430\u0441\u0442\u0435\u0440\u044F\u043D\u043D\u044B\u0439,
      \u0438\u0441\u043F\u0443\u0433\u0430\u043D\u043D\u044B\u0439 \u0432\u0437\u0433\u043B\u044F\u0434
      \u0438 \u043E\u043F\u0443\u0441\u043A\u0430\u044E\u0441\u044C \u043D\u0430
      \u043A\u043E\u043B\u0435\u043D\u0438 \u0441\u0443\u0434\u043E\u0440\u043E\u0436\u043D\u043E
      \u043F\u044B\u0442\u0430\u044F\u0441\u044C \u0441\u043E\u0431\u0440\u0430\u0442\u044C
      \u0440\u0430\u0441\u0441\u044B\u043F\u0430\u0432\u0448\u0438\u0435\u0441\u044F
      \u043F\u043E\u043A\u0443\u043F\u043A\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418, \u043D\u0435\u0440\u0432\u043D\u043E \u043F\u0435\u0440\u0435\u0431\u0438\u0440\u0430\u044F
      \u043E\u0440\u0430\u043D\u0436\u0435\u0432\u044B\u0435 \u0431\u043E\u043A\u0430,
      \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044E\u0441\u044C \u0441 \u0435\u0445\u0438\u0434\u043D\u044B\u043C
      \u0431\u043B\u0435\u0441\u043A\u043E\u043C \u0435\u0433\u043E \u0441\u0435\u0440\u044B\u0445
      \u0433\u043B\u0430\u0437."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0440\u0430\u0441\u043F\u043B\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432 \u0448\u0438\u0440\u043E\u043A\u043E\u0439 \u0443\u043B\u044B\u0431\u043A\u0435,
      \u043F\u0440\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u044F \u043C\u043D\u0435
      \u0440\u0443\u043A\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043B\u0438\u0448\u044C \u043E\u0442\u0432\u0435\u0447\u0430\u044E
      \u043D\u0430 \u044D\u0442\u043E\u0442 \u0436\u0435\u0441\u0442 \u0431\u0435\u0437\u043C\u043E\u043B\u0432\u043D\u044B\u043C
      \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C, \u043D\u0435 \u0434\u0432\u0438\u0433\u0430\u044F\u0441\u044C
      \u0441 \u043C\u0435\u0441\u0442\u0430 \u0438 \u043D\u0435 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u044F
      \u043F\u043E\u043C\u043E\u0449\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 2
    richText: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E\u2026 \u042F \u0441\u0430\u043C\u0430."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: "\u041D\u0430\u0446\u0438\u0441\u0442"
    speakerNameHint: "\u041D\u0430\u0446\u0438\u0441\u0442"
    speaker: {fileID: 11400000, guid: badc95f619d9f6c47a2786eff391fe12, type: 2}
    emotion: 2
    richText: "Lass mich dir helfen, Fr\xE4ulein."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
