    speaker: {fileID: 11400000, guid: e706e7d1a91e19d4abff1ac05facf1ab, type: 2}
    emotion: 8
    richText: "\u041F\u043E\u0447\u0435\u043C\u0443? \u042F \u0432 \u0441\u0432\u043E\u0438\u0445
      \u0441\u0442\u0435\u043D\u0430\u0445, \u043A\u0430\u043A \u0432 \u0441\u0430\u043C\u043E\u0439
      \u043D\u0430\u0434\u0435\u0436\u043D\u043E\u0439 \u043A\u0440\u0435\u043F\u043E\u0441\u0442\u0438."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0432\u0437\u0433\u043B\u044F\u0434"
  - speakerId: "\u0414\u0436\u0443\u043B\u0438\u044F"
    speakerNameHint: "\u0414\u0436\u0443\u043B\u0438\u044F"
    speaker: {fileID: 11400000, guid: e706e7d1a91e19d4abff1ac05facf1ab, type: 2}
    emotion: 17
    richText: "\u0414\u0430 \u0438 \u043C\u0430\u043B\u043E \u043A\u0442\u043E \u0442\u0440\u043E\u043D\u0435\u0442
      \u0442\u0443, \u043E\u0442 \u043A\u043E\u0433\u043E \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E
      \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u0435\u0433\u043E \u0436\u0438\u0437\u043D\u044C."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043A\u043B\u0430\u0434\u0443 \u0440\u0443\u043A\u0443 \u043D\u0430
      \u0435\u0451 \u043F\u043B\u0435\u0447\u043E\u2026"
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 30
    richText: "\u042D\u0442\u043E \u0441\u0430\u043C\u043E \u0441\u043E\u0431\u043E\u0439.
      \u041D\u043E \u043D\u0430 \u0441\u0432\u0438\u0434\u0430\u043D\u0438\u0435
      \u043E\u043D \u0442\u0435\u0431\u044F \u043D\u0435 \u0432 \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u0443
      \u043F\u043E\u0437\u043E\u0432\u0451\u0442."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u0430\u044F"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 30
    richText: "\u0414\u0430 \u0438 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0442\u044C\u0441\u044F
      \u0432\u043D\u0435, \u043A\u0430\u043A \u0442\u044B \u044D\u0442\u043E \u043D\u0430\u0437\u0432\u0430\u043B\u0430,
      \u043A\u0440\u0435\u043F\u043E\u0441\u0442\u0438, \u0432\u044B \u043D\u0435\u0441\u043E\u043C\u043D\u0435\u043D\u043D\u043E
      \u0431\u0443\u0434\u0435\u0442\u0435."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u0430\u044F"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043E\u0442\u0441\u0442\u0440\u0430\u043D\u044F\u044E\u0441\u044C,
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u044F \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u043D\u0430 \u043D\u0435\u0451 \u043F\u0440\u044F\u043C\u043E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\u042F \u043D\u0435 \u043F\u0440\u043E\u0448\u0443 \u0442\u0435\u0431\u044F
      \u0437\u0430\u0432\u044F\u0437\u044B\u0432\u0430\u0442\u044C \u0441 \u0442\u0435\u043C,
      \u043E\u0442 \u0447\u0435\u0433\u043E \u0442\u044B \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0448\u044C
      \u043F\u043E\u043B\u044C\u0437\u0443 \u0438 \u0443\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0438\u0435."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\u042F \u043B\u0438\u0448\u044C \u043F\u0440\u043E\u0448\u0443 \u0431\u044B\u0442\u044C
      \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u0435\u0439 \u043F\u043E
      \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044E \u043A \u043D\u0435\u043C\u0446\u0443."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u0437\u0434\u044B\u0445\u0430\u044E, \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u044F\u2026"
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 19
    richText: "\u042F \u0441\u0430\u043C\u0430 \u043D\u0430 \u0442\u0430\u043A\u0438\u0445
      \u043D\u0430\u0442\u044B\u043A\u0430\u043B\u0430\u0441\u044C \u0438 \u043D\u0435
      \u0440\u0430\u0437."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u0437\u0433\u043B\u044F\u0434 \u0432 \u0432\u0435\u0440\u0445\u043D\u0438\u0439
      \u0443\u0433\u043E\u043B"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\u0412\u043E\u0442, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
      \u0441\u0435\u0433\u043E\u0434\u043D\u044F... \u041D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u0438,
      \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u043C\u0438\u0442\u0438\u043D\u0433\u0430."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
