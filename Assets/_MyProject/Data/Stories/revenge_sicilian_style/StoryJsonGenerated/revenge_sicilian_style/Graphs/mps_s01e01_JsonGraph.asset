    emotion: 0
    richText: "\u0412\u043E\u0442-\u0432\u043E\u0442 \u043D\u0430\u0447\u043D\u0451\u0442\u0441\u044F
      \u0438\u0441\u0442\u043E\u0440\u0438\u044F. \u0414\u0430\u0432\u0430\u0439\u0442\u0435
      \u0432\u044B\u0431\u0435\u0440\u0435\u043C, \u043A\u0430\u043A \u0431\u0443\u0434\u0435\u0442
      \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u0442\u044C \u0432\u0430\u0448\u0430
