  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: mps_s01e01_l0324_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters: []
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043F\u0440\u043E\u0445\u043E\u0436\u0443 \u043C\u0438\u043C\u043E
      \u043F\u043B\u043E\u0449\u0430\u0434\u0438, \u0433\u0434\u0435 \u043D\u0435\u0434\u0430\u0432\u043D\u043E
      \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438 \u043D\u043E\u0432\u044B\u0439
      \u043C\u043E\u043D\u0443\u043C\u0435\u043D\u0442 \u2014 \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u0433\u043E
      \u043E\u0440\u043B\u0430 \u0441 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0451\u0440\u0442\u044B\u043C\u0438
      \u043A\u0440\u044B\u043B\u044C\u044F\u043C\u0438 \u2014 \u0441\u0438\u043C\u0432\u043E\u043B
      \u043D\u043E\u0432\u043E\u0439 \u0432\u043B\u0430\u0441\u0442\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u043E\u043A\u0440\u0443\u0433 \u043D\u0435\u0433\u043E \u2014
      \u0432\u0435\u043D\u043A\u0438 \u0438\u0437 \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445
      \u0446\u0432\u0435\u0442\u043E\u0432, \u0430 \u0443 \u043F\u043E\u0434\u043D\u043E\u0436\u0438\u044F
      \u2014 \u0441\u0432\u0435\u0436\u0438\u0435 \u0431\u0443\u043A\u0435\u0442\u044B,
      \u043F\u0440\u0438\u043D\u0435\u0441\u0451\u043D\u043D\u044B\u0435 \u043A\u0435\u043C-\u0442\u043E
      \u0438\u0437 \u043C\u0435\u0441\u0442\u043D\u044B\u0445."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412 \u044D\u0442\u043E\u043C \u0436\u0435\u0441\u0442\u0435 \u2014
      \u0438 \u043F\u043E\u043A\u043E\u0440\u043D\u043E\u0441\u0442\u044C, \u0438
      \u0442\u0438\u0445\u043E\u0435 \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u0434\u0440\u0443\u0433 \u0438\u0437-\u0437\u0430 \u0443\u0433\u043B\u0430
      \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043E\u0442\u0440\u044F\u0434
      \u0444\u0430\u0448\u0438\u0441\u0442\u043E\u0432."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u0445 \u0444\u043E\u0440\u043C\u0430 \u0431\u0435\u0437\u0443\u043F\u0440\u0435\u0447\u043D\u0430,
      \u043B\u0438\u0446\u0430 \u0445\u043E\u043B\u043E\u0434\u043D\u044B."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0434\u0438\u043D \u0438\u0437 \u043D\u0438\u0445 \u043E\u043A\u0438\u0434\u044B\u0432\u0430\u0435\u0442
      \u043C\u0435\u043D\u044F \u0431\u044B\u0441\u0442\u0440\u044B\u043C \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C,
      \u043D\u043E \u0442\u0443\u0442 \u0436\u0435 \u043E\u0442\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043D\u0435 \u0432\u044B\u0437\u044B\u0432\u0430\u044E \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u043D\u0438\u0439."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u0435\u0440\u0434\u0446\u0435 \u043A\u043E\u043B\u043E\u0442\u0438\u0442\u0441\u044F,
      \u043D\u043E \u044F \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u044E
      \u0438\u0434\u0442\u0438, \u0441\u0442\u0430\u0440\u0430\u044F\u0441\u044C
      \u043D\u0435 \u0432\u044B\u0434\u0430\u0432\u0430\u0442\u044C \u0432\u043E\u043B\u043D\u0435\u043D\u0438\u044F."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412 \u044D\u0442\u043E\u0442 \u043C\u043E\u043C\u0435\u043D\u0442
      \u044F \u043F\u043E\u043D\u0438\u043C\u0430\u044E: \u0421\u0438\u0446\u0438\u043B\u0438\u044F
      \u0436\u0438\u0432\u0451\u0442 \u0434\u0432\u043E\u0439\u043D\u043E\u0439 \u0436\u0438\u0437\u043D\u044C\u044E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u043D\u0430\u0440\u0443\u0436\u0438 \u2014 \u043F\u043E\u0440\u044F\u0434\u043E\u043A
      \u0438 \u0434\u0438\u0441\u0446\u0438\u043F\u043B\u0438\u043D\u0430, \u0432\u043D\u0443\u0442\u0440\u0438
      \u2014 \u043F\u0430\u043C\u044F\u0442\u044C \u043E \u0441\u0432\u043E\u0431\u043E\u0434\u0435
      \u0438 \u043D\u0430\u0434\u0435\u0436\u0434\u0430 \u043D\u0430 \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u044B."
    style: {fileID: 0}
    authorComment: 
