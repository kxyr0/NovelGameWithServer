  guid: mps_s01e01_l1170_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: bb87cc9663406034d82c0ff90ef0dfcf, type: 2}
    emotion: 0
    position: 2
