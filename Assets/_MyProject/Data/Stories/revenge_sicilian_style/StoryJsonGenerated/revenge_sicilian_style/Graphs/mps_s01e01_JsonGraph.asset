  guid: mps_s01e01_l0184_banner_01
  message: "\u041F\u043E \u043F\u0443\u0442\u0438 /*\u0437\u043D\u0430\u0447\u043E\u043A
    \u041E\u0441\u0442\u0440\u043E\u0443\u043C\u0438\u044F*/ \u041E\u0441\u0442\u0440\u043E\u0443\u043C\u0438\u044F
    \u2014 \u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430 \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F
    \u043D\u0435\u0437\u0430\u0443\u0440\u044F\u0434\u043D\u044B\u043C \u0438\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442\u043E\u043C
    \u0438 \u043F\u0440\u043E\u043D\u0438\u0446\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E
    \u0438 \u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0438\u0440\u0443\u0435\u0442
    \u0432\u044B\u0441\u043E\u043A\u0443\u044E \u0430\u0434\u0430\u043F\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C
    \u0432 \u0441\u043B\u043E\u0436\u043D\u044B\u0445 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044F\u0445."
