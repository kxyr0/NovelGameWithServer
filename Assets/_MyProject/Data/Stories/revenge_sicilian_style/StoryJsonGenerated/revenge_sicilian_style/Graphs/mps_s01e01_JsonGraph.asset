  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: mps_s01e01_l0082_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters: []
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u0441\u0442\u043E\u0440\u0438\u044F \u0432\u0434\u043E\u0445\u043D\u043E\u0432\u043B\u0435\u043D\u0430
      \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u043E\u0439 \u0421\u0438\u0446\u0438\u043B\u0438\u0438
      \u043F\u0435\u0440\u0438\u043E\u0434\u0430 \u0440\u0430\u0441\u0446\u0432\u0435\u0442\u0430
      \u0444\u0430\u0448\u0438\u0437\u043C\u0430 \u0438 \u043C\u043E\u0433\u0443\u0449\u0435\u0441\u0442\u0432\u0430
      \u043C\u0430\u0444\u0438\u043E\u0437\u043D\u044B\u0445 \u043A\u043B\u0430\u043D\u043E\u0432,
      \u043E\u0434\u043D\u0430\u043A\u043E \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0445\u0443\u0434\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C
      \u0432\u044B\u043C\u044B\u0441\u043B\u043E\u043C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0435
      \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u0438, \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0438
      \u0438 \u043C\u0435\u0441\u0442\u0430, \u0443\u043F\u043E\u043C\u044F\u043D\u0443\u0442\u044B\u0435
      \u0432 \u043F\u043E\u0432\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u0438,
      \u0441\u043B\u0443\u0436\u0430\u0442 \u043B\u0438\u0448\u044C \u043E\u0442\u043F\u0440\u0430\u0432\u043D\u043E\u0439
      \u0442\u043E\u0447\u043A\u043E\u0439 \u0434\u043B\u044F \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044F
      \u0441\u044E\u0436\u0435\u0442\u0430 \u0438 \u043D\u0435 \u043F\u0440\u0435\u0442\u0435\u043D\u0434\u0443\u044E\u0442
      \u043D\u0430 \u0438\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0443\u044E
      \u0434\u043E\u0441\u0442\u043E\u0432\u0435\u0440\u043D\u043E\u0441\u0442\u044C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u043D\u0438\u043C\u0430\u043D\u0438\u0435! \u0412 \u0434\u0430\u043D\u043D\u043E\u0439
      \u0433\u043B\u0430\u0432\u0435 \u0438\u043C\u0435\u0435\u0442\u0441\u044F \u0441\u0446\u0435\u043D\u0430
      \u0441\u043C\u0435\u0440\u0442\u0438 \u0431\u043B\u0438\u0437\u043A\u043E\u0433\u043E
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430. \u0427\u0438\u0442\u0430\u0439\u0442\u0435
      \u0441 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E\u0441\u0442\u044C\u044E!"
    style: {fileID: 0}
    authorComment: 
