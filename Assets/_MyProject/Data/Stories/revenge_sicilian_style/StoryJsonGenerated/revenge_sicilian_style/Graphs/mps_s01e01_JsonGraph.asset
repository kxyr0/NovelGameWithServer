  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: mps_s01e01_l1429_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters: []
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0428\u0435\u043F\u0447\u0443 \u044F \u0432 \u043F\u0443\u0441\u0442\u043E\u0442\u0443,
      \u043D\u043E \u0441\u043B\u043E\u0432\u0430 \u0442\u043E\u043D\u0443\u0442
      \u0432 \u043D\u043E\u0447\u043D\u043E\u0439 \u043F\u0440\u043E\u0445\u043B\u0430\u0434\u0435
      1938 \u0433\u043E\u0434\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0417\u0432\u0451\u0437\u0434\u044B \u0432 \u043D\u0435\u0431\u0435
      \u043D\u0430\u0434 \u0421\u0438\u0446\u0438\u043B\u0438\u0435\u0439 \u0445\u043E\u043B\u043E\u0434\u043D\u043E
      \u0438 \u0431\u0435\u0437\u0443\u0447\u0430\u0441\u0442\u043D\u043E \u0441\u043C\u043E\u0442\u0440\u044F\u0442
      \u043D\u0430 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0443\u044E
      \u0442\u0440\u0430\u0433\u0435\u0434\u0438\u044E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0438 \u0432\u0438\u0434\u0435\u043B\u0438 \u0442\u044B\u0441\u044F\u0447\u0438
      \u0442\u0430\u043A\u0438\u0445 \u0438\u0441\u0442\u043E\u0440\u0438\u0439.
      \u041D\u043E \u0434\u043B\u044F \u043C\u0435\u043D\u044F \u044D\u0442\u043E
      \u2014 \u043A\u043E\u043D\u0435\u0446 \u0441\u0432\u0435\u0442\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041C\u043E\u0439 \u043B\u0438\u0447\u043D\u044B\u0439 \u0430\u043F\u043E\u043A\u0430\u043B\u0438\u043F\u0441\u0438\u0441."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418 \u0432 \u0446\u0435\u043D\u0442\u0440\u0435 \u044D\u0442\u043E\u0433\u043E
      \u043F\u0435\u043F\u0435\u043B\u0438\u0449\u0430 \u043B\u0435\u0436\u0438\u0442
      \u043E\u043D \u2014 \u0447\u0435\u043B\u043E\u0432\u0435\u043A, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043E\u0431\u0435\u0449\u0430\u043B \u043C\u043D\u0435 \u0436\u0438\u0437\u043D\u044C,
      \u043D\u043E \u043E\u0441\u0442\u0430\u0432\u0438\u043B \u043F\u043E\u0441\u043B\u0435
      \u0441\u0435\u0431\u044F \u0442\u043E\u043B\u044C\u043A\u043E \u0431\u043E\u043B\u044C
      \u043F\u043E\u0442\u0435\u0440\u0438."
