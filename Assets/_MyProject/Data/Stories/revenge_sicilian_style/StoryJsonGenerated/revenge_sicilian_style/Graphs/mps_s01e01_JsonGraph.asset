  guid: mps_s01e01_l0278_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: 51a0e5c97c1ca7a409ad8a308500dd91, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u041C\u0443\u0441\u0441\u043E\u043B\u0438\u043D\u0438"
  lines:
  - speakerId: "\u041C\u0443\u0441\u0441\u043E\u043B\u0438\u043D\u0438"
    speakerNameHint: "\u041C\u0443\u0441\u0441\u043E\u043B\u0438\u043D\u0438"
    speaker: {fileID: 11400000, guid: 51a0e5c97c1ca7a409ad8a308500dd91, type: 2}
    emotion: 2
    richText: "\u0414\u0430 \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0435\u0442
      \u0418\u0442\u0430\u043B\u0438\u044F! \u0414\u0430 \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0435\u0442
      \u0444\u0430\u0448\u0438\u0437\u043C!"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: "\u041C\u0443\u0441\u0441\u043E\u043B\u0438\u043D\u0438"
    speakerNameHint: "\u041C\u0443\u0441\u0441\u043E\u043B\u0438\u043D\u0438"
    speaker: {fileID: 11400000, guid: 51a0e5c97c1ca7a409ad8a308500dd91, type: 2}
    emotion: 17
    richText: "\u041D\u0430 \u044D\u0442\u043E\u043C \u0432\u0441\u0451."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C\u043D\u043E"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u0441\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F
      \u0441 \u043F\u043E\u043C\u043E\u0441\u0442\u0430, \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u044F\u044F\u0441\u044C
      \u0437\u0430 \u043D\u0438\u043C \u0438 \u0432 \u043F\u043B\u043E\u0442\u043D\u043E\u043C
      \u043A\u043E\u043B\u044C\u0446\u0435 \u0441\u043E\u043B\u0434\u0430\u0442,
      \u043F\u043E\u043A\u0430 \u043D\u0435 \u0438\u0441\u0447\u0435\u0437\u0430\u0435\u0442
      \u0438\u0437 \u0432\u0438\u0434\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u0430\u0446\u0438\u0441\u0442\u044B, \u0434\u043E \u044D\u0442\u043E\u0433\u043E
      \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044E\u0449\u0438\u0435 \u043D\u0430\u0441
      \u043D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u0438, \u043E\u0442\u0441\u0442\u0443\u043F\u0430\u044E\u0442,
      \u043E\u0441\u0432\u043E\u0431\u043E\u0436\u0434\u0430\u044F \u043F\u0443\u0442\u044C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041A\u0440\u0435\u043F\u0447\u0435 \u043F\u0440\u0438\u0436\u0430\u0432
      \u043A \u0441\u0435\u0431\u0435 \u043A\u043E\u0440\u0437\u0438\u043D\u043A\u0443,
      \u044F \u0443\u0441\u043A\u043E\u043B\u044C\u0437\u0430\u044E \u0432 \u043B\u0430\u0431\u0438\u0440\u0438\u043D\u0442
      \u0443\u0437\u043A\u0438\u0445 \u043F\u0435\u0440\u0435\u0443\u043B\u043A\u043E\u0432."
    style: {fileID: 0}
    authorComment: 
