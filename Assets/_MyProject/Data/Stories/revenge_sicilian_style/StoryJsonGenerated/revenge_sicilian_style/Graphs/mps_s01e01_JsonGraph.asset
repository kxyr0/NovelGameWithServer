  exit: {fileID: 0}
  guid: mps_s01e01_l0665_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  - character: {fileID: 11400000, guid: 0d74ce51fe0a954408fea0cfa1c4bfc8, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u0410\u043D\u0442\u043E\u043D\u0438\u043E"
  lines:
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 2
    richText: "\u0422\u043E\u0433\u0434\u0430 \u043D\u0435 \u0441\u043A\u0443\u043F\u0438\u0442\u0435\u0441\u044C,
      \u043F\u0443\u0441\u0442\u044C \u0438\u0434\u0451\u0442 \u0432 \u0448\u043A\u043E\u043B\u0443
      \u0441 \u0445\u043E\u0440\u043E\u0448\u0438\u043C\u0438 \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u043D\u043E\u0441\u0442\u044F\u043C\u0438."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 2
    richText: "\u0421\u043A\u0430\u0436\u0438\u0442\u0435 \u0435\u0439, \u0447\u0442\u043E
      \u044D\u0442\u043E \u043F\u043E\u0434\u0430\u0440\u043E\u043A \u043E\u0442
      \u0434\u043E\u0431\u0440\u043E\u0439 \u0432\u043E\u043B\u0448\u0435\u0431\u043D\u0438\u0446\u044B.
      \u041C\u043D\u0435 \u0431\u0443\u0434\u0435\u0442 \u043F\u0440\u0438\u044F\u0442\u043D\u043E
      \u0437\u043D\u0430\u0442\u044C, \u0447\u0442\u043E \u043E\u043D\u0430 \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u0430."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043D\u0435
      \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u0439\u0442\u0435\u0441\u044C."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u0442\u0430\u0440\u0438\u043A \u043C\u043E\u043B\u0447\u0438\u0442,
      \u043D\u043E \u0432\u0441\u043A\u043E\u0440\u0435 \u0440\u0430\u0437\u0436\u0438\u043C\u0430\u0435\u0442
      \u043D\u0430\u0448\u0438 \u043B\u0430\u0434\u043E\u043D\u0438 \u0438 \u0443\u0431\u0438\u0440\u0430\u0435\u0442
      \u0434\u0435\u043D\u044C\u0433\u0438 \u0432 \u043A\u0430\u0440\u043C\u0430\u043D."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u0410\u043D\u0442\u043E\u043D\u0438\u043E"
    speakerNameHint: "\u0410\u043D\u0442\u043E\u043D\u0438\u043E"
    speaker: {fileID: 11400000, guid: 0d74ce51fe0a954408fea0cfa1c4bfc8, type: 2}
    emotion: 10
    richText: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0442\u0435\u0431\u0435
      \u0431\u043E\u043B\u044C\u0448\u043E\u0435. \u0414\u0430\u0439 \u0431\u043E\u0433
      \u0442\u0435\u0431\u0435 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F \u0438
      \u0445\u043E\u0440\u043E\u0448\u0435\u0433\u043E \u043C\u0443\u0436\u0430."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430 \u0441\u043E
      \u0441\u043B\u0435\u0437\u0430\u043C\u0438"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 2
    richText: "\u0418 \u0432\u0430\u043C \u0441\u043F\u0430\u0441\u0438\u0431\u043E,
      \u0434\u044F\u0434\u044E\u0448\u043A\u0430."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
