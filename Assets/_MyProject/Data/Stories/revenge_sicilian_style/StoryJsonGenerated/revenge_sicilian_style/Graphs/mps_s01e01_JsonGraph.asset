    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0442\u0435\u0446 \u0434\u043E\u043F\u0438\u0432\u0430\u0435\u0442
      \u0447\u0430\u0439, \u043E\u0442\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u0447\u0430\u0448\u043A\u0443 \u0438 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u043A\u043E \u043C\u043D\u0435
      \u0438, \u0443\u043B\u044B\u0431\u043D\u0443\u0432\u0448\u0438\u0441\u044C,
      \u043B\u0435\u0433\u043A\u043E \u0442\u0440\u0435\u043F\u043B\u0435\u0442 \u043F\u043E
      \u043F\u043B\u0435\u0447\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u041E\u0442\u0435\u0446"
    speakerNameHint: "\u041E\u0442\u0435\u0446"
    speaker: {fileID: 11400000, guid: bb87cc9663406034d82c0ff90ef0dfcf, type: 2}
    emotion: 2
    richText: "\u0420\u0430\u0434, \u0447\u0442\u043E \u0443 \u0432\u0441\u0435\u0445
      \u0432\u0441\u0451 \u043F\u043E\u043D\u0435\u043C\u043D\u043E\u0433\u0443 \u043D\u0430\u043B\u0430\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044F."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: "\u041E\u0442\u0435\u0446"
    speakerNameHint: "\u041E\u0442\u0435\u0446"
    speaker: {fileID: 11400000, guid: bb87cc9663406034d82c0ff90ef0dfcf, type: 2}
    emotion: 2
    richText: "\u041F\u0435\u0440\u0435\u0434\u0430\u0439 \u0438\u043C \u043E\u0442
      \u043C\u0435\u043D\u044F \u043F\u0440\u0438\u0432\u0435\u0442, \u043A\u043E\u0433\u0434\u0430
      \u0431\u0443\u0434\u0435\u0448\u044C \u0443 \u043D\u0438\u0445 \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0440\u0430\u0437."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u043D\u0430 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0435
      \u0437\u0430\u043C\u043E\u043B\u043A\u0430\u0435\u0442, \u0441\u043B\u043E\u0432\u043D\u043E
      \u0441\u043E\u0431\u0438\u0440\u0430\u044F\u0441\u044C \u0441 \u043C\u044B\u0441\u043B\u044F\u043C\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u041E\u0442\u0435\u0446"
    speakerNameHint: "\u041E\u0442\u0435\u0446"
    speaker: {fileID: 11400000, guid: bb87cc9663406034d82c0ff90ef0dfcf, type: 2}
    emotion: 17
    richText: "\u0410 \u0441\u0435\u0439\u0447\u0430\u0441 \u043C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E
      \u0435\u0449\u0451 \u043A\u043E\u0435-\u0447\u0442\u043E \u0441\u0434\u0435\u043B\u0430\u0442\u044C
      \u043F\u043E \u0434\u043E\u043C\u0443."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: "\u041E\u0442\u0435\u0446"
    speakerNameHint: "\u041E\u0442\u0435\u0446"
    speaker: {fileID: 11400000, guid: bb87cc9663406034d82c0ff90ef0dfcf, type: 2}
    emotion: 17
    richText: "\u0422\u044B, \u0432\u0435\u0440\u043D\u043E, \u0443\u0441\u0442\u0430\u043B\u0430.
      \u041F\u0440\u0438\u043C\u0438 \u0432\u0430\u043D\u043D\u0443, \u043E\u0442\u0434\u043E\u0445\u043D\u0438.
      \u0410 \u0432\u0435\u0447\u0435\u0440\u043E\u043C \u043D\u0430\u043C \u043D\u0443\u0436\u043D\u043E
      \u0431\u0443\u0434\u0435\u0442 \u043A\u043E\u0435 \u043E \u0447\u0451\u043C
      \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C, \u0445\u043E\u0440\u043E\u0448\u043E?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043A\u0438\u0432\u0430\u044E. \u0421\u0435\u0439\u0447\u0430\u0441
      \u043C\u043D\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E
      \u043E\u0434\u043D\u043E\u0433\u043E \u2014 \u043E\u043A\u0443\u043D\u0443\u0442\u044C\u0441\u044F
      \u0432 \u0442\u0451\u043F\u043B\u0443\u044E \u0432\u043E\u0434\u0443 \u0438
      \u0437\u0430\u0431\u044B\u0442\u044C\u0441\u044F \u043A\u0440\u0435\u043F\u043A\u0438\u043C
      \u0441\u043D\u043E\u043C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\u0425\u043E\u0440\u043E\u0448\u043E. \u0422\u0430\u043A \u0438 \u043F\u043E\u0441\u0442\u0443\u043F\u043B\u044E."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: "\u041E\u0442\u0435\u0446"
    speakerNameHint: "\u041E\u0442\u0435\u0446"
    speaker: {fileID: 11400000, guid: bb87cc9663406034d82c0ff90ef0dfcf, type: 2}
    emotion: 2
    richText: "\u041B\u044E\u0431\u043B\u044E \u0442\u0435\u0431\u044F, \u0434\u043E\u0447\u044C."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
