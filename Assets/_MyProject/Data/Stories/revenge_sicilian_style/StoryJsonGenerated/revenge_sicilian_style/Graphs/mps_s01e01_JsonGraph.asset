  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: mps_s01e01_l0158_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: badc95f619d9f6c47a2786eff391fe12, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u041D\u0430\u0446\u0438\u0441\u0442"
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u044E, \u0447\u0435\u0433\u043E
      \u043E\u043D \u0445\u043E\u0447\u0435\u0442, \u0442\u0430\u043A \u043A\u0430\u043A
      \u043D\u0435 \u0437\u043D\u0430\u044E \u0438\u0445 \u044F\u0437\u044B\u043A\u0430.
      \u041B\u0438\u0448\u044C \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u0430\u0433\u0430\u044E,
      \u0447\u0442\u043E \u043E\u043D \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F
      \u043F\u043E\u043C\u043E\u0447\u044C, \u043E\u0434\u043D\u0430\u043A\u043E
      \u043F\u043E\u043C\u043E\u0449\u0438 \u0435\u0433\u043E \u044F \u043D\u0435
      \u043F\u0440\u043E\u0441\u0438\u043B\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u043E\u0431\u0440\u0430\u0432 \u0430\u043F\u0435\u043B\u044C\u0441\u0438\u043D\u044B
      \u043E\u0431\u0440\u0430\u0442\u043D\u043E \u0432 \u043A\u043E\u0440\u0437\u0438\u043D\u0443,
      \u044F \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044E\u0441\u044C \u0438
      \u0432\u043D\u043E\u0432\u044C \u0441\u043C\u043E\u0442\u0440\u044E \u043D\u0430
      \u043C\u0443\u0436\u0447\u0438\u043D\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u0443\u0436\u0435 \u043D\u0435 \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u0437\u043E \u0432\u0441\u0435\u0445 \u0441\u0438\u043B \u0441\u043A\u0440\u044B\u0432\u0430\u044F
      \u0441\u0432\u043E\u0439 \u0441\u0442\u0440\u0430\u0445, \u044F \u0441\u0442\u0430\u0440\u0430\u044E\u0441\u044C
      \u043E\u0431\u043E\u0439\u0442\u0438 \u0435\u0433\u043E, \u043E\u0434\u043D\u0430\u043A\u043E
      \u0442\u043E\u0442 \u0445\u0432\u0430\u0442\u0430\u0435\u0442\u0441\u044F \u0437\u0430
      \u043A\u043E\u0440\u0437\u0438\u043D\u043A\u0443, \u0433\u0440\u0443\u0431\u043E
      \u0432\u044B\u0440\u044B\u0432\u0430\u0435\u0442 \u0435\u0451 \u0438 \u0431\u0440\u043E\u0441\u0430\u0435\u0442
      \u043E\u0431\u0440\u0430\u0442\u043D\u043E \u043D\u0430 \u0437\u0435\u043C\u043B\u044E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u041D\u0430\u0446\u0438\u0441\u0442"
    speakerNameHint: "\u041D\u0430\u0446\u0438\u0441\u0442"
    speaker: {fileID: 11400000, guid: badc95f619d9f6c47a2786eff391fe12, type: 2}
    emotion: 30
    richText: Wo hast du es eilig? Nach Hause?
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B\u0439"
