  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u043A\u043E\u0440\u043E\u0442\u043A\u043E \u043A\u043B\u0430\u043D\u044F\u0435\u0442\u0441\u044F,
      \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F, \u0431\u0435\u0440\u0435\u0436\u043D\u043E
