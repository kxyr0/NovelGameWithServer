  guid: mps_s01e01_l1541_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  - character: {fileID: 11400000, guid: 88ab372d37d4ecb4fa9362f48f0ced63, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0443\u0441\u0430\u043C\u0438"
  - character: {fileID: 11400000, guid: 69e1dc9f73c6867468fa7b327cd7565c, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0437\u043E\u043D\u0442\u043E\u043C"
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041C\u0435\u043D\u044F \u0441\u043B\u043E\u0432\u043D\u043E \u043F\u0440\u043E\u043D\u0437\u0430\u0435\u0442
      \u043C\u043E\u043B\u043D\u0438\u0435\u0439."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u0447\u0435\u0442\u043A\u043E \u043F\u043E\u043D\u0438\u043C\u0430\u044E:
      \u044D\u0442\u043E \u0442\u0435 \u0441\u0430\u043C\u044B\u0435 \u043B\u044E\u0434\u0438,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u0440\u0438\u0445\u043E\u0434\u044F\u0442
      \u043A \u0410\u043D\u0442\u043E\u043D\u0438\u043E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0422\u0435\u043F\u0435\u0440\u044C \u0438\u0445 \u0441\u043B\u043E\u0432\u0430
      \u043E\u0431\u0440\u0435\u0442\u0430\u044E\u0442 \u0441\u0442\u0440\u0430\u0448\u043D\u044B\u0439,
      \u0437\u043B\u043E\u0432\u0435\u0449\u0438\u0439 \u0441\u043C\u044B\u0441\u043B."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 4
    richText: "\u042D\u0442\u043E \u0432\u044B \u0443\u0431\u0438\u043B\u0438 \u0435\u0433\u043E?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0417\u043B\u043E\u0441\u0442\u044C"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0443\u0441\u0430\u043C\u0438
      \u043D\u0435 \u0432\u044B\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442.
      \u0415\u0433\u043E \u043B\u0438\u0446\u043E \u0438\u0441\u043A\u0430\u0436\u0430\u0435\u0442\u0441\u044F
      \u043E\u0442 \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0435\u043D\u0438\u044F."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0443\u0441\u0430\u043C\u0438"
    speakerNameHint: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0443\u0441\u0430\u043C\u0438"
    speaker: {fileID: 11400000, guid: 88ab372d37d4ecb4fa9362f48f0ced63, type: 2}
    emotion: 4
    richText: "\u041C\u044B \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u043C
      \u0437\u0430\u0449\u0438\u0442\u0443, \u0430 \u043D\u0435 \u0441\u043C\u0435\u0440\u0442\u044C,
      \u0434\u043E\u0440\u043E\u0433\u0443\u0448\u0430!"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0417\u043B\u043E\u0441\u0442\u044C"
  - speakerId: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0443\u0441\u0430\u043C\u0438"
    speakerNameHint: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0443\u0441\u0430\u043C\u0438"
    speaker: {fileID: 11400000, guid: 88ab372d37d4ecb4fa9362f48f0ced63, type: 2}
    emotion: 4
    richText: "\u0411\u0443\u0434\u044C\u0442\u0435 \u043F\u043E\u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u0435\u0435
      \u0441 \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u0438\u044F\u043C\u0438."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0417\u043B\u043E\u0441\u0442\u044C"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0437\u043E\u043D\u0442\u043E\u043C,
      \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u044F \u043B\u0435\u0434\u044F\u043D\u043E\u0435
      \u0441\u043F\u043E\u043A\u043E\u0439\u0441\u0442\u0432\u0438\u0435, \u043E\u0431\u0445\u043E\u0434\u0438\u0442
      \u043C\u0435\u043D\u044F \u0438 \u0437\u0430\u0433\u043E\u0440\u0430\u0436\u0438\u0432\u0430\u0435\u0442
      \u0441\u043E\u0431\u043E\u0439 \u0443\u0441\u0430\u0447\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u043C\u043E\u043B\u0447\u0430 \u0434\u043E\u0441\u0442\u0430\u0435\u0442
      \u0438\u0437 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0433\u043E
      \u043A\u0430\u0440\u043C\u0430\u043D\u0430 \u043F\u0438\u0434\u0436\u0430\u043A\u0430
      \u0432\u0438\u0437\u0438\u0442\u043A\u0443 \u0438 \u043F\u0440\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442
      \u043C\u043D\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0411\u0443\u043C\u0430\u0433\u0430 \u0441\u0443\u0445\u0430\u044F
      \u0438 \u043F\u043B\u043E\u0442\u043D\u0430\u044F, \u043D\u0435\u0441\u043C\u043E\u0442\u0440\u044F
      \u043D\u0430 \u043B\u0438\u0432\u0435\u043D\u044C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0437\u043E\u043D\u0442\u043E\u043C"
    speakerNameHint: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0437\u043E\u043D\u0442\u043E\u043C"
    speaker: {fileID: 11400000, guid: 69e1dc9f73c6867468fa7b327cd7565c, type: 2}
    emotion: 9
    richText: "\u041F\u0440\u043E\u0441\u0442\u0438\u0442\u0435 \u043C\u043E\u0435\u0433\u043E
      \u043A\u043E\u043B\u043B\u0435\u0433\u0443 \u0437\u0430 \u0438\u0437\u043B\u0438\u0448\u043D\u044E\u044E
      \u0433\u043E\u0440\u044F\u0447\u043D\u043E\u0441\u0442\u044C."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0417\u0430\u0434\u0443\u043C\u0447\u0438\u0432\u044B\u0439
      \u0432\u0437\u0433\u043B\u044F\u0434 \u0432\u043F\u0440\u0430\u0432\u043E"
  - speakerId: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0437\u043E\u043D\u0442\u043E\u043C"
    speakerNameHint: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0437\u043E\u043D\u0442\u043E\u043C"
    speaker: {fileID: 11400000, guid: 69e1dc9f73c6867468fa7b327cd7565c, type: 2}
    emotion: 2
    richText: "\u041C\u044B \u043D\u0438\u043A\u043E\u043C\u0443 \u043D\u0435 \u0436\u0435\u043B\u0430\u0435\u043C
      \u0437\u043B\u0430 \u0438 \u0445\u043E\u0442\u0438\u043C \u043B\u0438\u0448\u044C
      \u043F\u0440\u043E\u0442\u044F\u043D\u0443\u0442\u044C \u0440\u0443\u043A\u0443
      \u043F\u043E\u043C\u043E\u0449\u0438."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041B\u0435\u0433\u043A\u0430\u044F \u0443\u043B\u044B\u0431\u043A\u0430"
