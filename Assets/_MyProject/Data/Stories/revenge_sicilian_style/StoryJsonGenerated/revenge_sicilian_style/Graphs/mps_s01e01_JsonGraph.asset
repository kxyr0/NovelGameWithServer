  activeCharacters: []
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0442\u0435\u0446 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
      \u043A\u043E \u043C\u043D\u0435 \u0438, \u043C\u044F\u0433\u043A\u043E \u0443\u043B\u044B\u0431\u043D\u0443\u0432\u0448\u0438\u0441\u044C,
      \u0431\u0435\u0440\u0435\u0436\u043D\u043E \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
      \u043A\u043E\u0440\u0437\u0438\u043D\u0443 \u0441 \u043F\u043B\u043E\u0434\u0430\u043C\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u0443\u043D\u043E\u0441\u0438\u0442 \u0435\u0451 \u043D\u0430
      \u043A\u0443\u0445\u043D\u044E, \u0430 \u0437\u0430\u0442\u0435\u043C \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u0438, \u043D\u0430 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0435
      \u043F\u0440\u0438\u0436\u0430\u0432 \u043C\u0435\u043D\u044F \u043A \u0441\u0435\u0431\u0435,
      \u043A\u043E\u0440\u043E\u0442\u043A\u043E \u043E\u0431\u043D\u0438\u043C\u0430\u0435\u0442
      \u2014 \u0432 \u044D\u0442\u043E\u043C \u0436\u0435\u0441\u0442\u0435 \u0441\u0442\u043E\u043B\u044C\u043A\u043E
      \u0442\u0435\u043F\u043B\u0430 \u0438 \u0437\u0430\u0431\u043E\u0442\u044B,
      \u0447\u0442\u043E \u0441\u043B\u043E\u0432\u0430 \u043A\u0430\u0436\u0443\u0442\u0441\u044F
      \u043B\u0438\u0448\u043D\u0438\u043C\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0442\u0441\u0442\u0440\u0430\u043D\u0438\u0432\u0448\u0438\u0441\u044C,
      \u043E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u043C\u0435\u043D\u044F
      \u0441 \u0442\u043E\u0439 \u0441\u0430\u043C\u043E\u0439 \u0442\u0438\u0445\u043E\u0439
      \u0433\u043E\u0440\u0434\u043E\u0441\u0442\u044C\u044E, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
      \u044F \u0442\u0430\u043A \u0445\u043E\u0440\u043E\u0448\u043E \u0437\u043D\u0430\u044E."
