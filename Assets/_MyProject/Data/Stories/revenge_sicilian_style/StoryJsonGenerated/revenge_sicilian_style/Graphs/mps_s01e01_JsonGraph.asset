    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043E\u043F\u0443\u0441\u043A\u0430\u044E \u0440\u0443\u043A\u0443
      \u0432 \u043A\u043E\u0440\u0437\u0438\u043D\u0443, \u043D\u0430\u0449\u0443\u043F\u044B\u0432\u0430\u044E
      \u0434\u0432\u0430 \u0430\u043F\u0435\u043B\u044C\u0441\u0438\u043D\u0430 \u0438
      \u043F\u0440\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u044E \u0438\u0445 \u0441\u0442\u0430\u0440\u0438\u043A\u0443."
