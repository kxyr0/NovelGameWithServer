  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: mps_s01e01_l0222_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u0441\u043C\u0435\u0435\u0442
      \u0442\u0430\u043A \u0441\u043E \u043C\u043D\u043E\u0439 \u043F\u043E\u0441\u0442\u0443\u043F\u0430\u0442\u044C!"
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041A\u043E\u0433\u0434\u0430 \u0447\u0442\u043E-\u0442\u043E \u0442\u044F\u0433\u043E\u0442\u0438\u0442
      \u043C\u0435\u043D\u044F, \u044F \u043D\u0435 \u043E\u043F\u0443\u0441\u043A\u0430\u044E
      \u0440\u0443\u043A\u0438, \u0430 \u0440\u0435\u0448\u0430\u044E \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418 \u0432\u043E\u0442, \u043F\u0435\u0440\u0435\u0434\u043E \u043C\u043D\u043E\u0439
      \u043D\u043E\u0432\u0430\u044F \u043F\u0440\u0435\u0433\u0440\u0430\u0434\u0430.
      \u042F, \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E \u0432\u0437\u0432\u0435\u0448\u0438\u0432\u0430\u044F
      \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u0435 \u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u044F,
      \u043D\u0435 \u0441\u0440\u0430\u0437\u0443 \u0440\u0435\u0448\u0430\u044E\u0441\u044C
      \u043D\u0430 \u044D\u0442\u043E\u0442 \u0448\u0430\u0433."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u043E \u0438\u043D\u043E\u0433\u043E \u0432\u044B\u0445\u043E\u0434\u0430
      \u043D\u0435 \u0432\u0438\u0436\u0443. \u041E\u043D \u043F\u0440\u0438\u0447\u0438\u043D\u044F\u043B
      \u043C\u043D\u0435 \u0431\u043E\u043B\u044C, \u0438 \u044F \u043E\u0442\u0432\u0435\u0447\u0443
      \u0442\u0435\u043C \u0436\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412 \u043A\u043E\u043D\u0446\u0435 \u043A\u043E\u043D\u0446\u043E\u0432,
      \u043E\u043D \u043D\u0435 \u043F\u043E\u0441\u043C\u0435\u0435\u0442 \u0437\u0430\u0441\u0442\u0440\u0435\u043B\u0438\u0442\u044C
      \u043C\u0435\u043D\u044F \u043D\u0430 \u0433\u043B\u0430\u0437\u0430\u0445
      \u0443 \u0432\u0441\u0435\u0445."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 19
    richText: "\xAB\u041D\u0435 \u043F\u043E\u0441\u043C\u0435\u0435\u0442 \u0436\u0435?\xBB"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0432\u0437\u0433\u043B\u044F\u0434 \u0432 \u0432\u0435\u0440\u0445\u043D\u0438\u0439
      \u0443\u0433\u043E\u043B"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u0430\u0431\u0440\u0430\u0432 \u043F\u043E\u043B\u043D\u044B\u0435
      \u043B\u0435\u0433\u043A\u0438\u0435 \u0432\u043E\u0437\u0434\u0443\u0445\u0430,
      \u044F \u0441\u043E\u0431\u0438\u0440\u0430\u044E \u0437\u0430\u043C\u0430\u0445\u0438\u0432\u0430\u044E\u0441\u044C
      \u0438 \u0431\u044C\u044E \u043D\u0430\u0445\u0430\u043B\u0430 \u043F\u0440\u044F\u043C\u043E
      \u043C\u0435\u0436\u0434\u0443 \u043D\u043E\u0433."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0422\u043E\u0442 \u0432\u0441\u043A\u0440\u0438\u043A\u0438\u0432\u0430\u0435\u0442,
      \u0441\u043E\u0433\u043D\u0443\u0432\u0448\u0438\u0441\u044C \u043E\u0442 \u0431\u043E\u043B\u0438,
      \u043D\u043E, \u0441\u043E\u0431\u0440\u0430\u0432\u0448\u0438\u0441\u044C
      \u0441 \u0441\u0438\u043B\u0430\u043C\u0438, \u0441\u043D\u0438\u043C\u0430\u0435\u0442
      \u0430\u0432\u0442\u043E\u043C\u0430\u0442 \u0441 \u043F\u0440\u0435\u0434\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044F
      \u0438 \u043D\u0430\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043D\u0430
      \u043C\u0435\u043D\u044F."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 23
    richText: "\u2026"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0438\u0441\u043F\u0443\u0433"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0422\u043A\u043D\u0443\u0432 \u0432 \u043C\u0435\u043D\u044F \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u043E\u043C,
      \u043E\u043D \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u0443\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u043F\u0430\u043B\u0435\u0446, \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u044F
      \u0437\u0430 \u043C\u043E\u044E \u0441\u043F\u0438\u043D\u0443. \u0422\u0443\u0434\u0430,
      \u0433\u0434\u0435 \u0432\u043E\u0437\u0432\u044B\u0448\u0430\u0435\u0442\u0441\u044F
      \u0444\u0438\u0433\u0443\u0440\u0430 \u0414\u0443\u0447\u0435."
    style: {fileID: 0}
    authorComment: 
