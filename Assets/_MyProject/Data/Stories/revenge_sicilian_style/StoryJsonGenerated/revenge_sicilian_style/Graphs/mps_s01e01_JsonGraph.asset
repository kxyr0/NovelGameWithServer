    richText: "\u0421\u0438\u0446\u0438\u043B\u0438\u0439\u0441\u043A\u0430\u044F
      \u043F\u043B\u043E\u0449\u0430\u0434\u044C\u2026"
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041A\u043E\u0433\u0434\u0430-\u0442\u043E \u0437\u0434\u0435\u0441\u044C,
      \u043F\u043E\u0434 \u0433\u043E\u043C\u043E\u043D \u0440\u044B\u043D\u043E\u0447\u043D\u043E\u0439
      \u0442\u043E\u043B\u043F\u044B, \u0432\u044B\u0441\u0438\u043B\u0438\u0441\u044C
      \u0433\u0440\u0443\u0434\u044B \u0441\u043F\u0435\u043B\u044B\u0445 \u0430\u043F\u0435\u043B\u044C\u0441\u0438\u043D\u043E\u0432
      \u0438 \u0438\u0441\u0441\u0438\u043D\u044F-\u0447\u0451\u0440\u043D\u044B\u0445
      \u0433\u0440\u043E\u0437\u0434\u044C\u0435\u0432 \u0432\u0438\u043D\u043E\u0433\u0440\u0430\u0434\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0422\u0435\u043F\u0435\u0440\u044C \u0436\u0435 \u0432\u043E\u0437\u0434\u0443\u0445
      \u043F\u0440\u043E\u043F\u0438\u0442\u0430\u043D \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0437\u0430\u043F\u0430\u0445\u0430\u043C\u0438, \u043D\u043E \u0438 \u0442\u0440\u0435\u0432\u043E\u0433\u043E\u0439
      \u2014 \u0431\u0443\u0434\u0442\u043E \u0441\u0430\u043C\u0430 \u0437\u0435\u043C\u043B\u044F
      \u043F\u043E\u043C\u043D\u0438\u0442 \u043E \u0431\u044B\u043B\u043E\u0439
      \u0441\u0432\u043E\u0431\u043E\u0434\u0435 \u0438 \u043C\u043E\u043B\u0447\u0438\u0442
      \u043E \u0431\u0443\u0434\u0443\u0449\u0435\u043C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0417\u0434\u0435\u0441\u044C \u043D\u0430\u0437\u043D\u0430\u0447\u0430\u043B\u0438
      \u0441\u0432\u0438\u0434\u0430\u043D\u0438\u044F, \u0438 \u0432\u043B\u044E\u0431\u043B\u0451\u043D\u043D\u044B\u0435
      \u043F\u0430\u0440\u044B \u043B\u044E\u0431\u043E\u0432\u0430\u043B\u0438\u0441\u044C
      \u0432\u0438\u0434\u043E\u043C \u043D\u0430 \u0421\u0440\u0435\u0434\u0438\u0437\u0435\u043C\u043D\u043E\u0435
      \u043C\u043E\u0440\u0435, \u043E\u0442\u0440\u0430\u0436\u0430\u0432\u0448\u0435\u0435
      \u043A\u0440\u0430\u0441\u043A\u0438 \u0441\u0438\u0446\u0438\u043B\u0438\u0439\u0441\u043A\u043E\u0433\u043E
      \u0437\u0430\u043A\u0430\u0442\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0413\u0430\u0437\u0435\u0442\u043D\u044B\u0435 \u043A\u0438\u043E\u0441\u043A\u0438,
      \u043F\u0440\u0435\u0436\u0434\u0435 \u0441\u0442\u043E\u044F\u0432\u0448\u0438\u0435
      \u043D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u0438, \u0442\u0435\u043F\u0435\u0440\u044C
      \u044E\u0442\u0438\u043B\u0438\u0441\u044C \u0432 \u0443\u043A\u0440\u043E\u043C\u043D\u044B\u0445
      \u0443\u043B\u043E\u0447\u043A\u0430\u0445 , \u043B\u0438\u0448\u044C \u0431\u044B
      \u043D\u0435 \u043B\u0438\u0448\u0438\u0442\u044C\u0441\u044F \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u043A\u0430
      \u0438 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438 \u043A\u0443\u043F\u0438\u0442\u044C
      \u0441\u0432\u0435\u0436\u0438\u0439 \u0445\u043B\u0435\u0431."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0420\u0430\u043D\u044C\u0448\u0435 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u044B
      \u043F\u0440\u0435\u0441\u0441\u044B \u043F\u0435\u0441\u0442\u0440\u0435\u043B\u0438
      \u043D\u043E\u0432\u043E\u0441\u0442\u044F\u043C\u0438, \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u044B\u043C\u0438
      \u043E\u0442\u0432\u043B\u0435\u0447\u044C \u043E\u0442 \u043F\u043E\u0432\u0441\u0435\u0434\u043D\u0435\u0432\u043D\u044B\u0445
      \u0437\u0430\u0431\u043E\u0442 , \u0430 \u0442\u0435\u043F\u0435\u0440\u044C
      \u0438 \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u044C \u0435\u0451 \u043D\u0435
      \u043D\u0443\u0436\u043D\u043E \u2014 \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435
      \u043F\u043E\u043D\u044F\u0442\u043D\u043E \u0431\u0435\u0437 \u0441\u043B\u043E\u0432."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u0438 \u0441\u0430\u043C\u0430 \u043A\u043E\u0433\u0434\u0430-\u0442\u043E
      \u0431\u0440\u043E\u0434\u0438\u043B\u0430 \u0437\u0434\u0435\u0441\u044C \u0432\u0435\u0447\u0435\u0440\u0430\u043C\u0438,
      \u043D\u0430\u0441\u043B\u0430\u0436\u0434\u0430\u044F\u0441\u044C \u0441\u0432\u0435\u0436\u0438\u043C
      \u0432\u043E\u0437\u0434\u0443\u0445\u043E\u043C \u0438 \u0430\u0440\u043E\u043C\u0430\u0442\u0430\u043C\u0438,
      \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u043C\u044B\u043C\u0438 \u0432\u0435\u0442\u0440\u043E\u043C
      \u0438\u0437 \u0441\u0430\u0434\u043E\u0432 \u0441\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u044B\u0445
      \u0441\u0438\u043D\u044C\u043E\u0440\u043E\u0432."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0422\u043E\u0433\u0434\u0430 \u0431\u044B\u043B\u0430 \u0441\u0432\u043E\u0431\u043E\u0434\u0430.
      \u0410 \u0441\u0435\u0439\u0447\u0430\u0441\u2026"
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u0435\u0439\u0447\u0430\u0441 \u044F \u0441 \u0442\u0440\u0443\u0434\u043E\u043C
      \u043F\u0440\u043E\u0431\u0438\u0440\u0430\u044E\u0441\u044C \u0441\u043A\u0432\u043E\u0437\u044C
      \u0442\u043E\u043B\u043F\u0443, \u0441\u043B\u044B\u0448\u0430 \u0432\u044B\u043A\u0440\u0438\u043A\u0438
      \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0430 \u0438
      \u0432\u0438\u0434\u044F, \u043A\u0430\u043A \u0432\u0437\u043C\u044B\u0432\u0430\u044E\u0442
      \u0432 \u0432\u043E\u0437\u0434\u0443\u0445 \u0441\u0436\u0430\u0442\u044B\u0435
      \u043A\u0443\u043B\u0430\u043A\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\u041F\u0440\u043E\u0441\u0442\u0438\u0442\u0435\u2026 \u0418\u0437\u0432\u0438\u043D\u0438\u0442\u0435\u2026"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C\u043D\u0430\u044F"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412 \u0440\u0443\u043A\u0430\u0445 \u044F \u043D\u0435\u0441\u0443
      \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0443\u044E \u043F\u043B\u0435\u0442\u0451\u043D\u0443\u044E
      \u043A\u043E\u0440\u0437\u0438\u043D\u043A\u0443, \u0434\u043E\u0432\u0435\u0440\u0445\u0443
      \u043D\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u0443\u044E \u0430\u043F\u0435\u043B\u044C\u0441\u0438\u043D\u0430\u043C\u0438,
      \u043A\u0443\u043F\u043B\u0435\u043D\u043D\u044B\u043C\u0438 \u0432 \u043B\u0430\u0432\u043E\u0447\u043A\u0435
      \u043D\u0435\u043F\u043E\u0434\u0430\u043B\u0451\u043A\u0443 \u043E\u0442 \u0440\u0430\u0431\u043E\u0442\u044B
      \u0438 \u043F\u0440\u0438\u043A\u0440\u044B\u0442\u044B\u043C\u0438 \u0442\u043E\u043D\u043A\u043E\u0439
      \u0442\u043A\u0430\u043D\u044C\u044E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u0440\u043E\u0431\u0438\u0440\u0430\u044F\u0441\u044C \u0441\u043A\u0432\u043E\u0437\u044C
      \u0442\u043E\u043B\u043F\u0443, \u044F \u043D\u0435\u0432\u043E\u043B\u044C\u043D\u043E
      \u0437\u0430\u0434\u0435\u0432\u0430\u044E \u043A\u043E\u0440\u0437\u0438\u043D\u043A\u043E\u0439
      \u0442\u043E \u043E\u0434\u043D\u043E\u0433\u043E, \u0442\u043E \u0434\u0440\u0443\u0433\u043E\u0433\u043E
      \u0443\u0447\u0430\u0441\u0442\u043D\u0438\u043A\u0430 \u043C\u0438\u0442\u0438\u043D\u0433\u0430."
    style: {fileID: 0}
    authorComment: 
