  guid: mps_s01e01_l1129_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters: []
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0442\u0435\u0446 \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u0442
      \u043F\u043E\u043B\u043E\u0442\u0435\u043D\u0446\u0435 \u0438\u0437 \u0440\u0443\u043A,
      \u0438 \u043E\u043D\u043E \u043C\u044F\u0433\u043A\u043E \u0441\u043E\u0441\u043A\u0430\u043B\u044C\u0437\u044B\u0432\u0430\u0435\u0442
      \u043D\u0430 \u0441\u043F\u0438\u043D\u043A\u0443 \u043A\u0440\u0435\u0441\u043B\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u043A\u043E
      \u043C\u043D\u0435, \u0437\u0430\u043A\u043B\u044E\u0447\u0430\u0435\u0442
      \u0432 \u0442\u0451\u043F\u043B\u044B\u0435 \u043E\u0431\u044A\u044F\u0442\u0438\u044F
      \u0438, \u0441\u043A\u043B\u043E\u043D\u0438\u0432\u0448\u0438\u0441\u044C,
      \u043D\u0435\u0436\u043D\u043E \u0446\u0435\u043B\u0443\u0435\u0442 \u0432
      \u0449\u0451\u043A\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0417\u0430\u0442\u0435\u043C, \u0447\u0443\u0442\u044C \u043F\u043E\u043C\u0435\u0434\u043B\u0438\u0432,
      \u043E\u0442\u0441\u0442\u0443\u043F\u0430\u0435\u0442 \u043D\u0430 \u0448\u0430\u0433,
      \u0438 \u0432 \u0435\u0433\u043E \u0432\u0437\u0433\u043B\u044F\u0434\u0435
      \u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F \u0442\u0438\u0445\u0430\u044F,
      \u043E\u0442\u0435\u0447\u0435\u0441\u043A\u0430\u044F \u043B\u0430\u0441\u043A\u0430."
    style: {fileID: 0}
    authorComment: 
