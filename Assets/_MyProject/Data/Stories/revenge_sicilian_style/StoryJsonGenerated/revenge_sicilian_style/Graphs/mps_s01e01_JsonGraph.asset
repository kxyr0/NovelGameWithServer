  guid: mps_s01e01_l1194_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  - character: {fileID: 11400000, guid: bb87cc9663406034d82c0ff90ef0dfcf, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u041E\u0442\u0435\u0446"
  lines:
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 8
    richText: "\u0410 \u043A\u0442\u043E-\u0442\u043E \u0434\u043E\u043B\u0436\u0435\u043D
      \u0431\u044B\u043B \u043F\u0440\u0438\u0439\u0442\u0438?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0432\u0437\u0433\u043B\u044F\u0434"
  - speakerId: "\u041E\u0442\u0435\u0446"
    speakerNameHint: "\u041E\u0442\u0435\u0446"
    speaker: {fileID: 11400000, guid: bb87cc9663406034d82c0ff90ef0dfcf, type: 2}
    emotion: 28
    richText: "\u041D\u0435\u0442. \u041D\u0435\u0442."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u0437\u0433\u043B\u044F\u0434 \u0432\u043F\u0440\u0430\u0432\u043E.
      \u0422\u0440\u0435\u0432\u043E\u0436\u043D\u044B\u0439"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412 \u0435\u0433\u043E \u0432\u0437\u0433\u043B\u044F\u0434\u0435
      \u043C\u0435\u043B\u044C\u043A\u0430\u0435\u0442 \u0447\u0442\u043E-\u0442\u043E
      \u043D\u0435\u0443\u043B\u043E\u0432\u0438\u043C\u043E\u0435 \u2014 \u0442\u0435\u043D\u044C
      \u0442\u0440\u0435\u0432\u043E\u0433\u0438 \u0438\u043B\u0438, \u043C\u043E\u0436\u0435\u0442
      \u0431\u044B\u0442\u044C, \u043E\u0431\u043B\u0435\u0433\u0447\u0435\u043D\u0438\u044F?"
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 8
    richText: "\u0412\u0441\u0451 \u0445\u043E\u0440\u043E\u0448\u043E?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F"
  - speakerId: "\u041E\u0442\u0435\u0446"
    speakerNameHint: "\u041E\u0442\u0435\u0446"
    speaker: {fileID: 11400000, guid: bb87cc9663406034d82c0ff90ef0dfcf, type: 2}
    emotion: 21
    richText: "\u0414\u0430. \u041F\u0440\u043E\u0441\u0442\u043E \u0435\u0441\u0442\u044C
      \u0443 \u043C\u0435\u043D\u044F \u043A\u043B\u0438\u0435\u043D\u0442\u044B\u2026
      \u0412\u0441\u0451 \u043D\u0438\u043A\u0430\u043A \u043D\u0435 \u043C\u043E\u0433\u0443\u0442
      \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u044C\u0441\u044F \u0441
      \u043C\u0430\u0448\u0438\u043D\u043E\u0439."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0417\u0430\u043A\u0430\u0442\u044B\u0432\u0430\u0435\u0442
      \u0433\u043B\u0430\u0437\u0430"
  - speakerId: "\u041E\u0442\u0435\u0446"
    speakerNameHint: "\u041E\u0442\u0435\u0446"
    speaker: {fileID: 11400000, guid: bb87cc9663406034d82c0ff90ef0dfcf, type: 2}
    emotion: 17
    richText: "\u0423\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u044E\u0442
      \u043F\u0440\u043E\u0434\u0430\u0442\u044C \u0438\u043C \u044D\u043A\u0441\u043A\u043B\u044E\u0437\u0438\u0432,
      \u043D\u043E \u044F \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0441\u044C."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 32
    richText: "\u0427\u0442\u043E \u0437\u0430 \u044D\u043A\u0441\u043A\u043B\u044E\u0437\u0438\u0432?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041F\u0440\u0438\u0449\u0443\u0440"
  - speakerId: "\u041E\u0442\u0435\u0446"
    speakerNameHint: "\u041E\u0442\u0435\u0446"
    speaker: {fileID: 11400000, guid: bb87cc9663406034d82c0ff90ef0dfcf, type: 2}
    emotion: 2
    richText: "\u041C\u043E\u0434\u0435\u043B\u044C \u0438\u0437-\u0437\u0430 \u0440\u0443\u0431\u0435\u0436\u0430.
      \u041D\u0435 \u0431\u0435\u0440\u0438 \u0432 \u0433\u043E\u043B\u043E\u0432\u0443,
      \u0434\u043E\u0440\u043E\u0433\u0430\u044F."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: "\u041E\u0442\u0435\u0446"
    speakerNameHint: "\u041E\u0442\u0435\u0446"
    speaker: {fileID: 11400000, guid: bb87cc9663406034d82c0ff90ef0dfcf, type: 2}
    emotion: 28
    richText: "\u0412\u0440\u044F\u0434 \u043B\u0438 \u043E\u043D\u0438 \u0435\u0433\u043E
      \u043F\u043E\u043B\u0443\u0447\u0430\u0442: \u043C\u044B \u043D\u0435 \u0431\u0443\u0434\u0435\u043C
      \u043D\u0438 \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u044C, \u043D\u0438
      \u043F\u0440\u043E\u0434\u0430\u0432\u0430\u0442\u044C \u044D\u0442\u0443 \u043C\u0430\u0448\u0438\u043D\u0443."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u0437\u0433\u043B\u044F\u0434 \u0432\u043B\u0435\u0432\u043E"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 8
    richText: "\u041F\u043E\u0447\u0435\u043C\u0443?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F"
  - speakerId: "\u041E\u0442\u0435\u0446"
    speakerNameHint: "\u041E\u0442\u0435\u0446"
