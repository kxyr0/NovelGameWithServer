  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: mps_s01e01_l0455_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: 7a64daf2d25859d4aab34520bad5552d, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041A \u043D\u0430\u043C, \u0446\u043E\u043A\u0430\u044F \u043A\u0430\u0431\u043B\u0443\u043A\u0430\u043C\u0438
      \u043F\u043E \u0431\u0440\u0443\u0441\u0447\u0430\u0442\u043A\u0435, \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0436\u0435\u043D\u0449\u0438\u043D\u0430 \u0432 \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E
      \u0441\u0438\u0434\u044F\u0449\u0435\u043C \u0447\u0451\u0440\u043D\u043E\u043C
      \u0431\u0440\u044E\u0447\u043D\u043E\u043C \u043A\u043E\u0441\u0442\u044E\u043C\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0415\u0451 \u0432\u043E\u043B\u043E\u0441\u044B \u0443\u043B\u043E\u0436\u0435\u043D\u044B
      \u0432\u043E\u043B\u043E\u0441\u043E\u043A \u043A \u0432\u043E\u043B\u043E\u0441\u043A\u0443,
      \u0430 \u043D\u0430 \u043B\u0438\u0446\u0435 \u2014 \u043B\u0451\u0433\u043A\u0438\u0439,
      \u043D\u043E \u0434\u0435\u0440\u0437\u043A\u0438\u0439 \u043C\u0430\u043A\u0438\u044F\u0436,
      \u043F\u0440\u0438\u0434\u0430\u044E\u0449\u0438\u0439 \u0435\u0439 \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u044B\u0439
      \u0438 \u043D\u0430\u0434\u043C\u0435\u043D\u043D\u044B\u0439 \u0432\u0438\u0434."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0437\u0430\u0434\u0438\u0440\u0430\u0435\u0442
      \u043F\u043E\u0434\u0431\u043E\u0440\u043E\u0434\u043E\u043A, \u0441\u043B\u043E\u0432\u043D\u043E
      \u0436\u0435\u043B\u0430\u044F \u043F\u043E\u0434\u0447\u0435\u0440\u043A\u043D\u0443\u0442\u044C
      \u0441\u0432\u043E\u0451 \u043F\u0440\u0435\u0432\u043E\u0441\u0445\u043E\u0434\u0441\u0442\u0432\u043E
      \u043D\u0430\u0434 \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0438\u043C\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412 \u0440\u0443\u043A\u0435 \u0443 \u043D\u0435\u0451 \u2014 \u0442\u043E\u043D\u043A\u0430\u044F
      \u0441\u0438\u0433\u0430\u0440\u0435\u0442\u0430, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
      \u043E\u043D\u0430 \u0432\u0440\u0435\u043C\u044F \u043E\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u0438
      \u043F\u043E\u0434\u043D\u043E\u0441\u0438\u0442 \u043A \u0433\u0443\u0431\u0430\u043C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041A\u0440\u0430\u0435\u043C \u0433\u043B\u0430\u0437\u0430 \u044F
      \u0437\u0430\u043C\u0435\u0447\u0430\u044E \u043D\u0430 \u0434\u0440\u0443\u0433\u043E\u0439
      \u0441\u0442\u043E\u0440\u043E\u043D\u0435 \u043F\u0430\u0440\u0443 \u0444\u0430\u0448\u0438\u0441\u0442\u0441\u043A\u0438\u0445
      \u0441\u043E\u043B\u0434\u0430\u0442."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u0445 \u0432\u0437\u0433\u043B\u044F\u0434\u044B \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u044B,
      \u0430 \u0432 \u0433\u043B\u0430\u0437\u0430\u0445 \u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F
      \u0435\u0434\u0432\u0430 \u0441\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u043C\u0430\u044F
      \u0437\u043B\u043E\u0441\u0442\u044C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u0430\u043B\u044C\u0446\u044B \u043C\u0443\u0436\u0447\u0438\u043D
      \u0441\u0436\u0438\u043C\u0430\u044E\u0442\u0441\u044F \u0432 \u043A\u0443\u043B\u0430\u043A\u0438
      \u0442\u0430\u043A \u0441\u0438\u043B\u044C\u043D\u043E, \u0447\u0442\u043E,
      \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0432\u043E\u0442-\u0432\u043E\u0442
      \u043B\u043E\u043F\u043D\u0443\u0442 \u0432\u0435\u043D\u044B. \u041D\u043E
      \u043E\u043D\u0438 \u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F \u043D\u0435\u043F\u043E\u0434\u0432\u0438\u0436\u043D\u044B."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u043E\u0434\u0438\u0442\u0435\u043B\u044C \u0436\u0435 \u043D\u0435
      \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442 \u043D\u0438 \u043D\u0430
      \u043A\u043E\u0433\u043E \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F,
      \u0441\u043B\u043E\u0432\u043D\u043E \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u0438\u0432\u0448\u0438\u0441\u044C
      \u0432 \u0433\u043B\u0443\u0431\u0438\u043D\u0435 \u0441\u0430\u043B\u043E\u043D\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speakerNameHint: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speaker: {fileID: 11400000, guid: 7a64daf2d25859d4aab34520bad5552d, type: 2}
    emotion: 2
    richText: "\u0410\u043D\u0442\u043E\u043D\u0438\u043E, \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435!"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u0430\u044F\u0441\u044C"
  - speakerId: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speakerNameHint: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speaker: {fileID: 11400000, guid: 7a64daf2d25859d4aab34520bad5552d, type: 2}
    emotion: 8
    richText: "\u041A\u0430\u043A \u0432\u044B? \u041F\u043E\u0434\u0440\u043E\u0441\u0442\u043A\u0438
      \u0433\u0430\u0437\u0435\u0442\u044B \u043D\u0435 \u043A\u0440\u0430\u0434\u0443\u0442?
      \u041B\u044E\u0434\u0438 \u0432 \u0444\u043E\u0440\u043C\u0435 \u0432\u0430\u043C
      \u043D\u0435 \u0434\u043E\u043A\u0443\u0447\u0430\u044E\u0442?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0432\u0437\u0433\u043B\u044F\u0434"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0410\u043D\u0442\u043E\u043D\u0438\u043E \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F
      \u0432 \u043B\u0438\u0446\u0435 \u2014 \u044F \u044D\u0442\u043E \u0441\u0440\u0430\u0437\u0443
      \u043F\u043E\u0434\u043C\u0435\u0447\u0430\u044E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0415\u0433\u043E \u0432\u0437\u0433\u043B\u044F\u0434 \u0443\u0436\u0435
      \u043D\u0435 \u0442\u0430\u043A\u043E\u0439 \u043F\u0440\u0438\u0432\u0435\u0442\u043B\u0438\u0432\u044B\u0439
      \u0438 \u0442\u0451\u043F\u043B\u044B\u0439, \u043A\u0430\u043A \u0432 \u043D\u0430\u0447\u0430\u043B\u0435
      \u043D\u0430\u0448\u0435\u0439 \u0432\u0441\u0442\u0440\u0435\u0447\u0438."
    style: {fileID: 0}
    authorComment: 
