  guid: mps_s01e01_l0116_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: 51a0e5c97c1ca7a409ad8a308500dd91, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u041C\u0443\u0441\u0441\u043E\u043B\u0438\u043D\u0438"
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0411\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E
      \u0434\u0430\u0436\u0435 \u043D\u0435 \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442
      \u044D\u0442\u0438\u0445 \u043B\u0451\u0433\u043A\u0438\u0445 \u043A\u0430\u0441\u0430\u043D\u0438\u0439
      \u0432 \u043E\u0431\u0449\u0435\u0439 \u0441\u0443\u043C\u0430\u0442\u043E\u0445\u0435,
      \u0446\u0430\u0440\u044F\u0449\u0435\u0439 \u043D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041A\u0442\u043E-\u0442\u043E \u0431\u0440\u043E\u0441\u0430\u0435\u0442
      \u043D\u0430 \u043C\u0435\u043D\u044F \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439,
      \u0433\u0440\u043E\u0437\u043D\u044B\u0439 \u0432\u0437\u0433\u043B\u044F\u0434,
      \u043D\u043E \u0442\u0443\u0442 \u0436\u0435 \u043E\u0442\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043F\u043E\u0447\u0442\u0438 \u043D\u0435 \u043E\u0431\u0440\u0430\u0449\u0430\u044E
      \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F \u043D\u0430 \u0445\u0440\u0438\u043F\u043B\u044B\u0439
      \u0433\u043E\u043B\u043E\u0441, \u0434\u043E\u043D\u043E\u0441\u044F\u0449\u0438\u0439\u0441\u044F
      \u0438\u0437 \u0441\u0442\u0430\u0440\u043E\u0433\u043E \u043C\u0435\u0433\u0430\u0444\u043E\u043D\u0430,
      \u043D\u043E \u043D\u0435 \u043C\u043E\u0433\u0443 \u043D\u0435 \u0441\u043B\u044B\u0448\u0430\u0442\u044C
      \u0440\u0435\u0447\u044C \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430,
      \u0447\u044C\u0451 \u0438\u043C\u044F \u0437\u043D\u0430\u043A\u043E\u043C\u043E
      \u043A\u0430\u0436\u0434\u043E\u043C\u0443 \u0436\u0438\u0442\u0435\u043B\u044E
      \u041F\u0430\u043B\u0435\u0440\u043C\u043E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u041C\u0443\u0441\u0441\u043E\u043B\u0438\u043D\u0438"
    speakerNameHint: "\u041C\u0443\u0441\u0441\u043E\u043B\u0438\u043D\u0438"
    speaker: {fileID: 11400000, guid: 51a0e5c97c1ca7a409ad8a308500dd91, type: 2}
    emotion: 17
    richText: "\u0421\u0438\u0446\u0438\u043B\u0438\u0439\u0446\u044B!"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0447\u0435\u0440\u043D\u044B\u0439 \u0441\u0438\u043B\u0443\u044D\u0442"
  - speakerId: "\u041C\u0443\u0441\u0441\u043E\u043B\u0438\u043D\u0438"
    speakerNameHint: "\u041C\u0443\u0441\u0441\u043E\u043B\u0438\u043D\u0438"
    speaker: {fileID: 11400000, guid: 51a0e5c97c1ca7a409ad8a308500dd91, type: 2}
    emotion: 17
    richText: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u043E\u0431\u0440\u0430\u0449\u0430\u044E\u0441\u044C
      \u043A \u0432\u0430\u043C \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043A\u0430\u043A \u043A \u0436\u0438\u0442\u0435\u043B\u044F\u043C \u044D\u0442\u043E\u0433\u043E
      \u0432\u0435\u043B\u0438\u043A\u043E\u0433\u043E \u043E\u0441\u0442\u0440\u043E\u0432\u0430
      \u0438 \u0433\u043E\u0440\u043E\u0434\u0430, \u043D\u043E \u0438 \u043A\u0430\u043A
      \u043A \u043D\u0435\u043E\u0442\u044A\u0435\u043C\u043B\u0435\u043C\u043E\u0439
      \u0447\u0430\u0441\u0442\u0438 \u043D\u043E\u0432\u043E\u0439 \u0418\u0442\u0430\u043B\u0438\u0438
      \u2014 \u0438\u043C\u043F\u0435\u0440\u0438\u0438, \u0432\u043E\u0437\u0440\u043E\u0436\u0434\u0451\u043D\u043D\u043E\u0439
      \u0432\u043E\u043B\u0435\u0439 \u0444\u0430\u0448\u0438\u0437\u043C\u0430!"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0447\u0435\u0440\u043D\u044B\u0439 \u0441\u0438\u043B\u0443\u044D\u0442"
  - speakerId: "\u041C\u0443\u0441\u0441\u043E\u043B\u0438\u043D\u0438"
    speakerNameHint: "\u041C\u0443\u0441\u0441\u043E\u043B\u0438\u043D\u0438"
    speaker: {fileID: 11400000, guid: 51a0e5c97c1ca7a409ad8a308500dd91, type: 2}
    emotion: 17
    richText: "\u0421\u0438\u0446\u0438\u043B\u0438\u044F \u0432\u0441\u0435\u0433\u0434\u0430
      \u0431\u044B\u043B\u0430 \u0441\u0435\u0440\u0434\u0446\u0435\u043C \u0421\u0440\u0435\u0434\u0438\u0437\u0435\u043C\u043D\u043E\u043C\u043E\u0440\u044C\u044F,
      \u043E\u043F\u043B\u043E\u0442\u043E\u043C \u0441\u0438\u043B\u044B \u0438
      \u0447\u0435\u0441\u0442\u0438."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0447\u0435\u0440\u043D\u044B\u0439 \u0441\u0438\u043B\u0443\u044D\u0442"
  - speakerId: "\u041C\u0443\u0441\u0441\u043E\u043B\u0438\u043D\u0438"
    speakerNameHint: "\u041C\u0443\u0441\u0441\u043E\u043B\u0438\u043D\u0438"
    speaker: {fileID: 11400000, guid: 51a0e5c97c1ca7a409ad8a308500dd91, type: 2}
    emotion: 17
    richText: "\u041D\u043E \u0434\u043E\u043B\u0433\u0438\u0435 \u0433\u043E\u0434\u044B
      \u0441\u043B\u0430\u0431\u043E\u0441\u0442\u0438 \u0438 \u0440\u0430\u0437\u043E\u0431\u0449\u0451\u043D\u043D\u043E\u0441\u0442\u0438
      \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u0432 \u043F\u0440\u043E\u0448\u043B\u043E\u043C."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0447\u0435\u0440\u043D\u044B\u0439 \u0441\u0438\u043B\u0443\u044D\u0442"
  - speakerId: "\u041C\u0443\u0441\u0441\u043E\u043B\u0438\u043D\u0438"
    speakerNameHint: "\u041C\u0443\u0441\u0441\u043E\u043B\u0438\u043D\u0438"
    speaker: {fileID: 11400000, guid: 51a0e5c97c1ca7a409ad8a308500dd91, type: 2}
    emotion: 17
    richText: "\u0422\u0435\u043F\u0435\u0440\u044C, \u043F\u043E\u0434 \u0437\u043D\u0430\u043C\u0435\u043D\u0435\u043C
      \u0420\u0438\u043C\u0430, \u0432\u044B \u2014 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043F\u0440\u043E\u0432\u0438\u043D\u0446\u0438\u044F, \u0430 \u043E\u043F\u043E\u0440\u0430
      \u043D\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0439 \u043C\u043E\u0449\u0438!"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0447\u0435\u0440\u043D\u044B\u0439 \u0441\u0438\u043B\u0443\u044D\u0442"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u0441\u0442\u0430\u0440\u0430\u044E\u0441\u044C \u043D\u0435
      \u0437\u0430\u043C\u0435\u0447\u0430\u0442\u044C \u043D\u0430\u0440\u043E\u0447\u0438\u0442\u043E\u0441\u0442\u0438
      \u0435\u0433\u043E \u0441\u043B\u043E\u0432, \u043D\u0435 \u0432\u0441\u043B\u0443\u0448\u0438\u0432\u0430\u0442\u044C\u0441\u044F
      \u0432 \u0438\u0445 \u0441\u043C\u044B\u0441\u043B."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u043B\u043E\u0432\u0430 \u2014 \u043A\u0430\u043A \u043C\u0451\u0434,
      \u043D\u043E \u043F\u043E\u0434 \u043D\u0438\u043C\u0438 \u2014 \u0433\u043E\u0440\u0435\u0447\u044C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0414\u043B\u044F \u043C\u0435\u043D\u044F \u0432\u0430\u0436\u043D\u043E
      \u043F\u043E\u0441\u043A\u043E\u0440\u0435\u0435 \u043F\u043E\u043A\u0438\u043D\u0443\u0442\u044C
      \u043F\u043B\u043E\u0449\u0430\u0434\u044C \u0438 \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
      \u0434\u043E\u043C\u043E\u0439, \u0442\u0443\u0434\u0430, \u0433\u0434\u0435
      \u0435\u0449\u0451 \u043C\u043E\u0436\u043D\u043E \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
      \u0431\u0435\u0437 \u043E\u0433\u043B\u044F\u0434\u043A\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u043E, \u043F\u044B\u0442\u0430\u044F\u0441\u044C \u043F\u0440\u043E\u0442\u0438\u0441\u043D\u0443\u0442\u044C\u0441\u044F
      \u0441\u043A\u0432\u043E\u0437\u044C \u0442\u043E\u043B\u043F\u0443, \u044F
      \u043D\u0435\u0447\u0430\u044F\u043D\u043D\u043E \u0437\u0430\u0434\u0435\u0432\u0430\u044E
      \u043C\u0443\u0436\u0447\u0438\u043D\u0443 \u0432 \u0444\u0435\u043B\u044C\u0434\u0433\u0440\u0430\u0443
      \u2014 \u0441\u0435\u0440\u043E-\u0437\u0435\u043B\u0435\u043D\u044B\u0439
      \u043C\u0443\u043D\u0434\u0438\u0440, \u0444\u0443\u0440\u0430\u0436\u043A\u0430,
      \u0430\u0432\u0442\u043E\u043C\u0430\u0442, \u043A\u0440\u0435\u043F\u043A\u043E
      \u0441\u0436\u0430\u0442\u044B\u0439 \u0432 \u0440\u0443\u043A\u0435."
    style: {fileID: 0}
    authorComment: 
