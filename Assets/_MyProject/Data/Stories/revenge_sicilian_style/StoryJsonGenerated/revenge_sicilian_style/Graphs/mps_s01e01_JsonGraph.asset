  guid: mps_s01e01_l0186_banner_01
  message: "\u041F\u043E \u043F\u0443\u0442\u0438 /*\u0437\u043D\u0430\u0447\u043E\u043A
    \u0420\u0435\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438*/
    \u0420\u0435\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
    \u2014 \u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430 \u043F\u0440\u043E\u044F\u0432\u043B\u044F\u0435\u0442
    \u0441\u043A\u043B\u043E\u043D\u043D\u043E\u0441\u0442\u044C \u043A \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F\u043C. \u0415\u0451 \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u0435
    \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0437\u0443\u0435\u0442\u0441\u044F
    \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C\u044E \u0438 \u0440\u0435\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E,
    \u0430 \u043D\u0435 \u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0435\u043D\u0438\u044F\u043C\u0438
    \u0438 \u0434\u0438\u0441\u043A\u0443\u0441\u0441\u0438\u044F\u043C\u0438."
  waitForCompletion: 1
  fallbackDuration: 2.5
