    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044E\u0441\u044C
      \u043D\u0430\u0432\u0435\u0440\u0445, \u043F\u0440\u0438\u0432\u043E\u0436\u0443
      \u0441\u0435\u0431\u044F \u0432 \u043F\u043E\u0440\u044F\u0434\u043E\u043A
      \u0438 \u043B\u043E\u0436\u0443\u0441\u044C, \u043F\u043E\u0447\u0442\u0438
      \u0441\u0440\u0430\u0437\u0443 \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u0432\u0430\u044F\u0441\u044C
      \u0432 \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0439, \u0431\u0435\u0437\u043C\u044F\u0442\u0435\u0436\u043D\u044B\u0439
      \u0441\u043E\u043D, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0434\u043B\u0438\u0442\u0441\u044F
      \u0434\u043E \u0441\u0430\u043C\u043E\u0433\u043E \u0432\u0435\u0447\u0435\u0440\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0410 \u043F\u0440\u043E\u0441\u044B\u043F\u0430\u044E\u0441\u044C
      \u044F \u043E\u0442 \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E\u0433\u043E,
      \u043E\u0433\u043B\u0443\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
      \u0437\u0432\u0443\u043A\u0430."
    style: {fileID: 0}
    authorComment: 
