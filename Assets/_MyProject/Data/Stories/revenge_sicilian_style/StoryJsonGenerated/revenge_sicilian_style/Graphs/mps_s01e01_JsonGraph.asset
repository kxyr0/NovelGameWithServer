      \u043C\u0443\u0436\u0447\u0438\u043D\u0430 \u043D\u0435 \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u0442
      \u043F\u0440\u043E\u0439\u0442\u0438, \u0438 \u043C\u043E\u0438 \u043F\u043E\u043F\u044B\u0442\u043A\u0438
      \u0432\u044B\u0440\u0432\u0430\u0442\u044C\u0441\u044F \u0442\u0449\u0435\u0442\u043D\u044B.
      \u041F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F
      \u043D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 19
    richText: "\xAB\u041F\u043E\u043B\u0430\u0433\u0430\u044E, \u043E\u043D \u0436\u0435\u043B\u0430\u0435\u0442,
      \u0447\u0442\u043E\u0431\u044B \u044F \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C
      \u0438 \u0434\u043E\u0441\u043B\u0443\u0448\u0430\u043B\u0430 \u0440\u0435\u0447\u044C
      \u0414\u0443\u0447\u0435\xBB."
