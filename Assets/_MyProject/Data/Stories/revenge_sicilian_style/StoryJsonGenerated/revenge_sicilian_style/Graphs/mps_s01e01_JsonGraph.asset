    speakerNameHint: hero
  lines:
  - speakerId: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0437\u043E\u043D\u0442\u043E\u043C"
    speakerNameHint: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0437\u043E\u043D\u0442\u043E\u043C"
    speaker: {fileID: 11400000, guid: 69e1dc9f73c6867468fa7b327cd7565c, type: 2}
    emotion: 26
    richText: "\u0412\u0430\u0448 \u043E\u0442\u0435\u0446?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u044B\u0433\u043D\u0443\u043B \u0431\u0440\u043E\u0432\u044C"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043C\u043E\u043B\u0447\u0443, \u043F\u043E\u0433\u0440\u0443\u0436\u0451\u043D\u043D\u0430\u044F
      \u0432 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435 \u043C\u044B\u0441\u043B\u0438,
      \u043F\u043E\u043A\u0430 \u0434\u043E\u0436\u0434\u044C \u0432\u0441\u0451
      \u0442\u0430\u043A \u0436\u0435 \u043C\u043E\u043D\u043E\u0442\u043E\u043D\u043D\u043E
      \u0441\u0442\u0443\u0447\u0438\u0442 \u043F\u043E \u0437\u043E\u043D\u0442\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0437\u043E\u043D\u0442\u043E\u043C"
    speakerNameHint: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0437\u043E\u043D\u0442\u043E\u043C"
    speaker: {fileID: 11400000, guid: 69e1dc9f73c6867468fa7b327cd7565c, type: 2}
    emotion: 17
    richText: "\u0423\u043F\u0440\u044F\u043C\u044B\u0439 \u0431\u044B\u043B \u0447\u0435\u043B\u043E\u0432\u0435\u043A."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044E
      \u043D\u0430 \u043D\u0435\u0433\u043E \u0432\u0437\u0433\u043B\u044F\u0434,
      \u043D\u043E \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u044E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0437\u043E\u043D\u0442\u043E\u043C"
    speakerNameHint: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0437\u043E\u043D\u0442\u043E\u043C"
    speaker: {fileID: 11400000, guid: 69e1dc9f73c6867468fa7b327cd7565c, type: 2}
    emotion: 17
    richText: "\u041E\u0434\u043D\u0430\u043A\u043E \u043D\u0435 \u0433\u043B\u0443\u043F."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u043D\u043E\u0432\u0430 \u0442\u0438\u0448\u0438\u043D\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041C\u044B \u043E\u0431\u0430 \u0441\u043C\u043E\u0442\u0440\u0438\u043C
      \u043D\u0430 \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0439 \u043A\u0430\u043C\u0435\u043D\u044C
      \u043D\u0430\u0434\u0433\u0440\u043E\u0431\u0438\u044F, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u043C
      \u0443\u0436\u0435 \u043F\u043E\u0431\u043B\u0451\u0441\u043A\u0438\u0432\u0430\u044E\u0442
      \u043A\u0430\u043F\u043B\u0438 \u0434\u043E\u0436\u0434\u044F."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u0442\u043E\u0440\u043E\u0439 \u043C\u0443\u0436\u0447\u0438\u043D\u0430,
      \u0441 \u0433\u0443\u0441\u0442\u044B\u043C\u0438 \u0443\u0441\u0430\u043C\u0438,
      \u0447\u0443\u0442\u044C \u043F\u043E\u0434\u0430\u0435\u0442\u0441\u044F \u0432\u043F\u0435\u0440\u0451\u0434
      \u0438 \u043D\u0435\u0433\u0440\u043E\u043C\u043A\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u2026"
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0443\u0441\u0430\u043C\u0438"
    speakerNameHint: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0443\u0441\u0430\u043C\u0438"
    speaker: {fileID: 11400000, guid: 88ab372d37d4ecb4fa9362f48f0ced63, type: 2}
    emotion: 17
    richText: "\u0412\u0435\u0440\u043D\u043E. \u0422\u043E\u043B\u044C\u043A\u043E
      \u0432\u043E\u0442 \u0443\u043F\u0440\u044F\u043C\u0441\u0442\u0432\u043E \u0438
      \u043F\u0440\u0438\u0432\u0435\u043B\u043E \u0435\u0433\u043E \u043A \u0442\u0430\u043A\u043E\u043C\u0443
      \u043A\u043E\u043D\u0446\u0443."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u044E
      \u0433\u043E\u043B\u043E\u0432\u0443, \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044F,
      \u043A\u0430\u043A \u0432\u043D\u0443\u0442\u0440\u0438 \u043D\u0430\u0440\u0430\u0441\u0442\u0430\u0435\u0442
      \u0442\u0440\u0435\u0432\u043E\u0433\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 30
    richText: "\u041A\u0442\u043E \u0432\u044B? \u0418 \u043E \u0447\u0435\u043C
      \u0432\u044B \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u043F\u043E\u0445\u043E\u0440\u043E\u043D\u043D\u044B\u0439
      \u043D\u0430\u0440\u044F\u0434, \u041D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u0430\u044F"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441\u0436\u0438\u043C\u0430\u0435\u0442
      \u043F\u0430\u043B\u044C\u0446\u044B \u043D\u0430 \u0440\u0443\u0447\u043A\u0435
      \u0437\u043E\u043D\u0442\u0430, \u0432\u044B\u043F\u0440\u044F\u043C\u043B\u044F\u0435\u0442\u0441\u044F
      \u0438, \u0433\u043B\u044F\u0434\u044F \u043C\u043D\u0435 \u043F\u0440\u044F\u043C\u043E
      \u0432 \u0433\u043B\u0430\u0437\u0430, \u043E\u0442\u0447\u0435\u043A\u0430\u043D\u0438\u0432\u0430\u0435\u0442\u2026"
    style: {fileID: 0}
    authorComment: 
