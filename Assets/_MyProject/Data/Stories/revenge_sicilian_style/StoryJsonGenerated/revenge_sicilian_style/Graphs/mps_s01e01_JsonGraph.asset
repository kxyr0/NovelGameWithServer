  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u0448\u0430\u0433\u0430\u0435\u0442 \u0432\u043F\u0435\u0440\u0451\u0434,
      \u0438 \u0435\u0433\u043E \u0442\u0435\u043D\u044C \u043D\u0430 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0435
      \u043D\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043D\u0430\u0434\u0433\u0440\u043E\u0431\u0438\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0437\u043E\u043D\u0442\u043E\u043C"
    speakerNameHint: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0437\u043E\u043D\u0442\u043E\u043C"
    speaker: {fileID: 11400000, guid: 69e1dc9f73c6867468fa7b327cd7565c, type: 2}
    emotion: 17
    richText: "\u0414\u0435\u043B\u043E \u0432\u0430\u0448\u0435\u0433\u043E \u043E\u0442\u0446\u0430,
      \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E, \u043F\u0435\u0440\u0435\u0439\u0434\u0451\u0442
      \u043A \u0432\u0430\u043C \u043F\u043E \u043D\u0430\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0443."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0437\u043E\u043D\u0442\u043E\u043C"
    speakerNameHint: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0437\u043E\u043D\u0442\u043E\u043C"
    speaker: {fileID: 11400000, guid: 69e1dc9f73c6867468fa7b327cd7565c, type: 2}
    emotion: 17
    richText: "\u0412\u043E\u0437\u044C\u043C\u0438\u0442\u0435."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u043D\u0430\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E
      \u043F\u0440\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442 \u0432\u0438\u0437\u0438\u0442\u043A\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0437\u043E\u043D\u0442\u043E\u043C"
    speakerNameHint: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0437\u043E\u043D\u0442\u043E\u043C"
    speaker: {fileID: 11400000, guid: 69e1dc9f73c6867468fa7b327cd7565c, type: 2}
    emotion: 17
    richText: "\u041C\u044B \u0445\u043E\u0440\u043E\u0448\u043E \u0437\u043D\u0430\u043B\u0438
      \u0432\u0430\u0448\u0435\u0433\u043E \u043E\u0442\u0446\u0430."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0437\u043E\u043D\u0442\u043E\u043C"
    speakerNameHint: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0437\u043E\u043D\u0442\u043E\u043C"
    speaker: {fileID: 11400000, guid: 69e1dc9f73c6867468fa7b327cd7565c, type: 2}
    emotion: 17
    richText: "\u041F\u043E\u0437\u0432\u043E\u043D\u0438\u0442\u0435, \u0435\u0441\u043B\u0438
      \u0443 \u0432\u0430\u0441 \u0432\u043E\u0437\u043D\u0438\u043A\u043D\u0443\u0442
      \u0432\u043E\u043F\u0440\u043E\u0441\u044B \u043E \u043D\u0451\u043C... \u0438\u043B\u0438
      \u0435\u0441\u043B\u0438 \u0432\u044B \u043D\u0435 \u0437\u0430\u0445\u043E\u0442\u0438\u0442\u0435
      \u043F\u043E\u0432\u0442\u043E\u0440\u0438\u0442\u044C \u0435\u0433\u043E \u043E\u0448\u0438\u0431\u043E\u043A."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0437\u043E\u043D\u0442\u043E\u043C"
    speakerNameHint: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0437\u043E\u043D\u0442\u043E\u043C"
    speaker: {fileID: 11400000, guid: 69e1dc9f73c6867468fa7b327cd7565c, type: 2}
    emotion: 2
    richText: "\u0410 \u0442\u0435\u043F\u0435\u0440\u044C \u0438\u0437\u0432\u0438\u043D\u0438\u0442\u0435,
      \u043D\u0430\u0441 \u0436\u0434\u0443\u0442 \u0434\u0435\u043B\u0430."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041B\u0435\u0433\u043A\u0430\u044F \u0443\u043B\u044B\u0431\u043A\u0430"
