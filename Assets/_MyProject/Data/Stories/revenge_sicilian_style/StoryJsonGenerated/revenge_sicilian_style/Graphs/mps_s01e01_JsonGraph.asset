    speakerNameHint: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0432\u043D\u043E\u0432\u044C \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u043C\u0435\u043D\u044F \u0435\u0445\u0438\u0434\u043D\u043E,
      \u043F\u043E\u0441\u043B\u0435 \u0447\u0435\u0433\u043E \u0445\u043C\u044B\u043A\u0430\u0435\u0442
      \u0438 \u0441\u0430\u0434\u0438\u0442\u0441\u044F \u0432 \u043C\u0430\u0448\u0438\u043D\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442
      \u0441\u0442\u0435\u043A\u043B\u043E \u0438, \u043E\u0431\u0440\u0430\u0449\u0430\u044F\u0441\u044C
      \u043A\u043E \u043C\u043D\u0435, \u043F\u0440\u043E\u0438\u0437\u043D\u043E\u0441\u0438\u0442\u2026"
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speakerNameHint: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speaker: {fileID: 11400000, guid: 7a64daf2d25859d4aab34520bad5552d, type: 2}
    emotion: 2
    richText: "\u041E\u0442\u043B\u0438\u0447\u043D\u044B\u0439 \u043C\u0443\u0436\u0447\u0438\u043D\u0430,
      \u0432\u0435\u0440\u043D\u043E?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speakerNameHint: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speaker: {fileID: 11400000, guid: 7a64daf2d25859d4aab34520bad5552d, type: 2}
    emotion: 2
    richText: "\u041F\u043B\u0430\u0442\u0438\u0442 \u0432\u043E\u0432\u0440\u0435\u043C\u044F,
      \u043F\u0440\u043E\u0434\u0430\u0451\u0442 \u0441\u0432\u0435\u0436\u0443\u044E
      \u043F\u0440\u0435\u0441\u0441\u0443."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speakerNameHint: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speaker: {fileID: 11400000, guid: 7a64daf2d25859d4aab34520bad5552d, type: 2}
    emotion: 13
    richText: "\u0427\u0443\u0434\u043E, \u0430 \u043D\u0435 \u0447\u0435\u043B\u043E\u0432\u0435\u043A."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0415\u0445\u0438\u0434\u043D\u0430\u044F \u0443\u043B\u044B\u0431\u043A\u0430"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442
      \u043A\u043E\u0437\u044B\u0440\u0451\u043A \u0441 \u0437\u0435\u0440\u043A\u0430\u043B\u043E\u043C,
      \u0434\u043E\u0441\u0442\u0430\u0451\u0442 \u043F\u043E\u043C\u0430\u0434\u0443
      \u0438 \u043F\u043E\u0434\u043A\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442
      \u0433\u0443\u0431\u044B, \u043F\u0440\u0438 \u044D\u0442\u043E\u043C \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u044F:"
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speakerNameHint: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speaker: {fileID: 11400000, guid: 7a64daf2d25859d4aab34520bad5552d, type: 2}
    emotion: 17
    richText: "\u041C\u043E\u0436\u0435\u0442, \u0432\u0430\u043C \u0442\u043E\u0436\u0435
      \u0435\u0441\u0442\u044C \u0447\u0442\u043E \u0437\u0430\u0449\u0438\u0442\u0438\u0442\u044C?
      \u041F\u043E\u0434\u0443\u043C\u0430\u0439\u0442\u0435 \u0445\u043E\u0440\u043E\u0448\u0435\u043D\u044C\u043A\u043E."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speakerNameHint: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speaker: {fileID: 11400000, guid: 7a64daf2d25859d4aab34520bad5552d, type: 2}
    emotion: 2
    richText: "\u0412\u044B \u0437\u043D\u0430\u0435\u0442\u0435, \u043A \u043A\u043E\u043C\u0443
      \u043E\u0431\u0440\u0430\u0442\u0438\u0442\u044C\u0441\u044F \u043F\u043E \u0442\u0430\u043A\u043E\u043C\u0443
      \u0441\u043B\u0443\u0447\u0430\u044E."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speakerNameHint: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speaker: {fileID: 11400000, guid: 7a64daf2d25859d4aab34520bad5552d, type: 2}
    emotion: 17
    richText: "\u041F\u043E\u0435\u0445\u0430\u043B\u0438, \u0422\u043E\u043C. \u041D\u0435
      \u0441\u0442\u0430\u043D\u0435\u043C \u043D\u0430\u0434\u043E\u0435\u0434\u0430\u0442\u044C."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u0442\u0435\u043A\u043B\u043E \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F,
      \u0438 \u0430\u0432\u0442\u043E\u043C\u043E\u0431\u0438\u043B\u044C \u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0437\u0430 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0438\u043C \u0434\u043E\u043C\u043E\u043C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0410\u043D\u0442\u043E\u043D\u0438\u043E \u043A\u043E\u0440\u043E\u0442\u043A\u043E
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u043C\u0435\u043D\u044F
      \u0438 \u043E\u0442\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F,
      \u043B\u0438\u0445\u043E\u0440\u0430\u0434\u043E\u0447\u043D\u043E \u0441\u0442\u0430\u0440\u0430\u044F\u0441\u044C
      \u043F\u043E\u043F\u0440\u0430\u0432\u043B\u044F\u044F \u0433\u0430\u0437\u0435\u0442\u044B
      \u043D\u0430 \u043F\u0440\u0438\u043B\u0430\u0432\u043A\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u043A\u0430\u043A\u043E\u0435-\u0442\u043E \u0432\u0440\u0435\u043C\u044F
      \u043C\u043E\u043B\u0447\u0438\u0442, \u0430 \u043F\u043E\u0441\u043B\u0435
      \u043F\u0440\u043E\u0438\u0437\u043D\u043E\u0441\u0438\u0442\u2026"
    style: {fileID: 0}
    authorComment: 
