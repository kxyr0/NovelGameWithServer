  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: mps_s01e01_l0479_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: 7a64daf2d25859d4aab34520bad5552d, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
  - character: {fileID: 11400000, guid: 0d74ce51fe0a954408fea0cfa1c4bfc8, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u0410\u043D\u0442\u043E\u043D\u0438\u043E"
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0434\u043D\u0430\u043A\u043E \u044F \u043F\u0440\u0435\u0434\u043F\u043E\u0447\u0438\u0442\u0430\u044E
      \u043D\u0435 \u0432\u043C\u0435\u0448\u0438\u0432\u0430\u0442\u044C\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speakerNameHint: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speaker: {fileID: 11400000, guid: 7a64daf2d25859d4aab34520bad5552d, type: 2}
    emotion: 2
    richText: "\u042D\u0442\u043E \u0432\u0430\u0448\u0430 \u0432\u043D\u0443\u0447\u043A\u0430?
      \u0418\u043B\u0438 \u043C\u043E\u0436\u0435\u0442 \u0434\u043E\u0447\u044C?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0443\u043B\u044B\u0431\u043A\u0430"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0431\u0435\u0441\u0441\u0442\u044B\u0434\u043D\u043E
      \u0441\u043C\u0435\u0440\u044F\u0435\u0442 \u043C\u0435\u043D\u044F \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C
      \u0441 \u0433\u043E\u043B\u043E\u0432\u044B \u0434\u043E \u043D\u043E\u0433
      \u0438 \u043E\u0431\u0440\u0430\u0442\u043D\u043E, \u043F\u043E\u0441\u043B\u0435
      \u0447\u0435\u0433\u043E, \u0441\u043B\u043E\u0432\u043D\u043E \u0443\u0442\u0440\u0430\u0442\u0438\u0432
      \u0438\u043D\u0442\u0435\u0440\u0435\u0441, \u0432\u043D\u043E\u0432\u044C
      \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u043A \u0441\u0442\u0430\u0440\u0438\u043A\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u0410\u043D\u0442\u043E\u043D\u0438\u043E"
    speakerNameHint: "\u0410\u043D\u0442\u043E\u043D\u0438\u043E"
    speaker: {fileID: 11400000, guid: 0d74ce51fe0a954408fea0cfa1c4bfc8, type: 2}
    emotion: 30
    richText: "\u0417\u0434\u043E\u0440\u043E\u0432\u044C\u0435 \u043D\u0435 \u043F\u043E\u0434\u0432\u043E\u0434\u0438\u0442,
      \u0441\u043F\u0430\u0441\u0438\u0431\u043E. \u041E\u0437\u043E\u0440\u043D\u0438\u043A\u0438
      \u043D\u0435 \u0434\u043E\u043A\u0443\u0447\u0430\u044E\u0442."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430
      \u043C\u0435\u043D\u044F, \u0430 \u043F\u043E\u0441\u043B\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442
      \u0432\u0437\u0433\u043B\u044F\u0434 \u043A \u0441\u043E\u0431\u0435\u0441\u0435\u0434\u043D\u0438\u0446\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u0410\u043D\u0442\u043E\u043D\u0438\u043E"
    speakerNameHint: "\u0410\u043D\u0442\u043E\u043D\u0438\u043E"
    speaker: {fileID: 11400000, guid: 0d74ce51fe0a954408fea0cfa1c4bfc8, type: 2}
    emotion: 17
    richText: "\u041D\u0435\u0442. \u041D\u0435 \u0443\u0433\u0430\u0434\u0430\u043B\u0438."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u044C\u043D\u043E"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430 \u0443\u0445\u043C\u044B\u043B\u044F\u0435\u0442\u0441\u044F,
      \u0437\u0430\u0442\u044F\u0433\u0438\u0432\u0430\u044F\u0441\u044C \u043D\u043E\u0432\u043E\u0439
      \u043F\u043E\u0440\u0446\u0438\u0435\u0439 \u043D\u0438\u043A\u043E\u0442\u0438\u043D\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speakerNameHint: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speaker: {fileID: 11400000, guid: 7a64daf2d25859d4aab34520bad5552d, type: 2}
    emotion: 13
    richText: "\u0422\u043E-\u0442\u043E \u044F \u0434\u0443\u043C\u0430\u044E, \u043D\u0435
      \u043F\u043E\u0445\u043E\u0436\u0430."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0415\u0445\u0438\u0434\u043D\u0430\u044F \u0443\u043B\u044B\u0431\u043A\u0430"
  - speakerId: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speakerNameHint: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speaker: {fileID: 11400000, guid: 7a64daf2d25859d4aab34520bad5552d, type: 2}
    emotion: 8
    richText: "\u041A\u043B\u0438\u0435\u043D\u0442\u043A\u0430?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0432\u0437\u0433\u043B\u044F\u0434"
  - speakerId: "\u0410\u043D\u0442\u043E\u043D\u0438\u043E"
    speakerNameHint: "\u0410\u043D\u0442\u043E\u043D\u0438\u043E"
    speaker: {fileID: 11400000, guid: 0d74ce51fe0a954408fea0cfa1c4bfc8, type: 2}
    emotion: 30
    richText: "\u2026"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u043E"
  - speakerId: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speakerNameHint: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speaker: {fileID: 11400000, guid: 7a64daf2d25859d4aab34520bad5552d, type: 2}
    emotion: 2
    richText: "\u041D\u0443 \u044D\u0442\u043E \u0445\u043E\u0440\u043E\u0448\u043E,
      \u0447\u0442\u043E \u0443 \u0432\u0430\u0441 \u0432\u0441\u0451 \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435.
      \u0412\u0435\u0440\u043D\u043E?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: "\u0410\u043D\u0442\u043E\u043D\u0438\u043E"
    speakerNameHint: "\u0410\u043D\u0442\u043E\u043D\u0438\u043E"
    speaker: {fileID: 11400000, guid: 0d74ce51fe0a954408fea0cfa1c4bfc8, type: 2}
    emotion: 30
    richText: "\u0412\u0435\u0440\u043D\u043E."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041B\u0435\u0433\u043A\u043E\u0435 \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u043E"
