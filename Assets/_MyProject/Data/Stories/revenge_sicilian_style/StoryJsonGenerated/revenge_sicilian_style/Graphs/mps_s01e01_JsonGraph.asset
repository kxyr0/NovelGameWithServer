  guid: mps_s01e01_l0602_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0431\u0440\u0430\u0442\u0438\u0442\u0435 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435:
      \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0432\u044B\u0431\u043E\u0440\u044B
      \u0432 \u044D\u0442\u043E\u0439 \u0438\u0441\u0442\u043E\u0440\u0438\u0438
      \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u043F\u043B\u0430\u0442\u043D\u044B\u043C\u0438.
      \u041E\u043D\u0438 \u043E\u0442\u043C\u0435\u0447\u0435\u043D\u044B \u0441\u0438\u043C\u0432\u043E\u043B\u043E\u043C
      /*\u0437\u043D\u0430\u0447\u043E\u043A \u0412\u0430\u043B\u044E\u0442\u044B*/
      \xAB\u2764\uFE0F\xBB \u0438 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u044E\u0442
      \u0434\u043E\u0441\u0442\u0443\u043F \u043A \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u043C\u0443,
      \u044D\u043A\u0441\u043A\u043B\u044E\u0437\u0438\u0432\u043D\u043E\u043C\u0443
      \u043A\u043E\u043D\u0442\u0435\u043D\u0442\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\xAB\u042F \u0445\u043E\u0447\u0443\u2026"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C\u043D\u0430\u044F"
