    position: 0
    speakerNameHint: hero
  - character: {fileID: 11400000, guid: 0d74ce51fe0a954408fea0cfa1c4bfc8, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u0410\u043D\u0442\u043E\u043D\u0438\u043E"
  lines:
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\u0414\u0435\u043D\u044C \u0432\u044B\u0434\u0430\u043B\u0441\u044F
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u043C, \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0435
      \u0432\u0441\u0451 \u0433\u043B\u0430\u0434\u043A\u043E."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 2
    richText: "\u0412\u043E\u0442, \u0434\u043E\u0440\u043E\u0433\u0435 \u0434\u043E\u043C\u043E\u0439
      \u043C\u043D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043A\u0443\u043F\u0438\u0442\u044C.
      \u0421\u0432\u0435\u0436\u0438\u0439 \u0443\u0440\u043E\u0436\u0430\u0439."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\u0421\u0435\u0439\u0447\u0430\u0441 \u0438\u0434\u0443 \u0434\u043E\u043C\u043E\u0439.
      \u041E\u0442\u0435\u0446 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0443\u0448\u0451\u043B
      \u043F\u043E\u0440\u0430\u043D\u044C\u0448\u0435 \u2014 \u0443 \u043D\u0435\u0433\u043E
      \u0431\u044B\u043B\u0438 \u0434\u0435\u043B\u0430, \u0442\u0430\u043A \u0447\u0442\u043E
      \u0441 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u043E\u043C \u044F \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u043B\u0430\u0441\u044C
      \u043E\u0434\u043D\u0430."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0441\u0442\u044B\u0447\u043A\u0435
      \u0441 \u043D\u0430\u0446\u0438\u0441\u0442\u0441\u043A\u0438\u043C \u0441\u043E\u043B\u0434\u0430\u0442\u043E\u043C
      \u043D\u0430 \u043C\u0438\u0442\u0438\u043D\u0433\u0435 \u044F \u0440\u0435\u0448\u0438\u043B\u0430
      \u0443\u043C\u043E\u043B\u0447\u0430\u0442\u044C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u0435 \u0445\u043E\u0442\u0435\u043B\u043E\u0441\u044C \u0442\u0440\u0435\u0432\u043E\u0436\u0438\u0442\u044C
      \u0441\u0442\u0430\u0440\u0438\u043A\u0430. \u041E\u043D \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u043B
      \u0438\u0437\u043C\u0443\u0447\u0435\u043D\u043D\u044B\u043C, \u043D\u043E
      \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u043B \u0431\u043E\u0434\u0440\u043E\u0441\u0442\u044C
      \u0438 \u0431\u0435\u0437\u0437\u0430\u0431\u043E\u0442\u043D\u043E\u0441\u0442\u044C,
      \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0435\u0433\u043E
      \u0437\u0430\u0431\u043E\u0442\u044B \u0431\u044B\u043B\u0438 \u043D\u0435\u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C\u0438
      \u0438 \u043D\u0435 \u043E\u043C\u0440\u0430\u0447\u0430\u043B\u0438 \u0435\u0433\u043E
      \u0434\u0443\u0445."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 2
    richText: "\u041F\u043E\u0434 \u043A\u043E\u043D\u0435\u0446 \u0434\u043D\u044F
      \u0437\u0430\u0433\u043B\u044F\u043D\u0443\u043B \u0445\u043E\u0440\u043E\u0448\u0438\u0439
      \u043A\u043B\u0438\u0435\u043D\u0442 \u2014 \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
      \u043C\u043D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0443\u0431\u0435\u0434\u0438\u0442\u044C
      \u0435\u0433\u043E \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u043F\u043E\u043A\u0443\u043F\u043A\u0443."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 2
    richText: "\u041E\u043D \u0441\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E
      \u043F\u043E\u0434\u0443\u043C\u0430\u0435\u0442 \u0438 \u043F\u043E\u0434\u043E\u0439\u0434\u0451\u0442
      \u043F\u043E\u0437\u0436\u0435."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u043E\u043F\u0440\u0430\u0432\u0438\u0432 \u0433\u0430\u0437\u0435\u0442\u044B
      \u043D\u0430 \u043F\u043E\u043B\u043A\u0435, \u0441\u0442\u0430\u0440\u0438\u043A
      \u043E\u0442\u0440\u044F\u0445\u043D\u0443\u043B \u0440\u0443\u043A\u0438 \u0438
      \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u043A\u043E \u043C\u043D\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u0410\u043D\u0442\u043E\u043D\u0438\u043E"
    speakerNameHint: "\u0410\u043D\u0442\u043E\u043D\u0438\u043E"
    speaker: {fileID: 11400000, guid: 0d74ce51fe0a954408fea0cfa1c4bfc8, type: 2}
    emotion: 2
    richText: "\u0422\u044B \u0432\u0441\u0435\u0433\u0434\u0430 \u043E\u0442\u043B\u0438\u0447\u0430\u043B\u0430\u0441\u044C
      \u0436\u0438\u0432\u044B\u043C \u0443\u043C\u043E\u043C. \u042D\u0442\u043E\u0433\u043E
      \u0443 \u0442\u0435\u0431\u044F \u043D\u0435 \u043E\u0442\u043D\u044F\u0442\u044C."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 2
    richText: "\u2026"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0443\u043B\u044B\u0431\u0430\u044F\u0441\u044C"
