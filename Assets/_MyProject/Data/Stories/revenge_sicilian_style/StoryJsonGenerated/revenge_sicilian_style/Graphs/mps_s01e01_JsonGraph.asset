  guid: mps_s01e01_l1322_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters: []
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041C\u0435\u043D\u044F \u0431\u0443\u0434\u0438\u0442 \u0437\u0432\u0443\u043A."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u0435 \u043A\u0440\u0438\u043A, \u043D\u0435 \u0441\u0442\u0443\u043A
      \u2014 \u0441\u0443\u0445\u043E\u0439, \u0440\u0435\u0437\u043A\u0438\u0439
      \u0445\u043B\u043E\u043F\u043E\u043A, \u0431\u0443\u0434\u0442\u043E \u043A\u0442\u043E-\u0442\u043E
      \u0449\u0451\u043B\u043A\u043D\u0443\u043B \u043A\u043D\u0443\u0442\u043E\u043C
      \u043F\u0440\u044F\u043C\u043E \u043F\u043E\u0434 \u043E\u043A\u043D\u043E\u043C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u0437\u0430\u043C\u0438\u0440\u0430\u044E, \u043F\u0440\u0438\u0441\u043B\u0443\u0448\u0438\u0432\u0430\u044F\u0441\u044C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0422\u0438\u0448\u0438\u043D\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u0438\u0446\u0438\u043B\u0438\u044F \u0443\u043C\u0435\u0435\u0442
      \u0445\u0440\u0430\u043D\u0438\u0442\u044C \u0441\u0435\u043A\u0440\u0435\u0442\u044B."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u0443\u0436\u0435 \u0445\u043E\u0447\u0443 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0434\u0440\u0443\u0433\u043E\u0439 \u0431\u043E\u043A, \u0441\u043F\u0438\u0441\u0430\u0432
      \u0432\u0441\u0451 \u043D\u0430 \u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u044C,
      \u043A\u0430\u043A \u043D\u043E\u0447\u044C \u0432\u0437\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441\u043D\u043E\u0432\u0430."
    style: {fileID: 0}
    authorComment: 
