  guid: mps_s01e01_l0969_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  - character: {fileID: 11400000, guid: e706e7d1a91e19d4abff1ac05facf1ab, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u0414\u0436\u0443\u043B\u0438\u044F"
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u0441\u043C\u043E\u0442\u0440\u044E \u043D\u0430 \u0435\u0451
      \u0433\u0443\u0431\u044B. \u041E\u043D\u0430 \u0443\u0436\u0435 \u0443\u0441\u043F\u0435\u043B\u0430
      \u0432\u043E\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u043F\u043E\u0434\u0430\u0440\u043A\u043E\u043C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 8
    richText: "\u041D\u0435\u043C\u0435\u0446\u043A\u0438\u0439 \u0441\u043E\u043B\u0434\u0430\u0442?
      \u0418 \u0442\u044B \u043F\u0440\u0438\u043D\u044F\u043B\u0430 \u043E\u0442
      \u043D\u0435\u0433\u043E \u043F\u043E\u0434\u0430\u0440\u043E\u043A? \u0417\u0430\u0447\u0435\u043C?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0434\u043E\u0443\u043C\u0435\u043D\u0438\u0435"
  - speakerId: "\u0414\u0436\u0443\u043B\u0438\u044F"
    speakerNameHint: "\u0414\u0436\u0443\u043B\u0438\u044F"
    speaker: {fileID: 11400000, guid: e706e7d1a91e19d4abff1ac05facf1ab, type: 2}
    emotion: 2
    richText: "\u041E\u043D\u0430 \u043D\u0435 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
      \u043C\u043D\u0435 \u043B\u0438\u0448\u043D\u0435\u0439. \u0422\u0435\u043C
      \u0431\u043E\u043B\u0435\u0435 \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 30
    richText: "\u0414\u0430. \u0422\u043E\u043B\u044C\u043A\u043E \u0432\u0434\u043E\u0431\u0430\u0432\u043E\u043A
      \u043A \u043D\u0435\u0439 \u0443 \u0442\u0435\u0431\u044F \u0431\u0443\u0434\u0435\u0442
      \u0435\u0449\u0451 \u0438 \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E\u0435
      \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435 \u043E\u0442 \u043D\u0435\u0434\u0440\u0443\u0433\u0430.
      \u0422\u0435\u0431\u0435 \u044D\u0442\u043E \u043D\u0443\u0436\u043D\u043E?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u0430\u044F"
  - speakerId: "\u0414\u0436\u0443\u043B\u0438\u044F"
    speakerNameHint: "\u0414\u0436\u0443\u043B\u0438\u044F"
    speaker: {fileID: 11400000, guid: e706e7d1a91e19d4abff1ac05facf1ab, type: 2}
    emotion: 32
    richText: "\u042F \u043D\u0435 \u0438\u0441\u043F\u044B\u0442\u044B\u0432\u0430\u044E
      \u0434\u0438\u0441\u043A\u043E\u043C\u0444\u043E\u0440\u0442\u0430."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041F\u0440\u0438\u0449\u0443\u0440"
  - speakerId: "\u0414\u0436\u0443\u043B\u0438\u044F"
    speakerNameHint: "\u0414\u0436\u0443\u043B\u0438\u044F"
    speaker: {fileID: 11400000, guid: e706e7d1a91e19d4abff1ac05facf1ab, type: 2}
    emotion: 17
    richText: "\u042F \u043D\u0435 \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0441\u044C
      \u0441 \u043D\u0438\u043C \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0442\u044C\u0441\u044F."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: "\u0414\u0436\u0443\u043B\u0438\u044F"
    speakerNameHint: "\u0414\u0436\u0443\u043B\u0438\u044F"
    speaker: {fileID: 11400000, guid: e706e7d1a91e19d4abff1ac05facf1ab, type: 2}
    emotion: 19
    richText: "\u041F\u0443\u0441\u0442\u044C \u043F\u043E\u0431\u0435\u0433\u0430\u0435\u0442,
      \u043F\u043E\u0441\u0443\u0435\u0442\u0438\u0442\u0441\u044F, \u043D\u0430\u0434\u0430\u0440\u0438\u0442
      \u043F\u043E\u0434\u0430\u0440\u043A\u043E\u0432. \u0410 \u0442\u0430\u043C
      \u044F \u0435\u043C\u0443 \u0432\u0435\u0436\u043B\u0438\u0432\u043E \u043E\u0442\u043A\u0430\u0436\u0443."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u0437\u0433\u043B\u044F\u0434 \u0432 \u0432\u0435\u0440\u0445\u043D\u0438\u0439
      \u043B\u0435\u0432\u044B\u0439 \u0443\u0433\u043E\u043B"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043D\u0435\u043D\u0430\u0440\u043E\u043A\u043E\u043C \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u044E
      \u0441\u0446\u0435\u043D\u0443 \u043D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u0438.
      \u0421\u043E\u043B\u0434\u0430\u0442, \u043D\u0435\u0441\u043C\u043E\u0442\u0440\u044F
      \u043D\u0430 \u043C\u043E\u0439 \u043F\u043E\u043B, \u043E\u0431\u043E\u0448\u0451\u043B\u0441\u044F
      \u0441\u043E \u043C\u043D\u043E\u0439 \u043A\u0440\u0430\u0439\u043D\u0435
      \u0433\u0440\u0443\u0431\u043E. \u0427\u0442\u043E, \u0435\u0441\u043B\u0438,
      \u043F\u043E\u043B\u0443\u0447\u0438\u0432 \u043E\u0442\u043A\u0430\u0437,
      \u0435\u0451 \u043D\u0435\u043C\u0435\u0446 \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u0442
      \u0435\u0449\u0451 \u0445\u0443\u0436\u0435?"
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 28
    richText: "\u0414\u0436\u0443\u043B\u0438\u044F, \u043C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
      \u0447\u0442\u043E\u2026"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0432\u0437\u0433\u043B\u044F\u0434 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443"
