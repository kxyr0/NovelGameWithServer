  guid: mps_s01e01_l0528_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  - character: {fileID: 11400000, guid: 0d74ce51fe0a954408fea0cfa1c4bfc8, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u0410\u043D\u0442\u043E\u043D\u0438\u043E"
  - character: {fileID: 11400000, guid: 7a64daf2d25859d4aab34520bad5552d, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
  lines:
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 28
    richText: "\xAB\u041C\u043E\u0436\u0435\u0442 \u0410\u043D\u0442\u043E\u043D\u0438\u043E
      \u043A\u043E\u043C\u0443-\u0442\u043E \u0434\u043E\u043B\u0436\u0435\u043D?
      \u041D\u0435\u0443\u0436\u0435\u043B\u0438 \u043E\u043D \u0438\u0433\u0440\u043E\u043A?\xBB"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u0437\u0433\u043B\u044F\u0434 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 19
    richText: "\xAB\u0425\u043E\u0442\u044F, \u043E\u043D \u043D\u0435 \u043F\u043E\u0445\u043E\u0436
      \u043D\u0430 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0443\u0435\u0442\u0441\u044F \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u043C.\xBB"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0432\u0437\u0433\u043B\u044F\u0434 \u0432 \u0432\u0435\u0440\u0445\u043D\u0438\u0439
      \u0443\u0433\u043E\u043B"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\xAB\u042D\u0442\u043E \u0442\u043E\u0447\u043D\u043E \u043D\u0435
      \u043F\u0440\u043E \u0410\u043D\u0442\u043E\u043D\u0438\u043E\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u044C\u043D\u043E"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u0442\u0430\u0440\u0438\u043A \u0434\u0435\u043B\u0430\u0435\u0442
      \u043F\u0430\u0440\u0443 \u0448\u0430\u0433\u043E\u0432 \u043D\u0430\u0437\u0430\u0434,
      \u0432\u044B\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043B\u0430\u0434\u043E\u043D\u0438,
      \u0432\u0441\u0435\u043C \u0432\u0438\u0434\u043E\u043C \u0434\u0430\u0432\u0430\u044F
      \u043F\u043E\u043D\u044F\u0442\u044C, \u0447\u0442\u043E \u043F\u043E\u043C\u043E\u0449\u044C
      \u0435\u043C\u0443 \u043D\u0435 \u043D\u0443\u0436\u043D\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 30
    richText: "\xAB\u041E\u043D \u0435\u0451 \u0431\u043E\u0438\u0442\u0441\u044F\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E"
  - speakerId: "\u0410\u043D\u0442\u043E\u043D\u0438\u043E"
    speakerNameHint: "\u0410\u043D\u0442\u043E\u043D\u0438\u043E"
    speaker: {fileID: 11400000, guid: 0d74ce51fe0a954408fea0cfa1c4bfc8, type: 2}
    emotion: 19
    richText: "\u041D\u0435\u0442, \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044E."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u0437\u0433\u043B\u044F\u0434 \u0432\u043D\u0438\u0437"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430 \u043D\u0435\u0431\u0440\u0435\u0436\u043D\u043E
      \u0431\u0440\u043E\u0441\u0430\u0435\u0442 \u043E\u043A\u0443\u0440\u043E\u043A
      \u043D\u0430 \u0442\u0440\u043E\u0442\u0443\u0430\u0440 \u0438 \u043F\u0440\u0438\u0434\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u043A\u0430\u0431\u043B\u0443\u043A\u043E\u043C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u0440\u0438 \u044D\u0442\u043E\u043C \u043B\u043E\u0432\u043A\u043E
      \u043F\u0440\u044F\u0447\u0435\u0442 \u0434\u0435\u043D\u044C\u0433\u0438 \u0432
      \u043A\u0430\u0440\u043C\u0430\u043D \u0431\u0440\u044E\u043A."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speakerNameHint: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speaker: {fileID: 11400000, guid: 7a64daf2d25859d4aab34520bad5552d, type: 2}
    emotion: 2
    richText: "\u0425\u043E\u0440\u043E\u0448\u043E. \u0412 \u043B\u044E\u0431\u043E\u043C
      \u0441\u043B\u0443\u0447\u0430\u0435, \u043A\u0442\u043E \u0442\u0435\u0440\u043F\u0438\u0442
      \u043B\u0438\u0448\u043D\u044E\u044E \u0440\u0430\u0431\u043E\u0442\u0443,
      \u0432\u0435\u0440\u043D\u043E?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u0440\u043E\u0434\u0430\u0432\u0435\u0446 \u0433\u0430\u0437\u0435\u0442
      \u043A\u0438\u0432\u0430\u0435\u0442."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speakerNameHint: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speaker: {fileID: 11400000, guid: 7a64daf2d25859d4aab34520bad5552d, type: 2}
    emotion: 17
    richText: "\u0412\u0441\u0442\u0440\u0435\u0442\u0438\u043C\u0441\u044F \u0447\u0435\u0440\u0435\u0437
      \u043D\u0435\u0434\u0435\u043B\u044E, \u0410\u043D\u0442\u043E\u043D\u0438\u043E."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speakerNameHint: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speaker: {fileID: 11400000, guid: 7a64daf2d25859d4aab34520bad5552d, type: 2}
    emotion: 17
    richText: "\u0414\u043E \u0441\u0432\u0438\u0434\u0430\u043D\u0438\u044F."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
