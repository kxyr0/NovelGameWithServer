  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: mps_s01e01_l1336_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u0442\u043E\u0440\u043E\u0439 \u0432\u044B\u0441\u0442\u0440\u0435\u043B
      \u0437\u0432\u0443\u0447\u0438\u0442 \u0433\u0440\u043E\u043C\u0447\u0435,
      \u0431\u043B\u0438\u0436\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412 \u043D\u0451\u043C \u0441\u043B\u044B\u0448\u0438\u0442\u0441\u044F
      \u0447\u0442\u043E-\u0442\u043E \u043D\u0435\u043F\u043E\u043F\u0440\u0430\u0432\u0438\u043C\u043E\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u0432\u0441\u043A\u0430\u043A\u0438\u0432\u0430\u044E \u0441
      \u043A\u0440\u043E\u0432\u0430\u0442\u0438, \u0441\u0435\u0440\u0434\u0446\u0435
      \u043A\u043E\u043B\u043E\u0442\u0438\u0442\u0441\u044F \u0433\u0434\u0435-\u0442\u043E
      \u0432 \u0433\u043E\u0440\u043B\u0435. \u0411\u043E\u0441\u044B\u0435 \u043D\u043E\u0433\u0438
      \u043A\u0430\u0441\u0430\u044E\u0442\u0441\u044F \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0433\u043E
      \u043F\u043E\u043B\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u044B\u0433\u043B\u044F\u043D\u0443\u0432 \u0432 \u043E\u043A\u043D\u043E,
      \u044F \u0432\u0438\u0436\u0443 \u0435\u0433\u043E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0442\u0435\u0446 \u043B\u0435\u0436\u0438\u0442 \u043D\u0430
      \u043C\u043E\u0441\u0442\u043E\u0432\u043E\u0439 \u043B\u0438\u0446\u043E\u043C
      \u0432\u043D\u0438\u0437."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0424\u043E\u043D\u0430\u0440\u044C \u0432\u044B\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u0435\u0442
      \u0438\u0437 \u0442\u0435\u043C\u043D\u043E\u0442\u044B \u0435\u0433\u043E
      \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0451\u0440\u0442\u043E\u0435
      \u0442\u0435\u043B\u043E \u0438 \u0442\u0435\u043C\u043D\u0443\u044E \u043B\u0443\u0436\u0443,
      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u0440\u0430\u0441\u0442\u0435\u043A\u0430\u044E\u0449\u0443\u044E\u0441\u044F
      \u043F\u043E\u0434 \u043D\u0438\u043C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 23
    richText: "\u041E\u0442\u0435\u0446!"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0418\u0441\u043F\u0443\u0433"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041A\u0440\u0438\u043A \u0432\u044B\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441\u0430\u043C \u0441\u043E\u0431\u043E\u0439, \u043D\u043E \u0437\u0430\u0441\u0442\u0440\u0435\u0432\u0430\u0435\u0442
      \u0432 \u0433\u043E\u0440\u043B\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u0431\u0440\u043E\u0441\u0430\u044E\u0441\u044C \u0432\u043D\u0438\u0437
      \u043F\u043E \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u0435, \u043D\u0435
      \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044F \u043F\u043E\u0434 \u043D\u043E\u0433\u0430\u043C\u0438
      \u0441\u0442\u0443\u043F\u0435\u043D\u0435\u0439."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u0445\u043E\u0434\u043D\u0430\u044F \u0434\u0432\u0435\u0440\u044C
      \u043F\u043E\u0434\u0434\u0430\u0435\u0442\u0441\u044F \u043D\u0435 \u0441\u0440\u0430\u0437\u0443
      \u2014 \u0441\u0442\u0430\u0440\u0430\u044F \u0449\u0435\u043A\u043E\u043B\u0434\u0430
      \u043D\u0438\u043A\u0430\u043A \u043D\u0435 \u0445\u043E\u0447\u0435\u0442
      \u0441\u043B\u0443\u0448\u0430\u0442\u044C\u0441\u044F \u0434\u0440\u043E\u0436\u0430\u0449\u0438\u0445
      \u043F\u0430\u043B\u044C\u0446\u0435\u0432."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u0430\u043A\u043E\u043D\u0435\u0446, \u044F \u043D\u0430 \u0443\u043B\u0438\u0446\u0435."
    style: {fileID: 0}
    authorComment: 
