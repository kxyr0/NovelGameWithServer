  guid: mps_s01e01_l0885_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 2
    richText: "\xAB\u0414\u043E \u0447\u0435\u0433\u043E \u0436\u0435 \u043A\u0440\u0430\u0441\u0438\u0432\u043E\u0435
      \u0438 \u0432\u0435\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435
      \u0437\u0434\u0430\u043D\u0438\u0435. \u0421\u044E\u0434\u0430 \u043D\u0435
      \u0431\u0435\u0440\u0443\u0442 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
      \u043A\u043E\u0433\u043E \u043F\u043E\u043F\u0430\u043B\u043E\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 2
    richText: "\xAB\u0414\u0436\u0443\u043B\u0438\u0438 \u043F\u043E\u0432\u0435\u0437\u043B\u043E.
      \u041E\u043D\u0430 \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u044B\u043B\u0430
      \u043E\u0442\u043B\u0438\u0447\u043D\u0438\u0446\u0435\u0439 \u0438 \u0441\u043C\u043E\u0433\u043B\u0430
      \u0443\u0441\u0442\u0440\u043E\u0438\u0442\u044C\u0441\u044F \u0442\u0443\u0434\u0430,
      \u043A\u0443\u0434\u0430 \u0441\u0442\u0440\u0435\u043C\u0438\u043B\u0430\u0441\u044C
      \u0432\u0441\u0435\u0439 \u0434\u0443\u0448\u043E\u0439\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 28
    richText: "\xAB\u0422\u043E\u043B\u044C\u043A\u043E \u0432\u043E\u0442 \u0432\u0440\u044F\u0434
      \u043B\u0438 \u043E\u043D\u0430 \u043C\u0435\u0447\u0442\u0430\u043B\u0430
      \u043B\u0435\u0447\u0438\u0442\u044C \u0444\u0430\u0448\u0438\u0441\u0442\u043E\u0432.
      \u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u043A\u0430\u043A\u043E\u0432\u043E
      \u0435\u0439 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F?\xBB"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0432\u0437\u0433\u043B\u044F\u0434 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044E\u0441\u044C
      \u043F\u043E \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u0435 \u043A \u043C\u0430\u0441\u0441\u0438\u0432\u043D\u044B\u043C
      \u0434\u0432\u0435\u0440\u044F\u043C \u0438\u0437 \u0442\u0451\u043C\u043D\u043E\u0433\u043E
      \u043E\u0440\u0435\u0445\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u043E \u0435\u0434\u0432\u0430 \u044F \u043F\u0440\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u044E
      \u0440\u0443\u043A\u0443 \u043A \u0440\u0443\u0447\u043A\u0435, \u043C\u043E\u0439
      \u0432\u0437\u0433\u043B\u044F\u0434 \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430\u0435\u0442
      \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u0443 \u0441\u043B\u0443\u0436\u0435\u0431\u043D\u043E\u0433\u043E
      \u0432\u0445\u043E\u0434\u0430: \u043A \u0434\u0440\u0443\u0433\u043E\u0439
      \u0441\u0442\u043E\u0440\u043E\u043D\u0435 \u0437\u0434\u0430\u043D\u0438\u044F
      \u043F\u043E\u0434\u044A\u0435\u0437\u0436\u0430\u0435\u0442 \u043D\u0435\u043C\u0435\u0446\u043A\u0438\u0439
      \u0444\u0443\u0440\u0433\u043E\u043D."
    style: {fileID: 0}
    authorComment: 
