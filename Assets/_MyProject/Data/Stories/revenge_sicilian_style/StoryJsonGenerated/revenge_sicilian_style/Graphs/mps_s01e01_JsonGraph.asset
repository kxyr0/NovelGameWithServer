  exit: {fileID: 0}
  guid: mps_s01e01_l1364_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u043E\u0437\u0434\u0443\u0445 \u043F\u0440\u043E\u043F\u0438\u0442\u0430\u043D
      \u0437\u0430\u043F\u0430\u0445\u043E\u043C \u043F\u044B\u043B\u0438 \u0438
      \u043F\u043E\u0440\u043E\u0445\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043F\u0430\u0434\u0430\u044E \u043D\u0430 \u043A\u043E\u043B\u0435\u043D\u0438
      \u0440\u044F\u0434\u043E\u043C \u0441 \u043D\u0438\u043C, \u043F\u0435\u0440\u0435\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u044E
      \u0442\u044F\u0436\u0451\u043B\u043E\u0435 \u0442\u0435\u043B\u043E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0415\u0433\u043E \u0433\u043B\u0430\u0437\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u044B.
      \u0412 \u043D\u0438\u0445 \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435\u0442
      \u0442\u043E\u0433\u043E \u0442\u0451\u043F\u043B\u043E\u0433\u043E \u0441\u0432\u0435\u0442\u0430,
      \u043A \u043A\u043E\u0442\u043E\u0440\u043E\u043C\u0443 \u044F \u043F\u0440\u0438\u0432\u044B\u043A\u043B\u0430
      \u0441 \u0434\u0435\u0442\u0441\u0442\u0432\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0422\u043E\u043B\u044C\u043A\u043E \u043F\u0443\u0441\u0442\u043E\u0442\u0430
      \u0438 \u043E\u0442\u0440\u0430\u0436\u0435\u043D\u0438\u0435 \u0437\u0432\u0451\u0437\u0434."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 10
    richText: "\u041F\u0430\u043F\u0430\u2026"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0421\u043B\u0451\u0437\u044B"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0428\u0435\u043F\u0447\u0443 \u044F, \u043F\u0440\u0438\u0436\u0438\u043C\u0430\u044F
      \u0435\u0433\u043E \u0433\u043E\u043B\u043E\u0432\u0443 \u043A \u0441\u0435\u0431\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0420\u0443\u043A\u0430 \u043D\u0430\u0449\u0443\u043F\u044B\u0432\u0430\u0435\u0442
      \u0447\u0442\u043E-\u0442\u043E \u043B\u0438\u043F\u043A\u043E\u0435 \u0438
      \u0433\u043E\u0440\u044F\u0447\u0435\u0435."
    style: {fileID: 0}
    authorComment: 
