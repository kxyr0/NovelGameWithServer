    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u0443\u043B\u044B\u0431\u0430\u044E\u0441\u044C, \u0431\u0435\u0440\u044F
      \u0447\u0430\u0448\u043A\u0443 \u043E\u0431\u0435\u0438\u043C\u0438 \u0440\u0443\u043A\u0430\u043C\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041C\u044B \u0441\u0430\u0434\u0438\u043C\u0441\u044F \u0434\u0440\u0443\u0433
      \u043D\u0430\u043F\u0440\u043E\u0442\u0438\u0432 \u0434\u0440\u0443\u0433\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u041E\u0442\u0435\u0446"
    speakerNameHint: "\u041E\u0442\u0435\u0446"
    speaker: {fileID: 11400000, guid: bb87cc9663406034d82c0ff90ef0dfcf, type: 2}
    emotion: 17
    richText: "\u0417\u043D\u0430\u0447\u0438\u0442, \u0433\u043E\u0432\u043E\u0440\u0438\u0448\u044C,
      \u0434\u0435\u043D\u044C \u043F\u0440\u043E\u0448\u0451\u043B \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\u0414\u0430. \u0422\u0430\u043A \u0438 \u0431\u044B\u043B\u043E."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: "\u041E\u0442\u0435\u0446"
    speakerNameHint: "\u041E\u0442\u0435\u0446"
    speaker: {fileID: 11400000, guid: bb87cc9663406034d82c0ff90ef0dfcf, type: 2}
    emotion: 8
    richText: "\u041D\u0438\u043A\u0442\u043E \u043F\u043E\u0434\u043E\u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u043D\u0435 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B? \u041C\u043E\u0436\u0435\u0442
      \u043A\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u0432 \u0447\u0435\u0440\u043D\u043E\u043C?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u0434\u0435\u043B\u0430\u044E \u0433\u043B\u043E\u0442\u043E\u043A,
      \u0441\u0442\u0430\u0432\u044F \u0447\u0430\u0448\u043A\u0443 \u043E\u0431\u0440\u0430\u0442\u043D\u043E
      \u043D\u0430 \u0431\u043B\u044E\u0434\u0446\u0435."
    style: {fileID: 0}
    authorComment: 
