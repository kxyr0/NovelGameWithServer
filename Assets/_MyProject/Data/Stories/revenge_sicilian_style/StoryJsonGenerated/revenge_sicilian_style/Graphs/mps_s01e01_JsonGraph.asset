  guid: mps_s01e01_l0182_banner_01
  message: "\u0421\u0443\u0434\u044C\u0431\u0430 \u0433\u043B\u0430\u0432\u043D\u043E\u0439
    \u0433\u0435\u0440\u043E\u0438\u043D\u0438 \u0440\u0430\u0437\u0432\u0435\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u043D\u0430 \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E \u0442\u0440\u043E\u043F,
    \u0438 \u043A\u0430\u0436\u0434\u0430\u044F \u0438\u0437 \u043D\u0438\u0445 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
    \u0441\u0432\u043E\u0439 \u043E\u0442\u043F\u0435\u0447\u0430\u0442\u043E\u043A
