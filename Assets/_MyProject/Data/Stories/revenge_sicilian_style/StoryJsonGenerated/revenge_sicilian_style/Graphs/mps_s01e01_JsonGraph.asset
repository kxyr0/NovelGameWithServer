  guid: mps_s01e01_l1524_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: 69e1dc9f73c6867468fa7b327cd7565c, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0437\u043E\u043D\u0442\u043E\u043C"
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0437\u043E\u043D\u0442\u043E\u043C
      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F.
      \u0412 \u0435\u0433\u043E \u0433\u043B\u0430\u0437\u0430\u0445 \u043D\u0438
      \u0441\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u044F, \u043D\u0438
      \u0436\u0430\u043B\u043E\u0441\u0442\u0438 \u2014 \u043B\u0438\u0448\u044C
      \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0439 \u0440\u0430\u0441\u0447\u0451\u0442."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0437\u043E\u043D\u0442\u043E\u043C"
    speakerNameHint: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0437\u043E\u043D\u0442\u043E\u043C"
    speaker: {fileID: 11400000, guid: 69e1dc9f73c6867468fa7b327cd7565c, type: 2}
    emotion: 17
    richText: "\u041C\u043E\u0439 \u043A\u043E\u043B\u043B\u0435\u0433\u0430 \u0443\u0436\u0435
      \u0432\u0441\u0451 \u0441\u043A\u0430\u0437\u0430\u043B, \u043E\u0434\u043D\u0430\u043A\u043E
      \u044F \u043F\u043E\u0432\u0442\u043E\u0440\u044E\u0441\u044C."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u0434\u0435\u043B\u0430\u0435\u0442 \u0435\u0434\u0432\u0430
      \u0437\u0430\u043C\u0435\u0442\u043D\u0443\u044E \u043F\u0430\u0443\u0437\u0443,
      \u0441\u043B\u043E\u0432\u043D\u043E \u043F\u043E\u0434\u0431\u0438\u0440\u0430\u044F
      \u0441\u043B\u043E\u0432\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0437\u043E\u043D\u0442\u043E\u043C"
    speakerNameHint: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0437\u043E\u043D\u0442\u043E\u043C"
    speaker: {fileID: 11400000, guid: 69e1dc9f73c6867468fa7b327cd7565c, type: 2}
    emotion: 17
    richText: "\u041C\u044B \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u043B\u0438
      \u0435\u043C\u0443 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C.
      \u041D\u0430\u0434\u0451\u0436\u043D\u0443\u044E \u0437\u0430\u0449\u0438\u0442\u0443
      \u0432 \u043E\u0431\u043C\u0435\u043D \u043D\u0430 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u043F\u0440\u043E\u0446\u0435\u043D\u0442 \u043E\u0442 \u0435\u0433\u043E
      \u043F\u0440\u0438\u0431\u044B\u043B\u0438."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0437\u043E\u043D\u0442\u043E\u043C"
    speakerNameHint: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0437\u043E\u043D\u0442\u043E\u043C"
    speaker: {fileID: 11400000, guid: 69e1dc9f73c6867468fa7b327cd7565c, type: 2}
    emotion: 9
    richText: "\u0412 \u043D\u0430\u0448\u0438 \u0434\u043D\u0438 \u0443\u043B\u0438\u0446\u044B
      \u041F\u0430\u043B\u0435\u0440\u043C\u043E \u043F\u043E\u043B\u043D\u044B...
      \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u044B\u0445 \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u0435\u0439."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0417\u0430\u0434\u0443\u043C\u0447\u0438\u0432\u044B\u0439
      \u0432\u0437\u0433\u043B\u044F\u0434 \u0432\u043F\u0440\u0430\u0432\u043E"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u043E\u0431\u0432\u043E\u0434\u0438\u0442 \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C
      \u043A\u043B\u0430\u0434\u0431\u0438\u0449\u0435\u043D\u0441\u043A\u0443\u044E
      \u0430\u043B\u043B\u0435\u044E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0437\u043E\u043D\u0442\u043E\u043C"
    speakerNameHint: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0437\u043E\u043D\u0442\u043E\u043C"
    speaker: {fileID: 11400000, guid: 69e1dc9f73c6867468fa7b327cd7565c, type: 2}
    emotion: 2
    richText: "\u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u0437\u0430\u0445\u043E\u0447\u0435\u0442,
      \u0447\u0442\u043E\u0431\u044B \u044D\u0442\u0438 \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u0438
      \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E \u0440\u0430\u0437\u0431\u0438\u043B\u0438
      \u0432\u0438\u0442\u0440\u0438\u043D\u0443 \u0432\u0430\u0448\u0435\u0433\u043E
      \u0441\u0430\u043B\u043E\u043D\u0430 \u0438\u043B\u0438, \u0441\u043A\u0430\u0436\u0435\u043C,
      \u043F\u0440\u043E\u044F\u0432\u0438\u043B\u0438 \u0438\u0437\u043B\u0438\u0448\u043D\u0438\u0439
      \u0438\u043D\u0442\u0435\u0440\u0435\u0441 \u043A \u0432\u0430\u0448\u0435\u0439
      Lancia Aprilia."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041B\u0451\u0433\u043A\u0430\u044F \u0443\u043B\u044B\u0431\u043A\u0430"
