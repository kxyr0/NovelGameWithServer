    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u0437\u0430\u043C\u0435\u0447\u0430\u044E, \u043A\u0430\u043A
      \u043E\u043D \u043D\u0435\u0440\u0432\u043D\u043E \u0441\u0443\u0451\u0442
      \u0440\u0443\u043A\u0438 \u0432 \u043A\u0430\u0440\u043C\u0430\u043D\u044B
      \u0448\u0442\u0430\u043D\u043E\u0432, \u0441\u043B\u043E\u0432\u043D\u043E
      \u0447\u0442\u043E-\u0442\u043E \u043B\u0438\u0445\u043E\u0440\u0430\u0434\u043E\u0447\u043D\u043E
      \u0438\u0449\u0435\u0442..."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418 \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u043C\u0438\u0433 \u043F\u043E\u043D\u044F\u043B\u0430: \u044D\u0442\u043E
      \u2014 \u0434\u0435\u043D\u044C\u0433\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 6
    richText: "\xAB\u041E\u043D \u043E\u0442\u0434\u0430\u0451\u0442 \u0435\u0439
      \u0432\u0441\u0435 \u0441\u0432\u043E\u0438 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\xBB."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u0434\u0438\u0432\u043B\u0435\u043D\u0438\u0435"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 32
    richText: "\xAB\u0417\u0430\u0447\u0435\u043C?\xBB"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041F\u0440\u0438\u0449\u0443\u0440"
  - speakerId: "\u0410\u043D\u0442\u043E\u043D\u0438\u043E"
    speakerNameHint: "\u0410\u043D\u0442\u043E\u043D\u0438\u043E"
    speaker: {fileID: 11400000, guid: 0d74ce51fe0a954408fea0cfa1c4bfc8, type: 2}
    emotion: 17
    richText: "\u0412\u043E\u0442. \u042D\u0442\u043E\u0433\u043E \u0434\u043E\u043B\u0436\u043D\u043E
      \u0445\u0432\u0430\u0442\u0438\u0442\u044C."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u043F\u0440\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442
      \u0441\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u0435 \u0432\u043C\u0435\u0441\u0442\u0435
      \u043B\u0430\u0434\u043E\u043D\u0438, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u043B\u0435\u0436\u0430\u0442 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043A\u0443\u043F\u044E\u0440 \u0438 \u043C\u043E\u043D\u0435\u0442."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430 \u0443\u0441\u043C\u0435\u0445\u0430\u0435\u0442\u0441\u044F\u2026"
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speakerNameHint: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speaker: {fileID: 11400000, guid: 7a64daf2d25859d4aab34520bad5552d, type: 2}
    emotion: 8
    richText: "\u041D\u0435\u0433\u0443\u0441\u0442\u043E. \u0411\u0438\u0437\u043D\u0435\u0441
      \u043D\u0435 \u0438\u0434\u0451\u0442?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0432\u0437\u0433\u043B\u044F\u0434"
  - speakerId: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speakerNameHint: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speaker: {fileID: 11400000, guid: 7a64daf2d25859d4aab34520bad5552d, type: 2}
    emotion: 30
    richText: "\u041D\u0430 \u0442\u043E\u0439 \u043D\u0435\u0434\u0435\u043B\u0435
      \u0431\u044B\u043B\u043E \u0431\u043E\u043B\u044C\u0448\u0435."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041B\u0451\u0433\u043A\u043E\u0435 \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u043E"
  - speakerId: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speakerNameHint: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430"
    speaker: {fileID: 11400000, guid: 7a64daf2d25859d4aab34520bad5552d, type: 2}
    emotion: 8
    richText: "\u041C\u043E\u0436\u0435\u0442 \u0432\u0430\u043C \u0441 \u0447\u0435\u043C-\u0442\u043E
      \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u0430 \u043F\u043E\u043C\u043E\u0449\u044C,
      \u0441\u0438\u043D\u044C\u043E\u0440?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0432\u0437\u0433\u043B\u044F\u0434"
