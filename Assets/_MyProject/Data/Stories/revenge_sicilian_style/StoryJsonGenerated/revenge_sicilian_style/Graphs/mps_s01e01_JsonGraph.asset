  guid: mps_s01e01_l1381_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041A\u0440\u043E\u0432\u044C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0434\u0435\u0436\u0434\u0430 \u0442\u0443\u0442 \u0436\u0435
      \u043F\u0440\u043E\u043F\u0438\u0442\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0435\u044E, \u043D\u043E \u043C\u043D\u0435 \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043A\u0430\u0447\u0430\u044E \u0435\u0433\u043E, \u0441\u043B\u043E\u0432\u043D\u043E
      \u0440\u0435\u0431\u0451\u043D\u043A\u0430, \u0445\u043E\u0442\u044F \u0437\u043D\u0430\u044E
      \u2014 \u043E\u043D \u0443\u0436\u0435 \u043D\u0435 \u043E\u0442\u0432\u0435\u0442\u0438\u0442."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u043E\u0441\u0442\u0430\u0432\u0438\u043B \u043C\u0435\u043D\u044F.
      \u041F\u0440\u043E\u0441\u0442\u043E \u0432\u0437\u044F\u043B \u0438 \u0443\u0448\u0451\u043B."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 10
    richText: "\u041F\u043E\u0447\u0435\u043C\u0443?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0421\u043B\u0451\u0437\u044B"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041C\u0430\u0442\u044C... \u043E\u043D\u0430 \u0431\u044B\u043B\u0430
      \u0448\u043B\u044E\u0445\u043E\u0439, \u044D\u0442\u043E \u0441\u043B\u043E\u0432\u043E
      \u0436\u0436\u0451\u0442 \u043C\u0435\u043D\u044F \u0434\u0430\u0436\u0435
      \u0441\u0435\u0439\u0447\u0430\u0441, \u043A\u043E\u0433\u0434\u0430 \u044F
      \u0441\u0438\u0436\u0443 \u0432 \u043B\u0443\u0436\u0435 \u0435\u0433\u043E
      \u043A\u0440\u043E\u0432\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0443\u0448\u043B\u0430, \u0431\u0440\u043E\u0441\u0438\u043B\u0430
      \u043D\u0430\u0441 \u0440\u0430\u0434\u0438 \u043A\u0430\u043A\u043E\u0433\u043E-\u0442\u043E
      \u0430\u043C\u0435\u0440\u0438\u043A\u0430\u043D\u0446\u0430 \u0441 \u0431\u043B\u0435\u0441\u0442\u044F\u0449\u0438\u043C\u0438
      \u0431\u043E\u0442\u0438\u043D\u043A\u0430\u043C\u0438 \u0438 \u043F\u0443\u0441\u0442\u044B\u043C\u0438
      \u043E\u0431\u0435\u0449\u0430\u043D\u0438\u044F\u043C\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043D\u0435\u043D\u0430\u0432\u0438\u0434\u0435\u043B\u0430
      \u0435\u0451 \u0437\u0430 \u044D\u0442\u043E. \u041D\u043E \u043E\u0442\u0435\u0446...
      \u043E\u043D \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u044B\u043B \u0440\u044F\u0434\u043E\u043C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u0431\u044B\u043B \u0441\u043A\u0430\u043B\u043E\u0439,
      \u0441\u0442\u0435\u043D\u043E\u0439, \u0437\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u0439
      \u043C\u043E\u0436\u043D\u043E \u0441\u043F\u0440\u044F\u0442\u0430\u0442\u044C\u0441\u044F
      \u043E\u0442 \u0432\u0441\u0435\u0433\u043E \u043C\u0438\u0440\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0422\u0430\u043A \u043F\u043E\u0447\u0435\u043C\u0443 \u0436\u0435
      \u043E\u043D \u0442\u043E\u0436\u0435 \u0443\u0448\u0451\u043B?"
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u043E\u0447\u0435\u043C\u0443 \u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u043C\u0435\u043D\u044F \u043E\u0434\u043D\u0443 \u043D\u0430 \u044D\u0442\u043E\u0439
      \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u043E\u0439 \u0437\u0435\u043C\u043B\u0435?"
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u043B, \u0447\u0442\u043E
      \u0432\u0441\u0451 \u043D\u0430\u043B\u0430\u0434\u0438\u0442\u0441\u044F,
      \u0447\u0442\u043E \u043C\u044B \u0441\u043F\u0440\u0430\u0432\u0438\u043C\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
