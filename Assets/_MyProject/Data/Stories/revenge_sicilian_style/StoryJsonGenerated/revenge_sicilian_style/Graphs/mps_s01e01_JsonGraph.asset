  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: mps_s01e01_l0296_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters: []
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u0438\u0434\u0443 \u043F\u043E \u0443\u0437\u043A\u0438\u043C
      \u0443\u043B\u043E\u0447\u043A\u0430\u043C \u041F\u0430\u043B\u0435\u0440\u043C\u043E,
      \u0433\u0434\u0435 \u0432\u043E\u0437\u0434\u0443\u0445 \u043F\u0440\u043E\u043F\u0438\u0442\u0430\u043D
      \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u043C\u043E\u0440\u0441\u043A\u0438\u043C
      \u0431\u0440\u0438\u0437\u043E\u043C, \u043D\u043E \u0438 \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u0435\u043C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u043E\u043B\u043D\u0446\u0435, \u043A\u0430\u043A \u0432\u0441\u0435\u0433\u0434\u0430,
      \u0449\u0435\u0434\u0440\u043E \u0437\u0430\u043B\u0438\u0432\u0430\u0435\u0442
      \u0441\u0432\u0435\u0442\u043E\u043C \u0442\u0435\u0440\u0440\u0430\u043A\u043E\u0442\u043E\u0432\u044B\u0435
      \u043A\u0440\u044B\u0448\u0438 \u0438 \u0441\u0442\u0430\u0440\u0438\u043D\u043D\u044B\u0435
      \u0446\u0435\u0440\u043A\u0432\u0438, \u043D\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u0434\u0430\u0436\u0435 \u043E\u043D\u043E \u043D\u0435 \u043C\u043E\u0436\u0435\u0442
      \u0440\u0430\u0437\u0432\u0435\u044F\u0442\u044C \u0442\u044F\u0436\u0435\u043B\u0443\u044E
      \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0443, \u043D\u0430\u0432\u0438\u0441\u0448\u0443\u044E
      \u043D\u0430\u0434 \u043E\u0441\u0442\u0440\u043E\u0432\u043E\u043C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u0430 \u043A\u0430\u0436\u0434\u043E\u043C \u0443\u0433\u043B\u0443
      \u2014 \u0447\u0451\u0440\u043D\u044B\u0435 \u0440\u0443\u0431\u0430\u0448\u043A\u0438,
      \u0441\u0442\u0440\u043E\u0433\u0438\u0435 \u0432\u0437\u0433\u043B\u044F\u0434\u044B,
      \u043C\u0430\u0440\u0448\u0438\u0440\u0443\u044E\u0449\u0438\u0435 \u043A\u043E\u043B\u043E\u043D\u043D\u044B."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u0430\u0446\u0438\u0441\u0442\u0441\u043A\u0438\u0435 \u0444\u043B\u0430\u0433\u0438
      \u0440\u0430\u0437\u0432\u0435\u0432\u0430\u044E\u0442\u0441\u044F \u043D\u0430
      \u0432\u0435\u0442\u0440\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u0445 \u043A\u0440\u0430\u0441\u043D\u044B\u0435 \u043F\u043E\u043B\u043E\u0442\u043D\u0438\u0449\u0430
      \u0441 \u0444\u0430\u0441\u0446\u0438\u044F\u043C\u0438 \u043A\u0430\u0436\u0443\u0442\u0441\u044F
      \u043C\u043D\u0435 \u0445\u0438\u0449\u043D\u044B\u043C\u0438 \u043F\u0442\u0438\u0446\u0430\u043C\u0438,
      \u0433\u043E\u0442\u043E\u0432\u044B\u043C\u0438 \u0432 \u043B\u044E\u0431\u043E\u0439
      \u043C\u043E\u043C\u0435\u043D\u0442 \u0441\u043E\u0440\u0432\u0430\u0442\u044C\u0441\u044F
      \u0441 \u0434\u0440\u0435\u0432\u043A\u043E\u0432."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u0441\u0442\u0430\u0440\u0430\u044E\u0441\u044C \u043D\u0435
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0442\u044C \u0433\u043B\u0430\u0437,
      \u043D\u043E \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u0437\u0430\u043C\u0435\u0447\u0430\u044E:
      \u043D\u0430 \u0441\u0442\u0435\u043D\u0430\u0445 \u0434\u043E\u043C\u043E\u0432
      - \u043F\u043B\u0430\u043A\u0430\u0442\u044B \u0441 \u043F\u043E\u0440\u0442\u0440\u0435\u0442\u043E\u043C
      \u041C\u0443\u0441\u0441\u043E\u043B\u0438\u043D\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0415\u0433\u043E \u0432\u0437\u0433\u043B\u044F\u0434 \u0441\u043B\u0435\u0434\u0438\u0442
      \u0437\u0430 \u043A\u0430\u0436\u0434\u044B\u043C \u043F\u0440\u043E\u0445\u043E\u0436\u0438\u043C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412 \u0432\u043E\u0437\u0434\u0443\u0445\u0435 \u0441\u043B\u044B\u0448\u0438\u0442\u0441\u044F
      \u0440\u0435\u0437\u043A\u0438\u0439 \u0437\u0432\u0443\u043A \u043A\u043E\u043C\u0430\u043D\u0434,
      \u0442\u043E\u043F\u043E\u0442 \u0441\u0430\u043F\u043E\u0433 \u043F\u043E
      \u0431\u0440\u0443\u0441\u0447\u0430\u0442\u043A\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u043D\u043E\u0433\u0434\u0430 \u043C\u0438\u043C\u043E \u043F\u0440\u043E\u0435\u0437\u0436\u0430\u044E\u0442
      \u0433\u0440\u0443\u0437\u043E\u0432\u0438\u043A\u0438 \u0441 \u0441\u043E\u043B\u0434\u0430\u0442\u0430\u043C\u0438,
      \u0438 \u0442\u043E\u0433\u0434\u0430 \u0443\u043B\u0438\u0446\u0430 \u0437\u0430\u043C\u0438\u0440\u0430\u0435\u0442
      \u2014 \u043B\u044E\u0434\u0438 \u0442\u043E\u0440\u043E\u043F\u043B\u0438\u0432\u043E
      \u0443\u0441\u0442\u0443\u043F\u0430\u044E\u0442 \u0434\u043E\u0440\u043E\u0433\u0443,
      \u043F\u0440\u044F\u0447\u0430 \u043B\u0438\u0446\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u043E \u0421\u0438\u0446\u0438\u043B\u0438\u044F \u043D\u0435
      \u0441\u0434\u0430\u0441\u0442\u0441\u044F \u0442\u0430\u043A \u043F\u0440\u043E\u0441\u0442\u043E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0417\u0430 \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u043C\u0438
      \u0441\u0442\u0430\u0432\u043D\u044F\u043C\u0438 \u0441\u043B\u044B\u0448\u0438\u0442\u0441\u044F
      \u0448\u0451\u043F\u043E\u0442, \u0432 \u0442\u0435\u043D\u0438 \u043F\u0435\u0440\u0435\u0443\u043B\u043A\u043E\u0432
      \u043C\u0435\u043B\u044C\u043A\u0430\u044E\u0442 \u0431\u044B\u0441\u0442\u0440\u044B\u0435
      \u0432\u0437\u0433\u043B\u044F\u0434\u044B."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u0442\u0430\u0440\u0438\u043A\u0438, \u0441\u0438\u0434\u044F\u0449\u0438\u0435
      \u0443 \u0434\u0432\u0435\u0440\u0435\u0439 \u0434\u043E\u043C\u043E\u0432,
      \u043F\u0440\u043E\u0432\u043E\u0436\u0430\u044E\u0442 \u0441\u043E\u043B\u0434\u0430\u0442
      \u0442\u044F\u0436\u0451\u043B\u044B\u043C\u0438, \u043F\u043E\u043B\u043D\u044B\u043C\u0438
      \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0439 \u0433\u043B\u0430\u0437\u0430\u043C\u0438."
    style: {fileID: 0}
    authorComment: 
