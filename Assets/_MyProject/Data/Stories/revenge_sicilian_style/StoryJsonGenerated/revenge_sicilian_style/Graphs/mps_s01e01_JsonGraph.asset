    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0438 \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u044E\u0442\u0441\u044F
      \u0438, \u043D\u0435 \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044F\u0441\u044C,
      \u0443\u0445\u043E\u0434\u044F\u0442 \u043F\u0440\u043E\u0447\u044C \u043F\u043E
      \u043C\u043E\u043A\u0440\u043E\u0439 \u0430\u043B\u043B\u0435\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u0445 \u0448\u0430\u0433\u0438 \u0432\u0441\u043A\u043E\u0440\u0435
      \u0441\u0442\u0438\u0445\u0430\u044E\u0442 \u0437\u0430 \u0448\u0443\u043C\u043E\u043C
      \u0434\u043E\u0436\u0434\u044F."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043E\u0441\u0442\u0430\u044E\u0441\u044C \u043E\u0434\u043D\u0430,
      \u0441\u0436\u0438\u043C\u0430\u044F \u0432 \u0440\u0443\u043A\u0435 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439
      \u043A\u0430\u0440\u0442\u043E\u043D\u043D\u044B\u0439 \u043F\u0440\u044F\u043C\u043E\u0443\u0433\u043E\u043B\u044C\u043D\u0438\u043A."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u0430\u043B\u044C\u0446\u044B \u0441\u043A\u043E\u043B\u044C\u0437\u044F\u0442
      \u043F\u043E \u0433\u043B\u0430\u0434\u043A\u043E\u0439 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438.
      \u0412\u043D\u0435\u0437\u0430\u043F\u043D\u043E \u0447\u0442\u043E-\u0442\u043E
      \u0437\u0430\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043C\u0435\u043D\u044F
      \u043E\u0431\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 30
    richText: "\u0412\u044B \u0442\u0430\u043A \u0438 \u043D\u0435 \u043E\u0442\u0432\u0435\u0442\u0438\u043B\u0438
      \u043C\u043D\u0435, \u043A\u0442\u043E \u0432\u044B \u0442\u0430\u043A\u0438\u0435."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u0430\u044F"
