  guid: mps_s01e01_l1232_dialogue_01
  nodeTitle: "\u0414\u0438\u0430\u043B\u043E\u0433"
  activeCharacters:
  - character: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  - character: {fileID: 11400000, guid: bb87cc9663406034d82c0ff90ef0dfcf, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: "\u041E\u0442\u0435\u0446"
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u0441\u0442\u0430\u0432\u043B\u044E \u0447\u0430\u0448\u043A\u0443
      \u0441 \u0431\u043B\u044E\u0434\u0446\u0435\u043C \u043D\u0430 \u0441\u0442\u043E\u043B\u0438\u043A,
      \u0440\u044F\u0434\u043E\u043C \u0441 \u0433\u0430\u0437\u0435\u0442\u043E\u0439."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u0441\u0442\u0430\u044E \u0438 \u0441 \u0443\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0438\u0435\u043C
      \u043F\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u044E\u0441\u044C, \u043C\u0438\u043C\u043E\u0445\u043E\u0434\u043E\u043C
      \u043F\u043E\u0433\u043B\u0430\u0434\u0438\u0432 \u043A\u043E\u0442\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 28
    richText: "\u041D\u0435\u0442, \u0430\u043F\u043F\u0435\u0442\u0438\u0442 \u044F,
      \u0432\u0438\u0434\u0438\u043C\u043E, \u043D\u0435 \u043D\u0430\u0433\u0443\u043B\u044F\u043B\u0430."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u0437\u0433\u043B\u044F\u0434 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443"
  - speakerId: "\u041E\u0442\u0435\u0446"
    speakerNameHint: "\u041E\u0442\u0435\u0446"
    speaker: {fileID: 11400000, guid: bb87cc9663406034d82c0ff90ef0dfcf, type: 2}
    emotion: 8
    richText: "\u0422\u044B \u0448\u043B\u0430 \u0434\u043E\u043C\u043E\u0439 \u043F\u0435\u0448\u043A\u043E\u043C?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0412\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 2
    richText: "\u0414\u0430. \u042F \u0437\u0430\u0445\u043E\u0434\u0438\u043B\u0430
      \u043A \u0410\u043D\u0442\u043E\u043D\u0438\u043E \u0438 \u0414\u0436\u0443\u043B\u0438\u0438."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 17
    richText: "\u041C\u044B \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438,
      \u0438 \u044F \u0441\u0440\u0430\u0437\u0443 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0430\u0441\u044C
      \u0434\u043E\u043C\u043E\u0439."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u044C"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043A\u0438\u0432\u0430\u044E \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      \u0441\u0442\u043E\u043B\u0438\u043A\u0430, \u0433\u0434\u0435 \u043B\u0435\u0436\u0438\u0442
      \u0441\u0432\u0435\u0436\u0430\u044F \u0433\u0430\u0437\u0435\u0442\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: "\u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430"
    speaker: {fileID: 11400000, guid: eed10ce864a9890488ad8bfa0c24e544, type: 2}
    emotion: 2
    richText: "\u0412\u043E\u0442, \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u0430
      \u043D\u043E\u0432\u044B\u0435 \u0441\u043F\u043B\u0435\u0442\u043D\u0438.
      \u0423 \u0414\u0436\u0443\u043B\u0438\u0438 \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F
      \u043D\u0435\u043C\u0435\u0446\u043A\u0438\u0439 \u043A\u0430\u0432\u0430\u043B\u0435\u0440."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u043B\u044B\u0431\u043A\u0430"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0442\u0435\u0446 \u0443\u0441\u0442\u0430\u043B\u043E \u043E\u0442\u043A\u0438\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0441\u043F\u0438\u043D\u043A\u0443, \u0437\u0430\u043A\u0438\u0434\u044B\u0432\u0430\u0435\u0442
      \u043D\u043E\u0433\u0443 \u043D\u0430 \u043D\u043E\u0433\u0443 \u0438, \u0443\u043B\u044B\u0431\u0430\u044F\u0441\u044C,
      \u0434\u0435\u043B\u0430\u0435\u0442 \u0433\u043B\u043E\u0442\u043E\u043A \u0447\u0430\u044F."
    style: {fileID: 0}
    authorComment: 
  - speakerId: "\u041E\u0442\u0435\u0446"
    speakerNameHint: "\u041E\u0442\u0435\u0446"
    speaker: {fileID: 11400000, guid: bb87cc9663406034d82c0ff90ef0dfcf, type: 2}
    emotion: 6
    richText: "\u041D\u0430\u0446\u0438\u0441\u0442."
    style: {fileID: 0}
    authorComment: "Ink emotion: \u0423\u0434\u0438\u0432\u043B\u0435\u043D\u0438\u0435"
  - speakerId: "\u041E\u0442\u0435\u0446"
    speakerNameHint: "\u041E\u0442\u0435\u0446"
    speaker: {fileID: 11400000, guid: bb87cc9663406034d82c0ff90ef0dfcf, type: 2}
    emotion: 30
    richText: "\u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0442\u044B \u043F\u043E\u0441\u043E\u0432\u0435\u0442\u043E\u0432\u0430\u043B\u0430
      \u0435\u0439 \u0434\u0435\u0440\u0436\u0430\u0442\u044C\u0441\u044F \u043E\u0442
      \u043D\u0435\u0433\u043E \u043F\u043E\u0434\u0430\u043B\u044C\u0448\u0435?"
    style: {fileID: 0}
    authorComment: "Ink emotion: \u041D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u043E"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u042F \u043F\u043E\u0434\u0445\u043E\u0436\u0443 \u043A \u043A\u043D\u0438\u0436\u043D\u044B\u043C
      \u043F\u043E\u043B\u043A\u0430\u043C \u0438 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u043F\u0440\u043E\u0432\u043E\u0436\u0443 \u043A\u043E\u043D\u0447\u0438\u043A\u0430\u043C\u0438
      \u043F\u0430\u043B\u044C\u0446\u0435\u0432 \u043F\u043E \u043F\u043E\u0442\u0451\u0440\u0442\u044B\u043C
      \u043A\u043E\u0440\u0435\u0448\u043A\u0430\u043C."
    style: {fileID: 0}
    authorComment: 
