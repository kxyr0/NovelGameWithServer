  _gameName: "\u041C\u0435\u0441\u0442\u044C \u043F\u043E-\u0441\u0438\u0446\u0438\u043B\u0438\u0439\u0441\u043A\u0438"
  _genreText: "\u0414\u0440\u0430\u043C\u0430"
  _description: "\u0427\u0442\u043E\u0431\u044B \u043E\u0442\u043E\u043C\u0441\u0442\u0438\u0442\u044C
    \u0437\u0430 \u043E\u0442\u0446\u0430, \u0441\u0438\u0446\u0438\u043B\u0438\u0439\u0441\u043A\u0430\u044F
    \u043D\u0430\u0441\u043B\u0435\u0434\u043D\u0438\u0446\u0430 \u042D\u043B\u0435\u043C\u0435\u043D\u0442\u0438\u043D\u0430
    \u0432\u043D\u0435\u0434\u0440\u044F\u0435\u0442\u0441\u044F \u0432 \u041A\u043E\u0437\u0430
    \u041D\u043E\u0441\u0442\u0440\u0443 \u043F\u043E\u0434 \u043D\u043E\u0441\u043E\u043C
    \u0443 \u041C\u0443\u0441\u0441\u043E\u043B\u0438\u043D\u0438, \u0440\u0438\u0441\u043A\u0443\u044F
    \u0432\u0441\u0435\u043C, \u0447\u0442\u043E\u0431\u044B \u0440\u0435\u0448\u0438\u0442\u044C:
    \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u0442\u044C \u043C\u0430\u0444\u0438\u044E
    \u0438\u043B\u0438 \u0435\u0451 \u0432\u043E\u0437\u0433\u043B\u0430\u0432\u0438\u0442\u044C."
