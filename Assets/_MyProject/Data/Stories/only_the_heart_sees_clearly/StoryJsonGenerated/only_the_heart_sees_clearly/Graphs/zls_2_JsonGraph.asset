  guid: zls2_dialogue_011_warning_fairytale
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: d39beffe2615479bb3fa69a643c5e1f7, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: teta_galya
  lines:
  - speakerId: teta_galya
    speakerNameHint: "\u0422\u0451\u0442\u044F \u0413\u0430\u043B\u044F"
    speaker: {fileID: 11400000, guid: d39beffe2615479bb3fa69a643c5e1f7, type: 2}
    emotion: 2
    richText: "\u0414\u0430 \u043F\u0443\u0441\u0442\u044F\u043A\u0438. \u0413\u043E\u0432\u043E\u0440\u044F\u0442,
      \u043A\u0442\u043E-\u0442\u043E \u0448\u0443\u043C\u0435\u043B \u0443 \u0440\u0435\u043A\u0438,
      \u043F\u044C\u044F\u043D\u0441\u0442\u0432\u043E\u0432\u0430\u043B \u0442\u0430\u043C,
      \u0433\u0434\u0435 \u043D\u0435 \u0434\u043E\u043B\u0436\u043D\u043E - \u043B\u0435\u0442\u043E,
      \u0448\u0430\u0448\u043B\u044B\u043A\u0438 \u0436\u0435\u2026 \u0412\u043E\u0442
      \u0438 \u0432\u043E\u0437\u043C\u0443\u0442\u0438\u043B\u0430\u0441\u044C,
      \u043C\u043E\u043B, \u043F\u043E\u043A\u043E\u044F \u043D\u0435 \u0434\u0430\u044E\u0442."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u0442\u0430\u0440\u0443\u0448\u043A\u0430 \u043A\u0430\u0447\u0430\u0435\u0442
      \u0433\u043E\u043B\u043E\u0432\u043E\u0439. {playerName} \u043B\u0438\u0448\u044C
      \u043F\u043E\u0436\u0438\u043C\u0430\u0435\u0442 \u043F\u043B\u0435\u0447\u0430\u043C\u0438."
    style: {fileID: 0}
    authorComment: 
