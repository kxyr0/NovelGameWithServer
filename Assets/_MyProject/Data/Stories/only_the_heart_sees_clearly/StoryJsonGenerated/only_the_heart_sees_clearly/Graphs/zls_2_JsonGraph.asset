    richText: "\u041E\u043D\u0430 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u0435\u0433\u043E \u0441\u043C\u0435\u0445, \u0437\u0430\u043F\u0430\u0445
      \u0435\u0433\u043E \u043F\u0430\u0440\u0444\u044E\u043C\u0430, \u0442\u043E,
      \u043A\u0430\u043A \u043E\u043D \u0448\u0435\u043F\u0447\u0435\u0442 \u043A\u043E\u043C\u0443-\u0442\u043E
      \u0434\u0440\u0443\u0433\u043E\u043C\u0443 \u0442\u0435 \u0436\u0435 \u0441\u043B\u043E\u0432\u0430,
      \u0447\u0442\u043E \u043A\u043E\u0433\u0434\u0430-\u0442\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u043B
      \u0435\u0439."
