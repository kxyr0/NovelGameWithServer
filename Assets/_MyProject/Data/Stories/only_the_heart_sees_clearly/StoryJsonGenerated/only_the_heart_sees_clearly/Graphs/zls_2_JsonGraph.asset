  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: zls2_dialogue_012_rhyme_market
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 20
    position: 0
    speakerNameHint: hero
  - character: {fileID: 11400000, guid: 986b87b8b26944e9b0390c6979bdb391, type: 2}
    emotion: 0
    position: 1
    speakerNameHint: girl_1
  - character: {fileID: 11400000, guid: b27ea0cd50da4d35ae5a312ad98d8ff5, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: girl_2
  lines:
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 20
    richText: "\u0427\u0435\u0433\u043E \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0435
      \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u044E\u0442 \u043E\u0442 \u0441\u043A\u0443\u043A\u0438\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u0437\u044F\u0432 \u043F\u0430\u043A\u0435\u0442\u044B, \u043E\u043D\u0430
      \u043D\u0435 \u0443\u0441\u043F\u0435\u0432\u0430\u0435\u0442 \u0441\u0434\u0435\u043B\u0430\u0442\u044C
      \u0438 \u0448\u0430\u0433\u0430, \u043A\u0430\u043A \u0435\u0451 \u0441\u043B\u043E\u0432\u043D\u043E
      \u043E\u043A\u0430\u0442\u044B\u0432\u0430\u0435\u0442 \u0445\u043E\u043B\u043E\u0434\u043E\u043C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 986b87b8b26944e9b0390c6979bdb391, type: 2}
    emotion: 0
    richText: "\u041C\u0430\u0432\u043A\u0430 \u043C\u043E\u0435\u0442 \u0431\u0435\u0440\u0435\u0433\u0430,
      \u0432\u044B\u043C\u044B\u0432\u0430\u0435\u0442 \u0438\u043C\u0435\u043D\u0430."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: b27ea0cd50da4d35ae5a312ad98d8ff5, type: 2}
    emotion: 0
    richText: "\u041D\u0430 \u043C\u043E\u0441\u0442\u043E\u0447\u043A\u0435, \u0443
      \u0432\u043E\u0434\u044B, \u0441\u0438\u0434\u044F\u0442 \u043C\u0451\u0440\u0442\u0432\u044B\u0435
      \u0441\u0430\u0434\u044B."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u043C\u043E\u0440\u0433\u0430\u0435\u0442 \u0438 \u0440\u0435\u0437\u043A\u043E
      \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0437\u0432\u0443\u043A - \u0434\u0432\u0435 \u0434\u0435\u0432\u0447\u0443\u0448\u043A\u0438
      \u043B\u0435\u0442 \u043F\u044F\u0442\u0438 \u0432\u0435\u0441\u0435\u043B\u043E
      \u043F\u043E\u044E\u0442 \u0441\u0442\u0440\u0430\u043D\u043D\u0443\u044E \u0441\u0447\u0438\u0442\u0430\u043B\u043E\u0447\u043A\u0443,
      \u043F\u0440\u044B\u0433\u0430\u044F \u0447\u0435\u0440\u0435\u0437 \u0441\u043A\u0430\u043A\u0430\u043B\u043A\u0443."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 986b87b8b26944e9b0390c6979bdb391, type: 2}
    emotion: 2
    richText: "\u041A\u0442\u043E \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442
      - \u043D\u0435 \u043C\u043E\u0440\u0433\u043D\u0438. \u041A\u0442\u043E \u0443\u0441\u043B\u044B\u0448\u0438\u0442
      - \u043D\u0435 \u0437\u043E\u0432\u0438. \u0423 \u0432\u043E\u0434\u044B \u0441\u0438\u0434\u0438\u0442
      \u043E\u043D\u0430. \u041A\u0442\u043E \u043E\u0442\u0432\u0435\u0442\u0438\u0442
      - \u043D\u0435\u0442 \u0441\u043B\u0435\u0434\u0430."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442,
      \u043A\u0430\u043A \u043D\u0430 \u0437\u0430\u0442\u044B\u043B\u043A\u0435
      \u0448\u0435\u0432\u0435\u043B\u044F\u0442\u0441\u044F \u043C\u0435\u043B\u043A\u0438\u0435
      \u0432\u043E\u043B\u043E\u0441\u043A\u0438. \u042D\u0442\u043E \u043D\u0435
      \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u0447\u0438\u0442\u0430\u043B\u043E\u0447\u043A\u0430
      - \u044D\u0442\u043E \u0442\u043E\u0447\u043D\u044B\u0439 \u0442\u0435\u043A\u0441\u0442
      \u0438\u0437 \u0435\u0451 \u0441\u0435\u0433\u043E\u0434\u043D\u044F\u0448\u043D\u0435\u0433\u043E
      \u043F\u0443\u0433\u0430\u044E\u0449\u0435\u0433\u043E \u0441\u043D\u0430."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 986b87b8b26944e9b0390c6979bdb391, type: 2}
    emotion: 2
    richText: "\u041D\u0443 \u0432\u043E\u0442, \u0442\u044B \u0432\u043E\u0434\u0438\u0448\u044C!
      \u0421\u0447\u0438\u0442\u0430\u0439!"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0415\u0451 \u043F\u043E\u0434\u0440\u0443\u0436\u043A\u0430 \u043E\u0442\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F,
      \u0430 \u043E\u043D\u0430 \u0441\u0430\u043C\u0430 \u0443\u0431\u0435\u0433\u0430\u0435\u0442
      \u043F\u0440\u043E\u0447\u044C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u043E \u0448\u0435\u0435 {playerName} \u043F\u043E\u043B\u0437\u0435\u0442
      \u043B\u0438\u043F\u043A\u0438\u0439 \u0436\u0430\u0440."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 9
    richText: "\u041D\u0443 \u0432\u043E\u0442, \u043E\u0431\u044B\u0447\u043D\u0430\u044F
      \u0434\u0435\u0442\u0441\u043A\u0430\u044F \u0441\u0447\u0438\u0442\u0430\u043B\u043E\u0447\u043A\u0430."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0423\u0431\u0435\u0436\u0434\u0430\u0435\u0442 \u0441\u0435\u0431\u044F
      \u043E\u043D\u0430, \u043F\u044B\u0442\u0430\u044F\u0441\u044C \u0437\u0430\u0437\u0435\u043C\u043B\u0438\u0442\u044C\u0441\u044F
      \u0438 \u0443\u0441\u043F\u043E\u043A\u043E\u0438\u0442\u044C\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 9
    richText: "\u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u0443\u0441\u043B\u044B\u0448\u0430\u043B\u0430
      \u0433\u0434\u0435-\u043D\u0438\u0431\u0443\u0434\u044C, \u043A\u043E\u0433\u0434\u0430
      \u0448\u043B\u0430 \u043E\u0442 \u0441\u0442\u0430\u043D\u0446\u0438\u0438,
      \u0438 \u043C\u043E\u0437\u0433 \u043F\u0440\u043E\u0441\u0442\u043E \u0432\u044B\u0434\u0430\u043B
      \u044D\u0442\u043E \u0432\u043E \u0441\u043D\u0435\u2026 \u0414\u0430. \u042D\u0442\u043E
      \u043B\u043E\u0433\u0438\u0447\u043D\u043E. \u0411\u0435\u0441\u0441\u043E\u0437\u043D\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0435
      - \u0448\u0442\u0443\u043A\u0430 \u0441\u043B\u043E\u0436\u043D\u0430\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 9
    richText: "\u0427\u0443\u0440 \u043C\u0435\u043D\u044F\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0413\u043E\u0432\u043E\u0440\u0438\u0442 \u043D\u0430 \u0432\u0441\u044F\u043A\u0438\u0439
      \u0441\u043B\u0443\u0447\u0430\u0439, \u043F\u043E\u0447\u0442\u0438 \u0448\u0435\u043F\u043E\u0442\u043E\u043C,
      \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E \u0441\u0442\u044B\u0434\u0438\u0442\u0441\u044F.
      \u041D\u0430 \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435 \u0441\u0442\u044B\u0434\u0438\u0442\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
