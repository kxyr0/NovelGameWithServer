  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: zls2_dialogue_015_market_after_condition
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u0441\u0442\u0430\u0440\u0430\u0435\u0442\u0441\u044F
      \u043E\u0442\u043C\u0430\u0445\u043D\u0443\u0442\u044C\u0441\u044F \u043E\u0442
      \u0434\u0435\u0442\u0441\u043A\u0438\u0445 \u0433\u043E\u043B\u043E\u0441\u043E\u0432,
      \u043D\u043E \u0432\u043D\u0443\u0442\u0440\u0438 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u0441\u043B\u0430\u0431\u043E\u0435 \u044D\u0445\u043E - \u043D\u0435\u043C\u0443\u0434\u0440\u0435\u043D\u044B\u0435
      \u0441\u043B\u043E\u0432\u0430 \u0441\u043B\u043E\u0432\u043D\u043E \u043F\u0440\u043E\u043D\u0438\u043A\u043B\u0438
      \u043F\u043E\u0434 \u043A\u043E\u0436\u0443."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E
      \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u043F\u043E
      \u0441\u0442\u043E\u0440\u043E\u043D\u0430\u043C. \u0420\u044B\u043D\u043E\u043A
      \u0442\u043E\u0442 \u0436\u0435, \u043B\u044E\u0434\u0438 \u0442\u0435 \u0436\u0435,
      \u043D\u043E \u043D\u0430 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0435
      \u0435\u0439 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C,
      \u0447\u0442\u043E \u0432\u0441\u0451 - \u043D\u0435 \u0442\u0430\u043A\u043E\u0435,
      \u043A\u0430\u043A\u0438\u043C \u0432\u0438\u0434\u0438\u0442\u0441\u044F.
      \u0418\u043B\u0438 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u0430\u043A\u043E\u0435."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0422\u0451\u0442\u044F \u0413\u0430\u043B\u044F \u0441\u043C\u0435\u0451\u0442\u0441\u044F,
      \u0431\u043E\u043B\u0442\u0430\u044F \u0441 \u043E\u0447\u0435\u0440\u0435\u0434\u043D\u043E\u0439
      \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u044C\u043D\u0438\u0446\u0435\u0439,
      \u0438 {playerName} \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u0435\u0435."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 17
    richText: "\u0421\u0430\u043C\u0430 \u0441\u0435\u0431\u044F \u043D\u0430\u043A\u0440\u0443\u0442\u0438\u043B\u0430\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0440\u044B\u043D\u043A\u0435 \u0435\u0449\u0435 \u043D\u0435\u043C\u043D\u043E\u0433\u043E."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u0440\u043E\u0445\u0430\u0436\u0438\u0432\u0430\u044F\u0441\u044C
      \u043C\u0435\u0436\u0434\u0443 \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u043C\u0438
      \u0440\u044F\u0434\u0430\u043C\u0438, \u043E\u043D\u0430 \u043B\u043E\u0432\u0438\u0442
      \u043D\u0430 \u0441\u0435\u0431\u0435 \u0447\u0443\u0436\u0438\u0435 \u0432\u0437\u0433\u043B\u044F\u0434\u044B."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 28
    richText: "\u0412 \u0433\u043E\u0440\u043E\u0434\u0435 \u0434\u043E \u0442\u0435\u0431\u044F
      \u043D\u0438\u043A\u043E\u043C\u0443 \u043D\u0435\u0442 \u0434\u0435\u043B\u0430.
      \u0417\u0434\u0435\u0441\u044C \u0436\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0448\u044C
      \u0441\u0435\u0431\u044F \u0437\u0430\u043C\u043E\u0440\u0441\u043A\u043E\u0439
      \u0437\u0432\u0435\u0440\u044E\u0448\u043A\u043E\u0439, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u0443\u044E
      \u043A\u0430\u0436\u0434\u043E\u043C\u0443 \u0445\u043E\u0447\u0435\u0442\u0441\u044F
      \u043F\u043E\u0433\u043B\u0430\u0437\u0435\u0442\u044C\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0434\u0435\u043B\u0430\u0435\u0442 \u0432\u0438\u0434,
      \u0447\u0442\u043E \u043D\u0435 \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442
      \u043D\u0430 \u044D\u0442\u043E \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F,
      \u043D\u043E \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435 \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044F,
      \u043A\u043E\u0433\u0434\u0430 \u0441\u043B\u044B\u0448\u0438\u0442, \u043A\u0430\u043A
      \u0434\u0432\u0435 \u0436\u0435\u043D\u0449\u0438\u043D\u044B \u043F\u0435\u0440\u0435\u0448\u0435\u043F\u0442\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u043E \u043D\u0435\u0439, \u043F\u043E\u0441\u043C\u0435\u0438\u0432\u0430\u044F\u0441\u044C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0425\u043E\u0447\u0435\u0442\u0441\u044F \u043E\u0441\u0430\u0434\u0438\u0442\u044C.
      \u0421\u043A\u0430\u0437\u0430\u0442\u044C \xAB\u0432\u0430\u043C-\u0442\u043E
      \u043A\u0430\u043A\u043E\u0435 \u0434\u043E \u043C\u0435\u043D\u044F \u0434\u0435\u043B\u043E?\xBB"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u043E \u043E\u043D\u0430 \u043C\u043E\u043B\u0447\u0438\u0442,
      \u043D\u0435 \u0436\u0435\u043B\u0430\u044F \u0434\u0430\u0432\u0430\u0442\u044C
      \u0438\u043C \u043F\u043E\u0432\u043E\u0434 \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u0441\u0443\u0434\u043E\u0432"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u0441\u043A\u043E\u0440\u0435 \u0435\u0451 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435
      \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430\u0435\u0442 \u043F\u0440\u0438\u043B\u0430\u0432\u043E\u043A
      \u0441 \u0443\u043A\u0440\u0430\u0448\u0435\u043D\u0438\u044F\u043C\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 9
    richText: "\u041A\u0430\u043A \u0445\u043E\u0440\u043E\u0448\u043E, \u0447\u0442\u043E
      \u044F \u0432\u0437\u044F\u043B\u0430 \u0441 \u0441\u043E\u0431\u043E\u0439
      \u043D\u0430\u043B\u0438\u0447\u043A\u0443\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0440\u0435\u0448\u0430\u0435\u0442 \u043A\u0443\u043F\u0438\u0442\u044C\u2026"
    style: {fileID: 0}
    authorComment: 
