  guid: zls2_dialogue_004_dream_dismiss
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 20
    richText: "\u0412\u0438\u0434\u0438\u043C\u043E, \u044F \u043E\u0447\u0435\u043D\u044C
      \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F.
      \u041D\u0430\u0441\u043B\u0443\u0448\u0430\u0435\u0448\u044C\u0441\u044F \u0447\u0443\u0436\u0438\u0445
      \u0440\u043E\u0441\u0441\u043A\u0430\u0437\u043D\u0435\u0439 - \u0438 \u043D\u0435
      \u0442\u0430\u043A\u043E\u0435 \u043F\u0440\u0438\u0441\u043D\u0438\u0442\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 28
    richText: "\u041D\u0443\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438 \u0441\u0435\u0431\u0435
      \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435. \u0420\u0430\u0431\u043E\u0442\u0430
      - \u043B\u0443\u0447\u0448\u0435\u0435 \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u043E
      \u043E\u0442 \u0434\u0443\u0440\u043D\u044B\u0445 \u043C\u044B\u0441\u043B\u0435\u0439."
    style: {fileID: 0}
    authorComment: 
