  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: zls2_dialogue_038_final
  nodeTitle: 
  activeCharacters: []
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412 \u0434\u043E\u043C\u0435 \u0442\u0435\u043F\u043B\u043E \u0438
      \u043F\u0430\u0445\u043D\u0435\u0442 \u0441\u0443\u0445\u0438\u043C\u0438 \u0442\u0440\u0430\u0432\u0430\u043C\u0438.
      {playerName} \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0443 \u043E\u043A\u043D\u0430, \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0443. \u041D\u043E \u043D\u0438\u0447\u0435\u0433\u043E
      - \u0438 \u043D\u0438\u043A\u043E\u0433\u043E - \u0442\u0430\u043C \u0431\u043E\u043B\u044C\u0448\u0435
      \u043D\u0435\u0442."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0437\u0430\u043D\u0430\u0432\u0435\u0441\u043A\u0443 \u0438 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u0438\u0434\u0451\u0442 \u0432 \u0441\u0432\u043E\u044E \u043A\u043E\u043C\u043D\u0430\u0442\u0443."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u0432\u0435\u0442 \u043D\u0430 \u043D\u043E\u0447\u044C \u043D\u0435
      \u0433\u0430\u0441\u0438\u0442: \u0435\u0439 \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
      \u0447\u0442\u043E \u0435\u0441\u043B\u0438 \u0442\u043E\u0442 \u043F\u043E\u043C\u0435\u0440\u043A\u043D\u0435\u0442,
      \u0438\u0437 \u0442\u0435\u043C\u043D\u043E\u0442\u044B \u0441\u043E\u0442\u043A\u0435\u0442\u0441\u044F
      \u0441\u0438\u044F\u044E\u0449\u0430\u044F \u0441\u0435\u0440\u0435\u0431\u0440\u043E\u043C
      \u0434\u0435\u0432\u0438\u0447\u044C\u044F \u0444\u0438\u0433\u0443\u0440\u0430,
      \u0430 \u0442\u043E\u043D\u043A\u0438\u0435 \u0440\u0443\u043A\u0438 \u043E\u0431\u0445\u0432\u0430\u0442\u044F\u0442
      \u0435\u0451 \u0438 \u0443\u0432\u043B\u0435\u043A\u0443\u0442 \u0442\u0443\u0434\u0430,
      \u043E\u0442\u043A\u0443\u0434\u0430 \u043D\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044E\u0442\u0441\u044F\u2026"
    style: {fileID: 0}
    authorComment: 
