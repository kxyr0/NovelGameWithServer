  guid: zls2_dialogue_026_river_stranger
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  - character: {fileID: 11400000, guid: f0422403a4dc45c68330c10d7251ddc1, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: voice
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u0440\u0432\u0430\u043D\u043E \u0432\u044B\u0434\u044B\u0445\u0430\u0435\u0442."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 9
    richText: "\u041F\u0440\u043E\u0441\u0442\u043E \u0432\u0435\u0442\u0435\u0440.
      \u0418\u043B\u0438 \u0431\u043E\u043B\u044C\u0448\u0430\u044F \u043F\u0442\u0438\u0446\u0430\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F
      \u043F\u043E\u0434\u0430\u0432\u0438\u0442\u044C \u0432\u043E\u0437\u043D\u0438\u043A\u0448\u0443\u044E
      \u0438\u0437 \u043D\u0438\u043E\u0442\u043A\u0443\u0434\u0430 \u0442\u0440\u0435\u0432\u043E\u0433\u0443,
      \u0438 \u043F\u043E\u0447\u0442\u0438 \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u0435\u0442
      \u0436\u0435\u043B\u0430\u0435\u043C\u043E\u0433\u043E, \u043D\u043E \u0442\u0443\u0442
      \u0432\u0437\u0433\u043B\u044F\u0434 \u0432\u044B\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u0435\u0442
      \u0441\u0438\u043B\u0443\u044D\u0442, \u0441\u0442\u043E\u044F\u0449\u0438\u0439
      \u0432 \u0433\u0443\u0449\u0435 \u0442\u0440\u0430\u0432\u044B \u043D\u0430
      \u0434\u0440\u0443\u0433\u043E\u043C \u0431\u0435\u0440\u0435\u0433\u0443."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u043F\u0440\u0438\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043F\u043E\u043B\u0443\u0447\u0448\u0435."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0414\u043E\u043B\u0433\u043E \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
      \u0447\u0442\u043E \u044D\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E
      \u0442\u0435\u043D\u044C, \u043D\u043E \u0442\u0430 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442
      \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F - \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E,
      \u043F\u043B\u0430\u0432\u043D\u043E. \u0411\u0443\u0434\u0442\u043E \u043D\u0435
      \u0438\u0434\u0451\u0442, \u0430 \u0441\u043A\u043E\u043B\u044C\u0437\u0438\u0442
      \u0432\u0434\u043E\u043B\u044C \u0432\u043E\u0434\u044B."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u043B\u043E\u0432\u043D\u043E \u043E\u0449\u0443\u0442\u0438\u0432
      \u043D\u0430 \u0441\u0435\u0431\u0435 \u0447\u0443\u0436\u043E\u0439 \u0432\u0437\u0433\u043B\u044F\u0434,
      \u0441\u0438\u043B\u0443\u044D\u0442 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u0433\u043E\u043B\u043E\u0432\u0443."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: f0422403a4dc45c68330c10d7251ddc1, type: 2}
    emotion: 0
    richText: "\u0410 \u044F \u0442\u0435\u0431\u044F \u0436\u0434\u0430\u043B\u0430.
      \u0411\u043E\u044F\u043B\u0430\u0441\u044C, \u0447\u0442\u043E \u043D\u0435
      \u043F\u0440\u0438\u0434\u0435\u0448\u044C\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0416\u0435\u043D\u0441\u043A\u0438\u0439 \u0433\u043E\u043B\u043E\u0441
      \u0437\u0432\u0443\u0447\u0438\u0442 \u043C\u044F\u0433\u043A\u043E, \u043F\u0435\u0432\u0443\u0447\u0435.
      \u041F\u043E \u0441\u043F\u0438\u043D\u0435 \u0431\u0435\u0433\u0443\u0442
      \u043C\u0443\u0440\u0430\u0448\u043A\u0438 \u043E\u0442 \u0442\u043E\u0433\u043E,
      \u043A\u0430\u043A\u0438\u043C \u043D\u0435\u0437\u0434\u0435\u0448\u043D\u0438\u043C,
      \u043F\u043E\u0442\u0443\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u043C
      \u043E\u043D \u043A\u0430\u0436\u0435\u0442\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 25
    richText: "\u041A\u0442\u043E \u0437\u0434\u0435\u0441\u044C?"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u043C\u0435\u0441\u0442\u043E \u043E\u0442\u0432\u0435\u0442\u0430
      \u0438\u0437 \u0440\u0435\u043A\u0438 \u0434\u043E\u043D\u043E\u0441\u0438\u0442\u0441\u044F
      \u043B\u0451\u0433\u043A\u0438\u0439 \u0432\u0441\u043F\u043B\u0435\u0441\u043A.
      {playerName} \u0432\u0437\u0434\u0440\u0430\u0433\u0438\u0432\u0430\u0435\u0442."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u0442\u0440\u0430\u0445 \u043E\u043A\u0430\u0442\u044B\u0432\u0430\u0435\u0442
      \u043B\u0435\u0434\u044F\u043D\u044B\u043C \u043F\u043E\u0442\u043E\u043A\u043E\u043C
      \u0438 \u0441\u043A\u043E\u0432\u044B\u0432\u0430\u0435\u0442 \u043C\u044B\u0448\u0446\u044B,
      \u0437\u0430\u0441\u0442\u0430\u0432\u043B\u044F\u044F \u0437\u0430\u043C\u0435\u0440\u0435\u0442\u044C
      \u043D\u0430 \u043C\u0435\u0441\u0442\u0435."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: f0422403a4dc45c68330c10d7251ddc1, type: 2}
    emotion: 0
    richText: "\u0422\u044B \u0432\u0435\u0434\u044C \u043F\u0440\u0438\u0448\u043B\u0430
      \u043A\u043E \u043C\u043D\u0435 \u0441\u0430\u043C\u0430\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u043C\u043E\u0440\u0433\u0430\u0435\u0442 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0440\u0430\u0437."
    style: {fileID: 0}
    authorComment: 
