  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 9
    richText: "\u0418\u043D\u043E\u0433\u0434\u0430 \u043C\u043D\u0435 \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
      \u0447\u0442\u043E \u0437\u0434\u0435\u0441\u044C \u0434\u0430\u0436\u0435
      \u0434\u0435\u0440\u0435\u0432\u044C\u044F \u0437\u0430 \u0442\u043E\u0431\u043E\u0439
      \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u044E\u0442. \u0422\u0430\u043A
      \u0447\u0442\u043E \u044F \u0435\u0451 \u0441\u0442\u0440\u0430\u0445 \u043F\u043E\u043D\u0438\u043C\u0430\u044E\u2026"
    style: {fileID: 0}
    authorComment: 
