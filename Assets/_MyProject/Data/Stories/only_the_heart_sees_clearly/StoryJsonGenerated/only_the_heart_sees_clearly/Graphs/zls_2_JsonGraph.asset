  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: zls2_dialogue_023_after_phone
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0432 \u043E\u043A\u043D\u043E.
      \u0422\u0430\u043C - \u0431\u0435\u0437\u0431\u0440\u0435\u0436\u043D\u043E\u0435
      \u043F\u043E\u043B\u0435, \u043D\u0430\u0434 \u043A\u043E\u0442\u043E\u0440\u044B\u043C
      \u043C\u0438\u0433\u0430\u044E\u0442 \u043E\u0433\u043E\u043D\u044C\u043A\u0438.
      \u0412\u043E\u0437\u0434\u0443\u0445 \u0432\u0435\u0447\u0435\u0440\u043D\u0438\u0439,
      \u043B\u0438\u043F\u043A\u0438\u0439 - \u043F\u0440\u0435\u0434\u0432\u0435\u0441\u0442\u043D\u0438\u043A
      \u0433\u0440\u043E\u0437\u044B \u0438\u043B\u0438 \u0442\u0443\u043C\u0430\u043D\u0430.
      \u0421\u043B\u044B\u0448\u0438\u0442\u0441\u044F \u0436\u0443\u0436\u0436\u0430\u043D\u0438\u0435
      \u043A\u043E\u043C\u0430\u0440\u043E\u0432."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0422\u0430\u043A \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E
      \u0438 \u0443\u043C\u0438\u0440\u043E\u0442\u0432\u043E\u0440\u0451\u043D\u043D\u043E,
      \u043D\u043E \u0435\u0439 \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u0440\u0430\u0437\u0440\u044B\u0434\u0430\u0442\u044C\u0441\u044F,
      \u043A\u0430\u043A \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0439,
      \u043F\u0440\u044F\u043C\u043E \u0437\u0434\u0435\u0441\u044C, \u043D\u0438\u043A\u043E\u043C\u0443
      \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0425\u043E\u0447\u0435\u0442\u0441\u044F \u043D\u0430\u043F\u0438\u0441\u0430\u0442\u044C
      \u0435\u043C\u0443."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\xAB\u041C\u043D\u0435 \u043F\u043B\u043E\u0445\u043E.\xBB"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u043B\u0438 \xAB\u044F \u0442\u0435\u0431\u044F \u043D\u0435\u043D\u0430\u0432\u0438\u0436\u0443\xBB."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u043B\u0438\u2026 \u041F\u0430\u043B\u044C\u0446\u044B \u043F\u043E\u0434\u0440\u0430\u0433\u0438\u0432\u0430\u044E\u0442
      \u043E\u0442 \u0437\u043B\u043E\u0441\u0442\u0438, \u0441\u0436\u0438\u043C\u0430\u044F
      \u043C\u044F\u0433\u043A\u0438\u0439 \u043A\u0440\u0430\u0439 \u043E\u0434\u0435\u044F\u043B\u0430."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418 \u0432\u043E\u0442, \u0447\u0442\u043E \u0431\u0435\u0441\u0438\u0442
      \u0435\u0451 \u0431\u043E\u043B\u044C\u0448\u0435 \u0432\u0441\u0435\u0433\u043E:
      \u043D\u0435\u043D\u0430\u0432\u0438\u0441\u0442\u044C - \u044D\u0442\u043E
      \u0442\u043E\u0436\u0435 \u0441\u0432\u043E\u0435\u0433\u043E \u0440\u043E\u0434\u0430
      \u0444\u043E\u0440\u043C\u0430 \u043F\u0440\u0438\u0432\u044F\u0437\u0430\u043D\u043D\u043E\u0441\u0442\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0442\u043A\u0438\u043D\u0443\u0432\u0448\u0438\u0441\u044C
      \u043D\u0430 \u043F\u043E\u0434\u0443\u0448\u043A\u0443, \u043E\u043D\u0430
      \u0432\u0441\u0435\u0440\u044C\u0451\u0437 \u0440\u0430\u0437\u0434\u0443\u043C\u044B\u0432\u0430\u0435\u0442
      \u043D\u0430\u0434 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435\u043C,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u043B\u043E
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E. \u041A\u0440\u0430\u0441\u0438\u0432\u043E."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0422\u0430\u043A, \u0447\u0442\u043E\u0431\u044B \u043E\u043D \u043F\u043E\u0436\u0430\u043B\u0435\u043B."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0422\u0430\u043A, \u0447\u0442\u043E\u0431\u044B \u043E\u043D \u043F\u043E\u043D\u044F\u043B."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u043E \u043D\u0435\u0442 \u043D\u0430 \u0441\u0432\u0435\u0442\u0435
      \u0442\u0430\u043A\u0438\u0445 \u0441\u043B\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u044B \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u043D\u0435\u0433\u043E\u0434\u044F\u044F \u043F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C,
      \u0447\u0442\u043E \u043E\u043D \u043D\u0435\u0433\u043E\u0434\u044F\u0439."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 4
    richText: "\u041A \u0447\u0435\u0440\u0442\u0443. \u041F\u043E\u0439\u0434\u0443
      \u043F\u0440\u043E\u0439\u0434\u0443\u0441\u044C. \u041D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0432\u043E\u0437\u0434\u0443\u0445\u0430 - \u0438 \u0441\u043F\u0430\u0442\u044C..."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u0437 \u0434\u043E\u043C\u0430 \u043E\u043D\u0430 \u0432\u044B\u0441\u043A\u0430\u043B\u044C\u0437\u044B\u0432\u0430\u0435\u0442
      \u0442\u0438\u0445\u043E, \u0443\u043A\u0440\u0430\u0434\u043A\u043E\u0439
      - \u0435\u0451 \u0432\u044B\u0434\u0430\u0435\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0441\u043A\u0440\u0438\u043F \u0441\u0442\u0430\u0440\u043E\u0439 \u0434\u0432\u0435\u0440\u0438.
      \u041D\u043E \u0431\u0430\u0431 \u041D\u044E\u0440\u0430 \u0437\u0430\u043D\u044F\u0442\u0430
      \u043D\u0430 \u043A\u0443\u0445\u043D\u0435, \u0431\u043E\u0440\u043C\u043E\u0447\u0435\u0442
      \u0447\u0442\u043E-\u0442\u043E \u0441\u0435\u0431\u0435 \u043F\u043E\u0434
      \u043D\u043E\u0441, \u0433\u0440\u0435\u043C\u0438\u0442 \u043F\u043E\u0441\u0443\u0434\u043E\u0439
      \u0438 \u0432\u0440\u044F\u0434 \u043B\u0438 \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442
      \u0435\u0451 \u0438\u0441\u0447\u0435\u0437\u043D\u043E\u0432\u0435\u043D\u0438\u0435."
    style: {fileID: 0}
    authorComment: 
