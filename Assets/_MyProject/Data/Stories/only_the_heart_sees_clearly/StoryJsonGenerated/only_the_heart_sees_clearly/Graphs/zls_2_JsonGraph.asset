  lines:
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 9
    richText: "\u0422\u0430\u043C \u0442\u043E\u0447\u043D\u043E \u0431\u044B\u043B
      \u043A\u0442\u043E-\u0442\u043E \u0435\u0449\u0451, \u044F \u043F\u043E\u043C\u043D\u044E
      \u0433\u043E\u043B\u043E\u0441 \u0438 \u0442\u0435\u043D\u044C \u043D\u0430
      \u0434\u0440\u0443\u0433\u043E\u043C \u0431\u0435\u0440\u0435\u0433\u0443 \u0440\u0435\u043A\u0438.
      \u041E\u043D\u0430 \u0437\u0432\u0430\u043B\u0430 \u043C\u0435\u043D\u044F
      \u0438\u043B\u0438 \u043F\u044B\u0442\u0430\u043B\u0430\u0441\u044C \u043F\u043E\u043C\u043E\u0447\u044C?"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 28
    richText: "\u0422\u0430\u043A \u0441\u0442\u0440\u0430\u043D\u043D\u043E\u2026
      \u0432 \u0433\u043E\u0440\u043E\u0434\u0435 \u043C\u043D\u0435 \u0441\u043D\u0438\u043B\u0438\u0441\u044C
      \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0442\u0447\u0435\u0442\u044B \u0438
      \u0441\u0447\u0435\u0442\u0430 \u0437\u0430 \u043A\u043E\u043C\u043C\u0443\u043D\u0430\u043B\u043A\u0443,
      \u0430 \u0437\u0434\u0435\u0441\u044C\u2026 \u0437\u0434\u0435\u0441\u044C
