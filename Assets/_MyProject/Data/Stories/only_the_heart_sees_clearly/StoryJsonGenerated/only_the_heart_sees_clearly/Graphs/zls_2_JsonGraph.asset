  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: zls2_dialogue_031_ivan_collision
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  - character: {fileID: 11400000, guid: 6f61c44e0a134a16bf759933ce1fd8f6, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: ivan
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u0435 \u0443\u0441\u043F\u0435\u0432 \u0437\u0430\u0442\u043E\u0440\u043C\u043E\u0437\u0438\u0442\u044C,
      \u043E\u043D\u0430 \u0432\u0440\u0435\u0437\u0430\u0435\u0442\u0441\u044F \u043D\u043E\u0441\u043E\u043C
      \u0432 \u0448\u0438\u0440\u043E\u043A\u0443\u044E \u043C\u0443\u0436\u0441\u043A\u0443\u044E
      \u0433\u0440\u0443\u0434\u044C. \u0415\u0451, \u0434\u0440\u043E\u0436\u0430\u0449\u0443\u044E
      \u043E\u0442 \u043F\u0435\u0440\u0435\u0436\u0438\u0442\u043E\u0433\u043E \u0443\u0436\u0430\u0441\u0430,
      \u0442\u0443\u0442 \u0436\u0435 \u043E\u0431\u0434\u0430\u0451\u0442 \u0436\u0430\u0440\u043E\u043C
      \u0447\u0443\u0436\u043E\u0433\u043E \u0442\u0435\u043B\u0430. \u0428\u0443\u043C\u043D\u043E
      \u0434\u044B\u0448\u0430, \u043D\u043E\u0441\u043E\u043C \u043E\u043D\u0430
      \u0443\u043B\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442 \u0437\u0430\u043F\u0430\u0445
      \u043A\u043E\u0436\u0438 \u0438 \u043A\u043E\u043D\u0441\u043A\u043E\u0433\u043E
      \u043F\u043E\u0442\u0430. \u041B\u0451\u0433\u043A\u0438\u0435 \u0433\u043E\u0440\u044F\u0442,
      \u0432 \u0443\u0448\u0430\u0445 \u0441\u0442\u043E\u0438\u0442 \u0433\u0443\u043B,
      \u0430 \u043F\u0435\u0440\u0435\u0434 \u0433\u043B\u0430\u0437\u0430\u043C\u0438
      \u0432\u0441\u0451 \u0435\u0449\u0451 \u0441\u0442\u043E\u0438\u0442 \u0431\u043B\u0435\u0434\u043D\u043E\u0435,
      \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E\u0435 \u043B\u0438\u0446\u043E
      \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u043A\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041A\u0440\u0435\u043F\u043A\u0438\u0435 \u0440\u0443\u043A\u0438
      \u043B\u043E\u0432\u044F\u0442 \u0435\u0451 \u0437\u0430 \u0442\u0430\u043B\u0438\u044E."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u0432\u0441\u043A\u0440\u0438\u043A\u0438\u0432\u0430\u0435\u0442
      \u043E\u0442 \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E\u0441\u0442\u0438
      \u0438 \u0443\u0436\u0430\u0441\u0430."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 25
    richText: "\u041F\u0443\u0441\u0442\u0438! \u041F\u0443\u0441\u0442\u0438 \u043C\u0435\u043D\u044F!"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F
      \u0431\u0440\u044B\u043A\u0430\u0442\u044C\u0441\u044F, \u043D\u043E \u0437\u0430\u0442\u0438\u0445\u0430\u0435\u0442,
      \u0441\u0442\u043E\u0438\u0442 \u0435\u0439 \u0440\u0430\u0437\u0433\u043B\u044F\u0434\u0435\u0442\u044C
      \u0432 \u0441\u0435\u0440\u0435\u0431\u0440\u0438\u0441\u0442\u043E\u043C \u0441\u0432\u0435\u0442\u0435
      \u043B\u0443\u043D\u044B \u043B\u0438\u0446\u043E \u0418\u0432\u0430\u043D\u0430."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 6f61c44e0a134a16bf759933ce1fd8f6, type: 2}
    emotion: 2
    richText: "\u041E\u043F, \u043F\u043E\u0439\u043C\u0430\u043B! \u0422\u0438\u0448\u0435,
      \u0442\u0438\u0448\u0435. \u0422\u044B \u0447\u0435\u0433\u043E?"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430
      \u043D\u0435\u0451 \u0443\u0434\u0438\u0432\u043B\u0451\u043D\u043D\u043E \u0438
      \u0432\u0441\u0442\u0440\u0435\u0432\u043E\u0436\u0435\u043D\u043D\u043E. \u0425\u0432\u0430\u0442\u043A\u0443
      \u043E\u0441\u043B\u0430\u0431\u043B\u044F\u0435\u0442, \u0431\u0443\u0434\u0442\u043E
      \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u044F, \u0447\u0442\u043E
      \u0434\u0435\u0440\u0436\u0438\u0442 \u043D\u0435 \u043C\u0435\u0448\u043E\u043A
      \u0441 \u043A\u0430\u0440\u0442\u043E\u0448\u043A\u043E\u0439, \u0430 \u0436\u0438\u0432\u0443\u044E
      \u0434\u0435\u0432\u0443\u0448\u043A\u0443."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u0448\u0443\u043C\u043D\u043E \u0434\u044B\u0448\u0438\u0442,
      \u0436\u0430\u0434\u043D\u043E \u0445\u0432\u0430\u0442\u0430\u044F \u0440\u0442\u043E\u043C
      \u043F\u0440\u043E\u0445\u043B\u0430\u0434\u043D\u044B\u0439 \u0432\u0435\u0447\u0435\u0440\u043D\u0438\u0439
      \u0432\u043E\u0437\u0434\u0443\u0445."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 28
    richText: "\u041E\u043D \u0442\u0435\u043F\u043B\u044B\u0439, \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439,
      \u043E\u043D \u0441\u0432\u043E\u0439\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 6f61c44e0a134a16bf759933ce1fd8f6, type: 2}
    emotion: 2
    richText: "\u041E\u0442 \u0447\u0435\u0433\u043E \u0431\u0435\u0436\u0438\u0448\u044C,
      \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0430\u044F? \u0412\u0438\u0434
      \u0443 \u0442\u0435\u0431\u044F \u0442\u0430\u043A\u043E\u0439, \u043A\u0430\u043A
      \u0431\u0443\u0434\u0442\u043E \u043C\u0435\u0440\u0442\u0432\u0435\u0446\u0430
      \u0443\u0432\u0438\u0434\u0435\u043B\u0430\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u0441\u043A\u043B\u043E\u043D\u044F\u0435\u0442 \u0433\u043E\u043B\u043E\u0432\u0443
      \u0432 \u0431\u043E\u043A, \u043F\u044B\u0442\u0430\u044F\u0441\u044C \u043F\u043E\u0439\u043C\u0430\u0442\u044C
      \u0435\u0451 \u0432\u0437\u0433\u043B\u044F\u0434."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u043F\u043E\u0434\u0436\u0438\u043C\u0430\u0435\u0442
      \u0433\u0443\u0431\u044B."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 28
    richText: "\u041A\u0430\u043A \u0431\u0443\u0434\u0442\u043E\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u043D\u0435\u043B\u043E\u0432\u043A\u043E \u043E\u0442\u0441\u0442\u0440\u0430\u043D\u044F\u0435\u0442\u0441\u044F,
      \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044F, \u043A\u0430\u043A \u0433\u043E\u0440\u044F\u0442
      \u0449\u0451\u043A\u0438. \u041C\u0438\u0440 \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E
      \u043E\u0431\u0440\u0435\u0442\u0430\u0435\u0442 \u0447\u0451\u0442\u043A\u043E\u0441\u0442\u044C,
      \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0440\u044F\u0434\u043E\u043C
      - \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439, \u0436\u0438\u0432\u043E\u0439
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u0440\u0438\u0437\u043D\u0430\u0432\u0430\u0442\u044C\u0441\u044F
      \u043E \u0442\u043E\u043C, \u0447\u0442\u043E \u0432\u0438\u0434\u0435\u043B\u0430
      \u043A\u043E\u0433\u043E-\u0442\u043E \u0438\u043B\u0438 \u0447\u0442\u043E-\u0442\u043E
      \u0441\u0442\u0440\u0430\u043D\u043D\u043E\u0435 \u0443 \u0440\u0435\u043A\u0438
      \u043D\u0435 \u0445\u043E\u0447\u0435\u0442 - \u0435\u0449\u0451 \u043F\u0440\u0438\u043C\u0443\u0442
      \u0437\u0430 \u0441\u0443\u043C\u0430\u0441\u0448\u0435\u0434\u0448\u0443\u044E."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041C\u043E\u0436\u0435\u0442, \u044D\u0442\u043E \u0438\u0433\u0440\u044B
      \u0440\u0430\u0437\u0431\u0443\u0448\u0435\u0432\u0430\u0432\u0448\u0435\u0433\u043E\u0441\u044F
      \u0432\u043E\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 9
    richText: "\u0427\u0435\u0433\u043E \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0435
      \u043F\u0440\u0438\u0432\u0438\u0434\u0438\u0442\u0441\u044F\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041C\u043E\u0436\u0435\u0442, \u044D\u0442\u043E \u043C\u0435\u0441\u0442\u043D\u0430\u044F
      \u0440\u0435\u0431\u044F\u0442\u043D\u044F \u0440\u0435\u0448\u0438\u043B\u0430
      \u0442\u0430\u043A \u0433\u043B\u0443\u043F\u043E \u0440\u0430\u0437\u044B\u0433\u0440\u0430\u0442\u044C
      \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0443\u044E \u0434\u0435\u0432\u0447\u043E\u043D\u043A\u0443."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041C\u043E\u0436\u0435\u0442, \u043C\u043E\u0436\u0435\u0442, \u043C\u043E\u0436\u0435\u0442\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u0443 \u0433\u043B\u0443\u043F\u043E \u0436\u0435. \u041D\u043E
      \u0432\u0441\u0451 \u0432\u043D\u0443\u0442\u0440\u0438 \u0441\u0436\u0438\u043C\u0430\u0435\u0442\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0442 \u0441\u0442\u0440\u0430\u0445\u0430 \u0438 \u043E\u0442
      \u0430\u0431\u0441\u0443\u0440\u0434\u043D\u043E\u0433\u043E \u0447\u0443\u0432\u0441\u0442\u0432\u0430,
      \u0447\u0442\u043E \u043A\u0442\u043E-\u0442\u043E \u0432\u0438\u0434\u0438\u0442
      \u0435\u0451 \u043D\u0430\u0441\u043A\u0432\u043E\u0437\u044C."
    style: {fileID: 0}
    authorComment: 
