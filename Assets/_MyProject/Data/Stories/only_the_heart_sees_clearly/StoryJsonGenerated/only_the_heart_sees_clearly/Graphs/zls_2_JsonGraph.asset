  guid: zls2_dialogue_024_evening_walk
  nodeTitle: 
  activeCharacters: []
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041A \u0432\u0435\u0447\u0435\u0440\u0443 \u0434\u0435\u0440\u0435\u0432\u043D\u044F
      \u043F\u0440\u0435\u043E\u0431\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044F.
      \u0422\u0435\u043D\u0438 \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F
      \u0434\u043B\u0438\u043D\u043D\u044B\u043C\u0438, \u043E\u0441\u0442\u0440\u044B\u043C\u0438.
      \u0421\u0438\u043B\u0443\u044D\u0442\u044B \u0438\u0437\u0431 \u0442\u0435\u043F\u0435\u0440\u044C
      \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0442 \u0441\u0433\u043E\u0440\u0431\u043B\u0435\u043D\u043D\u044B\u0445
      \u0441\u0442\u0430\u0440\u0438\u043A\u043E\u0432."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0422\u0438\u0448\u0438\u043D\u0443 \u043D\u0430\u0440\u0443\u0448\u0430\u0435\u0442
      \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0442\u0440\u0435\u043A\u043E\u0442
      \u0441\u0432\u0435\u0440\u0447\u043A\u043E\u0432 \u0438 \u0440\u0435\u0434\u043A\u0438\u0439
      \u043B\u044E\u0434\u0441\u043A\u043E\u0439 \u0433\u043E\u043B\u043E\u0441:
      \u043A\u0442\u043E-\u0442\u043E \u0437\u043E\u0432\u0451\u0442 \u043A\u043E\u0448\u043A\u0443,
      \u043A\u0442\u043E-\u0442\u043E \u0440\u0443\u0433\u0430\u0435\u0442 \u0440\u0430\u0437\u043B\u0430\u044F\u0432\u0448\u0435\u0433\u043E\u0441\u044F
      \u043F\u0441\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u0435\u0447\u0435\u0440 \u043A\u0430\u0436\u0435\u0442\u0441\u044F
      \u0442\u0451\u043F\u043B\u044B\u043C, \u0432\u043E\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
      {playerName} \u0432\u0441\u0435 \u0440\u0430\u0432\u043D\u043E \u0435\u0436\u0438\u0442\u0441\u044F,
      \u043E\u0431\u043D\u0438\u043C\u0430\u044F \u0441\u0435\u0431\u044F \u0437\u0430
      \u043F\u043B\u0435\u0447\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0438\u0434\u0451\u0442 \u0431\u0435\u0437 \u0446\u0435\u043B\u0438,
      \u043A\u0430\u043A \u0432 \u0441\u043A\u0430\u0437\u043A\u0435, \u043A\u0443\u0434\u0430
      \u0433\u043B\u0430\u0437\u0430 \u0433\u043B\u044F\u0434\u044F\u0442. \u0421\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u043E\u0434\u0438\u043D \u0440\u0430\u0437, \u043F\u043E\u0442\u043E\u043C
      \u0434\u0440\u0443\u0433\u043E\u0439. \u041D\u043E\u0433\u0438 \u0441\u043B\u043E\u0432\u043D\u043E
      \u0441\u0430\u043C\u0438 \u043D\u0435\u0441\u0443\u0442 \u0435\u0451, \u0438
      {playerName} \u0441\u043E\u0432\u0441\u0435\u043C \u043D\u0435 \u0431\u043E\u0438\u0442\u0441\u044F
      \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E \u0437\u0430\u043F\u043B\u0443\u0442\u0430\u0442\u044C
      \u0432 \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u0442\u0440\u0430\u0432\u0435."
    style: {fileID: 0}
    authorComment: 
