  guid: zls2_dialogue_018_street_day
  nodeTitle: 
  activeCharacters: []
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0422\u0435\u043D\u0438 \u0432\u044B\u0442\u044F\u0433\u0438\u0432\u0430\u044E\u0442\u0441\u044F,
      \u0441\u0442\u0440\u0435\u043A\u043E\u0442 \u043A\u0443\u0437\u043D\u0435\u0447\u0438\u043A\u043E\u0432
      \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0433\u0440\u043E\u043C\u0447\u0435
      - \u0441\u043B\u043E\u0432\u043D\u043E \u0434\u0435\u0440\u0435\u0432\u043D\u044F
      \u0442\u0430\u043A \u0434\u044B\u0448\u0438\u0442."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412 \u0440\u0443\u043A\u0435 \u0442\u044F\u0436\u0435\u043B\u0435\u0435\u0442
      \u043A\u043E\u0440\u0437\u0438\u043D\u043A\u0430, \u043F\u043E \u0449\u0435\u043A\u0435
      \u0441\u043A\u043E\u043B\u044C\u0437\u0438\u0442 \u043F\u0440\u044F\u0434\u044C
      \u0432\u043E\u043B\u043E\u0441, \u043B\u0438\u043F\u043D\u0435\u0442 \u043A
      \u043A\u043E\u0436\u0435."
    style: {fileID: 0}
    authorComment: 
