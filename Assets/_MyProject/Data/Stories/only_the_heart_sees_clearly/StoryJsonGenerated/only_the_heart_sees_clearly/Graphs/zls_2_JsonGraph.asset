  guid: zls2_dialogue_010_warning_city
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  - character: {fileID: 11400000, guid: d39beffe2615479bb3fa69a643c5e1f7, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: teta_galya
  lines:
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 27
    richText: "\u0410 \u043D\u0430 \u0434\u0435\u043B\u0435 - \u043F\u0440\u043E\u0441\u0442\u0430\u044F
      \u0444\u0438\u0437\u0438\u043A\u0430. \u0411\u0435\u0440\u0435\u0433 \u043F\u043E\u0434\u043C\u044B\u043B\u043E,
      \u0442\u0435\u0447\u0435\u043D\u0438\u0435 \u0443\u0441\u0438\u043B\u0438\u043B\u043E\u0441\u044C\u2026
      \u041E\u0431\u044B\u0447\u043D\u043E\u0435 \u0434\u0435\u043B\u043E \u0434\u043B\u044F
      \u0438\u044E\u043D\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d39beffe2615479bb3fa69a643c5e1f7, type: 2}
    emotion: 17
    richText: "\u0414\u0430 \u043A\u0442\u043E \u0436 \u0438\u0445 \u043F\u043E\u0439\u043C\u0435\u0442,
      \u0434\u0435\u0442\u043E\u0447\u044C\u043A\u0430, \u0437\u0430\u043A\u043E\u043D\u044B
      \u044D\u0442\u0438. \u0422\u043E\u043B\u044C\u043A\u043E \u0440\u0435\u043A\u0430
      - \u043E\u043D\u0430 \u0436\u0438\u0432\u0430\u044F, \u0434\u0430 \u0441\u0432\u043E\u0435\u0432\u043E\u043B\u044C\u043D\u0430\u044F
      \u043E\u0447\u0435\u043D\u044C. \u041F\u043E\u043C\u043D\u0438 \u043E\u0431
      \u044D\u0442\u043E\u043C."
    style: {fileID: 0}
    authorComment: 
