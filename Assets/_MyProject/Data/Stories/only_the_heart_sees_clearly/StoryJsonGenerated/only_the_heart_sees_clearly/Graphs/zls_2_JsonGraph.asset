    richText: "\u2026\u041D\u0430 \u043C\u043E\u0441\u0442\u043E\u0447\u043A\u0435
      \u0443 \u0432\u043E\u0434\u044B \u0441\u0438\u0434\u044F\u0442 \u043C\u0451\u0440\u0442\u0432\u044B\u0435
