  guid: zls2_dialogue_002_wakeup
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0433\u043B\u0430\u0437\u0430 - \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0440\u0435\u0437\u043A\u043E, \u0431\u0443\u0434\u0442\u043E \u0432\u044B\u043D\u044B\u0440\u0438\u0432\u0430\u0435\u0442
      \u0438\u0437 \u0433\u043B\u0443\u0431\u0438\u043D\u044B \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C.
      \u0421\u0435\u0440\u0434\u0446\u0435 \u0433\u0440\u043E\u043C\u043A\u043E \u0431\u0443\u0445\u0430\u0435\u0442
      \u043E \u0440\u0451\u0431\u0440\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412 \u0443\u0433\u043B\u0443 \u043A\u043E\u043C\u043D\u0430\u0442\u044B
      \u0435\u0439 \u043C\u0435\u0440\u0435\u0449\u0438\u0442\u0441\u044F \u0442\u0451\u043C\u043D\u044B\u0439
      \u0436\u0435\u043D\u0441\u043A\u0438\u0439 \u0441\u0438\u043B\u0443\u044D\u0442,
      \u043A\u0430\u0447\u0430\u044E\u0449\u0438\u0439 \u043D\u0430 \u0440\u0443\u043A\u0430\u0445\u2026
      \u043F\u043E\u043B\u0435\u043D\u043E?"
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u043C\u043E\u0440\u0433\u0430\u0435\u0442 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0440\u0430\u0437."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: '{playerName}'
    speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 9
    richText: "\u041F\u043E\u0447\u0443\u0434\u0438\u043B\u043E\u0441\u044C \u0441\u043F\u0440\u043E\u0441\u043E\u043D\u044C\u044F\u2026"
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0417\u0430 \u043E\u043A\u043D\u043E\u043C \u043A\u0440\u0438\u0447\u0438\u0442
      \u043F\u0435\u0442\u0443\u0445. \u0415\u043C\u0443 \u0432 \u043E\u0442\u0432\u0435\u0442
      \u0437\u0430\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u043F\u0451\u0441."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041C\u0443\u0436\u0438\u043A (\u0441\u0438\u043B\u0443\u044D\u0442):
      \u0414\u0430 \u0437\u0430\u043C\u043E\u043B\u043A\u043D\u0438 \u0442\u044B,
      \u043E\u043A\u0430\u044F\u043D\u043D\u044B\u0439!"
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u0435\u0432\u043E\u043B\u044C\u043D\u043E \u043F\u0440\u0438\u0441\u043B\u0443\u0448\u0438\u0432\u0430\u044F\u0441\u044C
      \u043A \u043F\u043E\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u043C \u0437\u0432\u0443\u043A\u0430\u043C,
      {playerName} \u0441\u0430\u0434\u0438\u0442\u0441\u044F \u043D\u0430 \u043A\u0440\u043E\u0432\u0430\u0442\u0438,
      \u0441\u0433\u043E\u0440\u0431\u0438\u0432 \u0441\u043F\u0438\u043D\u0443 \u0438
      \u043E\u043F\u0443\u0441\u0442\u0438\u0432 \u043F\u043B\u0435\u0447\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0434\u0435\u044F\u043B\u043E \u0441\u043E\u0441\u043A\u0430\u043B\u044C\u0437\u044B\u0432\u0430\u0435\u0442
      \u043D\u0430 \u043F\u043E\u043B, \u043D\u043E \u043E\u043D\u0430 \u043D\u0435
      \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F \u0435\u0433\u043E \u043F\u043E\u0434\u043D\u044F\u0442\u044C.
      \u0412\u043C\u0435\u0441\u0442\u043E \u044D\u0442\u043E\u0433\u043E \u0432
      \u043F\u043E\u043F\u044B\u0442\u043A\u0430\u0445 \u0443\u043D\u044F\u0442\u044C
      \u0434\u0440\u043E\u0436\u044C \u043E\u0431\u043D\u0438\u043C\u0430\u0435\u0442
      \u0441\u0435\u0431\u044F \u0440\u0443\u043A\u0430\u043C\u0438 - \u0434\u0435\u0442\u0441\u043A\u0438\u0439
      \u0438 \u043D\u0430\u0438\u0432\u043D\u044B\u0439 \u0436\u0435\u0441\u0442."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412 \u0433\u043E\u043B\u043E\u0432\u0435 \u0437\u0430\u0435\u0432\u0448\u0435\u0439
      \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u043A\u043E\u0439 \u043D\u0430\u0432\u044F\u0437\u0447\u0438\u0432\u043E
      \u043A\u0440\u0443\u0442\u044F\u0442\u0441\u044F \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0435,
      \u043F\u0440\u0438\u043B\u0438\u043F\u0447\u0438\u0432\u044B\u0435 \u0441\u0442\u0440\u043E\u043A\u0438,
      \u043E\u0442 \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u043E\u0442\u0447\u0435\u0433\u043E-\u0442\u043E
      \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u043D\u0435 \u043F\u043E
      \u0441\u0435\u0431\u0435."
    style: {fileID: 0}
