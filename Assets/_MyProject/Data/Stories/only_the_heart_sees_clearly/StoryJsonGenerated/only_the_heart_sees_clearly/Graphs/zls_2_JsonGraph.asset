  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: zls2_dialogue_021_phone_open
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0437\u0430\u043C\u0438\u0440\u0430\u0435\u0442
      \u043D\u0430 \u0441\u0435\u043A\u0443\u043D\u0434\u0443, \u043D\u043E \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u043D\u043E
      \u0442\u044B\u043A\u0430\u0435\u0442 \u043F\u0430\u043B\u044C\u0446\u0435\u043C
      \u043D\u0430 \u0443\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u0438\u0435
      \u0438 \u0436\u0434\u0451\u0442, \u043D\u0435\u0442\u0435\u0440\u043F\u0435\u043B\u0438\u0432\u043E
      \u0451\u0440\u0437\u0430\u044F \u043D\u0430 \u043C\u0435\u0441\u0442\u0435."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u0432\u044F\u0437\u044C \u0432 \u0434\u0435\u0440\u0435\u0432\u043D\u0435
      \u043A\u0430\u043F\u0440\u0438\u0437\u043D\u0430\u044F. \u041A\u043E\u043B\u0435\u0441\u043E
      \u0437\u0430\u0433\u0440\u0443\u0437\u043A\u0438 \u043D\u0438\u043A\u0443\u0434\u0430
      \u043D\u0435 \u0442\u043E\u0440\u043E\u043F\u0438\u0442\u0441\u044F - \u043E\u043D\u043E
      \u043A\u0440\u0443\u0442\u0438\u0442\u0441\u044F \u0446\u0435\u043B\u0443\u044E
      \u0432\u0435\u0447\u043D\u043E\u0441\u0442\u044C \u0438, \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
      \u043D\u043E\u0440\u043E\u0432\u0438\u0442 \u0441\u0432\u0435\u0441\u0442\u0438
      \u0435\u0451 \u0441 \u0443\u043C\u0430."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041A\u0430\u0434\u0440 \u043F\u043E\u0434\u0433\u0440\u0443\u0436\u0430\u0435\u0442\u0441\u044F
      \u043A\u0443\u0441\u043A\u0430\u043C\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u043E\u0442 \u0435\u0433\u043E \u0443\u043B\u044B\u0431\u043A\u0430
      - \u043E\u043D\u0430 \u0437\u043D\u0430\u0435\u0442 \u044D\u0442\u0438 \u044F\u043C\u043E\u0447\u043A\u0438
      \u0438 \u044D\u0442\u0443 \u0440\u043E\u0434\u0438\u043D\u043A\u0443 \u043D\u0430
      \u043B\u0435\u0432\u043E\u0439 \u0449\u0435\u043A\u0435."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u043E\u0442 \u0435\u0433\u043E \u0440\u0443\u043A\u0430 - \u043A\u0430\u0436\u0434\u044B\u0439
      \u0448\u0440\u0430\u043C \u043D\u0430 \u044D\u0442\u0438\u0445 \u043F\u0430\u043B\u044C\u0446\u0430\u0445
      \u0435\u0439 \u0437\u043D\u0430\u043A\u043E\u043C. \u0422\u0435\u043F\u0435\u0440\u044C
      \u044D\u0442\u0430 \u0440\u0443\u043A\u0430 \u043B\u0435\u0436\u0438\u0442
      \u043D\u0430 \u0442\u0430\u043B\u0438\u0438 \u0434\u0440\u0443\u0433\u043E\u0439
      \u0434\u0435\u0432\u0443\u0448\u043A\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0417\u0430 \u0438\u0445 \u0441\u043F\u0438\u043D\u0430\u043C\u0438
      \u0441\u0438\u044F\u0435\u0442 \u043D\u043E\u0447\u043D\u043E\u0439 \u0433\u043E\u0440\u043E\u0434
      - \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0439, \u0434\u043E\u0440\u043E\u0433\u043E\u0439,
      \u0443\u0441\u043F\u0435\u0448\u043D\u044B\u0439, \u0442\u0430\u043A \u043B\u0435\u0433\u043A\u043E
      \u0435\u0451 \u0432\u044B\u0442\u0435\u0441\u043D\u0438\u0432\u0448\u0438\u0439."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u043A\u0440\u0435\u043F\u043A\u043E \u0441\u0436\u0438\u043C\u0430\u0435\u0442
      \u0442\u0435\u043B\u0435\u0444\u043E\u043D \u0432 \u0440\u0443\u043A\u0435,
      \u0441\u0446\u0435\u043F\u0438\u0432 \u0437\u0443\u0431\u044B."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412 \u0433\u043E\u0440\u043B\u0435 \u0432\u0441\u0442\u0430\u0435\u0442
      \u0432\u044F\u0437\u043A\u0438\u0439 \u043A\u043E\u043C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0437\u043B\u0438\u0442\u0441\u044F - \u043D\u0430
      \u043D\u0435\u0433\u043E - \u0437\u0430 \u0442\u043E, \u0447\u0442\u043E \u0442\u0430\u043A
      \u0441 \u043D\u0435\u0439 \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B.
      \u0418 \u043D\u0430 \u0441\u0435\u0431\u044F - \u0437\u0430 \u0442\u043E, \u0447\u0442\u043E
      \u0435\u0439 \u0432\u0441\u0451 \u0435\u0449\u0451 \u043D\u0435 \u0432\u0441\u0451
      \u0440\u0430\u0432\u043D\u043E."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 4
    richText: "\u0422\u0430\u043A \u043D\u0435\u0447\u0435\u0441\u0442\u043D\u043E.
      \u041E\u043D \u0436\u0438\u0432\u0451\u0442 \u0434\u0430\u043B\u044C\u0448\u0435.
      \u0410 \u044F\u2026 \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E \u0437\u0430\u0441\u0442\u0440\u044F\u043B\u0430
      \u043D\u0430 \u043E\u0434\u043D\u043E\u043C \u043C\u0435\u0441\u0442\u0435."
    style: {fileID: 0}
    authorComment: 
