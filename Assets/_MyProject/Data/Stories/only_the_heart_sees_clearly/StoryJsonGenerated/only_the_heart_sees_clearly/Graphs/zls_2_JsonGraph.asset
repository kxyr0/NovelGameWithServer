  guid: zls2_choice_questions_after_grandfather_ask_ivan
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  - character: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: bab_nyura
  lines:
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 27
    richText: "\u0411\u0430\u0431 \u041D\u044E\u0440, \u0430 \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0438\u0442\u0435
      \u043E\u0431 \u0418\u0432\u0430\u043D\u0435."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u043E \u0432\u0437\u0433\u043B\u044F\u0434\u0435 \u0411\u0430\u0431
      \u041D\u044E\u0440\u044B \u043C\u0435\u043B\u044C\u043A\u0430\u0435\u0442 \u0434\u0435\u0432\u0438\u0447\u044C\u0435
      \u043E\u0437\u043E\u0440\u0441\u0442\u0432\u043E."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 2
    richText: "\u041F\u043E\u043D\u0440\u0430\u0432\u0438\u043B\u0441\u044F, \u043D\u0435\u0431\u043E\u0441\u044C?"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u0441\u043C\u0443\u0449\u0435\u043D\u043D\u043E \u043E\u0442\u043C\u0430\u0445\u0438\u0432\u0430\u0435\u0442\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 12
    richText: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E,
      \u0437\u0430\u0447\u0435\u043C \u0441\u043F\u0440\u043E\u0441\u0438\u043B\u0430?
      \u0421\u0434\u0430\u043B\u0441\u044F \u043E\u043D \u043C\u043D\u0435\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 28
    richText: "\u0414\u0430 \u0442\u0430\u043A, \u043F\u0440\u043E\u0441\u0442\u043E
      \u043A \u0441\u043B\u043E\u0432\u0443 \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C.
      \u041B\u044E\u0431\u043E\u043F\u044B\u0442\u043D\u043E \u0441\u0442\u0430\u043B\u043E\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0411\u0430\u0431 \u041D\u044E\u0440\u0430 \u0441\u043C\u0435\u0451\u0442\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 2
    richText: "\u041B\u044E\u0431\u043E\u043F\u044B\u0442\u0441\u0442\u0432\u043E
      - \u043D\u0435 \u043F\u043E\u0440\u043E\u043A, \u0432\u043D\u0443\u0447\u0435\u043D\u044C\u043A\u0430,
      \u0430 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438\u2026
      \u0410 \u0412\u0430\u043D\u044C\u043A\u0430 \u0443 \u043D\u0430\u0441 \u043F\u0430\u0440\u0435\u043D\u044C
      \u0432\u0438\u0434\u043D\u044B\u0439. \u0414\u0435\u0432\u043A\u0438 \u0432\u043E\u043A\u0440\u0443\u0433
      \u043D\u0435\u0433\u043E \u0442\u0430\u043A \u0438 \u0432\u044C\u044E\u0442\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 2
    richText: "\u0427\u0430\u0441\u0442\u043E \u043C\u0435\u043D\u044F \u043F\u0440\u043E\u0432\u0435\u0434\u044B\u0432\u0430\u0435\u0442,
      \u0437\u0430\u0431\u043E\u0440 \u0432\u043E\u043D \u043F\u043E\u0434\u043F\u0440\u0430\u0432\u0438\u043B,
      \u0434\u0440\u043E\u0432 \u043D\u0430\u043A\u043E\u043B\u043E\u043B. \u0425\u043E\u0440\u043E\u0448\u0438\u0439
      \u043F\u0430\u0440\u0435\u043D\u044C, \u0445\u043E\u0442\u044C \u0438 \u043C\u043E\u043B\u0447\u0430\u043B\u0438\u0432\u044B\u0439,
      \u043A\u0430\u043A \u043F\u0435\u043D\u044C \u0433\u043E\u0440\u0435\u043B\u044B\u0439\u2026
      \u0422\u044B \u043F\u0440\u0438\u0441\u043C\u043E\u0442\u0440\u0438\u0441\u044C
      - \u043C\u043E\u0436\u0435\u0442, \u0441\u0443\u0436\u0435\u043D\u044B\u043C
      \u0442\u0435\u0431\u0435 \u0431\u0443\u0434\u0435\u0442."
    style: {fileID: 0}
    authorComment: 
