  guid: zls2_dialogue_030_forest_run
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u043E\u0437\u0434\u0443\u0445\u0430 \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442.
      \u041E\u043D\u0430 \u043D\u0435\u0441\u0451\u0442\u0441\u044F \u043F\u0440\u043E\u0447\u044C,
      \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044F, \u043A\u0430\u043A \u0440\u0435\u0447\u043D\u0430\u044F
      \u043F\u0440\u043E\u0445\u043B\u0430\u0434\u0430 \u0442\u044F\u043D\u0435\u0442\u0441\u044F
      \u0437\u0430 \u043D\u0435\u0439, \u0431\u0443\u0434\u0442\u043E \u0442\u043E\u043D\u043A\u0430\u044F
      \u043D\u0438\u0442\u044C. \u041F\u043E\u0434 \u043D\u043E\u0433\u0438 \u043F\u043E\u043F\u0430\u0434\u0430\u044E\u0442\u0441\u044F
      \u043C\u0435\u043B\u043A\u0438\u0435 \u044F\u043C\u043A\u0438 \u0438 \u0431\u0443\u0433\u0440\u044B,
      \u0445\u0440\u0443\u0441\u0442\u044F\u0442 \u0432\u0435\u0442\u043A\u0438.
      \u041F\u043E\u0434 \u0440\u0435\u0431\u0440\u043E\u043C \u0449\u0435\u043C\u0438\u0442
      \u043E\u0442 \u0431\u0435\u0433\u0430, \u0434\u044B\u0445\u0430\u043D\u0438\u0435
      \u0441\u0431\u0438\u0432\u0430\u0435\u0442\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: '{playerName}'
    speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 28
    richText: "\u041D\u0435 \u043D\u0430\u0434\u043E \u0431\u044B\u043B\u043E \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0430\u0442\u044C
      \u0443\u0440\u043E\u043A\u0438 \u0444\u0438\u0437\u043A\u0443\u043B\u044C\u0442\u0443\u0440\u044B!"
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u043E \u043E\u043D\u0430 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442
      \u0431\u0435\u0436\u0430\u0442\u044C, \u043D\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044F
      \u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u0438 - \u0442\u043E\u043B\u044C\u043A\u043E
      \u0443\u0436\u0430\u0441."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u0430\u0434\u0430\u0435\u0442, \u0441\u0431\u0438\u0432\u0430\u044F
      \u043A\u043E\u043B\u0435\u043D\u0438 \u043E \u043A\u043E\u0440\u043D\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
      - \u0438 \u0441\u043D\u043E\u0432\u0430 \u0431\u0435\u0436\u0438\u0442, \u043D\u0435
      \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u044F \u0434\u043E\u0440\u043E\u0433\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u043E \u043B\u0438\u0446\u0443 \u0431\u043E\u043B\u044C\u043D\u043E
      \u0445\u043B\u0435\u0449\u0435\u0442 \u043F\u043B\u0435\u0442\u044C \u043F\u043B\u044E\u0449\u0430,
      \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044F \u0441\u0430\u0434\u043D\u044F\u0449\u0438\u0435
      \u043F\u043E\u043B\u043E\u0441\u044B."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u043E\u0433\u0438 \u0443\u0432\u044F\u0437\u0430\u044E\u0442
      \u0432 \u0442\u0440\u0430\u0432\u0435 - \u0440\u0435\u043F\u0435\u0439 \u0446\u0435\u043F\u043B\u044F\u0435\u0442
      \u0435\u0451, \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E,
      \u043D\u043E\u0440\u043E\u0432\u044F \u0437\u0430\u0434\u0435\u0440\u0436\u0430\u0442\u044C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: '{playerName}'
    speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 25
    richText: "\u0414\u044B\u0448\u0438! \u041F\u0440\u043E\u0441\u0442\u043E \u0434\u044B\u0448\u0438!
      \u0422\u043E\u043B\u044C\u043A\u043E \u043D\u0435 \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0439\u0441\u044F!"
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0422\u0440\u043E\u043F\u0438\u043D\u043A\u0430 \u043F\u0435\u0442\u043B\u044F\u0435\u0442,
      \u043F\u044B\u0442\u0430\u044F\u0441\u044C \u0437\u0430\u043F\u0443\u0442\u0430\u0442\u044C.
      \u0418\u043B\u0438 \u0442\u0430\u043A \u0442\u043E\u043B\u044C\u043A\u043E
      \u043A\u0430\u0436\u0435\u0442\u0441\u044F - \u043C\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u044C-\u0442\u043E
      \u0435\u0439 \u043D\u0435 \u0437\u043D\u0430\u043A\u043E\u043C\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u0430\u043A\u043E\u043D\u0435\u0446 - \u0434\u0435\u0440\u0435\u0432\u043D\u044F.
      \u0412\u043E\u0442 \u0443\u0436\u0435 \u043C\u0435\u043B\u044C\u043A\u0430\u044E\u0442
      \u0441\u0438\u043B\u0443\u044D\u0442\u044B \u0434\u043E\u043C\u043E\u0432,
      \u043E\u0441\u0432\u0435\u0449\u0435\u043D\u043D\u044B\u0435 \u043E\u043A\u043D\u0430.
      \u041D\u043E {playerName} \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0442\u043E\u043B\u044C\u043A\u043E \u043A\u043E\u0433\u0434\u0430 \u043D\u0430
      \u043F\u043E\u043B\u043D\u043E\u0439 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438
      \u0432\u0440\u0435\u0437\u0430\u0435\u0442\u0441\u044F \u0432\u2026"
    style: {fileID: 0}
    authorComment: 
