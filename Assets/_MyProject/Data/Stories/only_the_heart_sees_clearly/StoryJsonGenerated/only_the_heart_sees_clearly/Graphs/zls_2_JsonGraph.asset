      {playerName} \u043F\u0435\u0440\u0435\u0441\u0438\u043B\u0438\u0432\u0430\u0435\u0442
      \u0441\u0435\u0431\u044F \u0438 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435
      \u0431\u043E\u043B\u0435\u0437\u043D\u0435\u043D\u043D\u043E\u0435 \u043B\u044E\u0431\u043E\u043F\u044B\u0442\u0441\u0442\u0432\u043E."
    style: {fileID: 0}
