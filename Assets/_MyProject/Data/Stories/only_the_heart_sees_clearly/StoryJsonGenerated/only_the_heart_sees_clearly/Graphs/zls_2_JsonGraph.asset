  guid: zls2_dialogue_005_morning_join
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u0430\u0445\u043D\u0435\u0442 \u0441\u0432\u0435\u0436\u0435\u0438\u0441\u043F\u0435\u0447\u0435\u043D\u043D\u044B\u043C
      \u0445\u043B\u0435\u0431\u043E\u043C, \u0438 \u043E\u0442 \u044D\u0442\u043E\u0433\u043E
      \u0430\u0440\u043E\u043C\u0430\u0442\u0430 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u0435\u0435 - \u0445\u043E\u0442\u044F
      \u0441\u0435\u0440\u0434\u0446\u0435 \u0432\u0441\u0435 \u0435\u0449\u0451
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442 \u043A\u043E\u043B\u043E\u0442\u0438\u0442\u044C\u0441\u044F
      \u0442\u0440\u0435\u0432\u043E\u0436\u043D\u043E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u0436\u043C\u0443\u0440\u0438\u0442\u0441\u044F, \u0432\u0434\u044B\u0445\u0430\u044F
      \u043F\u0440\u0438\u044F\u0442\u043D\u044B\u0439 \u0437\u0430\u043F\u0430\u0445."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041C\u0438\u0440 \u0434\u043B\u044F \u043D\u0435\u0451 \u0432\u043D\u043E\u0432\u044C
      \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u043E\u0431\u044B\u0447\u043D\u044B\u043C,
      \u0434\u0435\u0440\u0435\u0432\u0435\u043D\u0441\u043A\u0438\u043C \u0438 \u043F\u0440\u0438\u0432\u0435\u0442\u043B\u0438\u0432\u044B\u043C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u0437 \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u0439 \u043A\u043E\u043C\u043D\u0430\u0442\u044B
      \u0434\u043E\u043D\u043E\u0441\u044F\u0442\u0441\u044F \u0448\u0430\u0440\u043A\u0430\u044E\u0449\u0438\u0435
      \u0437\u0432\u0443\u043A\u0438: \u0431\u0430\u0431 \u041D\u044E\u0440\u0430
      \u0443\u0436\u0435 \u0432\u0441\u0442\u0430\u043B\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: '{playerName}'
    speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 17
    richText: "\u0412\u043E\u0442 \u0431\u044B \u043C\u043D\u0435 \u0441\u0442\u043E\u043B\u044C\u043A\u043E
      \u044D\u043D\u0435\u0440\u0433\u0438\u0438\u2026"
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u043B\u0435\u043D\u0438\u0432\u043E \u0441\u043F\u043E\u043B\u0437\u0430\u0435\u0442
      \u0441 \u043A\u0440\u043E\u0432\u0430\u0442\u0438, \u0441\u0442\u0443\u043F\u0430\u044F
      \u0431\u043E\u0441\u044B\u043C\u0438 \u043D\u043E\u0433\u0430\u043C\u0438 \u043D\u0430
      \u043F\u0440\u043E\u0445\u043B\u0430\u0434\u043D\u044B\u0439 \u0434\u043E\u0449\u0430\u0442\u044B\u0439
      \u043F\u043E\u043B. \u041C\u0435\u043B\u044C\u043A\u043E\u043C \u043B\u043E\u0432\u0438\u0442
      \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435 \u043E\u0442\u0440\u0430\u0436\u0435\u043D\u0438\u0435
      \u0432 \u0437\u0435\u0440\u043A\u0430\u043B\u0435 \u0438 \u0434\u043E\u0441\u0430\u0434\u043B\u0438\u0432\u043E
      \u043C\u043E\u0440\u0449\u0438\u0442\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: '{playerName}'
    speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 9
    richText: "\u041D\u0443\u0436\u043D\u043E \u043F\u0440\u0438\u0432\u0435\u0441\u0442\u0438
      \u0441\u0435\u0431\u044F \u0432 \u043F\u043E\u0440\u044F\u0434\u043E\u043A,
      \u043D\u0435 \u0442\u043E \u0411\u0430\u0431 \u041D\u044E\u0440\u0430 \u0440\u0435\u0448\u0438\u0442,
      \u0447\u0442\u043E \u044F \u0432\u0438\u0434\u0435\u043B\u0430 \u043F\u043E\u043A\u043E\u0439\u043D\u0438\u043A\u0430\u2026"
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u043D\u0430\u043A\u043B\u043E\u043D\u044F\u0435\u0442\u0441\u044F
      \u043A \u0441\u0443\u043C\u043A\u0435, \u0447\u0442\u043E\u0431\u044B \u0434\u043E\u0441\u0442\u0430\u0442\u044C
      \u043E\u0434\u0435\u0436\u0434\u0443."
    style: {fileID: 0}
    authorComment: 
