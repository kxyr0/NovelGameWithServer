  guid: zls2_choice_questions_after_grandfather_ivan_ask_mom_common
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 0
