  guid: zls2_choice_questions_start_ask_mom_common
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: bab_nyura
  - character: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0411\u0430\u0431 \u041D\u044E\u0440\u0430 \u043A\u0438\u0432\u0430\u0435\u0442,
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u044F \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C,
      \u0438 \u043A\u0440\u0435\u043F\u043A\u043E \u0441\u0436\u0438\u043C\u0430\u044F
      \u043F\u0430\u043B\u044C\u0446\u0430\u043C\u0438 \u043A\u0440\u0430\u0439 \u0441\u043A\u0430\u0442\u0435\u0440\u0442\u0438,
      - \u0442\u0430\u043A \u0447\u0442\u043E \u0431\u0435\u043B\u0435\u044E\u0442
      \u043A\u043E\u0441\u0442\u044F\u0448\u043A\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 0
    richText: "\u0422\u0430\u043A-\u0442\u043E \u043E\u043D\u043E \u0442\u0430\u043A,
      \u0434\u0430 \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u043E\u0442 \u0441\u043D\u044B
      \u0435\u0439 \u043F\u043E\u0441\u043B\u0435 \u0442\u043E\u0433\u043E \u0441\u043B\u0443\u0447\u0430\u044F
      \u0441\u043D\u0438\u043B\u0438\u0441\u044C \u0442\u0430\u043A\u0438\u0435,
      \u0447\u0442\u043E \u043E\u043D\u0430 \u043F\u043E \u043D\u043E\u0447\u0430\u043C
      \u043A\u0440\u0438\u0447\u0430\u043B\u0430\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u0432\u0437\u0434\u0440\u0430\u0433\u0438\u0432\u0430\u0435\u0442,
      \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u044F \u0442\u0443 \u0441\u0442\u0440\u0430\u043D\u043D\u0443\u044E
      \u0441\u0447\u0438\u0442\u0430\u043B\u043E\u0447\u043A\u0443, \u043D\u043E
      \u0442\u0443\u0442 \u0436\u0435 \u0433\u043E\u043D\u0438\u0442 \u043B\u0438\u0448\u043D\u0438\u0435
      \u043C\u044B\u0441\u043B\u0438 \u043F\u0440\u043E\u0447\u044C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 9
    richText: "\u042D\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043E\u0432\u043F\u0430\u0434\u0435\u043D\u0438\u0435\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 17
    richText: "\u0410 \u0441\u043D\u044B \u043E\u043D\u0438, \u0434\u0435\u0442\u043E\u043D\u044C\u043A\u0430,
      \u043D\u0435 \u0432\u0440\u0443\u0442\u2026"
