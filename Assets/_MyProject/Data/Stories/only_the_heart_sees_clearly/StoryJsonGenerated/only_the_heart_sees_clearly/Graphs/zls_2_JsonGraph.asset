  guid: zls2_dialogue_036_knees
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: bab_nyura
  lines:
  - speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 6
    richText: "\u0411\u0430\u0442\u044E\u0448\u043A\u0438, \u0430 \u0447\u0435\u0433\u043E
      \u043A\u043E\u043B\u0435\u043D\u0438 \u043A\u0440\u043E\u0432\u044F\u0442!?"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0432\u0441\u043F\u043B\u0435\u0441\u043A\u0438\u0432\u0430\u0435\u0442
      \u0440\u0443\u043A\u0430\u043C\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u043E\u0442\u043C\u0430\u0445\u0438\u0432\u0430\u0435\u0442\u0441\u044F:
      \u041D\u0438\u0447\u0435\u0433\u043E \u0441\u0442\u0440\u0430\u0448\u043D\u043E\u0433\u043E,
      \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043F\u043E\u0442\u043A\u043D\u0443\u043B\u0430\u0441\u044C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0411\u0430\u0431 \u041D\u044E\u0440\u0430 \u0432\u043E\u0440\u0447\u0438\u0442
      \u0441\u0435\u0431\u0435 \u043F\u043E\u0434 \u043D\u043E\u0441: \u041A\u043E\u043D\u0435\u0447\u043D\u043E.
      \u041C\u043E\u043B\u043E\u0434\u0451\u0436\u044C \u0442\u0435\u043F\u0435\u0440\u044C
      \u0432\u0441\u0451 \xAB\u043D\u0438\u0447\u0435\u0433\u043E \u0441\u0442\u0440\u0430\u0448\u043D\u043E\u0433\u043E\xBB.
      \u0410 \u043F\u043E\u0442\u043E\u043C \u0441 \u0433\u0430\u043D\u0433\u0440\u0435\u043D\u043E\u0439
      \u0432 \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u0443."
    style: {fileID: 0}
    authorComment: 
