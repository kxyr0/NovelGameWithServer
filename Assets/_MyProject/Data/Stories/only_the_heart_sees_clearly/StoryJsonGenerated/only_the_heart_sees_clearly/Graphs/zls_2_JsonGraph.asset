  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u043E\u0434\u0445\u043E\u0434\u044F \u043A \u043A\u0430\u043B\u0438\u0442\u043A\u0435,
      \u043E\u043D\u0430 \u0441\u043B\u044B\u0448\u0438\u0442 \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0439
      \u0433\u043E\u043B\u043E\u0441."
    style: {fileID: 0}
    authorComment: 
  - speakerId: bab_nyura
    speakerNameHint: "\u0411\u0430\u0431 \u041D\u044E\u0440\u0430"
    speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 2
    richText: "\u041E, \u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044C? \u0425\u043E\u0440\u043E\u0448\u043E.
      \u041F\u043E\u0441\u0442\u0430\u0432\u044C \u043D\u0430 \u0441\u0442\u043E\u043B.
      \u0412\u0435\u0447\u0435\u0440\u043E\u043C \u0431\u043B\u0438\u043D\u043E\u0432
      \u043D\u0430\u0436\u0430\u0440\u0438\u043C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u043A\u0438\u0432\u0430\u0435\u0442, \u0441\u0442\u0430\u0432\u0438\u0442
      \u043A\u043E\u0440\u0437\u0438\u043D\u043A\u0443, \u0437\u0430\u0442\u0435\u043C
      \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F \u0437\u0430
      \u0434\u043E\u043C\u0430\u0448\u043D\u0438\u0435 \u0445\u043B\u043E\u043F\u043E\u0442\u044B."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u043E \u0438 \u0442\u0443\u0442, \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F,
      \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u043C\u0435\u0441\u0442\u043E
      \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u043C \u043F\u0440\u0430\u0432\u0438\u043B\u0430\u043C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: bab_nyura
    speakerNameHint: "\u0411\u0430\u0431 \u041D\u044E\u0440\u0430"
    speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 14
    richText: "\u041A\u0442\u043E \u0436 \u0442\u0430\u043A \u043F\u043E\u0434\u043C\u0435\u0442\u0430\u0435\u0442?
      \u041C\u0435\u0441\u0442\u0438 \u043D\u0443\u0436\u043D\u043E \u043E\u0442
      \u043F\u043E\u0440\u043E\u0433\u0430 \u0432 \u0443\u0433\u043E\u043B."
    style: {fileID: 0}
    authorComment: 
  - speakerId: bab_nyura
    speakerNameHint: "\u0411\u0430\u0431 \u041D\u044E\u0440\u0430"
    speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 17
    richText: "\u0412\u0441\u0451 \u0434\u043E\u0431\u0440\u043E \u0432\u0435\u0434\u044C
      \u0438\u0437 \u0434\u043E\u043C\u0430 \u0432\u044B\u043C\u0435\u0442\u0435\u0448\u044C,
      \u0434\u0430 \u0435\u0449\u0435 \u0438 \u0431\u0435\u0437 \u0436\u0435\u043D\u0438\u0445\u0430
      \u043E\u0441\u0442\u0430\u043D\u0435\u0448\u044C\u0441\u044F!"
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u0442\u043E\u043B\u044C\u043A\u043E \u043A\u0430\u0447\u0430\u0435\u0442
      \u0433\u043E\u043B\u043E\u0432\u043E\u0439, \u043D\u043E \u0431\u0430\u0431\u0443\u0448\u043A\u0443
      \u0441\u043B\u0443\u0448\u0430\u0435\u0442, \u0441\u043C\u0435\u0442\u0430\u044F
      \u043C\u0443\u0441\u043E\u0440 \u043A \u0443\u0433\u043B\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: bab_nyura
    speakerNameHint: "\u0411\u0430\u0431 \u041D\u044E\u0440\u0430"
    speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 14
    richText: "\u0422\u044B \u043C\u043E\u0442\u0430\u0439 \u043D\u0430 \u0443\u0441,
