  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0423 \u043A\u0430\u043B\u0438\u0442\u043A\u0438 \u0435\u0451 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442
      \u0431\u0430\u0431 \u041D\u044E\u0440\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u0442\u0438\u0445\u043E \u043E\u0439\u043A\u0430\u0435\u0442,
      \u043F\u044B\u0442\u0430\u044F\u0441\u044C \u043E\u0442\u0434\u044B\u0448\u0430\u0442\u044C\u0441\u044F.
      \u041B\u0451\u0433\u043A\u0438\u0435 \u0433\u043E\u0440\u044F\u0442, \u0432
      \u0443\u0448\u0430\u0445 \u0441\u0442\u043E\u0438\u0442 \u0433\u0443\u043B,
      \u0430 \u043F\u0435\u0440\u0435\u0434 \u0433\u043B\u0430\u0437\u0430\u043C\u0438
      \u0432\u0441\u0451 \u0435\u0449\u0451 \u0441\u0442\u043E\u0438\u0442 \u0431\u043B\u0435\u0434\u043D\u043E\u0435,
      \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E\u0435 \u043B\u0438\u0446\u043E
      \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u043A\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: bab_nyura
    speakerNameHint: "\u0411\u0430\u0431 \u041D\u044E\u0440\u0430"
    speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 6
    richText: "\u0422\u044B \u0447\u0435\u0433\u043E, \u043A\u0430\u0441\u0430\u0442\u043E\u0447\u043A\u0430?"
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0422\u043E\u043B\u044C\u043A\u043E \u0447\u0442\u043E \u0442\u0435\u0440\u0437\u0430\u0432\u0448\u0438\u0439
      \u0435\u0451 \u0441\u0442\u0440\u0430\u0445 \u0443\u043F\u043E\u043B\u0437\u0430\u0435\u0442,
      \u043F\u0440\u0438\u0442\u0430\u0438\u0432\u0448\u0438\u0441\u044C \u0433\u0434\u0435-\u0442\u043E
      \u0432 \u0436\u0438\u0432\u043E\u0442\u0435. \u041E\u043D\u0430 \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F
      \u0443\u0441\u043F\u043E\u043A\u043E\u0438\u0442\u044C\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: '{playerName}'
    speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 28
    richText: "\u0410 \u044F\u2026 \u0420\u0435\u0448\u0438\u043B\u0430 \u0431\u0435\u0433\u0430\u0442\u044C
      \u043D\u0430\u0447\u0430\u0442\u044C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: bab_nyura
    speakerNameHint: "\u0411\u0430\u0431 \u041D\u044E\u0440\u0430"
    speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 6
    richText: "\u041A\u0442\u043E \u0436 \u0432 \u0442\u0430\u043A\u043E\u0435-\u0442\u043E
      \u0432\u0440\u0435\u043C\u044F \u0431\u0435\u0433\u0430\u0435\u0442, \u0432\u043D\u0443\u0447\u043A\u0430?"
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u043D\u0435\u043B\u043E\u0432\u043A\u043E \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F,
      \u043F\u043E\u0436\u0430\u0432 \u043F\u043B\u0435\u0447\u0430\u043C\u0438 \u0438
      \u043F\u0440\u0438\u0442\u0432\u043E\u0440\u044F\u044F\u0441\u044C \u0434\u0443\u0440\u043E\u0447\u043A\u043E\u0439."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u0440\u0438\u0437\u043D\u0430\u0432\u0430\u0442\u044C\u0441\u044F
      \u043E \u0442\u043E\u043C, \u0447\u0442\u043E \u0432\u0438\u0434\u0435\u043B\u0430
      \u043A\u043E\u0433\u043E-\u0442\u043E \u0438\u043B\u0438 \u0447\u0442\u043E-\u0442\u043E
      \u0441\u0442\u0440\u0430\u043D\u043D\u043E\u0435 \u0443 \u0440\u0435\u043A\u0438
      \u043D\u0435 \u0445\u043E\u0447\u0435\u0442 - \u0435\u0449\u0451 \u043F\u0440\u0438\u043C\u0443\u0442
      \u0437\u0430 \u0441\u0443\u043C\u0430\u0441\u0448\u0435\u0434\u0448\u0443\u044E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041C\u043E\u0436\u0435\u0442, \u044D\u0442\u043E \u0438\u0433\u0440\u044B
      \u0440\u0430\u0437\u0431\u0443\u0448\u0435\u0432\u0430\u0432\u0448\u0435\u0433\u043E\u0441\u044F
      \u0432\u043E\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041C\u043E\u0436\u0435\u0442, \u044D\u0442\u043E \u043C\u0435\u0441\u0442\u043D\u0430\u044F
      \u0440\u0435\u0431\u044F\u0442\u043D\u044F \u0440\u0435\u0448\u0438\u043B\u0430
      \u0442\u0430\u043A \u0433\u043B\u0443\u043F\u043E \u0440\u0430\u0437\u044B\u0433\u0440\u0430\u0442\u044C
      \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0443\u044E \u0434\u0435\u0432\u0447\u043E\u043D\u043A\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041C\u043E\u0436\u0435\u0442, \u043C\u043E\u0436\u0435\u0442, \u043C\u043E\u0436\u0435\u0442\u2026"
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u0443 \u0433\u043B\u0443\u043F\u043E \u0436\u0435. \u041D\u043E
      \u0432\u0441\u0451 \u0432\u043D\u0443\u0442\u0440\u0438 \u0441\u0436\u0438\u043C\u0430\u0435\u0442\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0442 \u0441\u0442\u0440\u0430\u0445\u0430 \u0438 \u043E\u0442
      \u0430\u0431\u0441\u0443\u0440\u0434\u043D\u043E\u0433\u043E \u0447\u0443\u0432\u0441\u0442\u0432\u0430,
      \u0447\u0442\u043E \u043A\u0442\u043E-\u0442\u043E \u0432\u0438\u0434\u0438\u0442
      \u0435\u0451 \u043D\u0430\u0441\u043A\u0432\u043E\u0437\u044C."
    style: {fileID: 0}
    authorComment: 
