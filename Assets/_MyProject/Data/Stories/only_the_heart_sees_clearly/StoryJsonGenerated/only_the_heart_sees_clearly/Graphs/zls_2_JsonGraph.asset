    emotion: 0
    richText: "\u0422\u0435\u043B\u0435\u0444\u043E\u043D \u043B\u0435\u0442\u0438\u0442
      \u043D\u0430 \u043F\u043E\u0434\u0443\u0448\u043A\u0443 \u044D\u043A\u0440\u0430\u043D\u043E\u043C
