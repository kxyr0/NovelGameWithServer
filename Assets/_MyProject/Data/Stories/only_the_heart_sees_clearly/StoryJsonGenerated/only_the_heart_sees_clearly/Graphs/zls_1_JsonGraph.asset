  exit: {fileID: 0}
  guid: zls1_dialogue_069
  nodeTitle: 
  activeCharacters: []
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u0430\u0445\u043D\u0435\u0442 \u0433\u0430\u0440\u044C\u044E,
      \u043F\u043E\u043B\u044B\u043D\u044C\u044E \u0438 \u0447\u0435\u043C-\u0442\u043E
      \u0435\u0449\u0451 - \u0433\u043E\u0440\u044C\u043A\u0438\u043C, \u0442\u0435\u0440\u043F\u043A\u0438\u043C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F \u0431\u0435\u0436\u0430\u0442\u044C,
      \u043D\u043E \u043D\u043E\u0433\u0438 \u043A\u0430\u0436\u0443\u0442\u0441\u044F
      \u0441\u0432\u0438\u043D\u0446\u043E\u0432\u044B\u043C\u0438, \u043F\u044F\u0442\u043A\u0438
      \u0436\u0436\u0451\u0442. \u041E\u043D\u0430 \u0440\u0430\u0441\u0442\u0435\u0440\u044F\u043D\u043D\u043E
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043F\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u0430\u043C,
      \u043D\u0435 \u0437\u043D\u0430\u044F, \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0420\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u0443\u044F\u0441\u044C
      \u0447\u0443\u0442\u044C\u0451\u043C, {playerName} \u0440\u0435\u0448\u0430\u0435\u0442\u2026"
    style: {fileID: 0}
    authorComment: 
