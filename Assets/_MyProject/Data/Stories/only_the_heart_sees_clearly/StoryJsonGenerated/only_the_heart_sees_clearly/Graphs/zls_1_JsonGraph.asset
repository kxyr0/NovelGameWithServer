  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: zls1_dialogue_011
  nodeTitle: 
  activeCharacters: []
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u044F\u0432\u043D\u043E
      \u043F\u043E\u0447\u0442\u0435\u043D\u043D\u044B\u0439 \u0432\u043E\u0437\u0440\u0430\u0441\u0442,
      \u043A\u043D\u0438\u0433\u0430 \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0442\u0430\u043A\u0442\u0438\u043B\u044C\u043D\u043E \u043F\u0440\u0438\u044F\u0442\u043D\u043E\u0439,
      \u0430 \u0442\u043A\u0430\u043D\u0435\u0432\u044B\u0439 \u043F\u0435\u0440\u0435\u043F\u043B\u0435\u0442
      - \u0447\u0443\u0442\u044C \u0448\u0435\u0440\u043E\u0445\u043E\u0432\u0430\u0442\u044B\u043C
      \u043D\u0430 \u043E\u0449\u0443\u043F\u044C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u043F\u0430\u0445\u043D\u0435\u0442 \u0441\u0442\u0430\u0440\u043E\u0439
      \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u043E\u0439, \u0430
      \u044F\u0440\u043A\u0438\u0435 \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0438
      \u0441\u043E \u0441\u043A\u0430\u0437\u043E\u0447\u043D\u044B\u043C\u0438 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430\u043C\u0438
      \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E \u043E\u0442\u0437\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u0432 \u043D\u0435\u0439 - \u0432 \u0433\u0440\u0443\u0434\u0438 \u0447\u0442\u043E-\u0442\u043E
      \u043A\u043E\u043B\u0435\u0442, \u0432\u0437\u044B\u0432\u0430\u044F \u043A
      \u043F\u043E\u0447\u0442\u0438 \u0437\u0430\u0431\u044B\u0442\u043E\u043C\u0443
      \u0447\u0443\u0432\u0441\u0442\u0432\u0443 \u0438\u0437 \u0434\u0430\u0432\u043D\u0435\u0433\u043E
      \u0434\u0435\u0442\u0441\u0442\u0432\u0430\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u0434\u043E\u0441\u0442\u0430\u0435\u0442 \u043A\u043E\u0448\u0435\u043B\u0435\u043A
      \u0438 \u043F\u0440\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442 \u043A\u0443\u043F\u044E\u0440\u0443,
      \u043D\u0435 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u044F \u0446\u0435\u043D\u0443."
    style: {fileID: 0}
    authorComment: 
