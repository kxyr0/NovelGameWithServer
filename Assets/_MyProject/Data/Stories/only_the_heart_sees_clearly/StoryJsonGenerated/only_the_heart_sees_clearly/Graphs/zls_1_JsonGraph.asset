  guid: zls1_dialogue_068
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: b092cf2fff92485faa2bbfcb27d6c17d, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: leshy
  - character: {fileID: 11400000, guid: 9534537272154786bc2c439ab64e5733, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: kashchey
  - character: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u043E\u0442 \u043B\u0435\u0448\u0438\u0439, \u043E\u0431\u043B\u0435\u0437\u043B\u044B\u0439
      \u0438 \u0437\u043B\u043E\u0439, \u0442\u044F\u043D\u0435\u0442 \u043A \u043D\u0435\u0439
      \u0440\u0443\u043A\u0443 \u0438\u0437 \u0441\u0430\u043C\u043E\u0439 \u043B\u0435\u0441\u043D\u043E\u0439
      \u0433\u0443\u0449\u0438, \u0448\u0435\u043F\u0447\u0435\u0442 \u0435\u0451
      \u0438\u043C\u044F \u0442\u044B\u0441\u044F\u0447\u0435\u0439 \u0433\u043E\u043B\u043E\u0441\u043E\u0432
      \u043B\u0438\u0441\u0442\u0432\u044B."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: b092cf2fff92485faa2bbfcb27d6c17d, type: 2}
    emotion: 17
    richText: "{playerName}\u2026 {playerName}\u2026 {playerName}\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u043E\u0442\u0441\u0442\u0443\u043F\u0430\u0435\u0442
      \u043D\u0430\u0437\u0430\u0434 \u0438 \u0441\u043F\u0438\u043D\u043E\u0439
      \u0443\u043F\u0438\u0440\u0430\u0435\u0442\u0441\u044F \u0432\u2026 \u043A\u043E\u0433\u043E-\u0442\u043E.
      \u041E\u043D\u0430 \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      - \u0442\u0435\u043B\u043E \u0441\u043B\u043E\u0432\u043D\u043E \u0434\u0432\u0438\u0433\u0430\u0435\u0442\u0441\u044F
      \u0441\u0430\u043C\u043E, \u0432\u043E\u043F\u0440\u0435\u043A\u0438 \u0435\u0451
      \u0432\u043E\u043B\u0435."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u042D\u0442\u043E\u0442\u043A\u0442\u043E-\u0442\u043E - \u041A\u043E\u0449\u0435\u0439.
      \u041E\u043D\u0430 \u0443\u0437\u043D\u0430\u0435\u0442 \u0435\u0433\u043E
      \u0441\u0440\u0430\u0437\u0443. \u041E\u043D \u043D\u0435 \u0434\u0432\u0438\u0433\u0430\u0435\u0442\u0441\u044F,
      \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 - \u043F\u0440\u043E\u0441\u0442\u043E
      \u0441\u0438\u0434\u0438\u0442 \u043D\u0430 \u0442\u0440\u043E\u043D\u0435,
      \u0430 \u0438\u0437 \u0435\u0433\u043E \u0433\u043B\u0430\u0437 \u0441\u0442\u0435\u043A\u0430\u0435\u0442
      \u0447\u0451\u0440\u043D\u0430\u044F, \u043A\u0430\u043A \u0441\u043C\u043E\u043B\u044C,
      \u0436\u0438\u0434\u043A\u043E\u0441\u0442\u044C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 9534537272154786bc2c439ab64e5733, type: 2}
    emotion: 17
    richText: "\u2026."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412 \u0433\u0440\u0443\u0434\u0438 \u043D\u0430\u0440\u0430\u0441\u0442\u0430\u0435\u0442
      \u043F\u0430\u043D\u0438\u043A\u0430, \u0441\u043A\u043E\u043B\u044C\u0437\u043A\u0430\u044F
      \u0438 \u0445\u043E\u043B\u043E\u0434\u043D\u0430\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 23
    richText: "\u042D\u0442\u043E \u043C\u043E\u0439 \u0441\u043E\u043D, \u0437\u043D\u0430\u0447\u0438\u0442
      \u044F \u0435\u0433\u043E \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u0443\u044E.
      \u041D\u0443\u0436\u043D\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u0434\u043E\u0441\u0447\u0438\u0442\u0430\u0442\u044C
      \u0434\u043E \u0434\u0435\u0441\u044F\u0442\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 21
    richText: "\u041E\u0434\u0438\u043D, \u0434\u0432\u0430\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u043D\u0435\u0437\u0430\u043F\u043D\u043E \u043F\u043E\u0434
      \u0431\u043E\u0441\u044B\u043C\u0438 \u043D\u043E\u0433\u0430\u043C\u0438 \u0432\u0441\u043F\u044B\u0445\u0438\u0432\u0430\u0435\u0442
      \u0442\u0440\u043E\u043F\u0430 - \u043D\u0435 \u0438\u0437 \u0443\u0442\u043E\u043F\u0442\u0430\u043D\u043D\u043E\u0439
      \u0437\u0435\u043C\u043B\u0438, \u043D\u0435 \u0438\u0437 \u0436\u0435\u043B\u0442\u043E\u0433\u043E
      \u043A\u0438\u0440\u043F\u0438\u0447\u0430, \u043A\u0430\u043A \u0432 \u0441\u0442\u0430\u0440\u043E\u0439
      \u0434\u043E\u0431\u0440\u043E\u0439 \u0441\u043A\u0430\u0437\u043A\u0435 -
      \u0438\u0437 \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442\u0430,
      \u0442\u0435\u043F\u043B\u043E\u0433\u043E, \u0448\u0435\u0440\u043E\u0445\u043E\u0432\u0430\u0442\u043E\u0433\u043E,
      \u043F\u043E\u0445\u043E\u0436\u0435\u0433\u043E \u043D\u0430 \u0447\u044C\u044E-\u0442\u043E
      \u043A\u043E\u0436\u0443 \u0441 \u0447\u0451\u0440\u043D\u044B\u043C\u0438
      \u0432\u0435\u043D\u0430\u043C\u0438 \u0441\u0442\u0440\u043E\u043A."
    style: {fileID: 0}
    authorComment: 
