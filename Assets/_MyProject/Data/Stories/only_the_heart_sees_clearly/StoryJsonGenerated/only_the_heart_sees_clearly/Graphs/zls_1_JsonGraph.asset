  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: zls1_dialogue_065
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u0435\u0442\u044C - \u043E\u0434\u043D\u0430 \u043F\u0430\u043B\u043A\u0430,
      \u0434\u0430 \u0438 \u0442\u0430 \xAB\u0435\u0448\u043A\u0430\xBB, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
      \u043F\u0440\u043E\u043F\u0430\u0434\u0430\u0435\u0442, \u0441\u0442\u043E\u0438\u0442
      \u0442\u043E\u043B\u044C\u043A\u043E \u0435\u0439 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0434\u0440\u0443\u0433\u043E\u0439 \u0431\u043E\u043A. \u0421\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0439
      \u043D\u0435\u0442."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: '{playerName}'
    speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 20
    richText: "\u041D\u0443 \u043A\u043E\u043D\u0435\u0447\u043D\u043E\u2026"
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u043E\u0434\u0436\u0430\u0432 \u0433\u0443\u0431\u044B, {playerName}
      \u0433\u0430\u0441\u0438\u0442 \u044D\u043A\u0440\u0430\u043D \u0438 \u043B\u0438\u0446\u043E\u043C
      \u0443\u0442\u044B\u043A\u0430\u0435\u0442\u0441\u044F \u0432 \u043F\u043E\u0434\u0443\u0448\u043A\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0422\u0435\u043C\u043D\u043E. \u0412 \u0433\u043B\u0443\u0445\u043E\u0439
      \u0442\u0438\u0448\u0438\u043D\u0435 \u043F\u043E\u0441\u043A\u0440\u0438\u043F\u044B\u0432\u0430\u0435\u0442
      \u043F\u043E\u043B\u043E\u0432\u0438\u0446\u0430 \u0438 \u0433\u0440\u0435\u043C\u0438\u0442
      \u043F\u043E\u0441\u0443\u0434\u0430 - \u0442\u043E \u0445\u043E\u0434\u0438\u0442
      \u0411\u0430\u0431 \u041D\u044E\u0440\u0430. \u0413\u0434\u0435-\u0442\u043E
      \u043F\u043E\u0434 \u043F\u043E\u043B\u043E\u043C \u0441\u043A\u0440\u0435\u0431\u0435\u0442\u0441\u044F
      \u043C\u044B\u0448\u044C."
    style: {fileID: 0}
    authorComment: 
