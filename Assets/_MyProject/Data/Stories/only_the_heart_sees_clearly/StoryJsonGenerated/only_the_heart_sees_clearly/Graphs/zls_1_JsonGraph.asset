  lines:
  - speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 17
    richText: "\u041D\u0430 \u0441\u043E\u043D \u0433\u0440\u044F\u0434\u0443\u0449\u0438\u0439,
      \u0447\u0442\u043E\u0431\u044B \u043B\u0443\u0447\u0448\u0435 \u0441\u043F\u0430\u043B\u043E\u0441\u044C
      \u0438 \u0434\u0443\u0448\u0430 \u043D\u0435 \u043C\u0435\u0442\u0430\u043B\u0430\u0441\u044C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u043F\u043E\u0441\u043B\u0443\u0448\u043D\u043E \u0432\u044B\u043F\u0438\u0432\u0430\u0435\u0442
      \u043D\u0430\u043F\u0438\u0442\u043E\u043A."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041C\u043E\u043B\u043E\u043A\u043E \u0441\u043B\u0430\u0434\u043A\u043E\u0435,
      \u0433\u0443\u0441\u0442\u043E\u0435 \u0438 \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442
      \u043E \u0434\u0435\u0442\u0441\u0442\u0432\u0435. \u041F\u043E \u0442\u0435\u043B\u0443
      \u043E\u0442 \u043D\u0435\u0433\u043E \u0440\u0430\u0437\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043F\u0440\u0438\u044F\u0442\u043D\u043E\u0435 \u0442\u0435\u043F\u043B\u043E
      \u0438 \u043D\u0430 \u0434\u0443\u0448\u0435 \u043D\u0430 \u043A\u0430\u043A\u043E\u0435-\u0442\u043E
      \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0435 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u0435\u0435."
    style: {fileID: 0}
    authorComment: 
