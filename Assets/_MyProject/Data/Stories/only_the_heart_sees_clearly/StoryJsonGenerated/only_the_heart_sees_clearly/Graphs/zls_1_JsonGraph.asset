  guid: zls1_dialogue_055
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u0437 \u043E\u043A\u043D\u0430 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432\u0438\u0434 \u043D\u0430 \u043B\u0435\u0441."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 17
    richText: "\u041F\u0440\u044F\u043C\u043E \u043A\u0430\u043A \u0432 \u0434\u043E\u0440\u043E\u0433\u043E\u043C
      \u043E\u0442\u0435\u043B\u0435."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412 \u0441\u0443\u043C\u0435\u0440\u043A\u0430\u0445 \u0434\u0435\u0440\u0435\u0432\u044C\u044F
      \u043A\u0430\u0436\u0443\u0442\u0441\u044F \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u043C\u0438
      \u0447\u0435\u0440\u043D\u044B\u043C\u0438 \u0432\u0435\u043B\u0438\u043A\u0430\u043D\u0430\u043C\u0438,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u043F\u043E\u0434\u0441\u0442\u0443\u043F\u0430\u044E\u0442 \u043A \u0441\u0430\u043C\u043E\u043C\u0443
      \u0437\u0430\u0431\u043E\u0440\u0443. \u0421\u043B\u044B\u0448\u043D\u043E,
      \u043A\u0430\u043A \u0433\u0434\u0435-\u0442\u043E \u0432\u0434\u0430\u043B\u0435\u043A\u0435
      \u0443\u0445\u0430\u0435\u0442 \u0441\u043E\u0432\u0430. {playerName} \u043F\u043E\u0441\u043F\u0435\u0448\u043D\u043E
      \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043E\u043A\u043D\u0430
      \u043D\u0430 \u0437\u0430\u0441\u043E\u0432 \u0438 \u0437\u0430\u0434\u0435\u0440\u0433\u0438\u0432\u0430\u0435\u0442
      \u0437\u0430\u043D\u0430\u0432\u0435\u0441\u043A\u0438 - \u0442\u043E\u043D\u043A\u0438\u0439
      \u0441\u0438\u0442\u0435\u0446, \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0430\u044E\u0449\u0438\u0439
      \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0443 \u0431\u043B\u0435\u0434\u043D\u044B\u0439,
      \u043F\u0440\u0438\u0437\u0440\u0430\u0447\u043D\u044B\u0439 \u0441\u0432\u0435\u0442
      \u043B\u0443\u043D\u044B, \u0434\u0435\u043B\u0430\u044E\u0449\u0438\u0439
      \u043E\u0447\u0435\u0440\u0442\u0430\u043D\u0438\u044F \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432
      \u043F\u0443\u0433\u0430\u044E\u0449\u0438\u043C\u0438."
    style: {fileID: 0}
    authorComment: 
