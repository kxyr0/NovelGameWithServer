  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: zls1_dialogue_040
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: bab_nyura
  lines:
  - speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 2
    richText: "\u0413\u0443\u043B\u044F\u0435\u0448\u044C? \u042D\u0445, \u043C\u043E\u043B\u043E\u0434\u043E\u0441\u0442\u044C\u2026
      \u044F \u0432 \u0442\u0432\u043E\u0438 \u0433\u043E\u0434\u044B\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u043A\u0438\u0432\u0430\u0435\u0442, \u0443\u043B\u044B\u0431\u0430\u044F\u0441\u044C,
      \u0438 \u0441\u043B\u0443\u0448\u0430\u0435\u0442. \u0415\u0439 \u0432\u0441\u0435\u0433\u0434\u0430
      \u043D\u0440\u0430\u0432\u0438\u043B\u0438\u0441\u044C \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u0435
      \u0438\u0441\u0442\u043E\u0440\u0438\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 2
    richText: "\u042F \u0432 \u0442\u0432\u043E\u0438 \u0433\u043E\u0434\u044B \u0442\u043E\u0436\u0435
      \u0433\u0443\u043B\u044F\u043B\u0430, \u043C\u0430\u043C\u043A\u0443 \u043D\u0435
      \u0441\u043B\u0443\u0448\u0430\u043B\u0430, \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u043B\u0430\u0441\u044C
      \u0437\u0430\u0442\u0435\u043C\u043D\u043E, \u0434\u0430 \u0432\u0441\u0435
      \u0436\u0434\u0430\u043B\u0430, \u043A\u043E\u0433\u0434\u0430 \u0436\u0438\u0437\u043D\u044C-\u0442\u043E
      \u043D\u0430\u0447\u043D\u0435\u0442\u0441\u044F - \u0442\u043E \u0436\u0435\u043D\u0438\u0445\u0430
      \u0436\u0434\u0430\u043B\u0430, \u043A\u043E\u0433\u0434\u0430 \u0441\u043E\u0441\u0432\u0430\u0442\u0430\u0435\u0442,
      \u0442\u043E \u0440\u0430\u0431\u043E\u0442\u044B. \u0412\u0441\u0435 \u0434\u0443\u043C\u0430\u043B\u0430,
      \u0432\u043E\u0442, \u043F\u043E\u0442\u043E\u043C, \u0434\u0430 \u043F\u043E\u0442\u043E\u043C,
      \u0442\u043E\u0440\u043E\u043F\u0438\u043B\u0430 \u0432\u0440\u0435\u043C\u044F\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u043F\u043E\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442
      \u043F\u043B\u0430\u0442\u043E\u043A, \u0443\u0441\u043C\u0435\u0445\u0430\u044F\u0441\u044C
      \u0441\u0430\u043C\u043E\u0439 \u0441\u0435\u0431\u0435. {playerName} \u0432\u0438\u0434\u0438\u0442
      \u0432 \u044D\u0442\u043E\u0439 \u0443\u0441\u043C\u0435\u0448\u043A\u0435
      \u0441\u0432\u0435\u0442\u043B\u0443\u044E \u0433\u0440\u0443\u0441\u0442\u044C,
      \u0438 \u043E\u0442 \u043D\u0435\u0435 \u0441\u0436\u0438\u043C\u0430\u0435\u0442\u0441\u044F
      \u0447\u0442\u043E-\u0442\u043E \u0432\u043D\u0443\u0442\u0440\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 2
    richText: "\u0410 \xAB\u043F\u043E\u0442\u043E\u043C\xBB - \u043E\u043D\u043E
      \u0432\u043E\u0442 \u043E\u043D\u043E, \u0432\u043D\u0443\u0447\u043A\u0430.
      \u0421\u0435\u0439\u0447\u0430\u0441\u2026 \u0422\u0430\u043A \u0447\u0442\u043E
      \u0433\u0443\u043B\u044F\u0439, \u043C\u0438\u043B\u0430\u044F, \u0438 \u043D\u0435
      \u0442\u043E\u0440\u043E\u043F\u0438\u0441\u044C. \u0413\u043E\u0440\u043E\u0434
      \u043E\u0442 \u0442\u0435\u0431\u044F \u043D\u0438\u043A\u0443\u0434\u0430
      \u043D\u0435 \u0434\u0435\u043D\u0435\u0442\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0411\u0430\u0431 \u041D\u044E\u0440\u0430 \u0437\u0430\u043C\u043E\u043B\u043A\u0430\u0435\u0442,
      \u0443\u0441\u0442\u0443\u043F\u0430\u044F \u043C\u0435\u0441\u0442\u043E \u0432\u0435\u0447\u0435\u0440\u043D\u0435\u0439
      \u0442\u0438\u0448\u0438\u043D\u0435. \u0413\u0434\u0435-\u0442\u043E \u0432\u0434\u0430\u043B\u0435\u043A\u0435
      \u0442\u044F\u0432\u043A\u0430\u0435\u0442 \u043F\u0435\u0441 - \u043D\u0430
      \u043D\u0435\u0433\u043E \u0433\u0440\u0443\u0431\u043E \u0440\u0443\u0433\u0430\u0435\u0442\u0441\u044F
      \u043C\u0435\u0441\u0442\u043D\u044B\u0439 \u043C\u0443\u0436\u0438\u043A,
      \u043E\u0431\u0437\u044B\u0432\u0430\u044F \u0448\u0430\u043B\u043E\u043F\u0430\u0435\u043C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u0437\u0435\u0432\u0430\u0435\u0442, \u043F\u0440\u0438\u043A\u0440\u044B\u0432\u0430\u044F
      \u0440\u043E\u0442 \u043B\u0430\u0434\u043E\u043D\u044C\u044E."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 14
    richText: "\u041E\u0445, \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430
      \u044F \u0442\u0435\u0431\u044F \u043E\u043F\u044F\u0442\u044C. \u0414\u0435\u043D\u044C-\u0442\u043E
      \u0434\u043B\u0438\u043D\u043D\u044B\u0439 \u0431\u044B\u043B\u2026 \u0422\u044B
      \u0438\u0434\u0438, \u0443\u043C\u044B\u0432\u0430\u0439\u0441\u044F \u0434\u0430
      \u043B\u043E\u0436\u0438\u0441\u044C. \u0423\u0442\u0440\u043E \u0432\u0435\u0447\u0435\u0440\u0430
      \u043C\u0443\u0434\u0440\u0435\u043D\u0435\u0435. \u0410 \u0437\u0430\u0432\u0442\u0440\u0430
      \u0434\u0435\u043B\u0430 \u0441 \u0442\u043E\u0431\u043E\u0439 \u043F\u043E
      \u0445\u043E\u0437\u044F\u0439\u0441\u0442\u0432\u0443 \u043F\u0435\u0440\u0435\u0434\u0435\u043B\u0430\u0435\u043C\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u043A\u0438\u0432\u0430\u0435\u0442 \u0438, \u043F\u043E\u0436\u0435\u043B\u0430\u0432
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E\u0439 \u043D\u043E\u0447\u0438,
      \u0443\u0445\u043E\u0434\u0438\u0442 \u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C\u0441\u044F
      \u043A\u043E \u0441\u043D\u0443."
    style: {fileID: 0}
    authorComment: 
