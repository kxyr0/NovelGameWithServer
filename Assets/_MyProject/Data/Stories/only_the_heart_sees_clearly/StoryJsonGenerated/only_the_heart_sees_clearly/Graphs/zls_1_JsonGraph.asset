  guid: zls1_dialogue_035
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  - character: {fileID: 11400000, guid: 6f61c44e0a134a16bf759933ce1fd8f6, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: ivan
  lines:
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 2
    richText: "\u041F\u0435\u0440\u0432\u044B\u0439 - \u043F\u043E\u0442\u043E\u043C\u0443
      \u0447\u0442\u043E \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439?"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u043D\u0435 \u043E\u0431\u0438\u0436\u0430\u0435\u0442\u0441\u044F,
      \u0432\u043C\u0435\u0441\u0442\u043E \u044D\u0442\u043E\u0433\u043E \u043F\u0440\u043E\u0441\u0442\u043E\u0434\u0443\u0448\u043D\u043E
      \u043F\u043E\u0436\u0438\u043C\u0430\u0435\u0442 \u043F\u043B\u0435\u0447\u0430\u043C\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 6f61c44e0a134a16bf759933ce1fd8f6, type: 2}
    emotion: 2
    richText: "\u0412\u0440\u043E\u0434\u0435 \u0442\u043E\u0433\u043E."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u0432\u0437\u0434\u044B\u0445\u0430\u0435\u0442 \u0441
      \u043F\u0440\u0438\u0442\u0432\u043E\u0440\u043D\u044B\u043C \u0440\u0430\u0437\u043E\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u0438\u0435\u043C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 13
    richText: "\u0417\u043D\u0430\u0447\u0438\u0442, \u0435\u0441\u043B\u0438 \u043C\u043D\u0435
      \u0432\u0434\u0440\u0443\u0433 \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F
      \u043A\u0430\u0432\u0430\u043B\u0435\u0440, \u0432\u044B\u0431\u0438\u0440\u0430\u0442\u044C
      \u043D\u0435 \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u0432\u0430\u043D \u0445\u043C\u044B\u043A\u0430\u0435\u0442."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 6f61c44e0a134a16bf759933ce1fd8f6, type: 2}
    emotion: 13
    richText: "\u0421\u0443\u0434\u044F \u043F\u043E \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0443
      \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u043E\u0432 - \u043D\u0435
      \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
