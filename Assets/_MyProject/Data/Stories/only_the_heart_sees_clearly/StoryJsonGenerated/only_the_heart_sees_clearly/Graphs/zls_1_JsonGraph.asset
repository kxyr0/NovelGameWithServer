  guid: zls1_dialogue_002
  nodeTitle: 
  activeCharacters: []
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u0442\u0430\u0440\u0438\u043A\u0438 \u043F\u043E\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u044E\u0442,
      \u0447\u0442\u043E \u043C\u0435\u0441\u0442\u043E \u0435\u0441\u0442\u044C
      \u0432 \u043C\u0438\u0440\u0435 \u043E\u0434\u043D\u043E, \u043D\u0435 \u043E\u0442\u043C\u0435\u0447\u0435\u043D\u043D\u043E\u0435
      \u043D\u0438 \u043D\u0430 \u043E\u0434\u043D\u043E\u0439 \u043A\u0430\u0440\u0442\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0422\u0430\u043C \u0436\u0438\u0432\u043E\u0435 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442
      \u043C\u0435\u0440\u0442\u0432\u043E\u0435, \u0438 \u0437\u043E\u0432\u0435\u0442
      \u044D\u0442\u043E \u043C\u0435\u0441\u0442\u043E \u0441\u0442\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432,
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u044B\u0445 \u043F\u0435\u0440\u0435\u0441\u0442\u0443\u043F\u0438\u0442\u044C
      \u0442\u0443 \u0442\u043E\u043D\u043A\u0443\u044E \u043D\u0435\u0437\u0440\u0438\u043C\u0443\u044E
      \u0433\u0440\u0430\u043D\u044C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0422\u043E\u043B\u044C\u043A\u043E \u043A\u043E\u0441\u043D\u0443\u0432\u0448\u0438\u0441\u044C
      \u0435\u0451, \u043D\u0435 \u043F\u044B\u0442\u0430\u0439\u0441\u044F \u0432\u043E\u0440\u043E\u0442\u0438\u0442\u044C
      \u0432\u0441\u0451 \u043D\u0430\u0437\u0430\u0434 - \u043F\u043E\u0434\u0447\u0438\u043D\u0438
      \u0441\u0435\u0431\u0435 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u0443\u044E
      \u0442\u0435\u043D\u044C \u0438\u043B\u0438 \u043E\u043D\u0430 \u043F\u043E\u0434\u0447\u0438\u043D\u0438\u0442
