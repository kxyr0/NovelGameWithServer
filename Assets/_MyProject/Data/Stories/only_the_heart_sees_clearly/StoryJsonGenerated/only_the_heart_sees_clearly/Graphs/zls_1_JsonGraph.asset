  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: zls1_dialogue_064
  nodeTitle: 
  activeCharacters: []
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u0437 \u043A\u0430\u0440\u043C\u0430\u043D\u0430 \u0431\u0435\u0441\u0448\u0443\u043C\u043D\u043E
      \u0432\u044B\u043F\u0430\u0434\u0430\u0435\u0442 \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0439,
      \u043F\u043E\u0442\u0440\u0435\u043F\u0430\u043D\u043D\u044B\u0439 \u043F\u043E
      \u043A\u0440\u0430\u044F\u043C \u043A\u043B\u043E\u0447\u043E\u043A \u043F\u043B\u043E\u0442\u043D\u043E\u0433\u043E
      \u043A\u0430\u0440\u0442\u043E\u043D\u0430 - \u0432\u0438\u0437\u0438\u0442\u043A\u0430
      \u0435\u0435 \u043F\u0441\u0438\u0445\u043E\u043B\u043E\u0433\u0430, \u0421\u0442\u0430\u043D\u0438\u0441\u043B\u0430\u0432\u0430
      \u041F\u0435\u0442\u0440\u043E\u0432\u0438\u0447\u0430."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u0433\u043E\u0440\u044C\u043A\u043E \u0443\u0441\u043C\u0435\u0445\u0430\u0435\u0442\u0441\u044F,
      \u043F\u0440\u044F\u0447\u0430 \u043A\u0430\u0440\u0442\u043E\u043D\u043A\u0443
      \u043E\u0431\u0440\u0430\u0442\u043D\u043E \u0432 \u043A\u0430\u0440\u043C\u0430\u043D.
      \u042D\u0442\u043E \u043E\u043D \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u043E\u0432\u0430\u043B
      \u0435\u0439 \u043F\u0440\u0435\u0441\u043B\u043E\u0432\u0443\u0442\u0443\u044E
      \u0441\u043C\u0435\u043D\u0443 \u043E\u0431\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438,
      \u043D\u043E \u0432\u0440\u044F\u0434 \u043B\u0438 \u0438\u043C\u0435\u043B
      \u0432 \u0432\u0438\u0434\u0443 \u043C\u0435\u0441\u0442\u043E, \u0433\u0434\u0435
      \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442 \u043B\u043E\u0432\u0438\u0442
      \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430 \u0432\u0435\u0440\u0445\u0443\u0448\u043A\u0435
      \u0441\u043E\u0441\u043D\u044B, \u0430 \u043C\u0435\u0441\u0442\u043D\u044B\u0435
      \u043F\u0430\u0440\u043D\u0438 \u0432\u044B\u0433\u043B\u044F\u0434\u044F\u0442
      \u0442\u0430\u043A, \u0431\u0443\u0434\u0442\u043E \u0432\u044B\u0448\u043B\u0438
      \u0438\u0437 \u0441\u043A\u0430\u0437\u043A\u0438, \u0442\u043E\u043B\u044C\u043A\u043E
      \u0447\u0442\u043E \u0441\u043F\u0435\u0448\u0438\u0432\u0448\u0438\u0441\u044C
      \u0441 \u0441\u0435\u0440\u043E\u0433\u043E \u0432\u043E\u043B\u043A\u0430\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041A \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0443 \u043E\u043D\u0430
      \u0442\u044F\u043D\u0435\u0442\u0441\u044F \u043C\u0430\u0448\u0438\u043D\u0430\u043B\u044C\u043D\u043E
      - \u0434\u0443\u0440\u043D\u0430\u044F \u043F\u0440\u0438\u0432\u044B\u0447\u043A\u0430
      \u043B\u0438\u0441\u0442\u0430\u0442\u044C \u043D\u0430 \u043D\u043E\u0447\u044C
      \u0433\u043B\u044F\u0434\u044F \u0441\u043E\u0446\u0441\u0435\u0442\u0438."
    style: {fileID: 0}
    authorComment: 
