    richText: "\u0427\u0443\u0442\u044C \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0432\u0448\u0438\u0441\u044C,
      \u043E\u043D \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442 {playerName:acc}.
      \u0412 \u0435\u0433\u043E \u0432\u0437\u0433\u043B\u044F\u0434\u0435 \u043C\u0435\u043B\u044C\u043A\u0430\u0435\u0442
      \u0447\u0442\u043E-\u0442\u043E \u043F\u043E\u0445\u043E\u0436\u0435\u0435
      \u043D\u0430 \u0438\u043D\u0442\u0435\u0440\u0435\u0441."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 84b3167982060924db8ff8418c005cb0, type: 2}
    emotion: 13
    richText: "\u041D\u0435\u0433\u043E\u0436\u0435 \u0434\u0435\u0432\u0443\u0448\u043A\u0430\u043C
      \u0432 \u043E\u0434\u0438\u043D\u043E\u0447\u043A\u0443 \u0432 \u0442\u0430\u043A\u043E\u0439
      \u0447\u0430\u0441 \u0440\u0430\u0437\u0433\u0443\u043B\u0438\u0432\u0430\u0442\u044C!"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u0443\u0441\u043C\u0435\u0445\u0430\u0435\u0442\u0441\u044F,
      \u0443\u0437\u043D\u0430\u0432 \u0432 \u043D\u0451\u043C \u0442\u043E\u0433\u043E
      \u0441\u0430\u043C\u043E\u0433\u043E \u0432\u0441\u0430\u0434\u043D\u0438\u043A\u0430,
      \u0447\u0442\u043E \u043F\u0430\u0440\u043E\u0439 \u0447\u0430\u0441\u043E\u0432
      \u0440\u0430\u043D\u0435\u0435 \u0435\u0434\u0432\u0430 \u043D\u0435 \u0441\u043D\u0451\u0441
      \u0435\u0451 \u0441 \u043D\u043E\u0433."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 20
    richText: "\u0410 \u044F \u043A\u0430\u043A \u043A\u043E\u0448\u043A\u0430 -
      \u0433\u0443\u043B\u044F\u044E \u0441\u0430\u043C\u0430 \u043F\u043E \u0441\u0435\u0431\u0435."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u0435\u0446 \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0435\u0442 \u0435\u0451 \u0441
      \u043D\u043E\u0433 \u0434\u043E \u0433\u043E\u043B\u043E\u0432\u044B. {playerName}
      \u0432\u043E\u0437\u043C\u0443\u0449\u0435\u043D\u043D\u043E \u0444\u044B\u0440\u043A\u0430\u0435\u0442,
      \u0441\u043A\u0440\u0435\u0449\u0438\u0432\u0430\u044F \u043D\u0430 \u0433\u0440\u0443\u0434\u0438
      \u0440\u0443\u043A\u0438, \u043D\u043E \u0442\u043E\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E \u043A\u0438\u0432\u0430\u0435\u0442,
      \u043F\u043E\u0434\u0432\u043E\u0434\u044F \u0438\u0442\u043E\u0433\u0438 \u0441\u0432\u043E\u0435\u0439
      \u043E\u0446\u0435\u043D\u043A\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 84b3167982060924db8ff8418c005cb0, type: 2}
    emotion: 2
    richText: "\u0412\u0438\u0436\u0443, \u043D\u0435 \u043C\u0435\u0441\u0442\u043D\u0430\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 13
    richText: "\u0410 \u0442\u044B \u0447\u0442\u043E, \u0437\u0434\u0435\u0448\u043D\u0438\u0439
      \u0434\u043E\u0437\u043E\u0440\u043D\u044B\u0439?"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u0441\u043C\u0435\u0451\u0442\u0441\u044F, \u0438 {playerName}
      \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E \u0434\u043B\u044F
      \u0441\u0435\u0431\u044F \u043E\u0442\u043C\u0435\u0447\u0430\u0435\u0442,
      \u0447\u0442\u043E \u043F\u0440\u0435\u0431\u044B\u0432\u0430\u043D\u0438\u0435
      \u0437\u0434\u0435\u0441\u044C \u043E\u0431\u0435\u0449\u0430\u0435\u0442 \u0441\u0442\u0430\u0442\u044C
      \u0434\u043B\u044F \u043D\u0435\u0435 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u043C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u0430\u043C\u0430 \u0442\u043E\u0433\u043E \u043D\u0435 \u0437\u0430\u043C\u0435\u0447\u0430\u044F,
      \u043E\u043D\u0430 \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F \u0443\u0433\u043E\u043B\u043A\u0430\u043C\u0438
      \u0433\u0443\u0431."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 84b3167982060924db8ff8418c005cb0, type: 2}
    emotion: 13
    richText: "\u0414\u043B\u044F \u0442\u0430\u043A\u043E\u0439 \u043A\u0440\u0430\u0441\u0438\u0432\u043E\u0439
      \u0434\u0435\u0432\u0443\u0448\u043A\u0438 \u043A\u0435\u043C \u0443\u0433\u043E\u0434\u043D\u043E
      \u0441\u0442\u0430\u043D\u0443. \u041D\u043E \u0432\u043E\u043E\u0431\u0449\u0435
      \u044F \u0418\u0432\u0430\u043D. \u041F\u0435\u0440\u0432\u044B\u0439 \u043F\u0430\u0440\u0435\u043D\u044C
      \u043D\u0430 \u0434\u0435\u0440\u0435\u0432\u043D\u0435."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName}, \u043F\u0440\u0438\u0449\u0443\u0440\u0438\u0432\u0448\u0438\u0441\u044C,
      \u0441\u043A\u043B\u043E\u043D\u044F\u0435\u0442 \u0433\u043E\u043B\u043E\u0432\u0443
      \u0432 \u0431\u043E\u043A. \u0422\u0435\u043F\u0435\u0440\u044C \u0435\u0451
      \u043E\u0447\u0435\u0440\u0435\u0434\u044C \u0435\u0433\u043E \u0440\u0430\u0437\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0442\u044C:
      \u0441\u0438\u043B\u044C\u043D\u044B\u0435 \u0440\u0443\u043A\u0438, \u0448\u0438\u0440\u043E\u043A\u0430\u044F
      \u0433\u0440\u0443\u0434\u044C, \u043F\u0440\u043E\u043F\u0438\u0442\u0430\u043D\u043D\u0430\u044F
      \u043F\u043E\u0442\u043E\u043C \u0438 \u043F\u044B\u043B\u044C\u044E \u043B\u044C\u043D\u044F\u043D\u0430\u044F
      \u0440\u0443\u0431\u0430\u0448\u043A\u0430..."
    style: {fileID: 0}
    authorComment: "Unknown speaker candidate: {playerName}, \u043F\u0440\u0438\u0449\u0443\u0440\u0438\u0432\u0448\u0438\u0441\u044C,
      \u0441\u043A\u043B\u043E\u043D\u044F\u0435\u0442 \u0433\u043E\u043B\u043E\u0432\u0443
      \u0432 \u0431\u043E\u043A. \u0422\u0435\u043F\u0435\u0440\u044C \u0435\u0451
      \u043E\u0447\u0435\u0440\u0435\u0434\u044C \u0435\u0433\u043E \u0440\u0430\u0437\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0442\u044C"
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0445\u043C\u044B\u043A\u0430\u0435\u0442."
    style: {fileID: 0}
    authorComment: 
