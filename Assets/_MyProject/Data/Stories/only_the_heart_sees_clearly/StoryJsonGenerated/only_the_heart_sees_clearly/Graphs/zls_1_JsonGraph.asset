  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: zls1_dialogue_037
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  - character: {fileID: 11400000, guid: 6f61c44e0a134a16bf759933ce1fd8f6, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: ivan
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041A\u043E\u043D\u044C \u0444\u044B\u0440\u043A\u0430\u0435\u0442,
      \u043C\u043E\u0442\u0430\u044F \u0433\u043E\u043B\u043E\u0432\u043E\u0439,
      \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043E\u0433\u043D\u0430\u0442\u044C
      \u043E\u0442 \u0441\u0435\u0431\u044F \u043D\u0430\u0437\u043E\u0439\u043B\u0438\u0432\u0443\u044E
      \u043C\u043E\u0448\u043A\u0430\u0440\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u043D\u0435\u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E
      \u0442\u044F\u043D\u0435\u0442 \u043A \u043D\u0435\u043C\u0443 \u0440\u0443\u043A\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: '{playerName}'
    speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 19
    richText: "\u041C\u043E\u0436\u043D\u043E \u043F\u043E\u0433\u043B\u0430\u0434\u0438\u0442\u044C?"
    style: {fileID: 0}
    authorComment: 
  - speakerId: ivan
    speakerNameHint: "\u0418\u0432\u0430\u043D"
    speaker: {fileID: 11400000, guid: 6f61c44e0a134a16bf759933ce1fd8f6, type: 2}
    emotion: 17
    richText: "\u0413\u043B\u0430\u0434\u044C, \u0447\u0435\u0433\u043E \u043D\u0435\u0442-\u0442\u043E?
      \u041E\u043D \u0441\u043C\u0438\u0440\u043D\u044B\u0439, \u043D\u0435 \u0443\u043A\u0443\u0441\u0438\u0442."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E
      \u043A\u0430\u0441\u0430\u0435\u0442\u0441\u044F \u0433\u0440\u0438\u0432\u044B
      \u043B\u0430\u0434\u043E\u043D\u044C\u044E. \u0416\u0435\u0441\u0442\u043A\u0438\u0435
      \u0432\u043E\u043B\u043E\u0441\u043A\u0438 \u0449\u0435\u043A\u043E\u0447\u0443\u0442
      \u043A\u043E\u0436\u0443, \u0447\u0443\u0442\u044C \u043F\u043E\u043A\u0430\u043B\u044B\u0432\u0430\u044F
      - \u043D\u0435\u043F\u0440\u0438\u0432\u044B\u0447\u043D\u043E, \u043D\u043E
      \u043F\u0440\u0438\u044F\u0442\u043D\u043E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: '{playerName}'
    speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 9
    richText: "\u0422\u0430\u043A \u0436\u0438\u0432\u043E \u0438 \u043F\u043E-\u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u043C\u0443\u2026"
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041A\u043E\u043D\u044C \u0448\u0443\u043C\u043D\u043E \u0432\u044B\u0434\u044B\u0445\u0430\u0435\u0442
      \u0435\u0439 \u0432 \u043F\u0430\u043B\u044C\u0446\u044B \u0442\u0451\u043F\u043B\u044B\u0439,
      \u0447\u0443\u0442\u044C \u0432\u043B\u0430\u0436\u043D\u044B\u0439 \u0432\u043E\u0437\u0434\u0443\u0445,
      \u0438 \u043D\u0435 \u043E\u0442\u0441\u0442\u0440\u0430\u043D\u044F\u0435\u0442\u0441\u044F
      - \u0431\u0443\u0434\u0442\u043E \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
      \u0435\u0451, \u0441\u043E\u0433\u043B\u0430\u0448\u0430\u044F\u0441\u044C
      \u043D\u0430 \u044D\u0442\u043E \u0437\u043D\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u043E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: ivan
    speakerNameHint: "\u0418\u0432\u0430\u043D"
    speaker: {fileID: 11400000, guid: 6f61c44e0a134a16bf759933ce1fd8f6, type: 2}
    emotion: 2
    richText: "\u0412\u0438\u0434\u0438\u0448\u044C? \u041F\u0440\u0438\u0437\u043D\u0430\u043B
      \u0442\u0435\u0431\u044F \u0412\u043E\u0440\u043E\u043D."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D \u0443\u0441\u043C\u0435\u0445\u0430\u0435\u0442\u0441\u044F,
      \u0438 \u043F\u0440\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442 \u0435\u0439
      \u044F\u0431\u043B\u043E\u043A\u043E - \u0443\u0433\u043E\u0449\u0435\u043D\u0438\u0435
      \u0434\u043B\u044F \u043A\u043E\u043D\u044F."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u0441\u043A\u0430\u0440\u043C\u043B\u0438\u0432\u0430\u0435\u0442
      \u0435\u0433\u043E \u0412\u043E\u0440\u043E\u043D\u0443. \u0422\u043E\u0442
      \u043D\u0430 \u0441\u0435\u043A\u0443\u043D\u0434\u0443 \u0437\u0430\u043C\u0438\u0440\u0430\u0435\u0442,
      \u0433\u043B\u044F\u0434\u0438\u0442 \u043D\u0430 \u043D\u0435\u0451 \u043F\u043E\u0447\u0442\u0438
      \u043F\u043E-\u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0438,
      \u043D\u043E \u0432\u0441\u0435 \u0436\u0435 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
      \u043B\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u043E \u0438 \u0441\u043B\u044E\u043D\u044F\u0432\u0438\u0442
      \u0435\u0439 \u0440\u0443\u043A\u0443."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u043C\u043E\u0440\u0449\u0438\u0442\u0441\u044F
      \u0441 \u043D\u0435\u043F\u0440\u0438\u0432\u044B\u0447\u043A\u0438, \u043D\u043E
      \u0418\u0432\u0430\u043D, \u0443\u0432\u0438\u0434\u0435\u0432 \u0432 \u044D\u0442\u043E\u043C
      \u0431\u0440\u0435\u0437\u0433\u043B\u0438\u0432\u043E\u0441\u0442\u044C, \u043B\u0438\u0448\u044C
      \u0445\u043C\u044B\u043A\u0430\u0435\u0442."
    style: {fileID: 0}
    authorComment: 
  - speakerId: ivan
    speakerNameHint: "\u0418\u0432\u0430\u043D"
    speaker: {fileID: 11400000, guid: 6f61c44e0a134a16bf759933ce1fd8f6, type: 2}
    emotion: 13
    richText: "\u0413\u043E\u0440\u043E\u0434\u0441\u043A\u0430\u044F\u2026 \u0421\u043C\u0435\u0440\u043A\u0430\u0435\u0442\u0441\u044F
      \u0443\u0436. \u0414\u0430\u0432\u0430\u0439 \u043F\u0440\u043E\u0432\u043E\u0436\u0443."
    style: {fileID: 0}
    authorComment: 
