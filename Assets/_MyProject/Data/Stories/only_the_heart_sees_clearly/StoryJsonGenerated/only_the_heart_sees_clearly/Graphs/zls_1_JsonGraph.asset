  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412 \u0433\u043E\u043B\u043E\u0432\u0435 \u043D\u0435\u0432\u043E\u043B\u044C\u043D\u043E
      \u0432\u0441\u043F\u043B\u044B\u0432\u0430\u044E\u0442 \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0438
      \u0435\u0451 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E \u0434\u043D\u044F
      \u0432 \u043E\u0444\u0438\u0441\u0435. \u041A\u043E\u043B\u043B\u0435\u0433\u0438,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043E\u0442\u0432\u043E\u0434\u0438\u043B\u0438
      \u0433\u043B\u0430\u0437\u0430 \u0438 \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438
      \u0441 \u0443\u043D\u0438\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
      \u0436\u0430\u043B\u043E\u0441\u0442\u044C\u044E, \u043D\u043E \u0441\u043A\u0440\u044B\u0442\u043D\u043E
      \u0448\u0435\u043F\u0442\u0430\u043B\u0438\u0441\u044C \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439,
      \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u044F \u0435\u0451 \u043E\u0442\u0432\u0440\u0430\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E,
      \u0431\u0430\u043D\u0430\u043B\u044C\u043D\u0443\u044E \u0434\u0440\u0430\u043C\u0443\u2026"
    style: {fileID: 0}
    authorComment: 
