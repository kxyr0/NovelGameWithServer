    emotion: 9
    richText: "\u041C\u0435\u0441\u0442\u043D\u044B\u0435 \u0434\u0435\u0432\u043A\u0438
      \u043E\u0431\u044B\u0447\u043D\u043E \u043F\u0430\u0440\u0430\u043C\u0438 \u0445\u043E\u0434\u044F\u0442,
      \u043F\u043E\u043E\u0434\u0438\u043D\u043E\u0447\u043A\u0435 \u0447\u0443\u0440\u0430\u044E\u0442\u0441\u044F:
      \u043C\u0430\u043B\u043E \u043B\u0438 - \u0432\u043E\u043B\u043A\u0438, \u043C\u0435\u0434\u0432\u0435\u0434\u0438..."
