  guid: zls1_dialogue_032
  nodeTitle: 
  activeCharacters: []
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0413\u0434\u0435-\u0442\u043E \u0432\u0434\u0430\u043B\u0438 \u043B\u0430\u0435\u0442
      \u043F\u0451\u0441, \u0441\u043B\u044B\u0448\u0438\u0442\u0441\u044F \u0440\u0436\u0430\u043D\u0438\u0435
      \u043A\u043E\u0431\u044B\u043B. \u0411\u043E\u043A\u043E\u0432\u044B\u043C
      \u0437\u0440\u0435\u043D\u0438\u0435\u043C \u043E\u043D\u0430 \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442
      \u043E\u0434\u0438\u043D\u043E\u043A\u0443\u044E \u0444\u0438\u0433\u0443\u0440\u0443
      \u0443 \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u043E\u0433\u043E \u0437\u0430\u0431\u043E\u0440\u0430:
      \u043F\u0430\u0440\u0435\u043D\u044C, \u043D\u0435\u0431\u0440\u0435\u0436\u043D\u043E
      \u043E\u043F\u0435\u0440\u0435\u0432\u0448\u0438\u0441\u044C \u043D\u0430 \u043F\u0435\u0440\u0435\u043A\u043B\u0430\u0434\u0438\u043D\u0443,
      \u0434\u0435\u0440\u0436\u0438\u0442 \u043F\u043E\u0434 \u0443\u0437\u0434\u0446\u044B
      \u043A\u043E\u043D\u044F."
    style: {fileID: 0}
    authorComment: "Unknown speaker candidate: \u0413\u0434\u0435-\u0442\u043E \u0432\u0434\u0430\u043B\u0438
      \u043B\u0430\u0435\u0442 \u043F\u0451\u0441, \u0441\u043B\u044B\u0448\u0438\u0442\u0441\u044F
      \u0440\u0436\u0430\u043D\u0438\u0435 \u043A\u043E\u0431\u044B\u043B. \u0411\u043E\u043A\u043E\u0432\u044B\u043C
      \u0437\u0440\u0435\u043D\u0438\u0435\u043C \u043E\u043D\u0430 \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442
      \u043E\u0434\u0438\u043D\u043E\u043A\u0443\u044E \u0444\u0438\u0433\u0443\u0440\u0443
      \u0443 \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u043E\u0433\u043E \u0437\u0430\u0431\u043E\u0440\u0430"
