    emotion: 0
    richText: "\u0412\u043D\u0443\u0442\u0440\u0438 \u043B\u0435\u0436\u0430\u0442
      \u043F\u0443\u0447\u043A\u0438 \u0437\u0430\u0441\u0443\u0448\u0435\u043D\u043D\u044B\u0445
      \u0442\u0440\u0430\u0432 \u0438 \u043F\u043E\u0436\u0435\u043B\u0442\u0435\u0432\u0448\u0438\u0435
      \u043E\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0441\u0442\u0430\u0440\u044B\u0435
      \u043A\u043E\u043D\u0432\u0435\u0440\u0442\u044B \u0441 \u043F\u0438\u0441\u044C\u043C\u0430\u043C\u0438
