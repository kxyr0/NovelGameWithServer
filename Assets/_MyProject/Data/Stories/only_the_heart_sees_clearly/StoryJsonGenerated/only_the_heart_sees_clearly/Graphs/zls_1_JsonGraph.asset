  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0442 \u0435\u0433\u043E \u0437\u0430\u043F\u0430\u0445\u0430
      - \u0441\u0443\u0445\u043E\u0439 \u0442\u0440\u0430\u0432\u044B, \u043F\u043E\u0442\u0430,
      \u043A\u043E\u0436\u0438 - \u043A\u0440\u0443\u0436\u0438\u0442\u0441\u044F
      \u0433\u043E\u043B\u043E\u0432\u0430, \u0438 \u0435\u0439 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u0434\u0430\u0436\u0435 \u043D\u0435\u043B\u043E\u0432\u043A\u043E \u043E\u0442
      \u0442\u043E\u0433\u043E, \u043D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043F\u0440\u0438\u0442\u044F\u0433\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u043C
      \u0441\u0435\u0439\u0447\u0430\u0441 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0435\u0439 \u044D\u0442\u043E\u0442 \u043F\u0440\u043E\u0441\u0442\u043E\u0439
      \u0434\u0435\u0440\u0435\u0432\u0435\u043D\u0441\u043A\u0438\u0439 \u043F\u0430\u0440\u0435\u043D\u044C."
