  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u043C\u0430\u043B\u043E \u0432\u0435\u0440\u0438\u0442
      \u0432 \u043F\u0440\u0438\u043C\u0435\u0442\u044B, \u043D\u043E \u043F\u0440\u043E\u0438\u0437\u043D\u043E\u0441\u0438\u0442
      \u0444\u0440\u0430\u0437\u0443 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u0438 \u0432\u0434\u0443\u043C\u0447\u0438\u0432\u043E, \u043F\u043E\u0447\u0442\u0438
      \u043D\u0430\u0440\u0430\u0441\u043F\u0435\u0432, \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435
      \u0436\u0435\u043B\u0430\u044F, \u0447\u0442\u043E\u0431\u044B \u043A \u043D\u0435\u0439
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043A\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u043F\u0440\u0438\u0448\u0435\u043B
      - \u043F\u0443\u0441\u0442\u044C \u0434\u0430\u0436\u0435 \u0438 \u0432\u043E
      \u0441\u043D\u0435 - \u0438 \u0432\u044B\u0432\u0435\u043B \u0435\u0451 \u0438\u0437
      \u044D\u0442\u043E\u0433\u043E \u0442\u0443\u043F\u0438\u043A\u0430, \u0432
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u043D\u0430, \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
      \u0441\u0430\u043C\u0430 \u0441\u0435\u0431\u044F \u0438 \u0437\u0430\u0432\u0435\u043B\u0430."
