  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: zls1_dialogue_060
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: bab_nyura
  - character: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0442\u0441\u0442\u0430\u0432\u0438\u0432 \u043F\u0443\u0441\u0442\u0443\u044E
      \u043A\u0440\u0443\u0436\u043A\u0443, \u043E\u043D\u0430 \u043D\u0435\u0441\u043F\u0435\u0448\u043D\u043E
      \u0440\u0430\u0441\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442 \u043F\u043E\u0441\u0442\u0435\u043B\u044C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 2
    richText: "\u0417\u043D\u0430\u0435\u0448\u044C, \u043A\u0430\u043A \u0433\u043E\u0432\u043E\u0440\u044F\u0442?
      \u041D\u0430 \u043D\u043E\u0432\u043E\u043C \u043C\u0435\u0441\u0442\u0435
      \u0441\u043F\u044F\u0442 - \u043D\u0430 \u0441\u043E\u043D \u0436\u0435\u043D\u0438\u0445
      \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0437\u0430\u0431\u043E\u0442\u043B\u0438\u0432\u043E
      \u043F\u043E\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442 \u043F\u0443\u0437\u0430\u0442\u0443\u044E
      \u043F\u043E\u0434\u0443\u0448\u043A\u0443. \u0412\u0437\u0433\u043B\u044F\u0434
      \u0443 \u043D\u0435\u0451 \u043C\u044F\u0433\u043A\u0438\u0439, \u043B\u0430\u0441\u043A\u043E\u0432\u044B\u0439
      - \u043A\u0430\u043A \u0443 \u043C\u0430\u043C\u044B."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 2
    richText: "\u0421\u043A\u0430\u0436\u0438: \xAB\u0421\u043F\u043B\u044E \u043D\u0430
      \u043D\u043E\u0432\u043E\u043C \u043C\u0435\u0441\u0442\u0435 - \u043F\u0440\u0438\u0441\u043D\u0438\u0441\u044C
      \u0436\u0435\u043D\u0438\u0445 \u043D\u0435\u0432\u0435\u0441\u0442\u0435\xBB."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u0444\u044B\u0440\u043A\u0430\u0435\u0442, \u0441\u043C\u043E\u0440\u0449\u0438\u0432
      \u043D\u043E\u0441."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 22
    richText: "\u041D\u0443 \u0443\u0436 \u043D\u0435\u0442, \u043C\u043D\u0435 \u043F\u043E\u043A\u0430
      \u0438 \u0431\u0435\u0437 \u0436\u0435\u043D\u0438\u0445\u043E\u0432 \u043D\u0435\u043F\u043B\u043E\u0445\u043E."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 17
    richText: "\u041E\u043D \u0434\u0430\u0436\u0435 \u043D\u0435 \u043F\u043E\u043F\u044B\u0442\u0430\u043B\u0441\u044F
      \u0438\u0437\u0432\u0438\u043D\u0438\u0442\u044C\u0441\u044F\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 6
    richText: "\u041D\u0443 \u0447\u0442\u043E \u0436 \u0442\u044B \u0442\u0430\u043A?
      \u0410\u0432\u043E\u0441\u044C, \u0438 \u043F\u0440\u0430\u0432\u0434\u0430
      \u043F\u0440\u0438\u0441\u043D\u0438\u0442\u0441\u044F?"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u0443\u0441\u0442\u0430\u043B\u043E \u0432\u0437\u0434\u044B\u0445\u0430\u0435\u0442,
      \u043D\u043E \u0440\u0435\u0448\u0430\u0435\u0442 \u043D\u0435 \u0440\u0430\u0441\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0442\u044C
      \u0431\u0430\u0431\u0443\u0448\u043A\u0443 - \u0432 \u043A\u043E\u043D\u0446\u0435
      \u043A\u043E\u043D\u0446\u043E\u0432, \u044D\u0442\u043E \u0442\u0430\u043A\u0430\u044F
      \u043C\u0435\u043B\u043E\u0447\u044C, \u043D\u0435\u0441\u0447\u0430\u0441\u0442\u043D\u0430\u044F
      \u043F\u0430\u0440\u0430 \u0441\u043B\u043E\u0432."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 20
    richText: "\u0421\u043F\u043B\u044E \u043D\u0430 \u043D\u043E\u0432\u043E\u043C
      \u043C\u0435\u0441\u0442\u0435, \u043F\u0440\u0438\u0441\u043D\u0438\u0441\u044C
      \u0436\u0435\u043D\u0438\u0445 \u043D\u0435\u0432\u0435\u0441\u0442\u0435\u2026"
    style: {fileID: 0}
    authorComment: 
