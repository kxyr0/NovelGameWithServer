  exit: {fileID: 0}
  guid: zls1_dialogue_061
  nodeTitle: 
  activeCharacters: []
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u043F\u0440\u043E\u0438\u0437\u043D\u043E\u0441\u0438\u0442
      \u0441\u043B\u043E\u0432\u0430 \u0441\u043A\u043E\u0440\u043E\u0433\u043E\u0432\u043E\u0440\u043A\u043E\u0439,
      \u0435\u0434\u0432\u0430 \u0441\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044F
      \u0438\u0440\u043E\u043D\u0438\u0447\u043D\u0443\u044E \u0443\u043B\u044B\u0431\u043A\u0443.
      \u0415\u0439 \u043F\u0440\u0430\u0432\u0434\u0430 \u0441\u043C\u0435\u0448\u043D\u043E
      \u043E\u0442 \u0441\u044E\u0440\u0440\u0435\u0430\u043B\u0438\u0441\u0442\u0438\u0447\u043D\u043E\u0441\u0442\u0438
      \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438: \u043E\u043D\u0430, \u0432\u0437\u0440\u043E\u0441\u043B\u0430\u044F
      \u0436\u0435\u043D\u0449\u0438\u043D\u0430, \u0436\u0435\u0440\u0442\u0432\u0430
      \u043A\u043E\u0440\u043F\u043E\u0440\u0430\u0442\u0438\u0432\u043D\u044B\u0445
      \u0438\u043D\u0442\u0440\u0438\u0433, \u0437\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u0441\u0443\u0436\u0435\u043D\u043D\u043E\u0433\u043E \u0432 \u0434\u0435\u0440\u0435\u0432\u043D\u0435
      \u0431\u0435\u0437 \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442\u0430.
      \u041A\u043E\u043C\u0443 \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0435\u0448\u044C
      - \u043D\u0435 \u043F\u043E\u0432\u0435\u0440\u044F\u0442\u2026"
    style: {fileID: 0}
    authorComment: "Unknown speaker candidate: \u041E\u043D\u0430 \u043F\u0440\u043E\u0438\u0437\u043D\u043E\u0441\u0438\u0442
      \u0441\u043B\u043E\u0432\u0430 \u0441\u043A\u043E\u0440\u043E\u0433\u043E\u0432\u043E\u0440\u043A\u043E\u0439,
      \u0435\u0434\u0432\u0430 \u0441\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044F
      \u0438\u0440\u043E\u043D\u0438\u0447\u043D\u0443\u044E \u0443\u043B\u044B\u0431\u043A\u0443.
      \u0415\u0439 \u043F\u0440\u0430\u0432\u0434\u0430 \u0441\u043C\u0435\u0448\u043D\u043E
      \u043E\u0442 \u0441\u044E\u0440\u0440\u0435\u0430\u043B\u0438\u0441\u0442\u0438\u0447\u043D\u043E\u0441\u0442\u0438
      \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438"
