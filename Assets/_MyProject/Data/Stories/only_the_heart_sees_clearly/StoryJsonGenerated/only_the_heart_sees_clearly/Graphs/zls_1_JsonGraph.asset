  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: zls1_dialogue_030
  nodeTitle: 
  activeCharacters: []
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u0435\u0447\u0435\u0440\u043D\u0438\u0439 \u0432\u043E\u0437\u0434\u0443\u0445
      \u041F\u043E\u0434\u043B\u0435\u0441\u044C\u044F \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043F\u0440\u043E\u0445\u043B\u0430\u0434\u043D\u044B\u0439 - \u043E\u043D
      \u043F\u043B\u043E\u0442\u043D\u044B\u0439, \u043D\u0430\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u0439
      \u043D\u0430 \u0430\u0440\u043E\u043C\u0430\u0442\u0430\u0445, \u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u0432 \u0433\u043E\u0440\u043E\u0434\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043D\u0435 \u0441\u044B\u0441\u043A\u0430\u0442\u044C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u0437\u0430\u043C\u0438\u0440\u0430\u0435\u0442 \u043D\u0430
      \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0435, \u043F\u0440\u0438\u043A\u0440\u044B\u0432\u0430\u044F
      \u0433\u043B\u0430\u0437\u0430."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u0430\u0445\u043D\u0435\u0442 \u0441\u043A\u043E\u0448\u0435\u043D\u043D\u043E\u0439,
      \u0447\u0443\u0442\u044C \u043F\u043E\u0434\u0441\u043E\u0445\u0448\u0435\u0439
      \u043D\u0430 \u0441\u043E\u043B\u043D\u0446\u0435 \u0442\u0440\u0430\u0432\u043E\u0439,
      \u0433\u043E\u0440\u044C\u043A\u043E\u0432\u0430\u0442\u043E\u0439 \u043F\u043E\u043B\u044B\u043D\u044C\u044E
      \u0438, \u0435\u0434\u0432\u0430 \u0443\u043B\u043E\u0432\u0438\u043C\u043E,
      - \u0440\u0435\u0447\u043D\u044B\u043C \u0438\u043B\u043E\u043C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0413\u0434\u0435-\u0442\u043E \u0432 \u043A\u0443\u0441\u0442\u0430\u0445
      \u0442\u0440\u0435\u0449\u0430\u0442 \u043A\u0443\u0437\u043D\u0435\u0447\u0438\u043A\u0438,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0432 \u0434\u0435\u0442\u0441\u0442\u0432\u0435
      \u0435\u0439 \u043E\u0447\u0435\u043D\u044C \u043D\u0440\u0430\u0432\u0438\u043B\u043E\u0441\u044C
      \u043B\u043E\u0432\u0438\u0442\u044C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u0434\u044B\u0448\u0438\u0442\u0441\u044F
      \u043D\u0430\u043C\u043D\u043E\u0433\u043E \u043B\u0435\u0433\u0447\u0435.
      \u0412\u043F\u0435\u0440\u0432\u044B\u0435 \u0437\u0430 \u0434\u043E\u043B\u0433\u043E\u0435
      \u0432\u0440\u0435\u043C\u044F \u043C\u0438\u0440 \u043D\u0438\u0447\u0435\u0433\u043E
      \u043E\u0442 \u043D\u0435\u0451 \u043D\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442,
      \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044F \u043F\u0440\u043E\u0441\u0442\u043E
      \u0436\u0438\u0442\u044C \u0438 \u0434\u044B\u0448\u0430\u0442\u044C \u043F\u043E\u043B\u043D\u043E\u0439
      \u0433\u0440\u0443\u0434\u044C\u044E."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0442\u043C\u0430\u0445\u0438\u0432\u0430\u044F\u0441\u044C
      \u043E\u0442 \u043C\u043E\u0448\u043A\u0430\u0440\u044B, \u043E\u043D\u0430
      \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u0437\u0430 \u043A\u0430\u043B\u0438\u0442\u043A\u0443,
      \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u043F\u043E \u043F\u044B\u043B\u044C\u043D\u043E\u0439
      \u0442\u0440\u043E\u043F\u0438\u043D\u043A\u0435 \u043C\u0435\u0436\u0434\u0443
      \u043E\u0433\u0440\u0430\u0434\u0430\u043C\u0438, \u043E\u0431\u0445\u043E\u0434\u044F
      \u0437\u0430\u0440\u043E\u0441\u043B\u0438 \u043A\u0440\u0430\u043F\u0438\u0432\u044B."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0422\u0440\u043E\u043D\u0443\u0442\u0430\u044F \u043F\u0435\u0440\u0432\u043E\u0439
      \u0442\u0440\u0430\u0432\u043E\u0439 \u0440\u043E\u0441\u0430 \u043F\u0440\u0438\u044F\u0442\u043D\u043E
      \u0445\u043E\u043B\u043E\u0434\u0438\u0442 \u0449\u0438\u043A\u043E\u043B\u043E\u0442\u043A\u0438.
      \u0412\u0435\u0442\u0435\u0440 \u0442\u0440\u0435\u043F\u043B\u0435\u0442 \u0438
      \u043F\u0443\u0442\u0430\u0435\u0442 \u0440\u0430\u0441\u043F\u0443\u0449\u0435\u043D\u043D\u044B\u0435
      \u0432\u043E\u043B\u043E\u0441\u044B \u0438, \u0438\u0433\u0440\u0430\u044F,
      \u0442\u0440\u043E\u0433\u0430\u0435\u0442 \u043A\u043E\u0436\u0443, \u0437\u0430\u0441\u0442\u0430\u0432\u043B\u044F\u044F
      \u043F\u043E\u0435\u0436\u0438\u0442\u044C\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
