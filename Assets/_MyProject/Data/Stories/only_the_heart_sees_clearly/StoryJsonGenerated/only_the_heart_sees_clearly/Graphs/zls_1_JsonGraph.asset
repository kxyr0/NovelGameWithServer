  guid: zls1_dialogue_014
  nodeTitle: 
  activeCharacters: []
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u0432\u0437\u0434\u044B\u0445\u0430\u0435\u0442, \u0440\u0430\u0437\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044F
      \u043A\u0440\u0430\u0441\u043E\u0447\u043D\u044B\u0435 \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0438,
      \u043C\u0435\u0441\u0442\u0430\u043C\u0438 \u0447\u0443\u0442\u044C \u043F\u043E\u0431\u043B\u0435\u043A\u0448\u0438\u0435
      \u043E\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412 \u0434\u0430\u043B\u0451\u043A\u043E\u043C \u0434\u0435\u0442\u0441\u0442\u0432\u0435
      \u0443 \u043D\u0435\u0451 \u0431\u044B\u043B\u0430 \u0442\u043E\u0447\u043D\u043E
      \u0442\u0430\u043A\u0430\u044F \u0436\u0435 \u043A\u043D\u0438\u0436\u043A\u0430
      - \u0441 \u043C\u044F\u0433\u043A\u043E\u0439 \u0442\u043A\u0430\u043D\u0435\u0432\u043E\u0439
      \u043E\u0431\u043B\u043E\u0436\u043A\u043E\u0439 \u0438 \u043D\u0435\u0440\u043E\u0432\u043D\u043E
      \u0441\u043A\u043B\u0435\u0435\u043D\u043D\u044B\u043C\u0438 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0430\u043C\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u043A\u0430\u043A \u0441\u0435\u0439\u0447\u0430\u0441
      \u043F\u043E\u043C\u043D\u0438\u0442, \u0447\u0442\u043E \u0442\u0430 \u043A\u043D\u0438\u0436\u043A\u0430
      \u043F\u0430\u0445\u043B\u0430 \u043F\u044B\u043B\u044C\u044E, \u0447\u0435\u0440\u0434\u0430\u043A\u043E\u043C
      \u0438 \u043B\u0435\u0442\u043E\u043C \u0432 \u0434\u0435\u0440\u0435\u0432\u043D\u0435.
      \u041E\u043D\u0430 \u043B\u044E\u0431\u0438\u043B\u0430 \u0435\u0451 \u0431\u043E\u043B\u044C\u0448\u0435
      \u0432\u0441\u0435\u0445 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445,
      \u043D\u043E \u0442\u0430 \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0430\u0441\u044C
      \u043F\u043E\u0441\u043B\u0435 \u043F\u0435\u0440\u0435\u0435\u0437\u0434\u0430,
      \u043A\u0430\u043A \u0438 \u043C\u043D\u043E\u0433\u0438\u0435 \u0434\u0440\u0443\u0433\u0438\u0435
      \u043C\u0435\u043B\u043E\u0447\u0438."
    style: {fileID: 0}
    authorComment: 
