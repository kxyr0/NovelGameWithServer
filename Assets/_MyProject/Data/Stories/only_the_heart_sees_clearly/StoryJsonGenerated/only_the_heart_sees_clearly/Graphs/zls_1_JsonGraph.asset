  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: zls1_dialogue_027
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: bab_nyura
  - character: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speakerId: bab_nyura
    speakerNameHint: "\u0411\u0430\u0431 \u041D\u044E\u0440\u0430"
    speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 17
    richText: "\u041E\u0445, \u0447\u0442\u043E-\u0442\u043E \u0441\u043E\u0432\u0441\u0435\u043C
      \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430 \u044F \u0442\u0435\u0431\u044F,
      \u043C\u0438\u043B\u0430\u044F. \u0410 \u0442\u044B \u0441\u0430\u0434\u0438\u0441\u044C,
      \u0441\u0430\u0434\u0438\u0441\u044C, \u043F\u043E\u043A\u0430 \u043D\u0435
      \u043E\u0441\u0442\u044B\u043B\u043E. \u0421\u0443\u043F\u0447\u0438\u043A
      \u0441 \u043B\u0430\u043F\u0448\u043E\u0439, \u043A\u043E\u043C\u043F\u043E\u0442\u2026"
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u043F\u043E\u0441\u043B\u0443\u0448\u043D\u043E \u043C\u043E\u0435\u0442
      \u0440\u0443\u043A\u0438 \u0438 \u0441\u0430\u0434\u0438\u0442\u0441\u044F
      \u0437\u0430 \u0441\u0442\u043E\u043B. \u0422\u043E\u0442 \u0437\u0430\u0441\u0442\u0435\u043B\u0435\u043D
      \u0431\u0435\u043B\u043E\u0441\u043D\u0435\u0436\u043D\u043E\u0439 \u0441\u043A\u0430\u0442\u0435\u0440\u0442\u044C\u044E
      \u0441 \u0432\u044B\u0448\u0438\u0432\u043A\u043E\u0439, \u044F\u0440\u043A\u043E\u0439,
      \u0441\u043B\u043E\u0432\u043D\u043E \u0438\u043D\u043E\u0440\u043E\u0434\u043D\u043E\u0439
      \u0432 \u044D\u0442\u043E\u043C \u0441\u0442\u0430\u0440\u043E\u043C \u0434\u043E\u043C\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: '{playerName}'
    speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 2
    richText: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E. \u041F\u0430\u0445\u043D\u0435\u0442
      \u0432\u043A\u0443\u0441\u043D\u043E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: bab_nyura
    speakerNameHint: "\u0411\u0430\u0431 \u041D\u044E\u0440\u0430"
    speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 2
    richText: "\u0410 \u0442\u043E \u043A\u0430\u043A \u0436\u0435. \u0412\u0441\u0451
      \u0441\u0432\u043E\u0451 - \u0434\u043E\u043C\u0430\u0448\u043D\u0435\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: bab_nyura
    speakerNameHint: "\u0411\u0430\u0431 \u041D\u044E\u0440\u0430"
    speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 14
    richText: "\u0413\u043B\u0430\u0437\u0430 \u0443 \u0442\u0435\u0431\u044F - \u043A\u0430\u043A
      \u0443 \u043F\u0442\u0438\u0446\u044B, \u0447\u0442\u043E \u0432 \u043A\u043B\u0435\u0442\u043A\u0435
      \u043F\u043E\u0431\u044B\u0432\u0430\u043B\u0430. \u0421\u0432\u043E\u0431\u043E\u0434\u0430
      \u0435\u0441\u0442\u044C, \u0430 \u043D\u0435 \u043B\u0435\u0442\u0438\u0442\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: '{playerName}'
    speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 19
    richText: "\u0411\u044B\u043B\u0430 \u0431\u044B \u0442\u044B, \u0431\u0430\u0431
      \u041D\u044E\u0440, \u043F\u0441\u0438\u0445\u043E\u043B\u043E\u0433\u043E\u043C,
      \u043E\u0442 \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432 \u043E\u0442\u0431\u043E\u044F
      \u0431\u044B \u043D\u0435 \u0431\u044B\u043B\u043E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: bab_nyura
    speakerNameHint: "\u0411\u0430\u0431 \u041D\u044E\u0440\u0430"
    speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 2
    richText: "\u0414\u0430 \u044F \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u0442\u0430\u0440\u0430\u044F.
      \u0421 \u0433\u043E\u0434\u0430\u043C\u0438, \u0445\u043E\u0442\u044C \u0433\u043B\u0430\u0437\u0430
      \u0443\u0436\u0435 \u043D\u0435 \u0442\u0435, \u0430 \u0432\u0441\u0451 \u0436
      \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0448\u044C \u0432\u0438\u0434\u0435\u0442\u044C
      \u0431\u043E\u043B\u044C\u0448\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: bab_nyura
    speakerNameHint: "\u0411\u0430\u0431 \u041D\u044E\u0440\u0430"
    speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 14
    richText: "\u0417\u043E\u0440\u043A\u043E \u043B\u0438\u0448\u044C \u0441\u0435\u0440\u0434\u0446\u0435,
      \u0434\u0435\u0442\u043E\u0447\u043A\u0430. \u0413\u043B\u0430\u0437\u0430-\u0442\u043E
      \u0447\u0430\u0441\u0442\u043E \u0432\u0440\u0443\u0442."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: '{playerName}'
    speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 19
    richText: "\u041E\u043D\u043E \u0443 \u043C\u0435\u043D\u044F, \u043F\u043E\u0445\u043E\u0436\u0435,
      \u0442\u043E\u0436\u0435 \u0432\u0440\u0451\u0442. \u0418\u043B\u0438 \u0441\u043E\u0432\u0441\u0435\u043C
      \u0440\u0430\u0437\u0443\u0447\u0438\u043B\u043E\u0441\u044C \u0432\u0438\u0434\u0435\u0442\u044C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: bab_nyura
    speakerNameHint: "\u0411\u0430\u0431 \u041D\u044E\u0440\u0430"
    speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 2
    richText: "\u0417\u043D\u0430\u0447\u0438\u0442, \u043D\u0430\u0434\u043E \u0435\u0433\u043E
      \u0441\u043D\u043E\u0432\u0430 \u043D\u0430\u0443\u0447\u0438\u0442\u044C.
      \u0422\u0435\u0431\u0435 \u0437\u0434\u0435\u0441\u044C \u0438 \u043F\u043E\u043A\u043E\u0439,
      \u0438 \u0442\u0438\u0448\u0438\u043D\u0430, \u0438 \u0442\u0440\u0430\u0432\u043A\u0438
      \u043C\u043E\u0438 \u0446\u0435\u043B\u0435\u0431\u043D\u044B\u0435\u2026 \u0410\u0432\u043E\u0441\u044C,
      \u043F\u043E\u043C\u043E\u0436\u0435\u0442."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: '{playerName}'
    speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 9
    richText: "\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u043A\u0430\u043A
      \u043E\u043D\u0430 \u0434\u043E\u0433\u0430\u0434\u0430\u043B\u0430\u0441\u044C?
      \u042F \u0436\u0435 \u043D\u0435 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u043B\u0430
      \u043D\u0438\u0447\u0435\u0433\u043E\u2026"
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: '{playerName}'
    speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 2
    richText: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0431\u0430\u0431 \u041D\u044E\u0440."
    style: {fileID: 0}
    authorComment: 
  - speakerId: bab_nyura
    speakerNameHint: "\u0411\u0430\u0431 \u041D\u044E\u0440\u0430"
    speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 2
    richText: "\u0422\u044B \u043A\u0443\u0448\u0430\u0439, \u043A\u0443\u0448\u0430\u0439
      - \u0432\u043E\u043D \u043A\u0430\u043A\u0430\u044F \u0445\u0443\u0434\u0430\u044F!
      \u0414\u0430\u0432\u0430\u0439 \u0434\u043E\u0431\u0430\u0432\u043A\u0438 \u043F\u043E\u043B\u043E\u0436\u0443?"
    style: {fileID: 0}
    authorComment: 
