  guid: zls1_dialogue_071
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u0441\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u0432\u043F\u0440\u0430\u0432\u043E - \u0442\u0443\u0434\u0430, \u0433\u0434\u0435
      \u0434\u043E\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u0436\u0443\u0440\u0447\u0430\u043D\u0438\u0435
      \u0432\u043E\u0434\u044B."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0431\u0435\u0436\u0438\u0442 \u043A \u0440\u0435\u043A\u0435,
      \u043F\u043E \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043D\u0435\u0441\u043F\u0435\u0448\u043D\u043E
      \u043F\u043B\u044B\u0432\u0435\u0442 \u0431\u0435\u0440\u0435\u0436\u043D\u043E
      \u0441\u043F\u043B\u0435\u0442\u0435\u043D\u043D\u044B\u0439 \u043A\u0435\u043C-\u0442\u043E
      \u0432\u0435\u043D\u043E\u043A."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u043D\u0435\u0437\u0430\u043F\u043D\u043E \u043E\u043D \u0442\u0435\u0440\u044F\u0435\u0442\u0441\u044F
      \u0438\u0437 \u0432\u0438\u0434\u0443, \u0431\u0443\u0434\u0442\u043E \u043A\u0442\u043E-\u0442\u043E
      \u0443\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442 \u0435\u0433\u043E \u043F\u043E\u0434
      \u0432\u043E\u0434\u0443. \u0422\u0432\u0451\u0440\u0434\u0430\u044F \u0437\u0435\u043C\u043B\u044F
      \u043F\u043E\u0434 \u043D\u043E\u0433\u0430\u043C\u0438 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u0432 \u043E\u0437\u0451\u0440\u043D\u044B\u0439 \u0438\u043B, \u043D\u043E\u0433\u0438
      \u0432\u044F\u0437\u043D\u0443\u0442. {playerName} \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F
      \u0432\u044B\u0434\u0435\u0440\u043D\u0443\u0442\u044C \u0441\u0442\u0443\u043F\u043D\u044E."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 17
    richText: "\u041D\u0435\u0442, \u043D\u0435\u0442, \u043D\u0435\u0442!"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u044B\u0441\u0432\u043E\u0431\u043E\u0434\u0438\u0432\u0448\u0438\u0441\u044C,
      \u043E\u043D\u0430 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442
      \u0431\u0435\u0436\u0430\u0442\u044C \u0431\u0435\u0437 \u043E\u0433\u043B\u044F\u0434\u043A\u0438
      \u0442\u0430\u043A, \u0441\u043B\u043E\u0432\u043D\u043E \u0443 \u043D\u0435\u0435
      \u043E\u0442\u043A\u0440\u044B\u043B\u043E\u0441\u044C \u0432\u0442\u043E\u0440\u043E\u0435
      \u0434\u044B\u0445\u0430\u043D\u0438\u0435."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0441\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443, \u043D\u043E \u0434\u043E\u0440\u043E\u0436\u043A\u0438
      \u0441\u043B\u0438\u0432\u0430\u044E\u0442\u0441\u044F \u0432 \u043E\u0434\u043D\u0443."
    style: {fileID: 0}
    authorComment: 
