  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u0441\u0436\u0438\u043C\u0430\u0435\u0442 \u0437\u0443\u0431\u044B"
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: '{playerName}'
    speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 23
    richText: "\u042D\u0442\u043E \u0432\u0441\u0435\u0433\u043E \u043B\u0438\u0448\u044C
      \u0441\u043E\u043D\u2026 \u041D\u0443\u0436\u043D\u043E \u043F\u0440\u043E\u0441\u0442\u043E
      \u043F\u0440\u043E\u0441\u043D\u0443\u0442\u044C\u0441\u044F. \u041F\u0440\u043E\u0441\u043D\u0443\u0442\u044C\u0441\u044F.
      \u041F\u0440\u043E\u0441\u043D\u0443\u0442\u044C\u0441\u044F. \u041F\u0440\u043E\u0441\u043D\u0443\u0442\u044C\u0441\u044F\u2026"
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041A\u043D\u0438\u0436\u043D\u044B\u0435 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u044B
      \u043B\u0438\u0441\u0442\u0430\u044E\u0442\u0441\u044F \u0441\u0430\u043C\u0438
      \u0441\u043E\u0431\u043E\u0439 - \u0431\u044B\u0441\u0442\u0440\u043E, \u0440\u0432\u0430\u043D\u043E,
      \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E \u043A\u0442\u043E-\u0442\u043E
      \u0442\u043E\u0440\u043E\u043F\u0438\u0442\u0441\u044F. \u041F\u0451\u0441\u0442\u0440\u044B\u0435
      \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0438 \u0441\u043C\u0435\u043D\u044F\u044E\u0442
      \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430 - \u0432 \u0433\u043B\u0430\u0437\u0430\u0445
      \u043E\u0442 \u043D\u0438\u0445 \u0432\u0441\u0451 \u0440\u044F\u0431\u0438\u0442
      \u0438 \u043F\u043B\u044B\u0432\u0451\u0442."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0422\u0438\u0448\u0438\u043D\u0443 \u0440\u0430\u0437\u0440\u0435\u0437\u0430\u0435\u0442
      \u0433\u043E\u043B\u043E\u0441 - \u0434\u043E\u0431\u0440\u044B\u0439, \u043C\u044F\u0433\u043A\u0438\u0439,
      \u043D\u043E \u043F\u043E-\u0441\u0442\u0430\u0440\u0447\u0435\u0441\u043A\u0438
      \u0441\u043A\u0440\u0438\u043F\u0443\u0447\u0438\u0439."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u0432\u0438\u0434\u0438\u0442 \u0442\u0443 \u0441\u0442\u0430\u0440\u0443\u0448\u043A\u0443,
      \u0447\u0442\u043E \u043F\u043E\u0432\u0441\u0442\u0440\u0435\u0447\u0430\u043B\u0430\u0441\u044C
      \u0435\u0439 \u043D\u0430 \u0432\u043E\u043A\u0437\u0430\u043B\u0435 \u0432\u043E
      \u0432\u0440\u0435\u043C\u044F \u0437\u0430\u0442\u044F\u0436\u043D\u043E\u0439
      \u043F\u0435\u0440\u0435\u0441\u0430\u0434\u043A\u0438 \u0441 \u043E\u0434\u043D\u043E\u0433\u043E
      \u043F\u043E\u0435\u0437\u0434\u0430 \u043D\u0430 \u0434\u0440\u0443\u0433\u043E\u0439.
      \u041D\u043E \u0447\u0435\u0440\u0442\u044B \u0435\u0451 \u0438\u0441\u043A\u0430\u0436\u0435\u043D\u044B:
      \u0440\u043E\u0442 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0448\u0438\u0440\u043E\u043A\u0438\u0439,
      \u0433\u043B\u0430\u0437\u0430 \u0442\u0451\u043C\u043D\u044B\u0435, \u0430
      \u043A\u043E\u0436\u0430 - \u0431\u0443\u0434\u0442\u043E \u0438\u0437 \u043F\u043E\u0436\u0435\u043B\u0442\u0435\u0432\u0448\u0435\u0439
      \u0431\u0443\u043C\u0430\u0433\u0438."
    style: {fileID: 0}
    authorComment: "Unknown speaker candidate: {playerName} \u0432\u0438\u0434\u0438\u0442
      \u0442\u0443 \u0441\u0442\u0430\u0440\u0443\u0448\u043A\u0443, \u0447\u0442\u043E
      \u043F\u043E\u0432\u0441\u0442\u0440\u0435\u0447\u0430\u043B\u0430\u0441\u044C
      \u0435\u0439 \u043D\u0430 \u0432\u043E\u043A\u0437\u0430\u043B\u0435 \u0432\u043E
      \u0432\u0440\u0435\u043C\u044F \u0437\u0430\u0442\u044F\u0436\u043D\u043E\u0439
      \u043F\u0435\u0440\u0435\u0441\u0430\u0434\u043A\u0438 \u0441 \u043E\u0434\u043D\u043E\u0433\u043E
      \u043F\u043E\u0435\u0437\u0434\u0430 \u043D\u0430 \u0434\u0440\u0443\u0433\u043E\u0439.
      \u041D\u043E \u0447\u0435\u0440\u0442\u044B \u0435\u0451 \u0438\u0441\u043A\u0430\u0436\u0435\u043D\u044B"
  - speakerId: old_woman_distorted
    speakerNameHint: "\u0421\u0442\u0430\u0440\u0443\u0448\u043A\u0430"
    speaker: {fileID: 11400000, guid: e32ee068f1274940a85a12941690590e, type: 2}
    emotion: 17
    richText: "\u0411\u0435\u0440\u0435\u0433\u0438 \u0441\u0435\u0431\u044F. \u0421\u043A\u0430\u0437\u043A\u0430
      \u0441\u0430\u043C\u0430 \u0442\u0435\u0431\u044F \u0432\u044B\u0431\u0440\u0430\u043B\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u0434\u0435\u043B\u0430\u0435\u0442 \u0448\u0430\u0433,
      \u0441\u043F\u043E\u0442\u044B\u043A\u0430\u0435\u0442\u0441\u044F \u0438 \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E
      \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043A\u0443\u0434\u0430-\u0442\u043E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u0440\u0438\u0437\u0435\u043C\u043B\u0435\u043D\u0438\u0435.
      \u0428\u0438\u0440\u043E\u043A\u043E \u0440\u0430\u0441\u043F\u0430\u0445\u043D\u0443\u0432
      \u0433\u043B\u0430\u0437\u0430, \u043E\u043D\u0430 \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E
      \u0432\u0438\u0434\u0438\u0442\u2026 \u0441\u0430\u043C\u0443 \u0441\u0435\u0431\u044F
      - \u0432 \u0431\u0435\u043B\u043E\u043C \u043F\u043B\u0430\u0442\u044C\u0435,
      \u0441\u0442\u043E\u044F\u0449\u0435\u0439 \u043D\u0430 \u043A\u0440\u0430\u044E
      \u043B\u0435\u0441\u0430. \u041F\u043B\u0430\u0442\u044C\u0435 \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442
      \u0442\u0430\u043A, \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E \u0435\u0435
      \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u043B\u0438 \u043A \u043A\u0430\u043A\u043E\u043C\u0443-\u0442\u043E
      \u043E\u0431\u0440\u044F\u0434\u0443. \u041D\u043E \u0441\u0430\u043C\u043E\u0435
      \u0441\u0442\u0440\u0430\u0448\u043D\u043E\u0435 - \u0442\u0435\u043D\u0438
      \u0437\u0430 \u0435\u0451 \u0441\u043F\u0438\u043D\u043E\u0439, \u0432 \u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u0443\u0433\u0430\u0434\u044B\u0432\u0430\u044E\u0442\u0441\u044F \u0441\u0438\u043B\u0443\u044D\u0442\u044B
      \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0445 \u0441\u043A\u0430\u0437\u043E\u0447\u043D\u044B\u0445
      \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0435\u0439."
    style: {fileID: 0}
    authorComment: 
  - speakerId: voice
    speakerNameHint: "\u0413\u043E\u043B\u043E\u0441"
    speaker: {fileID: 11400000, guid: f0422403a4dc45c68330c10d7251ddc1, type: 2}
    emotion: 0
    richText: "\u0418 \u0442\u044B \u0432\u044B\u0431\u0435\u0440\u0438 \u0435\u0451.
      \u041F\u043E\u043A\u0430 \u043D\u0435 \u043F\u043E\u0437\u0434\u043D\u043E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: '{playerName}'
    speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
