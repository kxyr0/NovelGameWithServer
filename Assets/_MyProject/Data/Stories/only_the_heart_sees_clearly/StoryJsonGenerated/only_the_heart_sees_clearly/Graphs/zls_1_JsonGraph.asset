  exit: {fileID: 0}
  guid: zls1_dialogue_072
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u0440\u0435\u0437\u043A\u043E \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0438 \u0441 \u0441\u0438\u043B\u043E\u0439 \u0436\u043C\u0443\u0440\u0438\u0442
      \u0433\u043B\u0430\u0437\u0430. \u0428\u0435\u043F\u043E\u0442 \u0441\u0442\u0438\u0445\u0430\u0435\u0442
      \u043D\u0430 \u0441\u0447\u0438\u0442\u0430\u043D\u043D\u044B\u0435 \u0441\u0435\u043A\u0443\u043D\u0434\u044B
      - \u0438 \u0435\u0441\u043B\u0438 \u0431\u044B \u043B\u0435\u0441 \u043C\u043E\u0433
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0443\u0434\u0438\u0432\u043B\u044F\u0442\u044C\u0441\u044F, \u043E\u043D
      \u0431\u044B \u0432\u044B\u0440\u0430\u0437\u0438\u043B \u0441\u0432\u043E\u0451
      \u0443\u0434\u0438\u0432\u043B\u0435\u043D\u0438\u0435 \u0438\u043C\u0435\u043D\u043D\u043E
      \u0442\u0430\u043A."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0434\u0438\u043D."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0434\u0435\u043B\u0430\u0435\u0442 \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0439
      \u0432\u0434\u043E\u0445 \u043D\u043E\u0441\u043E\u043C, \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044F,
      \u043A\u0430\u043A \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0439 \u0432\u043E\u0437\u0434\u0443\u0445
      \u0436\u0436\u0435\u0442 \u043B\u0435\u0433\u043A\u0438\u0435."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0414\u0432\u0430."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u044B\u0434\u044B\u0445\u0430\u0435\u0442. \u0421\u0435\u0440\u0434\u0446\u0435
      \u0437\u0430\u043F\u043E\u043B\u043E\u0448\u043D\u043E \u043A\u043E\u043B\u043E\u0442\u0438\u0442\u0441\u044F
      \u0433\u0434\u0435-\u0442\u043E \u043F\u043E\u0434 \u0440\u0435\u0431\u0440\u0430\u043C\u0438.
      \u041E\u043D\u0430 \u043D\u0435 \u0434\u0432\u0438\u0433\u0430\u0435\u0442\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 17
    richText: "\u042F \u0443\u0441\u0442\u0430\u043B\u0430. \u042F \u0431\u043E\u043B\u044C\u0448\u0435
      \u043D\u0435 \u0445\u043E\u0447\u0443 \u0431\u0435\u0436\u0430\u0442\u044C.
      \u041E\u0442 \u0447\u0435\u0433\u043E \u044F \u0432\u043E\u043E\u0431\u0449\u0435
      \u0431\u0435\u0433\u0443?"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 17
    richText: "\u0418\u043B\u0438, \u0432\u0435\u0440\u043D\u0435\u0435 \u0441\u043A\u0430\u0437\u0430\u0442\u044C,
      \u043E\u0442 \u043A\u043E\u0433\u043E?"
    style: {fileID: 0}
    authorComment: 
