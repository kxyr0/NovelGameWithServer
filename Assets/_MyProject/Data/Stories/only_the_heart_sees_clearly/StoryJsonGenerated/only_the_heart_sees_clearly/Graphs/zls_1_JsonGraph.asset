  guid: zls1_dialogue_081
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speakerId: hero
    speakerNameHint: '{playerName}'
    speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 17
    richText: "\u042F \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0432\u0441\u0451 \u044D\u0442\u043E \u043F\u0440\u043E\u0436\u0438\u043B\u0430.
      \u0427\u0442\u043E \u0431\u044B \u044D\u0442\u043E \u043C\u043E\u0433\u043B\u043E
      \u0437\u043D\u0430\u0447\u0438\u0442\u044C?"
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: '{playerName}'
    speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 17
    richText: "\u041C\u043E\u0436\u0435\u0442, \u0441\u0442\u043E\u0438\u0442 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u0442\u044C
      \u043F\u0440\u043E \u044D\u0442\u043E \u0431\u0430\u0431\u0443\u0448\u043A\u0435..?"
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: '{playerName}'
    speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 17
    richText: "\u041B\u0430\u0434\u043D\u043E, \u0435\u0440\u0443\u043D\u0434\u0430.
      \u041D\u0435 \u0431\u0443\u0434\u0443 \u0435\u0435 \u0442\u0440\u0435\u0432\u043E\u0436\u0438\u0442\u044C
      \u043F\u043E\u043F\u0443\u0441\u0442\u0443\u2026\xBB"
    style: {fileID: 0}
    authorComment: 
