  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: zls1_dialogue_067
  nodeTitle: 
  activeCharacters: []
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u042D\u0442\u043E \u0441\u0442\u0430\u0440\u0430\u044F \u043A\u043D\u0438\u0436\u043A\u0430
      \u0441\u043E \u0441\u043A\u0430\u0437\u043A\u0430\u043C\u0438, \u043F\u043E\u044F\u0432\u0438\u0432\u0448\u0430\u044F\u0441\u044F
      \u043F\u0435\u0440\u0435\u0434 \u043D\u0435\u0439 \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E,
      \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E \u043E\u043D\u0430 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0447\u0442\u043E \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0438\u0437\u043E\u0432\u0430\u043B\u0430\u0441\u044C
      \u0438\u0437 \u0442\u0435\u043C\u043D\u043E\u0442\u044B."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041A\u043D\u0438\u0436\u043A\u0430 \u043F\u043E\u043A\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F,
      \u043A\u0430\u043A \u0436\u0438\u0432\u0430\u044F. \u0411\u0443\u043A\u0432\u044B
      \u0432 \u043D\u0435\u0439 \u0440\u0430\u0441\u043F\u043E\u043B\u0437\u0430\u044E\u0442\u0441\u044F,
      \u043A\u0430\u043A \u043C\u043E\u0448\u043A\u0430\u0440\u0430, \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0438
      \u043E\u0431\u0440\u0435\u0442\u0430\u044E\u0442 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435
      \u0434\u044B\u0445\u0430\u043D\u0438\u0435: \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0438
      \u0434\u0432\u0438\u0433\u0430\u044E\u0442\u0441\u044F \u0438 \u043F\u044B\u0442\u0430\u044E\u0442\u0441\u044F
      \u0441 \u043D\u0435\u0439 \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C."
    style: {fileID: 0}
    authorComment: "Unknown speaker candidate: \u041A\u043D\u0438\u0436\u043A\u0430
      \u043F\u043E\u043A\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F, \u043A\u0430\u043A
      \u0436\u0438\u0432\u0430\u044F. \u0411\u0443\u043A\u0432\u044B \u0432 \u043D\u0435\u0439
      \u0440\u0430\u0441\u043F\u043E\u043B\u0437\u0430\u044E\u0442\u0441\u044F, \u043A\u0430\u043A
      \u043C\u043E\u0448\u043A\u0430\u0440\u0430, \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0438
      \u043E\u0431\u0440\u0435\u0442\u0430\u044E\u0442 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435
      \u0434\u044B\u0445\u0430\u043D\u0438\u0435"
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u0442\u044F\u043D\u0435\u0442 \u0440\u0443\u043A\u0443
      \u0438 \u0442\u0443\u0442 \u0436\u0435 \u043E\u0434\u0435\u0440\u0433\u0438\u0432\u0430\u0435\u0442,
      \u043C\u043E\u0440\u0449\u0430\u0441\u044C - \u043B\u0430\u0434\u043E\u043D\u044C
      \u043F\u0440\u043E\u043D\u0437\u0430\u0435\u0442 \u043D\u0435\u0441\u0442\u0435\u0440\u043F\u0438\u043C\u0430\u044F
      \u0431\u043E\u043B\u044C. \u0421\u0435\u043A\u0443\u043D\u0434\u0430, \u0438
      \u043E\u043D\u0430 \u0432\u0434\u0440\u0443\u0433 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u0432\u0430\u0435\u0442
      \u0441\u0435\u0431\u044F \u0433\u043B\u0430\u0432\u043D\u043E\u0439 \u0433\u0435\u0440\u043E\u0438\u043D\u0435\u0439
      \u0442\u0435\u0445 \u044F\u0440\u043A\u0438\u0445 \u043A\u0430\u0440\u0442\u0438\u043D\u043E\u043A,
      \u0447\u0442\u043E \u0442\u043E\u043B\u044C\u043A\u043E \u0447\u0442\u043E
      \u043C\u0435\u043B\u044C\u043A\u0430\u043B\u0438 \u043F\u0435\u0440\u0435\u0434
      \u043D\u0435\u0439."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u043E\u0442 \u043E\u043D\u0430 \u0431\u0440\u043E\u0441\u0430\u0435\u0442
      \u0432\u0435\u043D\u043E\u043A, \u0438 \u043E\u043D \u043F\u043B\u044B\u0432\u0435\u0442
      \u043F\u043E \u0432\u043E\u0434\u0435, \u0442\u0435\u0440\u044F\u044F\u0441\u044C
      \u0438\u0437 \u0432\u0438\u0434\u0443 \u0433\u0434\u0435-\u0442\u043E \u0432\u0434\u0430\u043B\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u0435\u0442\u0435\u0440 \u0448\u0443\u043C\u0438\u0442 \u0432
      \u043A\u0440\u043E\u043D\u0430\u0445 \u0434\u0435\u0440\u0435\u0432\u044C\u0435\u0432,
      \u0431\u0443\u0434\u0442\u043E \u043F\u044B\u0442\u0430\u044F\u0441\u044C \u0435\u0439
      \u0447\u0442\u043E-\u0442\u043E \u0441\u043A\u0430\u0437\u0430\u0442\u044C,
      \u043D\u043E \u043E\u043D\u0430 \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442
      - \u0438\u043B\u0438 \u043D\u0435 \u0445\u043E\u0447\u0435\u0442 \u043F\u043E\u043D\u0438\u043C\u0430\u0442\u044C."
    style: {fileID: 0}
    authorComment: 
