  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: zls1_dialogue_010
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  - character: {fileID: 11400000, guid: dcfc619f088249ff9e2a46ecd1e81669, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: old_woman
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0417\u0432\u0443\u0447\u043D\u044B\u0439 \u043B\u044F\u0437\u0433
      \u043A\u043E\u043B\u0451\u0441 \u043E \u0440\u0435\u043B\u044C\u0441\u044B
      \u0440\u0435\u0436\u0435\u0442 \u0441\u043B\u0443\u0445."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0414\u0443\u0448\u043D\u043E \u0442\u0430\u043A, \u0447\u0442\u043E
      \u0440\u0430\u0441\u043A\u0430\u043B\u0435\u043D\u043D\u044B\u0439 \u0430\u0441\u0444\u0430\u043B\u044C\u0442
      \u043F\u0435\u0440\u0440\u043E\u043D\u0430 \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E
      \u043F\u043B\u0430\u0432\u0438\u0442\u0441\u044F \u043F\u043E\u0434 \u043F\u043E\u0434\u043E\u0448\u0432\u043E\u0439.
      \u0412\u043E\u0437\u0434\u0443\u0445 - \u043F\u043E\u0447\u0442\u0438 \u043E\u0441\u044F\u0437\u0430\u0435\u043C\u043E
      \u0433\u0443\u0441\u0442\u043E\u0439."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u0430\u0445\u043D\u0435\u0442 \u043C\u0430\u0437\u0443\u0442\u043E\u043C
      \u0438 \u0441\u0432\u0435\u0436\u0435\u0438\u0441\u043F\u0435\u0447\u0435\u043D\u043D\u044B\u043C\u0438
      \u043F\u0438\u0440\u043E\u0436\u043A\u0430\u043C\u0438 - \u043D\u0438 \u0441
      \u0447\u0435\u043C \u043D\u0435\u0441\u0440\u0430\u0432\u043D\u0438\u043C\u044B\u0439
      \u0437\u0430\u043F\u0430\u0445 \u0436\u0435\u043B\u0435\u0437\u043D\u043E\u0434\u043E\u0440\u043E\u0436\u043D\u043E\u0433\u043E
      \u0432\u043E\u043A\u0437\u0430\u043B\u0430."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 4
    richText: "\u0414\u0430\u0436\u0435 \u0437\u0434\u0435\u0441\u044C \u043D\u0435\u0447\u0435\u043C
      \u0434\u044B\u0448\u0430\u0442\u044C. \u041C\u0438\u0440 \u043A\u0430\u043A
      \u0431\u0443\u0434\u0442\u043E \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043B\u0441\u044F
      \u0432 \u043E\u0434\u043D\u0443 \u043F\u0435\u0440\u0435\u0433\u0440\u0435\u0442\u0443\u044E
      \u0434\u0443\u0445\u043E\u0432\u043A\u0443\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 20
    richText: "\u0418 \u0441\u0443\u043C\u043A\u0430 \u0442\u0430\u043A\u0430\u044F
      \u0442\u044F\u0436\u0435\u043B\u0430\u044F\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u0435\u0442
      \u0441\u0443\u043C\u043A\u0443 \u0432 \u043F\u0440\u0430\u0432\u0443\u044E
      \u0440\u0443\u043A\u0443, \u0447\u0442\u043E\u0431\u044B \u043B\u0435\u0432\u0430\u044F
      \u043C\u043E\u0433\u043B\u0430 \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0442\u044C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0415\u0451 \u0432\u0437\u0433\u043B\u044F\u0434 \u0441\u043A\u043E\u043B\u044C\u0437\u0438\u0442
      \u043F\u043E \u043A\u0440\u0430\u044E \u043F\u0435\u0440\u0440\u043E\u043D\u0430,
      \u0433\u0434\u0435 \u0432 \u0441\u0430\u043C\u043E\u043C \u043F\u0435\u043A\u043B\u0435,
      \u0432\u0434\u0430\u043B\u0438 \u043E\u0442 \u0441\u043F\u0430\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
      \u0442\u0435\u043D\u0438 \u043D\u0430\u0432\u0435\u0441\u0430, \u0432\u0438\u0434\u043D\u0435\u0435\u0442\u0441\u044F
      \u0441\u0433\u043E\u0440\u0431\u043B\u0435\u043D\u043D\u0430\u044F \u0444\u0438\u0433\u0443\u0440\u0430
      \u0432 \u0442\u0451\u043C\u043D\u043E\u043C \u043F\u043B\u0430\u0442\u043A\u0435."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u0440\u0438\u0441\u043C\u043E\u0442\u0440\u0435\u0432\u0448\u0438\u0441\u044C,
      {playerName} \u0443\u0434\u0430\u0435\u0442\u0441\u044F \u0440\u0430\u0437\u0433\u043B\u044F\u0434\u0435\u0442\u044C
      \u0432 \u044D\u0442\u043E\u0439 \u0444\u0438\u0433\u0443\u0440\u0435 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0443\u044E
      \u0441\u0442\u0430\u0440\u0443\u0448\u043A\u0443, \u0441\u0438\u0434\u044F\u0449\u0443\u044E
      \u043F\u0435\u0440\u0435\u0434 \u0441\u0430\u043C\u043E\u0434\u0435\u043B\u044C\u043D\u044B\u043C
      \u043F\u0440\u0438\u043B\u0430\u0432\u043A\u043E\u043C, \u0441\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u043D\u044B\u043C
      \u0438\u0437 \u0449\u0435\u0440\u0431\u0430\u0442\u043E\u0433\u043E \u043F\u0435\u0440\u0435\u0432\u0435\u0440\u043D\u0443\u0442\u043E\u0433\u043E
      \u044F\u0449\u0438\u043A\u0430, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u043C
      \u043B\u0435\u0436\u0430\u0442 \u0441\u0442\u043E\u043F\u043A\u0438 \u0441\u0442\u0430\u0440\u044B\u0445
      \u043A\u043D\u0438\u0433."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u0440\u0430\u0437\u0434\u043D\u044B\u0439 \u0438\u043D\u0442\u0435\u0440\u0435\u0441
      \u0438 \u0431\u0430\u043D\u0430\u043B\u044C\u043D\u0430\u044F \u0441\u043A\u0443\u043A\u0430
      \u043F\u043E\u0434\u0442\u0430\u043B\u043A\u0438\u0432\u0430\u044E\u0442 {playerName}
      \u043F\u043E\u0434\u043E\u0439\u0442\u0438 \u0431\u043B\u0438\u0436\u0435,
      \u0447\u0442\u043E\u0431\u044B \u0440\u0430\u0441\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u0438\u0445 \u043E\u0431\u043B\u043E\u0436\u043A\u0438 \u0438 \u0432\u044B\u0446\u0432\u0435\u0442\u0448\u0438\u0435
      \u043A\u043E\u0440\u0435\u0448\u043A\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 9
    richText: "\u0411\u0435\u0434\u043D\u0430\u044F\u2026\u0421\u0438\u0434\u0435\u0442\u044C
      \u0437\u0434\u0435\u0441\u044C \u0447\u0430\u0441\u0430\u043C\u0438 \u0440\u0430\u0434\u0438
      \u043F\u0430\u0440\u044B \u0441\u043E\u0442\u0435\u043D \u0440\u0443\u0431\u043B\u0435\u0439
      - \u043F\u044B\u0442\u043A\u0430\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u0442\u0430\u0440\u0443\u0448\u043A\u0430 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0433\u043E\u043B\u043E\u0432\u0443, \u0438 \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442
      {playerName:acc}. \u0415\u0451 \u0433\u043B\u0430\u0437\u0430 \u043A\u0430\u0436\u0443\u0442\u0441\u044F
      \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u044F\u0441\u043D\u044B\u043C\u0438
      \u0434\u043B\u044F \u0441\u0442\u043E\u043B\u044C \u043F\u0440\u0435\u043A\u043B\u043E\u043D\u043D\u044B\u0445
      \u043B\u0435\u0442."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: dcfc619f088249ff9e2a46ecd1e81669, type: 2}
    emotion: 17
    richText: "\u041A\u0443\u043F\u0438 \u043A\u043D\u0438\u0436\u043A\u0443, \u043C\u0438\u043B\u0430\u044F\u2026
      \u0421\u043A\u0430\u0437\u043A\u0438 - \u043E\u043D\u0438 \u0442\u0430\u043A\u0438\u0435:
      \u0432 \u043D\u0438\u0445 \u0432\u0441\u044F \u043F\u0440\u0430\u0432\u0434\u0430,
      \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0432 \u0436\u0438\u0437\u043D\u0438
      \u0442\u0435\u0431\u0435 \u043D\u0435 \u0441\u044B\u0441\u043A\u0430\u0442\u044C."
    style: {fileID: 0}
    authorComment: 
