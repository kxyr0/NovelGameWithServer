  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: zls1_dialogue_041
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0423\u043C\u044B\u0432\u0430\u0442\u044C\u0441\u044F \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F
      \u0438\u0437 \u043A\u043E\u0432\u0448\u0438\u043A\u0430. \u0412\u043E\u0434\u0430
      \u0445\u043E\u043B\u043E\u0434\u043D\u0430\u044F \u0434\u043E \u043B\u043E\u043C\u043E\u0442\u044B
      \u0432 \u043A\u043E\u0441\u0442\u044F\u0445 - \u0433\u043E\u0440\u044F\u0447\u0430\u044F
      \u0437\u0434\u0435\u0441\u044C \u0437\u0430 \u0440\u043E\u0441\u043A\u043E\u0448\u044C,
      \u0430 \u043A\u043E\u043C\u0444\u043E\u0440\u0442 \u0432 \u043D\u044B\u043D\u0435\u0448\u043D\u0438\u0445
      \u0440\u0435\u0430\u043B\u0438\u044F\u0445 - \u043F\u043E\u043D\u044F\u0442\u0438\u0435
      \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0441 \u0442\u043E\u0441\u043A\u043E\u0439 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435
      \u043E\u0442\u0440\u0430\u0436\u0435\u043D\u0438\u0435."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0418\u0441\u043A\u0430\u0436\u0435\u043D\u043D\u044B\u0435 \u043D\u0430
      \u043F\u043E\u0434\u0440\u0430\u0433\u0438\u0432\u0430\u044E\u0449\u0435\u0439
      \u0432\u043E\u0434\u043D\u043E\u0439 \u0433\u043B\u0430\u0434\u0438, \u0432
      \u0442\u0443\u0441\u043A\u043B\u043E\u043C \u0441\u0432\u0435\u0442\u0435 \u043A\u0435\u0440\u043E\u0441\u0438\u043D\u043E\u0432\u043E\u0439
      \u043B\u0430\u043C\u043F\u044B \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435
      \u0447\u0435\u0440\u0442\u044B \u043A\u0430\u0436\u0443\u0442\u0441\u044F \u0447\u0443\u0436\u0438\u043C\u0438,
      \u0430 \u0433\u043B\u0430\u0437\u0430 - \u043A\u0430\u043A \u0434\u0432\u0430
      \u0442\u0435\u043C\u043D\u044B\u0445 \u043F\u0440\u043E\u0432\u0430\u043B\u0430."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u0440\u0430\u0432\u0430 \u0431\u044B\u043B\u0430 \u0431\u0430\u0431
      \u041D\u044E\u0440\u0430 - \u0432\u0437\u0433\u043B\u044F\u0434 \u0443 \u043D\u0435\u0451
      \u043F\u043E\u0442\u0443\u0445\u0448\u0438\u0439."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 3
    richText: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E,
      \u043A\u0430\u043A \u043F\u0442\u0438\u0446\u0430 \u0432 \u043A\u043B\u0435\u0442\u043A\u0435\u2026
      \u0418 \u0442\u043E\u0448\u043D\u043E \u043E\u0442 \u0442\u043E\u0433\u043E,
      \u0447\u0442\u043E \u0434\u0432\u0435\u0440\u0446\u0430 \u043A\u043B\u0435\u0442\u043A\u0438
      \u0434\u0430\u0432\u043D\u043E \u043E\u0442\u043A\u0440\u044B\u0442\u0430,
      \u0430 \u044F \u0432\u0441\u0435 \u0440\u0430\u0432\u043D\u043E \u0441\u0438\u0436\u0443
      \u043D\u0430 \u0436\u0435\u0440\u0434\u043E\u0447\u043A\u0435 \u0438 \u0431\u043E\u044E\u0441\u044C
      \u0440\u0430\u0441\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u043A\u0440\u044B\u043B\u044C\u044F,
      \u0431\u043E\u044E\u0441\u044C \u0432\u0437\u043B\u0435\u0442\u0435\u0442\u044C\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u0432\u0437\u0434\u044B\u0445\u0430\u0435\u0442 \u0438,
      \u043E\u0431\u0442\u0435\u0440\u0435\u0432 \u043B\u0438\u0446\u043E \u0432\u0430\u0444\u0435\u043B\u044C\u043D\u044B\u043C
      \u043F\u043E\u043B\u043E\u0442\u0435\u043D\u0446\u0435\u043C, \u0443\u0445\u043E\u0434\u0438\u0442
      \u0432 \u043E\u0442\u0432\u0435\u0434\u0451\u043D\u043D\u0443\u044E \u0435\u0439
      \u043A\u043E\u043C\u043D\u0430\u0442\u0443\u0448\u043A\u0443 - \u0442\u0430\u043A\u0443\u044E
      \u043A\u0440\u043E\u0448\u0435\u0447\u043D\u0443\u044E, \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0449\u0443\u044E
      \u0441 \u0432\u0438\u0434\u0443 \u043A\u0430\u044E\u0442\u0443 \u043A\u043E\u0440\u0430\u0431\u043B\u044F,
      \u0437\u0430\u0442\u0435\u0440\u044F\u043D\u043D\u043E\u0433\u043E \u0432 \u043E\u043A\u0435\u0430\u043D\u0435
      \u043B\u0435\u0441\u0430. \u041F\u0435\u0440\u0432\u044B\u043C \u0434\u0435\u043B\u043E\u043C
      \u043E\u043D\u0430 \u0440\u0435\u0448\u0430\u0435\u0442 \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C\u0441\u044F\u2026"
    style: {fileID: 0}
    authorComment: 
--- !u!114 &8553945470244777835
MonoBehaviour:
