  guid: zls1_dialogue_025
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: bab_nyura
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u0430\u043A\u043E\u043D\u0435\u0446 \u043E\u043D\u0438 \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0442
      \u043A \u043D\u0435\u0432\u044B\u0441\u043E\u043A\u043E\u043C\u0443 \u0434\u043E\u043C\u0438\u043A\u0443
      \u0441 \u043E\u0431\u043B\u0443\u043F\u0438\u0432\u0448\u0435\u0439\u0441\u044F
      \u0437\u0435\u043B\u0451\u043D\u043E\u0439 \u043A\u0430\u043B\u0438\u0442\u043A\u043E\u0439.
      \u041D\u0430\u0434 \u0434\u0432\u0435\u0440\u044C\u044E - \u0441\u0432\u044F\u0437\u043A\u0430
      \u0441\u0443\u0445\u0438\u0445 \u0442\u0440\u0430\u0432, \u0440\u044F\u0434\u043E\u043C
      - \u043F\u0430\u0440\u0430 \u0440\u0435\u0437\u0438\u043D\u043E\u0432\u044B\u0445
      \u0441\u0430\u043F\u043E\u0433."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0411\u0430\u0431 \u041D\u044E\u0440\u0430 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0441\u043A\u0440\u0438\u043F\u0443\u0447\u0443\u044E \u0434\u0432\u0435\u0440\u044C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 17
    richText: "\u041F\u0440\u043E\u0445\u043E\u0434\u0438, \u043C\u043E\u044F \u0445\u043E\u0440\u043E\u0448\u0430\u044F.
      \u0422\u0443\u0442 \u0443 \u043C\u0435\u043D\u044F \u0432\u0441\u0451 \u043F\u043E-\u0441\u0442\u0430\u0440\u043E\u043C\u0443.
      \u041D\u043E \u0443\u044E\u0442\u043D\u043E. \u041E\u0431\u0436\u0438\u0432\u0435\u0448\u044C\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
