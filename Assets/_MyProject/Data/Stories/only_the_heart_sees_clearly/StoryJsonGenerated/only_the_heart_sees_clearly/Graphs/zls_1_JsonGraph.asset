    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0422\u043E\u0433\u0434\u0430 \u044D\u0442\u043E \u0431\u044B\u043B
      \u043E\u0442\u043F\u0443\u0441\u043A \u0437\u0430 \u0441\u0432\u043E\u0439
      \u0441\u0447\u0435\u0442 \u0438 \u0441\u043F\u043E\u043D\u0442\u0430\u043D\u043D\u044B\u0439
      \u0430\u0432\u0442\u043E\u0431\u0443\u0441 \u0434\u043E \u043C\u043E\u0440\u044F."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0434\u043D\u0435\u0439
      \u043D\u0430 \u043F\u043E\u0431\u0435\u0440\u0435\u0436\u044C\u0435, \u0437\u0430\u043F\u0430\u0445
      \u0441\u043E\u043B\u0438 \u0438 \u043D\u0430\u0434\u0435\u0436\u0434\u0430.
      \u0422\u0430\u043A \u043E\u043D\u0430 \u043F\u0440\u043E\u0432\u0435\u043B\u0430
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0434\u043D\u0435\u0439,
      \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
      \u043E\u0431\u0440\u0430\u0442\u043D\u043E \u0432 \u0433\u043E\u0440\u043E\u0434."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u043E \u0442\u043E\u0433\u0434\u0430 \u0441 \u043D\u0435\u0439
      \u0431\u044B\u043B \u043E\u043D."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u0435\u0439\u0447\u0430\u0441 \u0436\u0435 \u0435\u0451 \u043F\u043E\u043F\u0443\u0442\u0447\u0438\u043A\u0438
      - \u0440\u0430\u0437\u043E\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u0438\u0435
      \u0432 \u0441\u0435\u0431\u0435 \u0438 \u0440\u0430\u0441\u043F\u0443\u0445\u0448\u0430\u044F
      \u043E\u0442 \u0432\u0435\u0449\u0435\u0439 \u0441\u0443\u043C\u043A\u0430,
      \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0435\u0434\u0432\u0430 \u043F\u043E\u043C\u0435\u0441\u0442\u0438\u043B\u0430\u0441\u044C
      \u043D\u0430 \u0431\u0430\u0433\u0430\u0436\u043D\u0443\u044E \u043F\u043E\u043B\u043A\u0443."
    style: {fileID: 0}
    authorComment: 
