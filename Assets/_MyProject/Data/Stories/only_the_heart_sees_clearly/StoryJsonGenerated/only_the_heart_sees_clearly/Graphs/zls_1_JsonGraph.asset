  enter: {fileID: 0}
  exit: {fileID: 0}
  guid: zls1_dialogue_015
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 0
    position: 0
