  guid: zls1_dialogue_018
  nodeTitle: 
  activeCharacters: []
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u0431\u0440\u043E\u0441\u0430\u0435\u0442 \u0441\u0443\u043C\u043A\u0443
      \u043F\u0440\u044F\u043C\u043E \u043D\u0430 \u043F\u044B\u043B\u044C\u043D\u0443\u044E
      \u0434\u043E\u0440\u043E\u0433\u0443 \u0438 \u0434\u0435\u043B\u0430\u0435\u0442
      \u0448\u0430\u0433 \u043D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0431\u044A\u044F\u0442\u0438\u044F \u0431\u0430\u0431\u0443\u0448\u043A\u0438,
      \u043A\u0440\u0435\u043F\u043A\u0438\u0435 \u0438 \u0442\u0451\u043F\u043B\u044B\u0435,
      \u0434\u0430\u044E\u0442 \u0435\u0439 \u043F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C,
      \u0447\u0442\u043E \u043E\u043D\u0430 \u0437\u0434\u0435\u0441\u044C \u043D\u0435
      \u0447\u0443\u0436\u0430\u044F, \u0430 \u0436\u0435\u043B\u0430\u043D\u043D\u0430\u044F
      \u0433\u043E\u0441\u0442\u044C\u044F - \u0438 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043B\u044E\u0431\u0438\u043C\u0430\u044F \u0432\u043D\u0443\u0447\u043A\u0430,
      \u043F\u043E \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043E\u0447\u0435\u043D\u044C
      \u0441\u043A\u0443\u0447\u0430\u043B\u0438."
    style: {fileID: 0}
    authorComment: 
