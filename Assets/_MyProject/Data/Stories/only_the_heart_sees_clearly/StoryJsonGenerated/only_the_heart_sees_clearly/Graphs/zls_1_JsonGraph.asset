  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0440\u043E\u0442, \u043D\u043E \u0432\u043C\u0435\u0441\u0442\u043E \u0433\u043E\u043B\u043E\u0441\u0430
      \u0432\u044B\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u043B\u0438\u0448\u044C
      \u043E\u0442\u0447\u0430\u044F\u043D\u043D\u044B\u0439 \u0445\u0440\u0438\u043F.
      \u041F\u0430\u0445\u043D\u0435\u0442 \u043F\u0435\u0447\u043A\u043E\u0439,
      \u0442\u0435\u0441\u0442\u043E\u043C \u0438 \u0441\u0443\u0445\u0438\u043C\u0438
      \u0442\u0440\u0430\u0432\u0430\u043C\u0438 \u043D\u0430\u0434 \u0434\u0432\u0435\u0440\u044C\u044E.
      \u041D\u0430 \u043F\u043B\u0435\u0447\u0438 \u043B\u043E\u0436\u0438\u0442\u0441\u044F
      \u0447\u0442\u043E-\u0442\u043E \u043B\u0435\u0433\u043A\u043E\u0435 \u0438
      \u0442\u0435\u043F\u043B\u043E\u0435, \u0431\u0443\u0434\u0442\u043E \u043F\u043B\u0430\u0442\u043E\u043A."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: f0422403a4dc45c68330c10d7251ddc1, type: 2}
    emotion: 0
    richText: "\u0423\u0442\u0440\u043E \u0432\u0435\u0447\u0435\u0440\u0430 \u043C\u0443\u0434\u0440\u0435\u043D\u0435\u0435\u2026"
