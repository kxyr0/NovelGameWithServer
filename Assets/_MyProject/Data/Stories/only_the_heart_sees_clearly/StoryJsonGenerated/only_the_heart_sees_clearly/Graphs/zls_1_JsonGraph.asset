  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u0432\u0441\u0435\u0433\u0434\u0430 \u0434\u0443\u043C\u0430\u043B\u0430,
      \u0447\u0442\u043E \u0434\u0435\u0440\u0435\u0432\u0435\u043D\u0441\u043A\u0430\u044F
      \u0436\u0438\u0437\u043D\u044C - \u044D\u0442\u043E \u0447\u0442\u043E-\u0442\u043E
      \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438
      \u0438\u043B\u0438 \u0434\u0430\u0436\u0435 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438.
      \u0418 \u0432\u043E\u0442 \u0442\u0435\u043F\u0435\u0440\u044C \u044D\u0442\u0430
      \xAB\u0434\u0440\u0443\u0433\u0430\u044F \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C\xBB
      \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442 \u0435\u0451 \u0432\u0436\u0438\u0432\u0443\u044E."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 20
    richText: "\u0417\u0434\u0435\u0441\u044C \u0434\u0430\u0436\u0435 \u043C\u043E\u0431\u0438\u043B\u044C\u043D\u0430\u044F
      \u0441\u0432\u044F\u0437\u044C \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
      \u043D\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u043C \u0438\u0437\u0434\u044B\u0445\u0430\u043D\u0438\u0438\u2026"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412 \u044D\u0442\u043E\u0442 \u043C\u043E\u043C\u0435\u043D\u0442
      \u0438\u0437-\u0437\u0430 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u0430,
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044F \u0441\u0442\u043E\u043B\u0431
      \u043F\u044B\u043B\u0438, \u0432\u044B\u043B\u0435\u0442\u0430\u0435\u0442
      \u0432\u0441\u0430\u0434\u043D\u0438\u043A \u043D\u0430 \u043A\u0440\u0443\u043F\u043D\u043E\u043C
      \u0433\u043D\u0435\u0434\u043E\u043C \u043A\u043E\u043D\u0435."
    style: {fileID: 0}
    authorComment: 
