  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0440\u043E\u0442, \u0447\u0442\u043E\u0431\u044B \u0441\u043A\u0430\u0437\u0430\u0442\u044C
      \u043F\u043E-\u0434\u0435\u0442\u0441\u043A\u0438 \u043D\u0430\u0438\u0432\u043D\u043E\u0435
      \xAB\u043C\u0430\u043C\u2026\xBB, \u043D\u043E \u0432\u043C\u0435\u0441\u0442\u043E
      \u0433\u043E\u043B\u043E\u0441\u0430 \u0432\u044B\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043B\u0438\u0448\u044C \u043E\u0442\u0447\u0430\u044F\u043D\u043D\u044B\u0439
      \u0445\u0440\u0438\u043F. \u0418 \u0432 \u043E\u0442\u0432\u0435\u0442 - \u043D\u0438\u0447\u0435\u0433\u043E.
      \u0422\u043E\u043B\u044C\u043A\u043E \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u043D\u044B\u0435
      \u0433\u0443\u0434\u043A\u0438: \u043E\u0434\u0438\u043D, \u0432\u0442\u043E\u0440\u043E\u0439,
      \u0442\u0440\u0435\u0442\u0438\u0439."
    style: {fileID: 0}
    authorComment: "Unknown speaker candidate: {playerName} \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0440\u043E\u0442, \u0447\u0442\u043E\u0431\u044B \u0441\u043A\u0430\u0437\u0430\u0442\u044C
      \u043F\u043E-\u0434\u0435\u0442\u0441\u043A\u0438 \u043D\u0430\u0438\u0432\u043D\u043E\u0435
