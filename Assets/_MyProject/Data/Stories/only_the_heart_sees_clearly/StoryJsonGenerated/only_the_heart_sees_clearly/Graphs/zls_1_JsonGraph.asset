  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0428\u0435\u043F\u043E\u0442 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u0432\u0441\u0435 \u0433\u0440\u043E\u043C\u0447\u0435 \u0438 \u0433\u0440\u043E\u043C\u0447\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0414\u044B\u0445\u0430\u043D\u0438\u0435 \u0441\u0431\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0438 \u043E\u0442 \u0434\u043E\u043B\u0433\u043E\u0433\u043E \u0431\u0435\u0433\u0430
      \u0449\u0435\u043C\u0438\u0442 \u0433\u0434\u0435-\u0442\u043E \u043F\u043E\u0434
      \u043B\u0435\u0432\u044B\u043C \u0440\u0435\u0431\u0440\u043E\u043C. \u0412\u0435\u0442\u043A\u0430
      \u0431\u043E\u043B\u044C\u043D\u043E \u0445\u043B\u0435\u0449\u0435\u0442 \u043F\u043E
      \u0449\u0435\u043A\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041A \u043B\u0438\u0446\u0443 \u043F\u0440\u0438\u043B\u0438\u0432\u0430\u0435\u0442
      \u0436\u0430\u0440. \u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u043E\u043D\u0430
      \u0432\u043E\u0442-\u0432\u043E\u0442 \u043F\u043E\u0442\u0435\u0440\u044F\u0435\u0442
      \u0441\u043E\u0437\u043D\u0430\u043D\u0438\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: '{playerName}'
    speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 17
    richText: "\u042D\u0442\u043E \u0432\u043E\u043E\u0431\u0449\u0435 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E
      \u0432\u043E \u0441\u043D\u0435?"
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u043E \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442
      \u0431\u0435\u0436\u0430\u0442\u044C \u0431\u0435\u0437 \u043E\u0433\u043B\u044F\u0434\u043A\u0438
      \u0442\u0430\u043A, \u0441\u043B\u043E\u0432\u043D\u043E \u0443 \u043D\u0435\u0435
      \u043E\u0442\u043A\u0440\u044B\u043B\u043E\u0441\u044C \u0432\u0442\u043E\u0440\u043E\u0435
      \u0434\u044B\u0445\u0430\u043D\u0438\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u0441\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443, \u043D\u043E \u0434\u043E\u0440\u043E\u0436\u043A\u0438
      \u0441\u043B\u0438\u0432\u0430\u044E\u0442\u0441\u044F \u0432 \u043E\u0434\u043D\u0443."
    style: {fileID: 0}
    authorComment: 
