  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u043E\u0435\u0437\u0434 \u043D\u0435\u0441\u0451\u0442\u0441\u044F
      \u0432\u0441\u0435 \u0434\u0430\u043B\u044C\u0448\u0435, \u043A\u043E\u043B\u0451\u0441\u0430
      \u043C\u0435\u0440\u043D\u043E \u0441\u0442\u0443\u0447\u0430\u0442 \u043E
      \u0440\u0435\u043B\u044C\u0441\u044B."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412 \u043E\u043A\u043D\u0435 \u043C\u0435\u043B\u044C\u043A\u0430\u0435\u0442
      \u044F\u0440\u043A\u0430\u044F \u0437\u0435\u043B\u0435\u043D\u044C \u0434\u0435\u0440\u0435\u0432\u044C\u0435\u0432,
      \u0441\u0435\u0440\u044B\u0435 \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u044B,
      \u0441\u0442\u0430\u0440\u044B\u0435, \u043F\u043E\u043A\u043E\u0441\u0438\u0432\u0448\u0438\u0435\u0441\u044F
      \u0434\u043E\u043C\u0438\u043A\u0438 \u0438 \u0446\u0435\u0440\u043A\u0432\u0443\u0448\u043A\u0438,
      \u0437\u0430\u0441\u0430\u0436\u0435\u043D\u043D\u044B\u0435 \u043E\u0433\u043E\u0440\u043E\u0434\u044B
      \u0438 \u043F\u043E\u043B\u044F."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u044B \u0432\u044B\u0445\u043E\u0434\u044F\u0442
      \u043D\u0430 \u0440\u0430\u0437\u043D\u044B\u0445 \u0441\u0442\u0430\u043D\u0446\u0438\u044F\u0445
      \u043E\u0434\u0438\u043D \u0437\u0430 \u043E\u0434\u043D\u0438\u043C, \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044F
      {playerName} \u0442\u043E\u043C\u0438\u0442\u044C\u0441\u044F \u0434\u0443\u0448\u043D\u043E\u043C
      \u043F\u043B\u0430\u0446\u043A\u0430\u0440\u0442\u0435 - \u0432 \u043E\u0434\u0438\u043D\u043E\u0447\u0435\u0441\u0442\u0432\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u043D\u0435\u0443\u044E\u0442\u043D\u043E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: '{playerName}'
    speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 20
    richText: "\u041D\u0443 \u043A\u043E\u043D\u0435\u0447\u043D\u043E. \u041A\u043E\u043C\u0443
      \u0435\u0449\u0435 \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F
      \u0435\u0445\u0430\u0442\u044C \u0432 \u0442\u0430\u043A\u0443\u044E \u0433\u043B\u0443\u0445\u043E\u043C\u0430\u043D\u044C\u2026"
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421 \u0433\u0440\u043E\u043C\u043A\u0438\u043C \u0445\u043B\u043E\u043F\u043A\u043E\u043C
      \u043E\u043D\u0430 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0441\u0442\u0430\u0440\u0443\u044E
      \u043A\u043D\u0438\u0436\u043A\u0443 \u0441 \u043F\u043E\u0442\u0440\u0451\u043F\u0430\u043D\u043D\u044B\u043C
      \u043A\u043E\u0440\u0435\u0448\u043A\u043E\u043C \u0438, \u043F\u043E\u0434\u043F\u0435\u0440\u0435\u0432
      \u0440\u0443\u043A\u043E\u0439 \u0433\u043E\u043B\u043E\u0432\u0443, \u0443\u0441\u0442\u0440\u0435\u043C\u043B\u044F\u0435\u0442
      \u0441\u043A\u0443\u0447\u0430\u044E\u0449\u0438\u0439 \u0432\u0437\u0433\u043B\u044F\u0434
      \u0432 \u043E\u043A\u043D\u043E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0442 \u0434\u0443\u0445\u043E\u0442\u044B, \u0441\u0442\u0430\u0432\u0448\u0435\u0439
      \u043F\u043E\u0447\u0442\u0438 \u043E\u0441\u044F\u0437\u0430\u0435\u043C\u043E\u0439,
      \u043A\u043B\u043E\u043D\u0438\u0442 \u0432 \u0441\u043E\u043D. \u0412 \u0441\u043E\u0437\u043D\u0430\u043D\u0438\u0438
      \u043C\u0435\u043B\u044C\u043A\u0430\u044E\u0442 \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0435
      \u043E\u0431\u0440\u0430\u0437\u044B: \u0432\u043E\u043B\u043A\u0438 \u0441
      \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0438\u043C\u0438
      \u0433\u043B\u0430\u0437\u0430\u043C\u0438, \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u044B\u0435
      \u0440\u0443\u0441\u0430\u043B\u043A\u0438, \u0448\u0435\u043F\u0447\u0443\u0449\u0438\u0435
      \u0435\u0451 \u0438\u043C\u044F... - \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435,
      \u0437\u0430 \u0447\u0442\u043E \u0446\u0435\u043F\u043B\u044F\u0435\u0442\u0441\u044F
      \u0443\u0442\u043E\u043C\u043B\u0451\u043D\u043D\u044B\u0439 \u0440\u0430\u0437\u0443\u043C."
    style: {fileID: 0}
    authorComment: "Unknown speaker candidate: \u041E\u0442 \u0434\u0443\u0445\u043E\u0442\u044B,
      \u0441\u0442\u0430\u0432\u0448\u0435\u0439 \u043F\u043E\u0447\u0442\u0438 \u043E\u0441\u044F\u0437\u0430\u0435\u043C\u043E\u0439,
      \u043A\u043B\u043E\u043D\u0438\u0442 \u0432 \u0441\u043E\u043D. \u0412 \u0441\u043E\u0437\u043D\u0430\u043D\u0438\u0438
      \u043C\u0435\u043B\u044C\u043A\u0430\u044E\u0442 \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0435
      \u043E\u0431\u0440\u0430\u0437\u044B"
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u0441\u0432\u043E\u0435\u0439
      \u0441\u0442\u0430\u043D\u0446\u0438\u0438 {playerName} \u0441\u043B\u044B\u0448\u0438\u0442
      \u0441\u043A\u0432\u043E\u0437\u044C \u043F\u043E\u043B\u0443\u0434\u0440\u0451\u043C\u0443.
      \u0420\u0435\u0437\u043A\u0438\u0439 \u0442\u043E\u043B\u0447\u043E\u043A \u043F\u043E\u0435\u0437\u0434\u0430
      \u0438 \u0443\u043F\u0430\u0432\u0448\u0430\u044F \u0441 \u0433\u043B\u0443\u0445\u0438\u043C
      \u0441\u0442\u0443\u043A\u043E\u043C \u043D\u0430 \u0433\u0440\u044F\u0437\u043D\u044B\u0439
      \u043F\u043E\u043B \u043A\u043D\u0438\u0433\u0430 \u0437\u0430\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442
      \u0435\u0435 \u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u043F\u0440\u043E\u0441\u043D\u0443\u0442\u044C\u0441\u044F."
    style: {fileID: 0}
    authorComment: 
  - speakerId: voice
    speakerNameHint: "\u0413\u043E\u043B\u043E\u0441"
    speaker: {fileID: 11400000, guid: f0422403a4dc45c68330c10d7251ddc1, type: 2}
    emotion: 0
    richText: "\u0421\u0442\u0430\u043D\u0446\u0438\u044F \xAB\u0414\u0435\u0440\u0435\u0432\u043D\u044F
      \u041F\u043E\u0434\u043B\u0435\u0441\u044C\u0435\xBB. \u0421\u0442\u043E\u044F\u043D\u043A\u0430
      \u0434\u0432\u0435 \u043C\u0438\u043D\u0443\u0442\u044B"
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: '{playerName}'
    speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 20
    richText: "\u041D\u0443 \u043D\u0430\u043A\u043E\u043D\u0435\u0446-\u0442\u043E!
      \u0415\u0449\u0451 \u0447\u0430\u0441 \u0437\u0434\u0435\u0441\u044C - \u0438
      \u044F \u0431\u044B \u0440\u0430\u0441\u0442\u0430\u044F\u043B\u0430, \u043A\u0430\u043A
      \u043F\u043B\u043E\u043C\u0431\u0438\u0440\u2026"
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u043E\u0434\u043E\u0431\u0440\u0430\u0432 \u043A\u043D\u0438\u0433\u0443
      \u0438 \u043A\u043E\u0435-\u043A\u0430\u043A \u0437\u0430\u043F\u0438\u0445\u043D\u0443\u0432
      \u0435\u0451 \u0432 \u043A\u0430\u0440\u043C\u0430\u043D \u0441\u0443\u043C\u043A\u0438,
      \u043E\u043D\u0430 \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u0438\u0437
      \u043F\u043E\u0435\u0437\u0434\u0430, \u0432\u043E\u043B\u043E\u0447\u0430
      \u0437\u0430 \u0441\u043E\u0431\u043E\u0439 \u0442\u044F\u0436\u0435\u043B\u044B\u0439
      \u0431\u0430\u0433\u0430\u0436 - \u0435\u0445\u0430\u043B\u0430 \u043D\u0430
      \u043D\u0435\u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u043D\u044B\u0439
      \u0441\u0440\u043E\u043A, \u0430 \u043F\u043E\u0442\u043E\u043C\u0443 \u0432\u0437\u044F\u043B\u0430
      \u0441 \u0441\u043E\u0431\u043E\u0439 \u0432\u0441\u0435, \u0447\u0442\u043E
      \u0442\u043E\u043B\u044C\u043A\u043E \u043C\u043E\u0436\u0435\u0442 \u0435\u0439
      \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u044C\u0441\u044F \u0432 \u0433\u043B\u0443\u0445\u043E\u0439
      \u0434\u0435\u0440\u0435\u0432\u0443\u0448\u043A\u0435, \u0432\u043A\u043B\u044E\u0447\u0430\u044F
      \u043D\u0430\u0431\u043E\u0440 \u0434\u043B\u044F \u0432\u044F\u0437\u0430\u043D\u0438\u044F,
      \u0447\u0442\u043E\u0431\u044B \u043D\u0435 \u043F\u043E\u043C\u0435\u0440\u0435\u0442\u044C
      \u0441\u043E \u0441\u043A\u0443\u043A\u0438."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0412\u044F\u0437\u0430\u0442\u044C \u043E\u043D\u0430, \u043A \u0441\u043B\u043E\u0432\u0443,
      \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u0438 \u043D\u0435 \u0443\u043C\u0435\u043B\u0430,
      \u043D\u043E \u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043B\u0430
      \u043D\u0430\u0443\u0447\u0438\u0442\u044C\u0441\u044F \u0443 \u0431\u0430\u0431
      \u041D\u044E\u0440\u044B, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043A\u043B\u044F\u0442\u0432\u0435\u043D\u043D\u043E
      \u043E\u0431\u0435\u0449\u0430\u043B\u0430 \u0435\u0451 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "{playerName} \u0441 \u0442\u0440\u0443\u0434\u043E\u043C \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442,
      \u043A\u0430\u043A \u0442\u0430 \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442."
    style: {fileID: 0}
    authorComment: 
  - speakerId: hero
    speakerNameHint: '{playerName}'
    speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 9
    richText: "\u0421\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E, \u043A\u0430\u043A
      \u0432\u0441\u0435 \u0431\u0430\u0431\u0443\u0448\u043A\u0438 \u0438\u0437
      \u0434\u0435\u0442\u0441\u043A\u0438\u0445 \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0439.
      \u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F, \u0443\u044E\u0442\u043D\u0430\u044F
      \u0438 \u043F\u0430\u0445\u043D\u0435\u0442 \u043F\u0435\u0447\u043A\u043E\u0439\u2026"
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0440\u0430\u0437
      \u043E\u043D\u0430 \u0432\u0438\u0434\u0435\u043B\u0430 \u0431\u0430\u0431\u0443\u0448\u043A\u0443
      \u043B\u0435\u0442 \u043F\u044F\u0442\u044C \u043D\u0430\u0437\u0430\u0434,
      \u0445\u043E\u0442\u044F, \u043F\u043E \u043D\u0430\u0441\u0442\u043E\u044F\u043D\u0438\u044E
      \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0435\u0439, \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043B\u0430
      \u0441 \u043D\u0435\u0439 \u043A\u043E\u043D\u0442\u0430\u043A\u0442: \u0437\u0432\u043E\u043D\u0438\u043B\u0430
      \u0432\u0440\u0435\u043C\u044F \u043E\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u0438,
      \u0445\u043E\u0442\u044F \u043D\u0435 \u0432\u0441\u0435\u0433\u0434\u0430
      \u043F\u043E\u043B\u0443\u0447\u0430\u043B\u043E\u0441\u044C \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
      \u0438\u0437-\u0437\u0430 \u0437\u0434\u0435\u0448\u043D\u0435\u0439 \u043A\u0430\u043F\u0440\u0438\u0437\u043D\u043E\u0439
      \u0441\u0432\u044F\u0437\u0438."
    style: {fileID: 0}
    authorComment: "Unknown speaker candidate: \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u0440\u0430\u0437 \u043E\u043D\u0430 \u0432\u0438\u0434\u0435\u043B\u0430
      \u0431\u0430\u0431\u0443\u0448\u043A\u0443 \u043B\u0435\u0442 \u043F\u044F\u0442\u044C
      \u043D\u0430\u0437\u0430\u0434, \u0445\u043E\u0442\u044F, \u043F\u043E \u043D\u0430\u0441\u0442\u043E\u044F\u043D\u0438\u044E
      \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0435\u0439, \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043B\u0430
      \u0441 \u043D\u0435\u0439 \u043A\u043E\u043D\u0442\u0430\u043A\u0442"
