  guid: zls1_dialogue_059
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: bab_nyura
  lines:
  - speakerId: bab_nyura
    speakerNameHint: "\u0411\u0430\u0431 \u041D\u044E\u0440\u0430"
    speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 17
    richText: "\u0422\u0440\u0430\u0432\u043A\u0438 \u043C\u043E\u0438. \u0421\u0430\u043C\u0430
      \u0441\u043E\u0431\u0438\u0440\u0430\u043B\u0430, \u0434\u0430 \u0441\u0443\u0448\u0438\u043B\u0430\u2026
      \u041F\u043E\u043F\u0435\u0439, \u0447\u0442\u043E\u0431\u044B \u0442\u0440\u0435\u0432\u043E\u0433\u0443
      \u0443\u043D\u044F\u0442\u044C, \u0434\u0430 \u0441\u043F\u0430\u0442\u044C
      \u043A\u0440\u0435\u043F\u043A\u043E."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0427\u0430\u0439 \u043F\u0430\u0445\u043D\u0435\u0442 \u043F\u043E\u043B\u044B\u043D\u044C\u044E
      \u0438 \u0447\u0435\u043C-\u0442\u043E \u0442\u0435\u0440\u043F\u043A\u0438\u043C.
      \u0413\u043E\u0440\u0447\u0438\u0442 \u043D\u0430 \u044F\u0437\u044B\u043A\u0435.
      {playerName} \u043C\u043E\u0440\u0449\u0438\u0442\u0441\u044F, \u043D\u043E
      \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u0434\u043E\u043F\u0438\u0432\u0430\u0435\u0442
      - \u0438\u0437 \u0443\u043F\u0440\u044F\u043C\u0441\u0442\u0432\u0430. \u0412\u043D\u0443\u0442\u0440\u0438
      \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0442\u0438\u0448\u0435,
      \u0431\u0443\u0434\u0442\u043E \u043A\u0442\u043E-\u0442\u043E \u043F\u0440\u0438\u043A\u0440\u0443\u0442\u0438\u043B
      \u0433\u0440\u043E\u043C\u043A\u043E\u0441\u0442\u044C \u0435\u0451 \u043C\u044B\u0441\u043B\u0435\u0439."
    style: {fileID: 0}
    authorComment: 
