  guid: zls1_dialogue_016
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: bab_nyura
  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u0442\u0443\u043F\u0438\u0432 \u043D\u0430 \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0439
      \u043F\u0435\u0440\u0440\u043E\u043D, \u043E\u043D\u0430 \u0441\u0440\u0430\u0437\u0443
      \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442, \u043A\u0430\u043A
      \u043E\u0431\u0443\u0432\u044C \u0442\u043E\u043D\u0435\u0442 \u0432 \u0440\u044B\u0445\u043B\u043E\u0439
      \u0437\u0435\u043C\u043B\u0435. \u041D\u0438\u043A\u0430\u043A\u043E\u0433\u043E
      \u0430\u0441\u0444\u0430\u043B\u044C\u0442\u0430 \u0438 \u043F\u043B\u0438\u0442\u043A\u0438
      - \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0441\u0435\u0440\u0435\u0432\u0448\u0438\u0435
      \u043E\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0434\u043E\u0441\u043A\u0438,
      \u0442\u0440\u0430\u0432\u0430-\xAB\u0437\u0435\u043B\u0451\u043D\u043A\u0430\xBB
      \u0438 \u0437\u0435\u043C\u043B\u044F \u043C\u0430\u0442\u0443\u0448\u043A\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041F\u043E\u0435\u0437\u0434, \u0438\u0437\u0434\u0430\u0432 \u043F\u0440\u043E\u0449\u0430\u043B\u044C\u043D\u044B\u0439
      \u0433\u0443\u0434\u043E\u043A, \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u0443\u043F\u043B\u044B\u0432\u0430\u0435\u0442 \u0432\u0434\u0430\u043B\u044C,
      \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044F \u0435\u0451 \u0432 \u043E\u0433\u043B\u0443\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
      \u0442\u0438\u0448\u0438\u043D\u0435."
    style: {fileID: 0}
    authorComment: 
  - speakerId: bab_nyura
    speakerNameHint: "\u0411\u0430\u0431 \u041D\u044E\u0440\u0430"
    speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 2
    richText: "\u0411\u0430\u0442\u044E\u0448\u043A\u0438, \u0430 \u0432\u044B\u0440\u043E\u0441\u043B\u0430-\u0442\u043E
      \u043A\u0430\u043A, {playerName}! \u042F \u0442\u0435\u0431\u044F \u0441\u0440\u0430\u0437\u0443
      \u0438 \u043D\u0435 \u043F\u0440\u0438\u0437\u043D\u0430\u043B\u0430, \u043A\u0430\u0441\u0430\u0442\u043E\u0447\u043A\u0430
      \u043C\u043E\u044F! \u0421\u043E\u0432\u0441\u0435\u043C \u0443\u0436\u0435
      \u043D\u0435\u0432\u0435\u0441\u0442\u0430!"
    style: {fileID: 0}
    authorComment: 
