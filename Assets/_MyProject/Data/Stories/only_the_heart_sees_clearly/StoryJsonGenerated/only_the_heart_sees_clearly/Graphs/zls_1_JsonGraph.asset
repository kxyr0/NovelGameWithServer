    richText: "\u0418 \u044F \u0440\u0430\u0434\u0430 \u0442\u0435\u0431\u044F \u0432\u0438\u0434\u0435\u0442\u044C,
      \u0431\u0430\u0431 \u041D\u044E\u0440\u2026 \u041F\u0440\u0430\u0432\u0434\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: bab_nyura
    speakerNameHint: "\u0411\u0430\u0431 \u041D\u044E\u0440\u0430"
    speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 6
    richText: "\u041E\u0439, \u0445\u0443\u0434\u0430\u044F-\u0442\u043E \u043A\u0430\u043A\u0430\u044F!
      \u041F\u043E\u0439\u0434\u0451\u043C, \u0434\u0435\u0442\u043E\u0447\u043A\u0430.
      \u0423\u0436\u0438\u043D \u0443\u0436\u0435 \u0441\u0442\u044B\u043D\u0435\u0442
      - \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E \u0433\u043E\u0442\u043E\u0432\u0438\u043B\u0430
      \u043A \u0442\u0432\u043E\u0435\u043C\u0443 \u043F\u0440\u0438\u0435\u0437\u0434\u0443,
      \u043B\u0430\u043F\u0448\u0443 \u0434\u043E\u043C\u0430\u0448\u043D\u044E\u044E
      \u043A\u0430\u0442\u0430\u043B\u0430."
    style: {fileID: 0}
    authorComment: 
  - speakerId: bab_nyura
    speakerNameHint: "\u0411\u0430\u0431 \u041D\u044E\u0440\u0430"
    speaker: {fileID: 11400000, guid: 5146748805ce46f289363f19c8cebc9f, type: 2}
    emotion: 2
    richText: "\u041F\u043E\u0439\u0434\u0451\u043C, \u043F\u043E\u0439\u0434\u0451\u043C,
      \u043F\u043E\u043A\u0430 \u043A\u043E\u043C\u0430\u0440\u044B \u043D\u0435
      \u0438\u0441\u043A\u0443\u0441\u0430\u043B\u0438!"
    style: {fileID: 0}
    authorComment: 
