  lines:
  - speakerId: 
    speakerNameHint: 
    speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u043D\u0430 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0438\u0442
      \u0432\u0437\u0433\u043B\u044F\u0434 \u043D\u0430 \u0441\u0442\u043E\u043B.
      \u0422\u0430\u043C \u0432\u0441\u0435 \u0442\u0430\u043A \u0436\u0435 \u043B\u0435\u0436\u0438\u0442
      \u0441\u0442\u0430\u0440\u0430\u044F \u043A\u043D\u0438\u0436\u043A\u0430,
      \u043E\u0442\u043A\u0440\u044B\u0442\u0430\u044F \u043D\u0430 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0435
      \u0441 \u0432\u044B\u0446\u0432\u0435\u0442\u0448\u0435\u043C \u043E\u0442
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435\u043C
      \u041A\u043E\u0449\u0435\u044F. \u0415\u0433\u043E \u0447\u0435\u0440\u043D\u044B\u0435
      \u0433\u043B\u0430\u0437\u0430-\u043F\u0440\u043E\u0432\u0430\u043B\u044B \u043A\u0430\u0436\u0443\u0442\u0441\u044F
