  guid: zls1_dialogue_013
  nodeTitle: 
  activeCharacters:
  - character: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 0
    position: 0
    speakerNameHint: hero
  - character: {fileID: 11400000, guid: dcfc619f088249ff9e2a46ecd1e81669, type: 2}
    emotion: 0
    position: 2
    speakerNameHint: old_woman
  lines:
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 17
    richText: "\u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u0432\u043E\u0442 \u044D\u0442\u0443,
      \u0441 \u0432\u043E\u043B\u043A\u043E\u043C."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: dcfc619f088249ff9e2a46ecd1e81669, type: 2}
    emotion: 17
    richText: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0442\u0435\u0431\u0435,
      \u0432\u043D\u0443\u0447\u043A\u0430. \u0411\u0435\u0440\u0435\u0433\u0438
      \u0441\u0435\u0431\u044F. \u0421\u043A\u0430\u0437\u043A\u0430 \u0441\u0430\u043C\u0430
      \u0442\u0435\u0431\u044F \u0432\u044B\u0431\u0440\u0430\u043B\u0430."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: d146811a8c0b49afbc98a3f67fd2d46e, type: 2}
    emotion: 6
    richText: "\u0427\u0442\u043E?"
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 11400000, guid: dcfc619f088249ff9e2a46ecd1e81669, type: 2}
    emotion: 17
    richText: "\u041D\u0438\u0447\u0435\u0433\u043E, \u043C\u0438\u043B\u0430\u044F,
      \u0437\u0430\u0431\u043E\u043B\u0442\u0430\u043B\u0430\u0441\u044C \u044F \u0447\u0442\u043E-\u0442\u043E\u2026
      \u0412\u0438\u0436\u0443 \u043F\u0440\u043E\u0441\u0442\u043E, \u0447\u0442\u043E
      \u043F\u0443\u0442\u044C \u0443 \u0442\u0435\u0431\u044F \u0434\u043E\u043B\u0433\u0438\u0439,
      \u0430 \u043D\u0430 \u0441\u0435\u0440\u0434\u0446\u0435 \u0442\u044F\u0436\u043A\u043E."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u041E\u0442 \u0441\u0442\u0440\u0430\u043D\u043D\u043E\u0433\u043E
      \u0434\u0438\u0430\u043B\u043E\u0433\u0430 \u0435\u0451 \u043E\u0442\u0432\u043B\u0435\u043A\u0430\u0435\u0442
      \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0430\u044E\u0449\u0438\u0439
      \u0433\u0443\u0434\u043E\u043A \u043F\u043E\u0435\u0437\u0434\u0430 - \u0432\u043E\u0442
      \u0443\u0436 \u0438 \u043F\u0440\u0430\u0432\u0434\u0430, \u0437\u0430\u0431\u043E\u043B\u0442\u0430\u043B\u0430\u0441\u044C\u2026"
    style: {fileID: 0}
    authorComment: 
