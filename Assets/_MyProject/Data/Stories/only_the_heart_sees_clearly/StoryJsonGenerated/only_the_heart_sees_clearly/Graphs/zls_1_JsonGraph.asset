  guid: zls1_dialogue_005
  nodeTitle: "\u041E\u0431\u0443\u0447\u0435\u043D\u0438\u0435"
  activeCharacters: []
  lines:
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0432\u044B\u0431\u043E\u0440
      \u043F\u043E\u043C\u043E\u0436\u0435\u0442 \u0432\u0430\u043C \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u044C
      \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440 \u0433\u043B\u0430\u0432\u043D\u043E\u0439
      \u0433\u0435\u0440\u043E\u0438\u043D\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u0442\u0430\u0442 \u0421\u043A\u0430\u0437\u043A\u0430 \u043E\u0442\u0440\u0430\u0436\u0430\u0435\u0442
      \u0435\u0451 \u0441\u043A\u043B\u043E\u043D\u043D\u043E\u0441\u0442\u044C \u0434\u043E\u0432\u0435\u0440\u044F\u0442\u044C
      \u0438\u043D\u0442\u0443\u0438\u0446\u0438\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u0442\u0430\u0442 \u0413\u043E\u0440\u043E\u0434 \u043E\u0442\u0440\u0430\u0436\u0430\u0435\u0442
      \u0435\u0435 \u0441\u043A\u043B\u043E\u043D\u043D\u043E\u0441\u0442\u044C \u043A
      \u0440\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u0438."
    style: {fileID: 0}
    authorComment: 
  - speaker: {fileID: 0}
    emotion: 0
    richText: "\u0421\u0442\u0430\u0442 \u0423\u0432\u0430\u0436\u0435\u043D\u0438\u0435
      \u043E\u0442\u0440\u0430\u0436\u0430\u0435\u0442 \u0442\u043E, \u043A\u0430\u043A
      \u043A \u0433\u0435\u0440\u043E\u0438\u043D\u0435 \u0431\u0443\u0434\u0443\u0442
      \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u044C\u0441\u044F \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0438\u0435."
    style: {fileID: 0}
    authorComment: 
