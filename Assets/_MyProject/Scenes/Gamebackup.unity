--- !u!114 &585303005
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 585303003}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ea538e4a5f444051b8e4431efe3fad2d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _runOnStart: 1
  _restartIfAlreadyRunning: 0
  _rememberCompletedSteps: 1
  _debugShowEveryLaunch: 0
  _showEveryPlayInDebug: 0
  _forceShowAllSteps: 0
  _root: {fileID: 585303003}
  _canvasGroup: {fileID: 585303006}
  _panelRoot: {fileID: 611787320}
  _titleText: {fileID: 1974010696}
  _titleBackground: {fileID: 822416088}
  _bodyText: {fileID: 1039994103}
  _primaryButton: {fileID: 15961248}
  _primaryButtonText: {fileID: 1617672985}
  _secondaryButton: {fileID: 309543261}
  _secondaryButtonText: {fileID: 1462233}
  _secondaryButtonOnlyOnLastStep: 1
  _bringToFrontOnShow: 1
  _deactivateRootOnHide: 0
  _disableLegacyFirstLaunchControllers: 1
  _clearAllRootTextsBeforeWrite: 1
  _steps:
  - _enabled: 1
    _state: 1
    _stepKey: cat_intro
    _revision: 1
    _title: "\u041C\u044F\u0443..."
    _body: "\u042F \u2014 \u0442\u0432\u043E\u0439 \u043C\u043E\u0445\u043D\u0430\u0442\u044B\u0439
      \u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\n\u0432 Nocturne \u2014
      \u0432 \u043C\u0438\u0440\u0435, \u0433\u0434\u0435 \u043A\u0430\u0436\u0434\u044B\u0439\n\u0432\u044B\u0431\u043E\u0440
      \u043C\u0435\u043D\u044F\u0435\u0442 \u0445\u043E\u0434 \u0442\u0432\u043E\u0435\u0439\n\u0438\u0441\u0442\u043E\u0440\u0438\u0438.
      \u0421\u0432\u0435\u0447\u0438 \u0437\u0434\u0435\u0441\u044C \u043E\u0441\u0432\u0435\u0449\u0430\u044E\u0442\n\u043F\u0443\u0442\u044C,
      \u0430 \u0420\u0443\u0431\u0438\u043D\u044B \u0437\u0430\u0436\u0438\u0433\u0430\u044E\u0442\n\u043C\u043E\u043C\u0435\u043D\u0442\u044B,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043C\u0435\u043D\u044F\u044E\u0442
      \u0432\u0441\u0451..."
    _primaryButtonText: "\u041F\u043E\u043D\u044F\u0442\u043D\u043E"
    _primaryAction: 0
    _showSecondaryButton: 0
    _secondaryButtonText: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C
      \u0442\u0430\u043A"
    _secondaryAction: 1
    _overridePanelSize: 1
    _panelSize: {x: 1117.69, y: 1930.39}
    _showTitleBackground: 1
    _overrideTitleBackgroundSize: 0
    _titleBackgroundSize: {x: 337, y: 184}
    _overrideTitleTextLayout: 0
    _titleTextSize: {x: 337, y: 96}
    _titleFontSize: 42
    _titleTextOffset: {x: 0, y: 0}
    _overrideBodyTextLayout: 0
    _bodyTextSize: {x: 900, y: 520}
    _bodyFontSize: 32
    _bodyTextOffset: {x: 0, y: 0}
  - _enabled: 1
    _state: 2
    _stepKey: terms
    _revision: 1
    _title: "\u0423\u0441\u043B\u043E\u0432\u0438\u044F \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F"
    _body: "\u041D\u0430\u0436\u0438\u043C\u0430\u044F \u201C\u041F\u0440\u0438\u043D\u044F\u0442\u044C\u201D,
      \u0432\u044B \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442\u0435
      \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u0435 \u0441 \u0423\u0441\u043B\u043E\u0432\u0438\u044F\u043C\u0438
      \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F \u0438 \u041F\u043E\u043B\u0438\u0442\u0438\u043A\u043E\u0439
      \u043A\u043E\u043D\u0444\u0438\u0434\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438.
      \u041F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442
      \u0440\u043E\u043C\u0430\u043D\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u043A\u043E\u043D\u0442\u0435\u043D\u0442. \u0412\u043E\u0437\u0440\u0430\u0441\u0442\u043D\u043E\u0435
      \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u0435 16+"
    _primaryButtonText: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C"
    _primaryAction: 0
    _showSecondaryButton: 0
    _secondaryButtonText: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C
      \u0442\u0430\u043A"
    _secondaryAction: 1
    _overridePanelSize: 1
    _panelSize: {x: 1117.69, y: 2018.65}
    _showTitleBackground: 1
    _overrideTitleBackgroundSize: 1
    _titleBackgroundSize: {x: 456.3, y: 184}
    _overrideTitleTextLayout: 0
    _titleTextSize: {x: 337, y: 96}
    _titleFontSize: 42
    _titleTextOffset: {x: 0, y: 0}
    _overrideBodyTextLayout: 0
    _bodyTextSize: {x: 900, y: 520}
    _bodyFontSize: 32
    _bodyTextOffset: {x: 0, y: 0}
  - _enabled: 1
    _state: 3
    _stepKey: progress_warning
    _revision: 1
    _title: "\u0412\u043D\u0438\u043C\u0430\u043D\u0438\u0435!"
    _body: "\u0421\u043E\u0445\u0440\u0430\u043D\u0438 \u0441\u0432\u043E\u0439 \u043F\u0443\u0442\u044C
      !\r\n\u0412\u043E\u0439\u0434\u0438 \u0432 \u0430\u043A\u043A\u0430\u0443\u043D\u0442,
      \u0447\u0442\u043E\u0431\u044B \u043D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C
      \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441, \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439
      \u0438\u0433\u0440\u0443 \u0441 \u043B\u044E\u0431\u043E\u0433\u043E \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430
      \u0432 \u043B\u044E\u0431\u043E\u0435 \u0432\u0440\u0435\u043C\u044F"
    _primaryButtonText: "\u0412\u043E\u0439\u0442\u0438"
    _primaryAction: 2
    _showSecondaryButton: 0
    _secondaryButtonText: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C
      \u0442\u0430\u043A"
