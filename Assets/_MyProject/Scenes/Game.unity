      m_Calls: []
  m_text: "\u041E\u043F\u0438\u0441\u0430\u043D\u0438\u0435 \u043D\u043E\u0432\u0435\u043B\u043B\u044B,
    \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0441\u043E\u0441\u0442\u043E\u0438\u0442
    \u0438\u0437 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445 \u0441\u0442\u0440\u043E\u043A,
    \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043E\u0447\u0435\u043D\u044C
    \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u043C \u0438 \u0432\u044B\u043D\u0443\u0436\u0434\u0430\u0435\u0442
    \u044D\u0442\u0438\u043C \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044F
    \u043D\u0430\u0447\u0430\u0442\u044C \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442\u044C
    \u043D\u043E\u0432\u0435\u043B\u043B\u0443. \u0410 \u044D\u0442\u043E\u0442 \u043A\u0443\u0441\u043E\u043A
    \u0442\u0435\u043A\u0441\u0442\u0430 \u044F \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u044E
    \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u043B\u044F \u0442\u043E\u0433\u043E,
    \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C
    \u043A\u0430\u043A \u0431\u0443\u0434\u0435\u0442 \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u0442\u044C
    \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u0435 \u0435\u0441\u043B\u0438 \u043E\u043D\u043E
    \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043D\u0435\u0442 \u043F\u043E\u043C\u0435\u0449\u0430\u0442\u044C\u0441\u044F
    \u0432 \u0442\u0435\u043A\u0441\u0442\u043E\u0432\u044B\u0439 \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440"
